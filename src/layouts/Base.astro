---
import '../styles/global.css';
import { SEYEON } from '../data/curriculum';

interface Props { title: string; desc?: string; }
const { title, desc = '아빠와 세연이가 백지에 다시 그리는 수학 12년 지도' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const NAV = [
  { href: '/',        label: '홈' },
  { href: '/map',     label: '개념지도' },
  { href: '/prep',    label: '아빠 예습' },
  { href: '/journal', label: '일지' },
  { href: '/notes',   label: '강의노트' },
  { href: '/board',   label: '게시판' },
  { href: '/files',   label: '자료실' },
  { href: '/trash',   label: '휴지통' },
];
const cur = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · 수학 바이블</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={`${title} · 수학 바이블`} />
  <meta property="og:description" content={desc} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="site-head">
    <div class="bar">
      <a class="brand" href="/">수학 바이블<span class="pen">세연이의 12년 지도</span></a>
      <nav class="nav" aria-label="주 메뉴">
        {NAV.map((n) => (
          <a href={n.href} aria-current={cur(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main class="wrap" style="padding-top:26px">
    <slot />
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:baseline">
        <span class="hand" style="font-size:20px;color:var(--graphite)">
          아빠가 세연이를 위해 만든 지도
        </span>
        <span class="tiny">
          현재 진도: {SEYEON.grade} 2학기 {SEYEON.unit}단원 「{SEYEON.unitName}」
          · 기준일 {SEYEON.updated}
        </span>
        <span class="tiny" style="margin-left:auto">
          <button type="button" id="lockBtn" class="ghost" style="font-size:12px;padding:4px 10px">잠금</button>
        </span>
      </div>
    </div>
  </footer>

  <div id="toast" role="status" aria-live="polite"></div>

  <script>
    import { isUnlocked, clearPass, toast } from '../lib/db';
    const btn = document.getElementById('lockBtn') as HTMLButtonElement | null;
    if (btn) {
      isUnlocked().then((ok) => { btn.textContent = ok ? '잠그기' : '잠김'; });
      btn.addEventListener('click', () => {
        clearPass();
        btn.textContent = '잠김';
        toast('잠갔습니다');
        setTimeout(() => location.reload(), 600);
      });
    }
  </script>
</body>
</html>
