---
const year = new Date().getFullYear();

const explore = [
  { href: '/projects', label: 'Work' },
  { href: '/templates', label: 'Templates' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/video-catalog', label: 'Videos' },
  { href: '/guides', label: 'Learn' },
  { href: '/blog', label: 'Blog' },
  { href: '/archive', label: 'Archive' },
];

const connect = [
  { href: '/contact', label: 'Contact' },
  { href: 'https://github.com/Jason198341', label: 'GitHub', external: true },
  { href: 'https://youtube.com/@PeopleSky', label: 'YouTube', external: true },
  { href: '/board', label: 'Board' },
];
---

<footer class="relative border-t border-border/30">
  <!-- Gradient border animation -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>

  <div class="mx-auto max-w-5xl px-6 pt-12 pb-8">

    <!-- Navigation grid -->
    <div class="grid grid-cols-2 gap-8 sm:gap-16 mb-12">
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-text-muted/50 mb-4">Explore</h3>
        <ul class="space-y-2.5">
          {explore.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-text-muted hover:text-text transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-text-muted/50 mb-4">Connect</h3>
        <ul class="space-y-2.5">
          {connect.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-text-muted hover:text-text transition-colors duration-200 inline-flex items-center gap-1.5"
                {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {link.label}
                {link.external && (
                  <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-border/20 mb-8"></div>

    <!-- Quote + Copyright -->
    <p class="reveal text-center text-sm text-text-muted/60 italic mb-8 max-w-md mx-auto leading-relaxed">
      "Fulfillment activates the moment you define it."
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-muted/50 font-mono">
        &copy; {year} Jason Moon &middot; Built with Astro
      </p>

      <div class="flex items-center gap-4">
        <a
          href="https://github.com/Jason198341"
          target="_blank"
          rel="noopener"
          class="group relative text-text-muted/50 hover:text-text transition-colors duration-300"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          <!-- Hover glow -->
          <span class="absolute inset-0 rounded-full bg-accent/0 group-hover:bg-accent/10 blur-md transition-all duration-300"></span>
        </a>
      </div>
    </div>
  </div>
</footer>
