---
const pathname = Astro.url.pathname;

interface NavLink {
  href?: string;
  label: string;
  children?: { href: string; label: string }[];
}

const links: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Work' },
  {
    label: 'Showcase',
    children: [
      { href: '/exec-english-100/', label: 'English 100' },
      { href: '/templates', label: 'Templates' },
      { href: '/prompts', label: 'Prompts' },
      { href: '/video-catalog', label: 'Videos' },
      { href: '/thoughts', label: 'Thoughts' },
      { href: '/skills', label: 'Skills' },
    ],
  },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

function isActive(link: NavLink): boolean {
  if (link.href) {
    if (link.href === '/') return pathname === '/';
    return pathname.startsWith(link.href);
  }
  return link.children?.some((c) => pathname.startsWith(c.href)) ?? false;
}

const mobileLinks: { href: string; label: string; indent?: boolean }[] = [];
for (const link of links) {
  if (link.children) {
    mobileLinks.push({ href: '', label: link.label });
    for (const child of link.children) {
      mobileLinks.push({ href: child.href, label: child.label, indent: true });
    }
  } else {
    mobileLinks.push({ href: link.href!, label: link.label });
  }
}
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-border/40 bg-bg/80 backdrop-blur-md"
>
  <!-- Top status strip -->
  <div class="hidden sm:flex items-center justify-between px-6 h-6 border-b border-border/30 bg-surface/50 font-mono text-[10px] tracking-[0.2em] uppercase text-text-faint">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5">
        <span class="hud-pip hud-pip--on"></span>
        <span class="text-green">Sys_Online</span>
      </span>
      <span>37.5665°N · 126.9780°E</span>
    </div>
    <div class="flex items-center gap-4">
      <span id="hud-clock">00:00:00 KST</span>
      <span class="text-accent">v2026.04</span>
    </div>
  </div>

  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 h-14">
    <a href="/" class="group flex items-center gap-3 font-mono text-sm font-bold tracking-tight text-text">
      <span class="reg-mark text-accent"></span>
      <span class="tracking-wider">
        JASONMOON<span class="text-accent">.DEV</span>
      </span>
      <span class="hidden md:inline-block hud-id">SYS-001</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-0.5">
      {links.map((link, idx) =>
        link.children ? (
          <li class="relative" id="showcase-dropdown">
            <button
              class:list={[
                'relative flex items-center gap-1 px-3 py-2 font-mono text-[11px] tracking-[0.2em] uppercase transition-colors duration-200',
                isActive(link) ? 'text-accent' : 'text-text-muted hover:text-text',
              ]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="text-text-faint/60 mr-1">0{idx + 1}</span>
              {link.label}
              <svg class="w-3 h-3 opacity-60 transition-transform duration-200" id="showcase-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
              {isActive(link) && (
                <span class="absolute -bottom-0.5 left-2 right-2 h-0.5 bg-accent"></span>
              )}
            </button>
            <div
              id="showcase-panel"
              class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-52 border border-border-strong bg-bg/95 backdrop-blur-xl shadow-2xl opacity-0 invisible translate-y-1 transition-all duration-200 pointer-events-none"
            >
              <div class="border-b border-border/50 px-3 py-1.5 font-mono text-[9px] tracking-[0.25em] uppercase text-text-faint flex justify-between">
                <span>Showcase Index</span>
                <span class="text-accent">{link.children.length}</span>
              </div>
              <div class="p-1">
                {link.children.map((child, cIdx) => (
                  <a
                    href={child.href}
                    class:list={[
                      'flex items-center justify-between px-3 py-2 font-mono text-[11px] tracking-[0.15em] uppercase transition-colors',
                      pathname.startsWith(child.href)
                        ? 'text-accent bg-accent-dim'
                        : 'text-text-muted hover:text-accent hover:bg-surface',
                    ]}
                  >
                    <span>{child.label}</span>
                    <span class="text-text-faint/50 text-[9px]">{String(cIdx + 1).padStart(2, '0')}</span>
                  </a>
                ))}
              </div>
            </div>
          </li>
        ) : (
          <li>
            <a
              href={link.href}
              class:list={[
                'relative flex items-center gap-1 px-3 py-2 font-mono text-[11px] tracking-[0.2em] uppercase transition-colors duration-200',
                isActive(link) ? 'text-accent' : 'text-text-muted hover:text-text',
              ]}
            >
              <span class="text-text-faint/60 mr-1">0{idx + 1}</span>
              {link.label}
              {isActive(link) && (
                <span class="absolute -bottom-0.5 left-2 right-2 h-0.5 bg-accent"></span>
              )}
            </a>
          </li>
        )
      )}
    </ul>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="md:hidden relative w-10 h-10 flex items-center justify-center text-text-muted hover:text-accent border border-border"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <g id="hamburger-icon" class="transition-all duration-300 origin-center">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16" />
        </g>
      </svg>
    </button>
  </nav>

  <!-- Mobile nav -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden transition-all duration-300 ease-out border-t border-border/40"
    style="max-height: 0; opacity: 0;"
  >
    <div class="bg-bg/95 backdrop-blur-xl">
      <ul class="px-6 py-4 space-y-0.5">
        {mobileLinks.map((item, i) =>
          item.href === '' ? (
            <li class="mobile-menu-item pt-3" style={`transition-delay: ${i * 40}ms;`}>
              <span class="block px-2 py-1 font-mono text-[9px] tracking-[0.3em] uppercase text-accent border-l-2 border-accent pl-3">
                {item.label}
              </span>
            </li>
          ) : (
            <li class="mobile-menu-item" style={`transition-delay: ${i * 40}ms;`}>
              <a
                href={item.href}
                class:list={[
                  'flex items-center justify-between font-mono text-xs tracking-[0.15em] uppercase transition-colors',
                  item.indent ? 'pl-8 pr-3 py-2' : 'px-3 py-2.5',
                  pathname.startsWith(item.href) && item.href !== '/'
                    ? 'text-accent bg-accent-dim'
                    : item.href === '/' && pathname === '/'
                      ? 'text-accent bg-accent-dim'
                      : 'text-text-muted hover:text-accent hover:bg-surface',
                ]}
              >
                <span>{item.label}</span>
                <span class="text-text-faint/40 text-[9px]">→</span>
              </a>
            </li>
          )
        )}
      </ul>
    </div>
  </div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-[80px] sm:h-[86px]"></div>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const clock = document.getElementById('hud-clock');
  let isOpen = false;
  let lastScrollY = 0;
  let ticking = false;

  // Clock readout
  function updateClock() {
    if (!clock) return;
    const d = new Date();
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    const ss = String(d.getSeconds()).padStart(2, '0');
    clock.textContent = `${hh}:${mm}:${ss} KST`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    if (menu) {
      if (isOpen) {
        menu.style.maxHeight = menu.scrollHeight + 'px';
        menu.style.opacity = '1';
      } else {
        menu.style.maxHeight = '0';
        menu.style.opacity = '0';
      }
    }
  });

  // Desktop dropdown
  const dropdown = document.getElementById('showcase-dropdown');
  const panel = document.getElementById('showcase-panel');
  const chevron = document.getElementById('showcase-chevron');
  let hoverTimeout: ReturnType<typeof setTimeout> | null = null;

  function showDropdown() {
    if (hoverTimeout) clearTimeout(hoverTimeout);
    hoverTimeout = setTimeout(() => {
      if (panel) {
        panel.classList.remove('opacity-0', 'invisible', 'translate-y-1', 'pointer-events-none');
        panel.classList.add('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
      }
      if (chevron) chevron.style.transform = 'rotate(180deg)';
      dropdown?.querySelector('button')?.setAttribute('aria-expanded', 'true');
    }, 100);
  }

  function hideDropdown() {
    if (hoverTimeout) clearTimeout(hoverTimeout);
    hoverTimeout = setTimeout(() => {
      if (panel) {
        panel.classList.add('opacity-0', 'invisible', 'translate-y-1', 'pointer-events-none');
        panel.classList.remove('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
      }
      if (chevron) chevron.style.transform = '';
      dropdown?.querySelector('button')?.setAttribute('aria-expanded', 'false');
    }, 200);
  }

  dropdown?.addEventListener('mouseenter', showDropdown);
  dropdown?.addEventListener('mouseleave', hideDropdown);
  dropdown?.querySelector('button')?.addEventListener('click', () => {
    const expanded = panel?.classList.contains('opacity-100');
    if (expanded) hideDropdown();
    else showDropdown();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('opacity-100')) {
      hideDropdown();
    }
  });

  // Scroll-aware header (hide on scroll down)
  function onScroll() {
    if (!header) return;
    const scrollY = window.scrollY;
    const scrollingDown = scrollY > lastScrollY && scrollY > 120;

    if (scrollingDown && !isOpen) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }

    lastScrollY = scrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });
</script>
