---
const pathname = Astro.url.pathname;

interface NavLink {
  href?: string;
  label: string;
  children?: { href: string; label: string }[];
}

const links: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Work' },
  {
    label: 'Showcase',
    children: [
      { href: '/templates', label: 'Templates' },
      { href: '/prompts', label: 'Prompts' },
      { href: '/video-catalog', label: 'Videos' },
    ],
  },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

function isActive(link: NavLink): boolean {
  if (link.href) {
    if (link.href === '/') return pathname === '/';
    return pathname.startsWith(link.href);
  }
  // Parent with children: active if any child is active
  return link.children?.some((c) => pathname.startsWith(c.href)) ?? false;
}

// Flatten for mobile menu
const mobileLinks: { href: string; label: string; indent?: boolean }[] = [];
let mobileIdx = 0;
for (const link of links) {
  if (link.children) {
    // Showcase header (non-clickable)
    mobileLinks.push({ href: '', label: link.label });
    for (const child of link.children) {
      mobileLinks.push({ href: child.href, label: child.label, indent: true });
    }
  } else {
    mobileLinks.push({ href: link.href!, label: link.label });
  }
}
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 transition-all duration-300">
    <a href="/" class="group flex items-center gap-2.5 font-mono text-lg font-bold tracking-tight text-text transition-colors">
      <span class="relative">
        <img src="/logo.png" alt="" class="w-7 h-7 rounded transition-transform duration-300 group-hover:scale-110" />
        <span class="absolute inset-0 rounded bg-accent/0 group-hover:bg-accent/20 blur-md transition-all duration-300"></span>
      </span>
      <span>jasonmoon<span class="text-accent">.dev</span></span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1">
      {links.map((link) =>
        link.children ? (
          <li class="relative" id="showcase-dropdown">
            <button
              class:list={[
                'relative flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                isActive(link) ? 'text-accent' : 'text-text-muted hover:text-text',
              ]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {link.label}
              <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-200" id="showcase-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
              {isActive(link) && (
                <span class="absolute bottom-0.5 left-3 right-3 h-0.5 rounded-full bg-accent"></span>
              )}
            </button>
            {/* Dropdown panel */}
            <div
              id="showcase-panel"
              class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 rounded-xl border border-border/50 bg-surface/95 backdrop-blur-xl shadow-2xl opacity-0 invisible translate-y-1 transition-all duration-200 pointer-events-none"
            >
              <div class="p-2">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'block px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                      pathname.startsWith(child.href)
                        ? 'text-accent bg-accent/10'
                        : 'text-text-muted hover:text-text hover:bg-surface-hover',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </li>
        ) : (
          <li>
            <a
              href={link.href}
              class:list={[
                'relative px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                isActive(link) ? 'text-accent' : 'text-text-muted hover:text-text',
              ]}
            >
              {link.label}
              {isActive(link) && (
                <span class="absolute bottom-0.5 left-3 right-3 h-0.5 rounded-full bg-accent"></span>
              )}
            </a>
          </li>
        )
      )}
    </ul>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="md:hidden relative w-10 h-10 flex items-center justify-center text-text-muted hover:text-text transition-colors rounded-lg"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <g id="hamburger-icon" class="transition-all duration-300 origin-center">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16" />
        </g>
      </svg>
    </button>
  </nav>

  <!-- Mobile nav -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden transition-all duration-300 ease-out"
    style="max-height: 0; opacity: 0;"
  >
    <div class="border-t border-border/30 bg-surface/80 backdrop-blur-xl">
      <ul class="px-6 py-4 space-y-1">
        {mobileLinks.map((item, i) =>
          item.href === '' ? (
            // Showcase section header (non-clickable)
            <li class="mobile-menu-item" style={`transition-delay: ${i * 50}ms;`}>
              <span class="block px-4 py-2 text-xs font-mono uppercase tracking-widest text-text-muted/50">
                {item.label}
              </span>
            </li>
          ) : (
            <li class="mobile-menu-item" style={`transition-delay: ${i * 50}ms;`}>
              <a
                href={item.href}
                class:list={[
                  'block rounded-lg text-sm font-medium transition-colors',
                  item.indent ? 'pl-8 pr-4 py-2' : 'px-4 py-2.5',
                  pathname.startsWith(item.href) && item.href !== '/'
                    ? 'text-accent bg-accent/10'
                    : item.href === '/' && pathname === '/'
                      ? 'text-accent bg-accent/10'
                      : 'text-text-muted hover:text-text hover:bg-surface-hover',
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </div>
  </div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-16"></div>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  let isOpen = false;
  let lastScrollY = 0;
  let ticking = false;

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    if (menu) {
      if (isOpen) {
        menu.style.maxHeight = menu.scrollHeight + 'px';
        menu.style.opacity = '1';
      } else {
        menu.style.maxHeight = '0';
        menu.style.opacity = '0';
      }
    }
  });

  // Desktop dropdown with 200ms hover delay
  const dropdown = document.getElementById('showcase-dropdown');
  const panel = document.getElementById('showcase-panel');
  const chevron = document.getElementById('showcase-chevron');
  let hoverTimeout: ReturnType<typeof setTimeout> | null = null;

  function showDropdown() {
    if (hoverTimeout) clearTimeout(hoverTimeout);
    hoverTimeout = setTimeout(() => {
      if (panel) {
        panel.classList.remove('opacity-0', 'invisible', 'translate-y-1', 'pointer-events-none');
        panel.classList.add('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
      }
      if (chevron) chevron.style.transform = 'rotate(180deg)';
      dropdown?.querySelector('button')?.setAttribute('aria-expanded', 'true');
    }, 100);
  }

  function hideDropdown() {
    if (hoverTimeout) clearTimeout(hoverTimeout);
    hoverTimeout = setTimeout(() => {
      if (panel) {
        panel.classList.add('opacity-0', 'invisible', 'translate-y-1', 'pointer-events-none');
        panel.classList.remove('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
      }
      if (chevron) chevron.style.transform = '';
      dropdown?.querySelector('button')?.setAttribute('aria-expanded', 'false');
    }, 200);
  }

  dropdown?.addEventListener('mouseenter', showDropdown);
  dropdown?.addEventListener('mouseleave', hideDropdown);

  // Also handle keyboard: toggle on click/enter
  dropdown?.querySelector('button')?.addEventListener('click', () => {
    const expanded = panel?.classList.contains('opacity-100');
    if (expanded) hideDropdown();
    else showDropdown();
  });

  // Close dropdown on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('opacity-100')) {
      hideDropdown();
    }
  });

  // Scroll-aware header
  function onScroll() {
    if (!header) return;
    const scrollY = window.scrollY;
    const scrollingDown = scrollY > lastScrollY && scrollY > 80;

    if (scrollY > 50) {
      header.style.backgroundColor = 'rgba(17,17,22,0.85)';
      header.style.backdropFilter = 'blur(16px)';
      header.style.webkitBackdropFilter = 'blur(16px)';
      header.style.borderBottom = '1px solid rgba(34,34,48,0.4)';
    } else {
      header.style.backgroundColor = '';
      header.style.backdropFilter = '';
      header.style.webkitBackdropFilter = '';
      header.style.borderBottom = '';
    }

    if (scrollingDown && !isOpen) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }

    lastScrollY = scrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });
</script>
