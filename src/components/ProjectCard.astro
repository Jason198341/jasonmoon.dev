---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  stack: string[];
  image?: string;
  projectType?: string;
}

const { title, description, slug, category, stack, image, projectType } = Astro.props;

const categoryColors: Record<string, string> = {
  'Web App': 'text-indigo-400 bg-indigo-500/10',
  'Mobile App': 'text-emerald-400 bg-emerald-500/10',
  'Chrome Extension': 'text-amber-400 bg-amber-500/10',
};

const typeColors: Record<string, string> = {
  Personal: 'text-amber-400 bg-amber-400/10 border border-amber-400/20',
  Client: 'text-emerald-400 bg-emerald-400/10 border border-emerald-400/20',
};
---

<a
  href={`/projects/${slug}`}
  class="group block rounded-xl border border-border bg-surface overflow-hidden hover:border-accent/40 hover:bg-surface-hover transition-all duration-200 glow-hover"
>
  {image && (
    <div class="h-36 overflow-hidden bg-bg/50">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-start justify-between mb-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${categoryColors[category] || 'text-text-muted bg-surface'}`}>
          {category}
        </span>
        {projectType && (
          <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-medium ${typeColors[projectType] || ''}`}>
            {projectType}
          </span>
        )}
      </div>
      <svg class="w-4 h-4 text-text-muted group-hover:text-accent transition-colors -translate-x-1 group-hover:translate-x-0 duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
      </svg>
    </div>

    <h3 class="text-lg font-semibold mb-2 group-hover:text-accent transition-colors">
      {title}
    </h3>

    <p class="text-sm text-text-muted leading-relaxed mb-4">
      {description}
    </p>

    <div class="flex flex-wrap gap-1.5">
      {stack.slice(0, 5).map((tech) => (
        <span class="px-2 py-0.5 rounded text-xs font-mono text-text-muted bg-bg border border-border">
          {tech}
        </span>
      ))}
      {stack.length > 5 && (
        <span class="px-2 py-0.5 rounded text-xs font-mono text-text-muted bg-bg border border-border">
          +{stack.length - 5}
        </span>
      )}
    </div>
  </div>
</a>
