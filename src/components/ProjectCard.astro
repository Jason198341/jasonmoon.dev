---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  stack: string[];
}

const { title, description, slug, category, stack } = Astro.props;

const categoryColors: Record<string, string> = {
  'Web App': 'text-indigo-400 bg-indigo-400/10',
  'Mobile App': 'text-emerald-400 bg-emerald-400/10',
  'Chrome Extension': 'text-amber-400 bg-amber-400/10',
};
---

<a
  href={`/projects/${slug}`}
  class="group block rounded-xl border border-border bg-surface p-6 hover:border-accent/40 hover:bg-surface-hover transition-all duration-200"
>
  <div class="flex items-start justify-between mb-3">
    <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${categoryColors[category] || 'text-text-muted bg-surface'}`}>
      {category}
    </span>
    <svg class="w-4 h-4 text-text-muted group-hover:text-accent transition-colors -translate-x-1 group-hover:translate-x-0 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
    </svg>
  </div>

  <h3 class="text-lg font-semibold mb-2 group-hover:text-accent transition-colors">
    {title}
  </h3>

  <p class="text-sm text-text-muted leading-relaxed mb-4">
    {description}
  </p>

  <div class="flex flex-wrap gap-1.5">
    {stack.map((tech) => (
      <span class="px-2 py-0.5 rounded text-xs font-mono text-text-muted bg-bg border border-border">
        {tech}
      </span>
    ))}
  </div>
</a>
