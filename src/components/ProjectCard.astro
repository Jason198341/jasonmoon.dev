---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  stack: string[];
  image?: string;
  projectType?: string;
}

const { title, description, slug, category, stack, image, projectType } = Astro.props;

const categoryLabels: Record<string, string> = {
  'Web App': 'WEB',
  'Mobile App': 'MOB',
  'Chrome Extension': 'EXT',
  'Desktop App': 'DSK',
  'CLI Tool': 'CLI',
  'Concept': 'R&D',
};
const catTag = categoryLabels[category] || 'SYS';

// Simple hash → PRJ id for visual consistency
const prjId = Array.from(slug).reduce((a, c) => a + c.charCodeAt(0), 0) % 99;
const prjCode = `PRJ-${String(prjId).padStart(2, '0')}`;

const statusPip = projectType === 'Client' ? 'hud-pip--on' : 'hud-pip--amber';
const statusLabel = projectType === 'Client' ? 'Delivered' : projectType === 'Personal' ? 'Personal' : 'Active';
---

<a
  href={`/projects/${slug}`}
  class="group relative block border border-border bg-surface/40 overflow-hidden hover:border-accent transition-colors duration-300"
>
  <!-- Corner brackets -->
  <span class="absolute top-0 left-0 w-3.5 h-3.5 border-t border-l border-accent/70 group-hover:border-accent transition-colors z-20"></span>
  <span class="absolute top-0 right-0 w-3.5 h-3.5 border-t border-r border-accent/70 group-hover:border-accent transition-colors z-20"></span>
  <span class="absolute bottom-0 left-0 w-3.5 h-3.5 border-b border-l border-accent/70 group-hover:border-accent transition-colors z-20"></span>
  <span class="absolute bottom-0 right-0 w-3.5 h-3.5 border-b border-r border-accent/70 group-hover:border-accent transition-colors z-20"></span>

  <!-- Top strip: ID + status -->
  <div class="flex items-center justify-between px-4 py-2 border-b border-border bg-bg/50 font-mono text-[10px] tracking-[0.2em] uppercase">
    <span class="text-accent">{prjCode} // {catTag}</span>
    <span class="flex items-center gap-1.5 text-text-muted">
      <span class={`hud-pip ${statusPip}`} style="width:5px;height:5px;"></span>
      {statusLabel}
    </span>
  </div>

  {image && (
    <div class="relative h-40 overflow-hidden bg-bg/30">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover object-top group-hover:scale-[1.05] transition-transform duration-700 ease-out opacity-80 group-hover:opacity-100"
        loading="lazy"
      />
      <!-- Crosshair overlay on hover -->
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
        <span class="absolute top-1/2 left-0 right-0 h-px bg-accent/40"></span>
        <span class="absolute top-0 bottom-0 left-1/2 w-px bg-accent/40"></span>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent"></div>
    </div>
  )}

  <div class="p-5">
    <h3 class="font-display text-lg font-bold tracking-tight mb-2 text-text group-hover:text-accent transition-colors duration-300">
      {title}
    </h3>

    <p class="text-sm text-text-muted leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>

    <!-- Stack as technical callouts -->
    <div class="flex flex-wrap gap-x-2 gap-y-1 mb-3">
      {stack.slice(0, 4).map((tech, idx) => (
        <>
          <span class="font-mono text-[10px] text-text-muted tracking-wider uppercase">{tech}</span>
          {idx < Math.min(stack.length, 4) - 1 && <span class="text-accent/50 text-[10px]">·</span>}
        </>
      ))}
      {stack.length > 4 && (
        <span class="font-mono text-[10px] text-text-faint tracking-wider">+{stack.length - 4}</span>
      )}
    </div>

    <div class="flex items-center justify-between pt-2 border-t border-border/50">
      <span class="font-mono text-[10px] text-text-faint tracking-[0.2em] uppercase group-hover:text-accent transition-colors">
        ► Execute
      </span>
      <svg class="w-3.5 h-3.5 text-text-faint group-hover:text-accent group-hover:translate-x-0.5 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </div>
  </div>
</a>
