---
import { getPrep, PREP_FIELDS, CHECK_ITEMS, PREP_LABEL } from '../data/prep';

interface Props { id: string; }
const { id } = Astro.props;
const p = getPrep(id);
const doneChecks = p ? CHECK_ITEMS.filter((c) => p.checklist?.[c.key]).length : 0;
---
{p ? (
  <>
    <div class="card lift" style="border-left:6px solid var(--ink)">
      <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap">
        <b style="font-size:17px">예습 노트</b>
        <span class={`pill ${p.status === 'ready' || p.status === 'taught' ? 'learned' : 'current'}`}>
          {PREP_LABEL[p.status]}
        </span>
        {p.minutes && <span class="tiny">약 {p.minutes}분</span>}
        <span class="tiny">자기점검 {doneChecks}/{CHECK_ITEMS.length}</span>
        {p.updated && <span class="tiny" style="margin-left:auto">{p.updated}</span>}
      </div>

      <div style="margin-top:12px;display:grid;gap:6px">
        {CHECK_ITEMS.map((c) => (
          <div style="display:flex;gap:8px;align-items:flex-start;font-size:13.5px">
            <span style={`flex:0 0 auto;font-weight:700;color:${p.checklist?.[c.key] ? 'var(--learned)' : 'var(--pencil)'}`}>
              {p.checklist?.[c.key] ? '✓' : '·'}
            </span>
            <span style={p.checklist?.[c.key] ? '' : 'color:var(--soft)'}>{c.label}</span>
          </div>
        ))}
      </div>
    </div>

    {PREP_FIELDS.map(([k, title]) => {
      const v = (p as any)[k];
      if (!v) return null;
      const mono = k === 'script';
      return (
        <div class="card" style={`margin-top:12px${mono ? ';background:#FAFAF7' : ''}`}>
          <div class="tiny" style="font-weight:700;letter-spacing:.3px">{title}</div>
          <div style={`white-space:pre-wrap;margin-top:6px;font-size:${mono ? '14px' : '14.5px'};line-height:1.75${
            mono ? ";font-family:ui-monospace,'D2Coding',Consolas,monospace" : ''}`}>{v}</div>
        </div>
      );
    })}
  </>
) : (
  <div class="lock">
    <p style="margin:0">
      <b>이 개념은 아직 예습 전입니다.</b><br />
      <span class="tiny">
        예습 노트는 코드에 씁니다 — <code>src/data/prep/</code> 에 추가 후 배포.
        Claude에게 <code>/mathjason</code> 으로 불러주시면 됩니다.
      </span>
    </p>
  </div>
)}
