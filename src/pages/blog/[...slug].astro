---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, category, tags } = post.data;

// Reading time estimate
const rendered = await render(post);
const wordCount = rendered.Content.toString().length / 5; // rough estimate
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Prev / Next
const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prev = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const next = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const categoryConfig: Record<string, { label: string; color: string; dot: string }> = {
  dev: { label: 'Dev', color: 'text-indigo-400 bg-indigo-500/10', dot: 'bg-indigo-400' },
  ai: { label: 'AI', color: 'text-emerald-400 bg-emerald-500/10', dot: 'bg-emerald-400' },
  essay: { label: 'Essay', color: 'text-amber-400 bg-amber-500/10', dot: 'bg-amber-400' },
  tutorial: { label: 'Tutorial', color: 'text-teal-400 bg-teal-500/10', dot: 'bg-teal-400' },
};

const cfg = categoryConfig[category] || { label: category, color: 'text-text-muted bg-surface', dot: 'bg-text-muted' };

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
---

<Base title={`${title} — Blog`} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <!-- Back link -->
    <a href="/blog" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Blog
    </a>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3 text-sm">
        <time class="text-text-muted font-mono">{formatDate(date)}</time>
        <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-xs font-medium ${cfg.color}`}>
          <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
          {cfg.label}
        </span>
        <span class="text-text-muted/60">&middot;</span>
        <span class="text-text-muted">{readingTime} min read</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold mb-3">{title}</h1>
      <p class="text-text-muted leading-relaxed">{description}</p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {tags.map((tag) => (
            <span class="px-2 py-0.5 rounded-md text-[11px] font-mono text-text-muted/70 bg-bg/60 border border-border/50">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="prose pb-12">
      <Content />
    </div>

    <!-- Prev / Next navigation -->
    <div class="border-t border-border pt-6 flex justify-between gap-4">
      {prev ? (
        <a href={`/blog/${prev.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-left">
          <span class="text-xs text-text-muted">Older</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {prev.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
      {next ? (
        <a href={`/blog/${next.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-right">
          <span class="text-xs text-text-muted">Newer</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {next.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
    </div>
  </article>
</Base>
