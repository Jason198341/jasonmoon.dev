---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categories = ['All', 'dev', 'ai', 'essay', 'tutorial'] as const;

const categoryConfig: Record<string, { label: string; color: string; dot: string }> = {
  dev: { label: 'Dev', color: 'text-indigo-400 bg-indigo-500/10', dot: 'bg-indigo-400' },
  ai: { label: 'AI', color: 'text-emerald-400 bg-emerald-500/10', dot: 'bg-emerald-400' },
  essay: { label: 'Essay', color: 'text-amber-400 bg-amber-500/10', dot: 'bg-amber-400' },
  tutorial: { label: 'Tutorial', color: 'text-teal-400 bg-teal-500/10', dot: 'bg-teal-400' },
};

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}

// Ideas data (mirrored from ideas.astro)
const ideas = [
  {
    id: 'label-decoder',
    number: '01',
    status: 'Exploring',
    statusColor: 'text-amber-400 bg-amber-400/10 border-amber-400/20',
    accent: '#818cf8',
    accentDim: 'rgba(129,140,248,0.08)',
    accentBorder: 'rgba(129,140,248,0.2)',
    name: 'AI 라벨 해독 서비스',
    nameEn: 'Label Decoder',
    tagline: 'AI가 당신에게 붙인 라벨을 해체한다',
    category: 'Meta-AI · B2C',
    thesis: 'AI는 당신을 분석하고 설명한다. 하지만 그 설명이 당신을 가두기 시작한다.',
    problem: [
      '"ADHD 성향", "회피형 애착", "번아웃 3단계" — 정확한 라벨이 가능성을 닫는다.',
      'AI 진단은 인상이지 전부가 아니다. 하지만 대부분의 사람은 그것을 자신의 정의로 받아들인다.',
    ],
    target: 'AI 코칭·상담·자기계발 앱을 많이 쓰는 사람들.',
  },
  {
    id: 'judgment-free',
    number: '02',
    status: 'Thinking',
    statusColor: 'text-cyan-400 bg-cyan-400/10 border-cyan-400/20',
    accent: '#22d3ee',
    accentDim: 'rgba(34,211,238,0.06)',
    accentBorder: 'rgba(34,211,238,0.18)',
    name: '판단 없는 듣기',
    nameEn: 'Judgment-Free Listening',
    tagline: '조언 없이, 판단 없이 — 그냥 들어준다',
    category: 'Human Connection · B2C',
    thesis: '조언은 넘치고 경청은 없다. 아무도 그냥 들어주지 않는다.',
    problem: [
      'AI는 분석해주고, 친구는 해결책을 주고, 상담사는 진단을 내린다.',
      '"판단 없이 들려지는 경험" — 가장 근본적인 인간 욕구 중 하나가 사라지고 있다.',
    ],
    target: '설명받는 게 피곤한 사람들. 판단 없이 말하고 싶은 순간이 있는 모든 사람.',
  },
  {
    id: 'mirror-literacy',
    number: '03',
    status: 'Thinking',
    statusColor: 'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
    accent: '#34d399',
    accentDim: 'rgba(52,211,153,0.06)',
    accentBorder: 'rgba(52,211,153,0.18)',
    name: '미러링 리터러시',
    nameEn: 'Mirroring Literacy',
    tagline: 'AI에 뺏긴 역할을 인간이 되찾는다',
    category: 'Education · B2B2C',
    thesis: 'AI가 사람을 설명해주는 자리를 차지했다. 하지만 주변 사람에게 제대로 이해받고 싶다는 욕구는 없어지지 않는다.',
    problem: [
      '리더는 팀원을 평가하지만 그 사람의 존재를 설명해주지 않는다.',
      '파트너는 상대를 사랑하지만 상대가 느끼는 방식으로 이해해주지 못한다.',
    ],
    target: '리더, 관리자, 부모, 커플.',
  },
];

const pipeline = [
  { name: '런닝 코치 OS', desc: '훈련 로그·부상·심리 상태를 하나의 흐름으로 연결', tag: 'B2C · Sports' },
  { name: '자동차 부품 원가 AI', desc: '10년 설계 경험 + LLM으로 원가 즉시 추정', tag: 'B2B · Automotive' },
  { name: '부모-자녀 영어 대화 앱', desc: '부모가 영어 선생님이 되는 앱', tag: 'B2C · EdTech' },
  { name: 'KPI 캐스케이드 엔진', desc: '전략 목표가 개인 할 일까지 자동 분해', tag: 'B2B · SaaS' },
  { name: '아이디어 생존 테스트', desc: '72시간 안에 실제 수요 검증', tag: 'B2C · Tools' },
  { name: '감정 번역기', desc: '내가 느끼는 걸 상대의 언어로 바꿔주는 도구', tag: 'B2C · Wellness' },
];

const shipped = [
  { name: 'PostSpark', desc: '배경 → LinkedIn 콘텐츠 10개', url: 'https://postspark-ai.vercel.app', tag: 'Live' },
  { name: 'IdeaForge', desc: '불편함 → 사업 아이디어 10개', url: 'https://ideaforge-tool.vercel.app', tag: 'Live' },
  { name: '증상 구조화 도구', desc: '환자 언어 → 의사 언어', url: 'https://health-radio-tool.vercel.app', tag: 'Live' },
];
---

<Base title="Blog — Jason Moon" description="Thoughts on building, AI, and engineering — from an automotive engineer who codes at night.">
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4 animate-fade-in-up delay-1">Blog</h1>
      <p class="text-text-muted mb-8 max-w-2xl leading-relaxed animate-fade-in-up delay-2">
        Notes on building, learning, and shipping — from dev deep-dives to broader reflections.
      </p>

      <!-- Tab switcher: Posts | Ideas -->
      <div class="flex gap-1 mb-10 animate-fade-in-up delay-3 border-b border-border/40 pb-0" id="blog-tabs">
        <button
          data-tab="posts"
          class="px-5 py-2.5 text-sm font-semibold transition-all duration-200 border-b-2 -mb-px border-accent text-accent"
        >
          Posts
        </button>
        <button
          data-tab="ideas"
          class="px-5 py-2.5 text-sm font-semibold transition-all duration-200 border-b-2 -mb-px border-transparent text-text-muted hover:text-text"
        >
          Ideas
        </button>
      </div>

      <!-- ═══ POSTS TAB ═══ -->
      <div id="tab-posts">
        <!-- Category filter pills -->
        <div class="flex flex-wrap gap-2 mb-10" id="filters">
          {categories.map((cat) => (
            <button
              data-category={cat}
              class:list={[
                'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border',
                cat === 'All'
                  ? 'border-accent text-accent bg-accent/10'
                  : 'border-border/60 text-text-muted hover:text-text hover:border-accent/30',
              ]}
            >
              {cat === 'All' ? 'All' : categoryConfig[cat]?.label || cat}
            </button>
          ))}
        </div>

        <!-- Post list -->
        <div class="space-y-4" id="post-list">
          {posts.map((post, i) => {
            const cfg = categoryConfig[post.data.category] || { label: post.data.category, color: 'text-text-muted bg-surface', dot: 'bg-text-muted' };
            return (
              <div data-cat={post.data.category} class="reveal" style={`transition-delay: ${Math.min(i * 60, 400)}ms;`}>
                <a
                  href={`/blog/${post.id}`}
                  class="group block p-5 rounded-xl border border-border/60 bg-surface/40 hover:bg-surface hover:border-accent/30 transition-all duration-300"
                >
                  <div class="flex items-center gap-3 mb-2 text-xs">
                    <time class="text-text-muted font-mono">{formatDate(post.data.date)}</time>
                    <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md font-medium ${cfg.color}`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
                      {cfg.label}
                    </span>
                  </div>
                  <h2 class="text-lg font-bold group-hover:text-accent transition-colors duration-200 mb-1">
                    {post.data.title}
                  </h2>
                  <p class="text-sm text-text-muted leading-relaxed line-clamp-2 mb-3">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {post.data.tags.map((tag) => (
                        <span class="px-2 py-0.5 rounded-md text-[11px] font-mono text-text-muted/70 bg-bg/60 border border-border/50">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </div>
            );
          })}
        </div>

        {posts.length === 0 && (
          <div class="text-center py-16 text-text-muted">
            <p class="text-lg mb-2">No posts yet.</p>
            <p class="text-sm">Check back soon.</p>
          </div>
        )}
      </div>

      <!-- ═══ IDEAS TAB ═══ -->
      <div id="tab-ideas" class="hidden">
        <!-- Featured Ideas -->
        <div class="mb-12">
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-display text-xl font-bold text-text">Featured Ideas</h2>
            <span class="text-xs text-text-muted/50 font-mono">3 concepts</span>
          </div>
          <div class="space-y-5">
            {ideas.map((idea) => (
              <article
                class="rounded-xl border overflow-hidden p-6 transition-all duration-300"
                style={`border-color: ${idea.accentBorder}; background: ${idea.accentDim};`}
              >
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class="font-mono text-xs font-bold" style={`color: ${idea.accent}80`}>{idea.number}</span>
                  <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full border ${idea.statusColor}`}>{idea.status}</span>
                  <span class="text-xs text-text-muted/50 font-mono">{idea.category}</span>
                </div>
                <h3 class="font-display text-xl font-bold text-text mb-0.5">{idea.name}</h3>
                <p class="text-xs font-mono mb-2" style={`color: ${idea.accent}90`}>{idea.nameEn}</p>
                <p class="text-sm text-text-muted mb-3">{idea.tagline}</p>
                <p class="text-sm text-text font-medium leading-relaxed mb-3">{idea.thesis}</p>
                <ul class="space-y-1.5 mb-3">
                  {idea.problem.map((p) => (
                    <li class="flex gap-2 text-sm text-text-muted leading-relaxed">
                      <span class="mt-1.5 w-1 h-1 rounded-full flex-shrink-0" style={`background: ${idea.accent}`}></span>
                      {p}
                    </li>
                  ))}
                </ul>
                <p class="text-xs text-text-muted/60"><strong class="text-text-muted/80">Target:</strong> {idea.target}</p>
              </article>
            ))}
          </div>
        </div>

        <!-- Pipeline -->
        <div class="mb-12">
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-display text-xl font-bold text-text">Pipeline</h2>
            <span class="text-xs text-text-muted/50 font-mono">always growing</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {pipeline.map((item) => (
              <div class="p-4 rounded-xl border border-border/60 bg-surface/40 group hover:border-accent/20 transition-colors">
                <div class="flex items-start justify-between gap-2 mb-1.5">
                  <h3 class="font-semibold text-text text-sm group-hover:text-accent transition-colors">{item.name}</h3>
                  <span class="text-[10px] font-mono text-text-muted/50 whitespace-nowrap border border-border/50 px-2 py-0.5 rounded-full flex-shrink-0">{item.tag}</span>
                </div>
                <p class="text-xs text-text-muted leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Shipped -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-display text-xl font-bold text-text">Shipped</h2>
            <span class="text-xs text-text-muted/50 font-mono">live</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {shipped.map((tool) => (
              <a
                href={tool.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 rounded-xl border border-border/60 bg-surface/40 group hover:border-accent/30 transition-colors flex items-start justify-between gap-2"
              >
                <div>
                  <span class="text-[10px] font-mono font-bold text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-2 py-0.5 rounded-full">{tool.tag}</span>
                  <h3 class="font-semibold text-text text-sm group-hover:text-accent transition-colors mt-1.5 mb-0.5">{tool.name}</h3>
                  <p class="text-xs text-text-muted">{tool.desc}</p>
                </div>
                <svg class="w-3.5 h-3.5 text-text-muted/30 group-hover:text-accent/60 transition-colors flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- Full ideas page link -->
        <div class="text-center pt-4">
          <a href="/ideas" class="text-sm text-accent hover:underline font-medium">
            View full Ideas page &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Tab switching
  const tabButtons = document.querySelectorAll('#blog-tabs button');
  const postsTab = document.getElementById('tab-posts');
  const ideasTab = document.getElementById('tab-ideas');

  function switchTab(tab: string) {
    tabButtons.forEach((btn) => {
      const isTarget = btn.getAttribute('data-tab') === tab;
      if (isTarget) {
        btn.className = 'px-5 py-2.5 text-sm font-semibold transition-all duration-200 border-b-2 -mb-px border-accent text-accent';
      } else {
        btn.className = 'px-5 py-2.5 text-sm font-semibold transition-all duration-200 border-b-2 -mb-px border-transparent text-text-muted hover:text-text';
      }
    });

    if (tab === 'ideas') {
      postsTab?.classList.add('hidden');
      ideasTab?.classList.remove('hidden');
    } else {
      postsTab?.classList.remove('hidden');
      ideasTab?.classList.add('hidden');
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab') || 'posts';
      switchTab(tab);
      history.replaceState(null, '', tab === 'ideas' ? '#ideas' : window.location.pathname);
    });
  });

  // Restore tab from hash
  if (window.location.hash === '#ideas') {
    switchTab('ideas');
  }

  // Category filter (Posts tab only)
  const buttons = document.querySelectorAll('#filters button');
  const cards = document.querySelectorAll('#post-list [data-cat]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');

      buttons.forEach((b) => {
        b.className = 'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border border-border/60 text-text-muted hover:text-text hover:border-accent/30';
      });
      btn.className = 'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border border-accent text-accent bg-accent/10';

      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (cat === 'All' || el.dataset.cat === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
