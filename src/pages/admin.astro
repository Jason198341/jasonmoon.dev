---
import enc from '../data/adminEnc.json';
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<meta name="theme-color" content="#070b14" />
<title>ADMIN · jasonmoon.dev</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet" />
<style is:global>
  :root{
    --bg:#070b14;--surface:#0d1422;--elev:#111a2c;--grid:#182335;--border:#1e2d45;--bs:#2c3f5c;
    --text:#e8ecf2;--muted:#8ea0b8;--faint:#4a5a74;--accent:#ffb000;--accent-dim:#ffb00022;--red:#ff5a4d;--green:#10b981;
    --disp:'Space Grotesk','Pretendard',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;background:var(--bg);color:var(--text);font-family:var(--disp);}
  body{
    min-height:100dvh;
    background:
      radial-gradient(ellipse at top, rgba(255,176,0,.05), transparent 60%),
      linear-gradient(to right, rgba(24,35,53,.55) 1px, transparent 1px) 0 0/64px 64px,
      linear-gradient(to bottom, rgba(24,35,53,.55) 1px, transparent 1px) 0 0/64px 64px,
      linear-gradient(to right, rgba(24,35,53,.25) 1px, transparent 1px) 0 0/16px 16px,
      linear-gradient(to bottom, rgba(24,35,53,.25) 1px, transparent 1px) 0 0/16px 16px,
      var(--bg);
  }
  .mono{font-family:var(--mono);}
  /* corner reg-marks */
  .reg{position:fixed;width:16px;height:16px;z-index:5;color:var(--accent);pointer-events:none;}
  .reg::before,.reg::after{content:'';position:absolute;background:currentColor;opacity:.7;}
  .reg::before{left:50%;top:0;bottom:0;width:1px;transform:translateX(-50%);}
  .reg::after{top:50%;left:0;right:0;height:1px;transform:translateY(-50%);}
  .reg.tl{top:14px;left:14px;}.reg.tr{top:14px;right:14px;}.reg.bl{bottom:14px;left:14px;}.reg.br{bottom:14px;right:14px;}

  /* ── GATE ── */
  #gate{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:24px;}
  .gate-card{position:relative;width:100%;max-width:420px;border:1px solid var(--bs);background:var(--surface);padding:36px 32px;}
  .gate-card span.gb{position:absolute;width:14px;height:14px;}
  .gb.t1{top:-1px;left:-1px;border-top:1.5px solid var(--accent);border-left:1.5px solid var(--accent);}
  .gb.t2{top:-1px;right:-1px;border-top:1.5px solid var(--accent);border-right:1.5px solid var(--accent);}
  .gb.b1{bottom:-1px;left:-1px;border-bottom:1.5px solid var(--accent);border-left:1.5px solid var(--accent);}
  .gb.b2{bottom:-1px;right:-1px;border-bottom:1.5px solid var(--accent);border-right:1.5px solid var(--accent);}
  .gate-lock{font-size:34px;margin-bottom:14px;}
  .gate-card h1{font-family:var(--mono);font-size:13px;letter-spacing:.35em;text-transform:uppercase;color:var(--accent);margin:0 0 4px;}
  .gate-card .gp{font-family:var(--mono);font-size:11px;color:var(--faint);margin:0 0 24px;letter-spacing:.15em;text-transform:uppercase;}
  .gate-card input{width:100%;padding:14px;background:var(--bg);border:1px solid var(--bs);color:var(--text);font-size:16px;font-family:var(--mono);outline:none;border-radius:0;}
  .gate-card input:focus{border-color:var(--accent);}
  .gate-card button{width:100%;margin-top:12px;padding:14px;background:var(--accent);color:#000;border:none;font-weight:700;font-size:15px;cursor:pointer;letter-spacing:.05em;font-family:var(--disp);}
  .gate-card button:hover{background:#ffc233;}
  #gate-err{color:var(--red);font-family:var(--mono);font-size:11px;margin-top:12px;min-height:16px;letter-spacing:.05em;}

  /* ── SHELL ── */
  #shell{display:none;max-width:1040px;margin:0 auto;padding:0 18px 90px;}
  .adm-top{position:sticky;top:0;z-index:20;background:rgba(7,11,20,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);margin:0 -18px;padding:10px 18px;}
  .adm-top-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
  .adm-brand{font-family:var(--mono);font-size:11px;letter-spacing:.25em;text-transform:uppercase;color:var(--accent);display:flex;align-items:center;gap:8px;}
  .adm-brand .dot{width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red);}
  .adm-actions{display:flex;gap:8px;flex-wrap:wrap;}
  .btn{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:8px 13px;border:1px solid var(--bs);background:var(--surface);color:var(--muted);cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
  .btn:hover{border-color:var(--accent);color:var(--accent);}
  .btn-accent{background:var(--accent);color:#000;border-color:var(--accent);font-weight:700;}
  .btn-accent:hover{background:#ffc233;color:#000;}
  /* tabs */
  .adm-tabs{display:flex;gap:0;margin-top:10px;border:1px solid var(--border);width:fit-content;}
  .tab{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:9px 18px;background:transparent;border:none;color:var(--muted);cursor:pointer;border-right:1px solid var(--border);}
  .tab:last-child{border-right:none;}
  .tab.on{background:var(--accent);color:#000;font-weight:700;}
  .tab:not(.on):hover{color:var(--accent);}

  #content{margin-top:20px;}
  #view-operator,#view-client{display:none;}
  #view-operator.on,#view-client.on{display:block;}

  /* ── OPERATOR styles ── */
  .ac-banner{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--red);border:1px solid var(--red);padding:8px 12px;margin-bottom:18px;}
  .ac-banner .ac-pip{width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red);flex-shrink:0;}
  .ac-sec{position:relative;border:1px solid var(--border);background:var(--surface);margin-bottom:16px;}
  .ac-sec::before{content:'';position:absolute;top:-1px;left:-1px;width:14px;height:14px;border-top:1.5px solid var(--accent);border-left:1.5px solid var(--accent);}
  .ac-sec::after{content:'';position:absolute;bottom:-1px;right:-1px;width:14px;height:14px;border-bottom:1.5px solid var(--accent);border-right:1.5px solid var(--accent);}
  .ac-warn{border-color:var(--accent);background:linear-gradient(180deg,#ffb0000a,transparent 40%),var(--surface);}
  .ac-head{display:flex;align-items:center;gap:12px;padding:10px 16px;border-bottom:1px solid var(--border);background:rgba(255,255,255,.015);}
  .ac-head p{margin:0;font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);}
  .ac-id{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--accent);background:var(--accent-dim);border:1px solid var(--accent);padding:2px 8px;text-transform:uppercase;white-space:nowrap;}
  .ac-body{padding:16px;}
  .ac-body h3{font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--accent);margin:18px 0 8px;padding-left:9px;border-left:2px solid var(--accent);}
  .ac-body h3:first-child{margin-top:0;}
  .ac-tag{font-family:var(--mono);font-size:12px;color:var(--accent);letter-spacing:.04em;margin:0 0 12px;}
  .ac-note{font-size:12px;color:var(--faint);font-style:italic;margin:8px 0 0;}
  .ac-big{font-size:14px;line-height:1.7;padding-left:20px;margin:0;}
  .ac-big li{margin-bottom:9px;}
  .ac-big u,.ac-body u{text-decoration-color:var(--accent);text-underline-offset:2px;}
  .ac-body b{color:var(--accent);}
  table{width:100%;border-collapse:collapse;margin:8px 0;font-size:13px;}
  th,td{border:1px solid var(--border);padding:7px 9px;text-align:left;vertical-align:top;}
  th{background:#0f1a2e;color:var(--accent);font-family:var(--mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;}
  td b{color:var(--accent);}
  .ac-script{background:var(--bg);border:1px solid var(--border);border-left:3px solid var(--accent);padding:11px 13px;margin:8px 0;font-size:13px;line-height:1.65;color:var(--muted);}
  .ac-script b{color:var(--text);}
  .ac-script i{color:var(--faint);}

  /* ── CLIENT quote (white, print-ready) ── */
  #view-client{padding:8px 0;}
  .quote{max-width:780px;margin:0 auto;background:#fdfcf9;color:#1a1a1a;border:1px solid #ddd;box-shadow:0 8px 40px rgba(0,0,0,.4);padding:40px 44px;font-family:var(--disp);}
  .quote-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #111;padding-bottom:16px;margin-bottom:20px;gap:16px;}
  .quote-brand{font-size:28px;font-weight:700;margin:0;color:#111;letter-spacing:-.02em;}
  .quote-brand span{color:#c98a00;}
  .quote-sub{margin:4px 0 0;color:#444;font-size:14px;}
  .quote-stamp{font-family:var(--mono);font-weight:700;font-size:22px;color:#fff;background:#c98a00;padding:8px 14px;text-align:center;line-height:1.1;border-radius:3px;}
  .quote-stamp span{display:block;font-size:9px;letter-spacing:.1em;margin-top:3px;font-weight:500;}
  .quote-lead{font-size:14px;color:#222;line-height:1.7;margin:0 0 18px;}
  .quote-lead b{color:#111;}
  .quote-table{width:100%;border-collapse:collapse;margin:0 0 16px;font-size:13.5px;}
  .quote-table th{background:#111;color:#fff;font-family:var(--mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;padding:9px 11px;text-align:left;border:1px solid #111;}
  .quote-table td{border:1px solid #ccc;padding:9px 11px;color:#1a1a1a;vertical-align:middle;}
  .quote-table td.q-free{color:#0a7d3a;font-weight:700;}
  .quote-table tr:nth-child(even) td{background:#f4f1ea;}
  .quote-note{border-left:3px solid #c98a00;padding:4px 0 4px 12px;margin:0 0 20px;}
  .quote-note p{margin:3px 0;font-size:12px;color:#555;line-height:1.5;}
  .quote-foot{border-top:2px solid #111;padding-top:16px;}
  .quote-foot-t{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#c98a00;margin:0 0 8px;}
  .quote-foot p{margin:4px 0;font-size:14px;color:#222;}
  .quote-foot b{color:#111;}

  @media (max-width:680px){
    .quote{padding:26px 20px;}
    .quote-brand{font-size:22px;}
    table,.quote-table{font-size:11px;}
    th,td{padding:6px;}
  }

  /* ── PRINT — client quote only by default ── */
  @media print{
    .reg,#gate,.adm-top,.adm-tabs{display:none !important;}
    html,body{background:#fff !important;}
    body::before,body::after{display:none !important;}
    #shell{display:block !important;padding:0;max-width:none;}
    #content{margin:0;}
    #view-operator{display:none !important;}
    #view-client{display:block !important;}
    .quote{box-shadow:none;border:none;max-width:none;margin:0;padding:0;}
    .quote-table th,.quote-stamp{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    /* operator print mode */
    body.print-op #view-operator{display:block !important;background:#fff;color:#000;}
    body.print-op #view-client{display:none !important;}
    body.print-op .ac-sec{background:#fff;border-color:#bbb;}
    body.print-op .ac-head p,body.print-op .ac-body,body.print-op td,body.print-op .ac-script{color:#000;}
    body.print-op .ac-banner{color:#000;border-color:#000;}
    body.print-op th{background:#222 !important;color:#fff !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  }
</style>
</head>
<body>
  <span class="reg tl"></span><span class="reg tr"></span><span class="reg bl"></span><span class="reg br"></span>

  <!-- ░░ GATE ░░ -->
  <div id="gate">
    <div class="gate-card">
      <span class="gb t1"></span><span class="gb t2"></span><span class="gb b1"></span><span class="gb b2"></span>
      <div class="gate-lock">🔒</div>
      <h1>ADMIN ACCESS</h1>
      <p class="gp">jasonmoon.dev · 사업계획 &amp; 응대전략</p>
      <input id="pw" type="password" placeholder="비밀번호" autocomplete="off" autofocus />
      <button id="unlock">▶ 잠금 해제</button>
      <div id="gate-err"></div>
    </div>
  </div>

  <!-- ░░ SHELL ░░ -->
  <div id="shell">
    <div class="adm-top">
      <div class="adm-top-row">
        <span class="adm-brand"><span class="dot"></span> ADMIN · CONFIDENTIAL</span>
        <div class="adm-actions">
          <button class="btn btn-accent" id="pdf-btn">📄 PDF 저장</button>
          <button class="btn" id="lock">잠그기</button>
        </div>
      </div>
      <div class="adm-tabs">
        <button class="tab on" data-view="operator">🛠 운영자 전략실</button>
        <button class="tab" data-view="client">📄 고객 발송용 견적서</button>
      </div>
    </div>
    <div id="content"></div>
  </div>

  <script type="application/json" id="enc-data" set:html={JSON.stringify(enc)}></script>
  <script>
    const ENC = JSON.parse(document.getElementById('enc-data').textContent);
    const gate = document.getElementById('gate');
    const shell = document.getElementById('shell');
    const pwInput = document.getElementById('pw');
    const errEl = document.getElementById('gate-err');
    const content = document.getElementById('content');
    const pdfBtn = document.getElementById('pdf-btn');
    let currentView = 'operator';

    function b64(b){const s=atob(b);const u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u;}

    async function decrypt(password){
      const enc=new TextEncoder();
      const km=await crypto.subtle.importKey('raw',enc.encode(password),'PBKDF2',false,['deriveKey']);
      const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b64(ENC.salt),iterations:ENC.iter,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['decrypt']);
      const plain=await crypto.subtle.decrypt({name:'AES-GCM',iv:b64(ENC.iv)},key,b64(ENC.data));
      return new TextDecoder().decode(plain);
    }

    function setView(v){
      currentView=v;
      document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.view===v));
      const op=document.getElementById('view-operator'), cl=document.getElementById('view-client');
      if(op) op.classList.toggle('on',v==='operator');
      if(cl) cl.classList.toggle('on',v==='client');
      pdfBtn.textContent = v==='client' ? '📄 견적서 PDF 저장' : '📄 전략서 PDF';
      window.scrollTo({top:0,behavior:'instant'});
    }

    async function tryUnlock(){
      const pw=pwInput.value; if(!pw) return;
      errEl.textContent='확인 중…';
      try{
        content.innerHTML=await decrypt(pw);
        gate.style.display='none'; shell.style.display='block';
        setView('operator');
        document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>setView(t.dataset.view)));
        try{sessionStorage.setItem('adm',pw);}catch(e){}
      }catch(e){
        errEl.textContent='✕ 비밀번호가 올바르지 않습니다.';
        pwInput.value=''; pwInput.focus();
      }
    }

    document.getElementById('unlock').addEventListener('click',tryUnlock);
    pwInput.addEventListener('keydown',e=>{if(e.key==='Enter')tryUnlock();});
    document.getElementById('lock').addEventListener('click',()=>{
      try{sessionStorage.removeItem('adm');}catch(e){}
      shell.style.display='none'; content.innerHTML=''; gate.style.display='flex'; pwInput.value=''; errEl.textContent='';
    });
    pdfBtn.addEventListener('click',()=>{
      if(currentView==='operator'){
        document.body.classList.add('print-op'); window.print();
        setTimeout(()=>document.body.classList.remove('print-op'),600);
      } else { window.print(); }
    });

    (async()=>{try{const s=sessionStorage.getItem('adm');if(s){pwInput.value=s;await tryUnlock();}}catch(e){}})();
  </script>
</body>
</html>
