---
import Base from '../layouts/Base.astro';
import { SUBJECTS, SPINE_LABEL, STATUS_LABEL, type Spine } from '../data/subjects';
import { SEYEON, STAGE_BY_N } from '../data/curriculum';

const live = SUBJECTS.filter((s) => s.status === 'live');
const frame = SUBJECTS.filter((s) => s.status === 'frame');
const ext = SUBJECTS.filter((s) => s.status === 'external');

const GROUPS: { spine: Spine; head: string }[] = [
  { spine: 'hierarchy', head: '쌓아 올리는 것' },
  { spine: 'timeline',  head: '시간을 따라가는 것' },
  { spine: 'space',     head: '땅 위에서 보는 것' },
  { spine: 'corpus',    head: '읽어서 쌓는 것' },
  { spine: 'practice',  head: '하면서 느는 것' },
  { spine: 'toolkit',   head: '꺼내 쓰는 것' },
];
---
<Base title="과목 고르기" desc="세연이 공부방 — 과목별 지도">
  <section style="margin-bottom:10px">
    <p class="hand" style="font-size:26px;color:var(--soft);margin:0">
      아빠가 세연이한테 만들어주는
    </p>
    <h1>세연이 공부방</h1>
    <p class="lead" style="max-width:660px">
      학교에서 배운 것과, 아무것도 없이 스스로 다시 만들어낼 수 있는 것은 다릅니다.
      이 공부방은 그 격차를 메우는 기록입니다.
    </p>
  </section>

  <!-- 지금 상황 -->
  <section class="card lift" style="margin:20px 0;border-left:6px solid var(--current)">
    <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:flex-start">
      <div style="flex:1;min-width:250px">
        <div class="tiny" style="font-weight:700;letter-spacing:.4px">세연이는 지금</div>
        <div style="font-size:22px;font-weight:900;letter-spacing:-.5px;margin:2px 0 4px">
          {STAGE_BY_N[SEYEON.stage].label} · 해외 국제학교
        </div>
        <div class="hand" style="font-size:23px;color:var(--red)">
          내년에 한국 학교로 돌아간다
        </div>
      </div>
      <div style="flex:1;min-width:260px">
        <div class="tiny" style="font-weight:700;margin-bottom:5px">그래서 급한 것</div>
        <ul style="margin:0;padding-left:18px;font-size:13.5px">
          <li><b>국어</b> — 한국어가 생활 언어에서 <b>학습 언어</b>로 올라가야 한다</li>
          <li><b>한국사</b> — 학교에서 배운 적이 없다. 백지에서 시작</li>
          <li><b>용어 전환</b> — 영어로 알던 개념을 한국어 용어와 잇기</li>
          <li><b>영어</b> — 거꾸로, 잃지 않는 것이 과제</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="grid c4" style="margin:16px 0 4px">
    <div class="stat"><div class="n">{SUBJECTS.length}</div><div class="k">과목</div></div>
    <div class="stat"><div class="n">{live.length}</div><div class="k">진행 중</div></div>
    <div class="stat"><div class="n">{frame.length}</div><div class="k">틀만 있음</div></div>
    <div class="stat"><div class="n">{ext.length}</div><div class="k">별도 앱</div></div>
  </div>

  {GROUPS.map((g) => {
    const items = SUBJECTS.filter((s) => s.spine === g.spine);
    if (!items.length) return null;
    return (
      <section>
        <h2>{g.head}</h2>
        <p class="tiny" style="margin:-4px 0 12px">{SPINE_LABEL[g.spine]}</p>
        <div class="subj-grid">
          {items.map((s) => (
            <a class="subj-card" href={s.href} style={`--sc:${s.color}`}
               target={s.status === 'external' ? '_blank' : undefined}
               rel={s.status === 'external' ? 'noopener' : undefined}>
              <div class="top">
                <span class="em">{s.emoji}</span>
                <span class="nm" style={`color:${s.color}`}>{s.name}</span>
                <span class="eng-term sm">{s.en}</span>
                <span class={`pill ${s.status === 'live' ? 'learned'
                                   : s.status === 'external' ? 'current' : 'upcoming'}`}
                      style="margin-left:auto">{STATUS_LABEL[s.status]}</span>
              </div>
              <div class="why">{s.why}</div>
              <dl>
                <dt>단위</dt><dd>{s.unit}</dd>
                <dt>증명</dt><dd>{s.proof}</dd>
              </dl>
              <div class="meta">귀국 갭 · {s.gap}</div>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <h2>왜 과목마다 틀이 다른가</h2>
  <div class="card" style="background:#F5F9FF;border-color:#C9DDF5">
    <p style="margin:0 0 8px">
      수학 틀을 그대로 복사해 다른 과목에 붙이면 <b>두 과목은 반드시 무너집니다.</b>
      수학이 작동한 이유는 ① 위계가 강하고 ② 백지에서 재도출할 수 있고 ③ 개념 수가 유한하기 때문입니다.
      이 셋은 과목마다 다릅니다.
    </p>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:13.5px;min-width:520px">
        <thead>
          <tr style="border-bottom:2px solid var(--graphite)">
            <th style="text-align:left;padding:6px 8px">뼈대</th>
            <th style="text-align:left;padding:6px 8px">무엇으로 조직되나</th>
            <th style="text-align:left;padding:6px 8px">과목</th>
          </tr>
        </thead>
        <tbody>
          {GROUPS.map((g) => {
            const items = SUBJECTS.filter((s) => s.spine === g.spine);
            if (!items.length) return null;
            return (
              <tr style="border-bottom:1px solid var(--hairline)">
                <td style="padding:6px 8px;font-weight:700">{g.head}</td>
                <td style="padding:6px 8px;color:var(--soft)">{SPINE_LABEL[g.spine]}</td>
                <td style="padding:6px 8px">{items.map((s) => s.name).join(' · ')}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</Base>
