---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const flagships = allProjects.filter(p => p.data.flagship).sort((a, b) => a.data.order - b.data.order);
const others = allProjects.filter(p => !p.data.flagship && p.data.featured).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Jason Moon — Engineer, Father, Builder">

  <!-- Hero -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
        <!-- Text side -->
        <div>
          <p class="font-mono text-sm text-accent mb-4">Hi, I'm</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            Jason Moon
          </h1>
          <p class="text-lg sm:text-xl text-text leading-relaxed mb-2">
            I build tools for the people I care about.
          </p>
          <p class="font-mono text-sm text-accent/80 mb-6">복잡함을 명확함으로. 없으면 만든다.</p>
          <p class="text-base text-text-muted leading-relaxed mb-8">
            Automotive engineer and father of two.
            I build apps for my kids' education, my family's habits, and my own growth — then ship them for everyone.
            <span class="text-text font-medium">7 products. 2 with custom domains. All built solo.</span>
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/projects"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-accent text-white font-medium text-sm hover:bg-accent-hover transition-colors"
            >
              View All Projects
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a
              href="/about"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border text-text-muted font-medium text-sm hover:text-text hover:border-text-muted transition-colors"
            >
              How I Think
            </a>
          </div>
        </div>

        <!-- Bento grid of project screenshots -->
        <div class="hidden lg:block">
          <div class="grid grid-cols-3 grid-rows-3 gap-3 h-[420px]">
            <a href="/projects/prompt-garden" class="group col-span-2 row-span-2 rounded-2xl overflow-hidden border border-border bg-surface relative">
              <img src="/projects/prompt-garden.png" alt="Prompt Garden" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="eager" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4 flex items-center gap-2">
                <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span></span>
                <span class="text-white text-sm font-semibold">Prompt Garden</span>
              </div>
            </a>
            <a href="/projects/engreading" class="group rounded-2xl overflow-hidden border border-border bg-surface relative">
              <img src="/projects/engreading.png" alt="EngReading" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="eager" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-2 left-3">
                <span class="text-white text-xs font-semibold">EngReading</span>
              </div>
            </a>
            <a href="/projects/sat-crusher" class="group rounded-2xl overflow-hidden border border-border bg-surface relative">
              <img src="/projects/sat-crusher.png" alt="SAT Crusher" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-2 left-3">
                <span class="text-white text-xs font-semibold">SAT Crusher</span>
              </div>
            </a>
            <a href="/projects/family-graph" class="group rounded-2xl overflow-hidden border border-border bg-surface relative">
              <img src="/projects/family-graph.png" alt="Family Graph" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-2 left-3">
                <span class="text-white text-xs font-semibold">Family Graph</span>
              </div>
            </a>
            <a href="/projects/the-parasite" class="group rounded-2xl overflow-hidden border border-border bg-surface relative">
              <img src="/projects/the-parasite.png" alt="The Parasite" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-2 left-3">
                <span class="text-white text-xs font-semibold">The Parasite</span>
              </div>
            </a>
            <a href="/projects/smart-memo" class="group rounded-2xl overflow-hidden border border-border bg-surface relative">
              <img src="/projects/smart-memo.png" alt="Smart Memo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-2 left-3">
                <span class="text-white text-xs font-semibold">Smart Memo</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship Projects — Full-width showcase -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-border"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-widest">Live Products</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <div class="space-y-8">
        {flagships.map((project, i) => (
          <a
            href={`/projects/${project.id}`}
            class="group block rounded-2xl border border-border bg-surface overflow-hidden hover:border-accent/50 transition-all duration-300"
          >
            <div class:list={['grid gap-0', project.data.image ? 'lg:grid-cols-2' : '']}>
              <!-- Text side -->
              <div class="p-8 sm:p-10 flex flex-col justify-center">
                {project.data.domain && (
                  <div class="flex items-center gap-2 mb-4">
                    <span class="relative flex h-2.5 w-2.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </span>
                    <span class="font-mono text-sm text-emerald-600">{project.data.domain}</span>
                  </div>
                )}
                <h3 class="text-2xl sm:text-3xl font-bold mb-2 group-hover:text-accent transition-colors">
                  {project.data.title}
                </h3>
                {project.data.tagline && (
                  <p class="text-sm font-medium text-accent mb-3">{project.data.tagline}</p>
                )}
                <p class="text-text-muted leading-relaxed mb-6">
                  {project.data.description}
                </p>
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {project.data.stack.slice(0, 5).map((tech) => (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted bg-bg border border-border">
                      {tech}
                    </span>
                  ))}
                  {project.data.stack.length > 5 && (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted bg-bg border border-border">
                      +{project.data.stack.length - 5}
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-3">
                  {project.data.live && (
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                      Visit Live
                      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </span>
                  )}
                </div>
              </div>
              <!-- Image side -->
              {project.data.image && (
                <div class="relative bg-bg/50 overflow-hidden">
                  <img
                    src={project.data.image}
                    alt={`${project.data.title} screenshot`}
                    class="w-full h-full object-cover object-top opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent lg:bg-gradient-to-r lg:from-surface/60 lg:via-transparent lg:to-transparent"></div>
                </div>
              )}
              {!project.data.image && project.data.domain && (
                <div class="hidden lg:flex items-center justify-center bg-bg/30 p-10">
                  <div class="text-center">
                    <p class="font-mono text-4xl font-bold text-accent/30 mb-2">{project.data.domain}</p>
                    <p class="text-sm text-text-muted">Live on the web</p>
                  </div>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Other Featured Projects -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-border"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-widest">More Projects</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            slug={project.id}
            category={project.data.category}
            stack={project.data.stack}
            image={project.data.image}
          />
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/projects" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors">
          View all projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl border border-border bg-surface p-8 sm:p-10 text-center">
        <p class="text-lg sm:text-xl text-text-muted leading-relaxed">
          <span class="text-text font-semibold">7 products.</span>
          <span class="text-text font-semibold">2 live with custom domains.</span>
          Web, Mobile, and Chrome Extension.
        </p>
        <p class="text-sm text-accent font-medium mt-3">Every project solves a problem I actually had.</p>
      </div>
    </div>
  </section>

  <!-- Beyond Code -->
  <section class="pb-20">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-px flex-1 bg-border"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-widest">Beyond Code</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>
      <p class="text-center text-text-muted text-sm mb-8">Software is where I build. Reading and running are where I think.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/archive/reading" class="group block rounded-xl border border-border bg-surface p-6 hover:border-accent/40 transition-all">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">📚</span>
            <h3 class="font-semibold group-hover:text-accent transition-colors">Reading</h3>
          </div>
          <p class="text-sm text-text-muted">100회 읽기 프로젝트 — depth over breadth. <span class="text-text">3/100 completed.</span></p>
        </a>
        <a href="/archive/running" class="group block rounded-xl border border-border bg-surface p-6 hover:border-accent/40 transition-all">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🏃</span>
            <h3 class="font-semibold group-hover:text-accent transition-colors">Running</h3>
          </div>
          <p class="text-sm text-text-muted">기록은 남기되, 성과는 쫓지 않는다. <span class="text-text">Process over results.</span></p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl border border-border bg-surface p-8 sm:p-12 text-center">
        <h2 class="text-2xl font-bold mb-3">Let's Build Something</h2>
        <p class="text-text-muted mb-6 max-w-md mx-auto">
          Have a complex problem that needs clarity? Let's talk.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-accent text-white font-medium text-sm hover:bg-accent-hover transition-colors"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Base>
