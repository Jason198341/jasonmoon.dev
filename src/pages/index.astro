---
import Base from '../layouts/Base.astro';
import { portfolio } from '../data/portfolio';
import { atlas, atlasTotal } from '../data/styleAtlas';

const KAKAO = 'https://invite.kakao.com/tc/EszOu7fY0i';
const previewSamples = portfolio.slice(0, 6);
const previewStyles = atlas.flatMap((c) => c.styles).slice(0, 14);

const stats = [
  { value: '0', suffix: '원', label: '제작비', unit: 'FREE', id: 'I-01' },
  { value: '2', suffix: '축', label: '홈페이지 + 업무툴', unit: 'TRACKS', id: 'I-02' },
  { value: String(atlasTotal), suffix: '종', label: '스타일 좌표', unit: 'ATLAS', id: 'I-03' },
  { value: '100', suffix: '%', label: '파일까지 드림', unit: 'YOURS', id: 'I-04' },
];
---

<Base
  title="무료 홈페이지 · 업무 자동화 툴 제작 — jasonmoon.dev"
  description="홈페이지와 윈도우 업무 자동화 툴(엑셀·아웃룩·실시간 번역 등)을 무료로 만들어 드립니다. 완성 파일까지 그대로 드립니다. 카카오톡으로 편하게 문의하세요."
>

  <!-- ════════════════ MOLTEN TIME INTRO (융시 熔時) ════════════════ -->
  <div id="mt-intro" style="position:fixed;inset:0;z-index:9999;background:#060607;color:#b8b2a6;overflow:hidden;font-family:Georgia,'Noto Serif KR','Apple SD Gothic Neo',serif;display:flex;flex-direction:column;align-items:center;transition:opacity .7s ease;">
    <div class="mt-art" style="position:relative;flex:1;width:100%;display:flex;align-items:center;justify-content:center;min-height:0;">
      <canvas id="mt-cv" width="1100" height="1100" style="display:block;cursor:ns-resize;touch-action:none;"></canvas>
      <div style="position:absolute;right:clamp(14px,4vw,54px);top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;opacity:.85;">
        <div id="mt-tempRead" style="font-size:11px;color:#8a8172;font-variant-numeric:tabular-nums;">T 0.45</div>
        <input type="range" id="mt-tS" min="0" max="1" step="0.005" value="0.45" style="-webkit-appearance:none;appearance:none;width:3px;height:min(30vh,240px);background:linear-gradient(to top,#2a4a66,#7a5a2e,#a33c22);border-radius:2px;outline:none;writing-mode:vertical-lr;direction:rtl;">
        <div style="writing-mode:vertical-rl;font-size:11px;letter-spacing:.5em;color:#6e6759;">열 熱</div>
      </div>
    </div>
    <div style="width:min(620px,92vw);border-top:1px solid #26241f;padding:16px 8px 22px;text-align:center;">
      <div style="font-size:16.5px;color:#ddd3bd;letter-spacing:.06em;">「융시 熔時」 <i style="font-style:normal;color:#7d7466;font-size:13px;margin-left:10px;letter-spacing:.18em;">MOLTEN TIME · 2026</i></div>
      <div style="font-size:13px;color:#98917f;margin-top:10px;line-height:1.8;">바늘은 없다. 열에 떠는 입자들이 있을 뿐이다.
        식히면 시간은 결정이 되고, 데우면 흐르고, 끓이면 증발한다.<br>
        그러나 어느 온도에서도 구름의 무게중심은 시각을 기억한다 —
        개체의 요동은 온도의 것이고, 중심은 큰 수의 것이므로.</div>
      <div style="margin-top:10px;font-size:12.5px;color:#7d7466;font-variant-numeric:tabular-nums;letter-spacing:.05em;">
        상태 <span id="mt-stateW" style="color:#ddd3bd;">액체 液體</span> ·
        퍼짐 <span id="mt-spread">±0분</span> ·
        그럼에도 중심 <b id="mt-centerT" style="color:#cfa75a;font-weight:600;">--:--</b>
      </div>
      <button id="mt-enter" style="margin-top:16px;background:none;border:1px solid #3a372f;color:#b8b2a6;padding:9px 34px;font-family:inherit;font-size:13px;letter-spacing:.3em;cursor:pointer;transition:all .3s;">입 장 →</button>
    </div>
  </div>

  <script is:inline>
  (function(){
  "use strict";
  const intro=document.getElementById('mt-intro');
  if(!intro) return;
  if(sessionStorage.getItem('mt_seen')){ intro.remove(); return; }
  let alive=true;
  function leave(){
    if(!alive) return; alive=false;
    sessionStorage.setItem('mt_seen','1');
    intro.style.opacity='0';
    setTimeout(()=>intro.remove(),700);
  }
  document.getElementById('mt-enter').addEventListener('click',leave);
  addEventListener('keydown',e=>{if(e.key==='Escape')leave();});

  const cv=document.getElementById('mt-cv'), ctx=cv.getContext('2d');
  const S=1100, C=S/2, R=S*0.40;
  function fit(){
    const art=intro.querySelector('.mt-art'); if(!art)return;
    const h=art.clientHeight, w=innerWidth;
    const px=Math.min(h*0.96, w*0.9);
    cv.style.width=cv.style.height=px+'px';
  }
  addEventListener('resize',fit); fit(); setTimeout(fit,50);

  function gauss(){let u=0,v=0;while(!u)u=Math.random();while(!v)v=Math.random();
    return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);}

  let T=0.45, lastTouch=-1e9, clock=0;
  const tS=document.getElementById('mt-tS'), tempRead=document.getElementById('mt-tempRead');
  tS.addEventListener('input',()=>{T=+tS.value; lastTouch=clock;});
  cv.addEventListener('pointerdown',e=>{cv.setPointerCapture(e.pointerId); dragT(e);});
  cv.addEventListener('pointermove',e=>{if(e.buttons)dragT(e);});
  function dragT(e){
    const r=cv.getBoundingClientRect();
    T=Math.min(1,Math.max(0,1-(e.clientY-r.top)/r.height));
    tS.value=T; lastTouch=clock;
  }
  intro.addEventListener('wheel',e=>{e.preventDefault();T=Math.min(1,Math.max(0,T-e.deltaY*0.0004)); tS.value=T; lastTouch=clock;},{passive:false});

  function cloud(n,len,girth){
    const a=[];
    for(let i=0;i<n;i++){
      const u=0.14+0.86*Math.sqrt(Math.random());
      a.push({u, x:0.2*gauss(), r:len*u, girth,
        size:0.9+Math.random()*1.6, warm:Math.random(), tw:Math.random()*7});
    }
    return a;
  }
  const minC=cloud(460,R*0.94,1.00), hourC=cloud(330,R*0.58,0.85), secC=cloud(120,R*1.00,0.42);

  function angles(){
    const d=new Date();
    const ms=d.getMilliseconds()/1000, s=d.getSeconds()+ms, m=d.getMinutes()+s/60, h=(d.getHours()%12)+m/60;
    return {h:h/12*2*Math.PI-Math.PI/2, m:m/60*2*Math.PI-Math.PI/2, s:s/60*2*Math.PI-Math.PI/2, d};
  }
  const sigma=t=>0.014+1.7*Math.pow(t,2.7);
  function stepCloud(arr,dt){
    const k=2.4, sg=sigma(T), s=sg*Math.sqrt(2*k);
    for(const p of arr){
      p.x += -k*p.x*dt + s*Math.sqrt(dt)*gauss();
      p.tw += dt*(1.5+T*6);
    }
  }
  function pal(t,warm){
    const w=t+0.12*(warm-0.5); let r,g,b;
    if(w<0.33){const q=w/0.33; r=150+q*95; g=205-q*35; b=255-q*135;}
    else if(w<0.7){const q=(w-0.33)/0.37; r=245+q*10; g=170-q*55; b=120-q*75;}
    else{const q=(w-0.7)/0.3; r=255; g=115-q*55; b=45-q*20;}
    return [r|0,g|0,b|0];
  }
  function drawCloud(arr,base,inten){
    const sg=sigma(T);
    for(const p of arr){
      const spread=p.girth*(0.35+0.85*p.u);
      const a=base+p.x*spread;
      const x=C+p.r*Math.cos(a), y=C+p.r*Math.sin(a);
      const c=pal(T,p.warm), r=c[0], g=c[1], b=c[2];
      const tw=0.75+0.25*Math.sin(p.tw);
      const al=inten*tw*(0.10+0.55/(1+3*sg));
      ctx.fillStyle='rgba('+r+','+g+','+b+','+(al*0.35)+')';
      ctx.beginPath(); ctx.arc(x,y,p.size*3.2+T*3,0,7); ctx.fill();
      ctx.fillStyle='rgba('+Math.min(255,r+60)+','+Math.min(255,g+60)+','+Math.min(255,b+50)+','+al+')';
      ctx.beginPath(); ctx.arc(x,y,p.size,0,7); ctx.fill();
    }
  }
  function rim(){
    ctx.strokeStyle='rgba(160,150,130,0.10)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.arc(C,C,R+34,0,7); ctx.stroke();
    for(let i=0;i<12;i++){
      const a=i/12*2*Math.PI-Math.PI/2;
      ctx.strokeStyle=i%3===0?'rgba(200,188,160,0.30)':'rgba(160,150,130,0.14)';
      ctx.lineWidth=i%3===0?2.5:1.2;
      const r1=R+26,r2=R+42;
      ctx.beginPath();
      ctx.moveTo(C+r1*Math.cos(a),C+r1*Math.sin(a));
      ctx.lineTo(C+r2*Math.cos(a),C+r2*Math.sin(a)); ctx.stroke();
    }
  }
  const stateW=document.getElementById('mt-stateW'), spreadEl=document.getElementById('mt-spread'),
        centerT=document.getElementById('mt-centerT');
  function plaque(t){
    const sg=sigma(T); let st;
    if(T<0.17) st='결정 結晶';
    else if(T<0.52) st='액체 液體';
    else if(T<0.82) st='비등 沸騰';
    else st='증기 蒸氣';
    stateW.textContent=st;
    spreadEl.textContent='±'+(sg/(2*Math.PI)*60).toFixed(1)+'분';
    const d=t.d; let hh=d.getHours()%12; if(hh===0)hh=12;
    centerT.textContent=String(hh).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');
    tempRead.textContent='T '+T.toFixed(2);
  }
  let last=performance.now(), acc=0;
  function frame(now){
    if(!alive) return;
    const dt=Math.min(Math.max((now-last)/1000,0),0.05); last=now; clock+=dt;
    if(clock-lastTouch>12){ T=0.36+0.30*Math.sin(clock/17); tS.value=T; }
    const t=angles();
    stepCloud(minC,dt); stepCloud(hourC,dt); stepCloud(secC,dt);
    ctx.globalCompositeOperation='destination-out';
    ctx.fillStyle='rgba(0,0,0,'+(0.10+0.13*T)+')';
    ctx.fillRect(0,0,S,S);
    ctx.globalCompositeOperation='source-over';
    rim();
    ctx.globalCompositeOperation='lighter';
    drawCloud(secC ,t.s,0.30);
    drawCloud(minC ,t.m,0.85);
    drawCloud(hourC,t.h,1.00);
    if(T<0.2){
      for(let i=0;i<2;i++){
        const arr=Math.random()<0.5?minC:hourC, p=arr[(Math.random()*arr.length)|0];
        const base=arr===minC?t.m:t.h;
        const a=base+p.x*p.girth*(0.35+0.85*p.u);
        ctx.fillStyle='rgba(255,255,255,0.9)';
        ctx.beginPath(); ctx.arc(C+p.r*Math.cos(a),C+p.r*Math.sin(a),1.6,0,7); ctx.fill();
      }
    }
    ctx.globalCompositeOperation='source-over';
    ctx.fillStyle='rgba(220,210,185,0.85)';
    ctx.beginPath(); ctx.arc(C,C,4.5,0,7); ctx.fill();
    acc+=dt; if(acc>0.25){acc=0; plaque(t);}
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  })();
  </script>

  <!-- ════════════════ HERO ════════════════ -->
  <section class="relative overflow-hidden border-b border-border-strong">
    <div class="absolute top-4 left-4 text-accent"><span class="reg-mark"></span></div>
    <div class="absolute top-4 right-4 text-accent"><span class="reg-mark"></span></div>

    <div class="mx-auto max-w-6xl px-6 pt-14 pb-16 sm:pt-20 sm:pb-24">
      <div class="flex items-center gap-3 mb-7 font-mono text-[10px] sm:text-[11px] tracking-[0.3em] uppercase">
        <span class="hud-pip hud-pip--amber"></span>
        <span class="text-accent">지금 · 무료 제작 접수중</span>
        <span class="text-text-faint hidden sm:inline">// 포트폴리오를 쌓는 중입니다</span>
      </div>

      <h1 class="font-display font-bold tracking-[-0.03em] text-text leading-[0.95] mb-7" style="font-size: clamp(2.6rem, 8vw, 6rem);">
        홈페이지도<span class="text-accent">,</span><br/>
        업무 프로그램도<br/>
        <span class="text-accent">무료로</span> 만들어 드립니다.
      </h1>

      <p class="text-text-muted text-lg sm:text-2xl leading-relaxed max-w-3xl mb-3">
        빠르고 깔끔하게 만들어, <span class="text-text font-semibold">완성된 파일까지 그대로 드립니다.</span>
        제작비는 <span class="text-accent font-bold">0원</span>입니다.
      </p>
      <p class="text-text-faint text-sm sm:text-base max-w-2xl mb-10">
        "왜 공짜냐고요?" — 솔직히 말씀드리면, 지금은 <span class="text-text-muted">실력을 보여줄 포트폴리오와 후기를 모으는 단계</span>라서요.
        그래서 여러분은 손해 볼 게 없습니다.
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-12">
        <a href={KAKAO} target="_blank" rel="noopener"
          class="group inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-accent text-black font-bold text-base sm:text-lg tracking-tight shadow-[0_4px_24px_rgba(255,176,0,0.4)] hover:bg-accent-hover hover:scale-[1.02] transition-all">
          💬 카카오톡으로 무료 문의하기
        </a>
        <a href="/portfolio"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-border-strong text-text-muted font-mono text-sm tracking-[0.2em] uppercase hover:border-accent hover:text-accent transition-all">
          ► 제작 샘플 먼저 보기
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 border border-border-strong divide-x divide-y sm:divide-y-0 divide-border bg-surface/40">
        {stats.map(({ value, suffix, label, unit, id }) => (
          <div class="px-4 sm:px-6 py-5">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[9px] tracking-[0.2em] uppercase text-text-faint">{id}</span>
              <span class="hud-pip hud-pip--on" style="width:6px;height:6px;"></span>
            </div>
            <p class="font-display text-3xl sm:text-5xl font-bold text-accent leading-none">{value}<span class="text-xl sm:text-3xl">{suffix}</span></p>
            <div class="mt-2 flex items-center justify-between">
              <span class="font-mono text-[9px] sm:text-[10px] text-text-muted tracking-[0.15em] uppercase">{label}</span>
              <span class="font-mono text-[9px] text-text-faint tracking-wider">{unit}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════ 두 축 서비스 ════════════════ -->
  <section class="relative border-b border-border-strong">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-A // SERVICE</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">두 가지를 만들어 드립니다</p>
    </div>

    <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-border-strong">
      <!-- 축 1 -->
      <div class="p-8 sm:p-12 relative reveal">
        <span class="absolute top-6 right-6 font-mono text-[10px] text-text-faint tracking-[0.2em]">01</span>
        <div class="text-5xl mb-5">🌐</div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-text mb-4">홈페이지 제작</h2>
        <p class="text-text-muted leading-relaxed mb-6">
          카페·펜션·학원·헬스장·병원·인테리어 — 매출로 이어지는 <span class="text-text">진짜 홈페이지</span>를
          고퀄리티로 만들어 드립니다. 원하는 분위기를 <a href="/styles" class="text-accent underline underline-offset-2">스타일 도감</a>에서 고르기만 하면 됩니다.
          <span class="block mt-2 text-sm text-text-faint">단골 업종(카페·미용실·헬스장 등)은 <a href="/services" class="text-accent underline underline-offset-2">웹앱(설치 없이 홈화면 추가·푸시·쿠폰)</a>까지 연계 가능합니다.</span>
        </p>
        <ul class="space-y-2.5 text-sm">
          {['업종에 맞는 디자인 시안 제작', '소개·메뉴·가격·사진·연락처 구성', '모바일까지 반응형으로', '완성 파일 그대로 전달 (소유권 100% 고객님)'].map((t) => (
            <li class="flex items-start gap-3 text-text-muted">
              <span class="text-accent mt-0.5">✓</span><span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
      <!-- 축 2 -->
      <div class="p-8 sm:p-12 relative reveal">
        <span class="absolute top-6 right-6 font-mono text-[10px] text-text-faint tracking-[0.2em]">02</span>
        <div class="text-5xl mb-5">⚙️</div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-text mb-4">업무 자동화 윈도우 툴</h2>
        <p class="text-text-muted leading-relaxed mb-6">
          매일 반복하는 귀찮은 작업, <span class="text-text">프로그램으로 만들어 드립니다.</span>
          버튼 한 번이면 끝나게요. 코딩 몰라도 됩니다 — 뭐가 귀찮은지만 말씀하세요.
        </p>
        <ul class="space-y-2.5 text-sm">
          {['엑셀 자동 정리·집계·보고서 생성', '아웃룩 메일 자동 분류·일괄 발송', '실시간 번역 프로그램', '파일 이름 일괄 변경·자료 자동 수집 등 무엇이든'].map((t) => (
            <li class="flex items-start gap-3 text-text-muted">
              <span class="text-accent mt-0.5">✓</span><span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ════════════════ 문의 가이드 (큼직·친절) ════════════════ -->
  <section class="relative border-b border-border-strong bg-surface/20">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id" style="color:var(--color-accent);border-color:var(--color-accent);background:var(--color-accent-dim);">MOD-B // HOW-TO</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">문의는 이렇게 하시면 됩니다</p>
    </div>

    <div class="mx-auto max-w-5xl px-6 py-14 sm:py-20">
      <h2 class="font-display font-bold text-text text-center leading-tight mb-4" style="font-size: clamp(2rem, 6vw, 3.8rem);">
        딱 <span class="text-accent">4가지</span>만 알려주세요
      </h2>
      <p class="text-center text-text-muted text-lg sm:text-xl mb-12 max-w-2xl mx-auto">
        어렵게 생각하지 마세요. 아래 4가지를 <span class="text-text font-semibold">카카오톡으로 편하게</span> 적어 보내주시면 됩니다.
        말로 하셔도 됩니다.
      </p>

      <div class="grid sm:grid-cols-2 gap-4 sm:gap-5 mb-12">
        {[
          { n: '1', icon: '🏪', t: '어떤 가게/일인가요?', d: '예) "성수동에서 작은 카페 해요" / "세무사 사무실입니다"' },
          { n: '2', icon: '🎨', t: '어떤 느낌을 원하세요?', d: '예) "깔끔·고급" — 스타일 도감에서 2~3개 골라 섞어도 OK. 잘 모르면 느낌만 말씀하세요 — 3가지 시안으로 제안드려요' },
          { n: '3', icon: '📝', t: '어떤 내용이 들어가나요?', d: '예) 가게 소개, 메뉴와 가격, 사진 몇 장, 전화번호, 영업시간 — 있는 만큼만' },
