---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroWorldMap from '../components/HeroWorldMap';
import { getCollection } from 'astro:content';
import { getTotalCount as getCatalogCount } from '../data/video-catalog';

const allProjects = await getCollection('projects');
const allPrompts = await getCollection('prompts');
const promptCount = allPrompts.length;
const catalogCount = getCatalogCount();
const templateCount = 8; // live Remotion templates on /templates
const flagships = allProjects.filter(p => p.data.flagship).sort((a, b) => a.data.order - b.data.order);
const others = allProjects.filter(p => !p.data.flagship && p.data.featured).sort((a, b) => a.data.order - b.data.order);
const concepts = allProjects.filter(p => p.data.category === 'Concept').sort((a, b) => a.data.order - b.data.order);

const personalCount = allProjects.filter(p => p.data.projectType === 'Personal').length;
const clientCount = allProjects.filter(p => p.data.projectType === 'Client' && p.data.category !== 'Concept').length;
const liveCount = allProjects.filter(p => p.data.live).length;

const typeColors: Record<string, string> = {
  Personal: 'text-amber-400 bg-amber-400/10 border-amber-400/20',
  Client: 'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
};

const stats = [
  { value: allProjects.length, suffix: '+', label: 'Projects Built', icon: '⚡' },
  { value: liveCount, suffix: '', label: 'Live Products', icon: '🌐' },
  { value: clientCount, suffix: '', label: 'Client Projects', icon: '🤝' },
  { value: 15, suffix: '+', label: 'Tech Stack', icon: '🛠' },
];
---

<Base title="Jason Moon — Automotive Engineer, Systems Designer, Fullstack Builder">

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="relative min-h-[60vh] sm:min-h-dvh flex items-center justify-center overflow-hidden">
    <!-- Blueprint grid background -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
      style="background-image: linear-gradient(rgba(129,140,248,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(129,140,248,0.3) 1px, transparent 1px); background-size: 60px 60px;"
    ></div>

    <!-- Radial glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(99,102,241,0.08) 0%, transparent 70%);"
    ></div>

    <!-- World map -->
    <div class="absolute inset-0 pointer-events-none">
      <HeroWorldMap client:load />
    </div>

    <!-- Gradient overlay for readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-bg/60 via-bg/30 to-bg pointer-events-none"></div>

    <!-- Floating particles (CSS only) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute w-1 h-1 rounded-full bg-accent/40 animate-float delay-1" style="top:20%;left:15%;"></div>
      <div class="absolute w-1.5 h-1.5 rounded-full bg-accent/30 animate-float delay-3" style="top:30%;right:20%;"></div>
      <div class="absolute w-1 h-1 rounded-full bg-cyan/30 animate-float delay-5" style="top:60%;left:10%;"></div>
      <div class="absolute w-1.5 h-1.5 rounded-full bg-accent/20 animate-float delay-7" style="top:70%;right:15%;"></div>
      <div class="absolute w-1 h-1 rounded-full bg-warm/20 animate-float delay-2" style="top:45%;left:80%;"></div>
      <div class="absolute w-0.5 h-0.5 rounded-full bg-accent/40 animate-float delay-6" style="top:15%;left:50%;"></div>
    </div>

    <!-- Hero content -->
    <div class="relative mx-auto max-w-5xl px-6 text-center pt-12 pb-24">
      <p class="font-mono text-xs sm:text-sm text-accent mb-4 sm:mb-6 tracking-[0.2em] uppercase animate-fade-in-up delay-1">
        Automotive Engineer &middot; Systems Designer &middot; Fullstack Builder
      </p>

      <h1 class="font-display text-3xl sm:text-5xl lg:text-7xl xl:text-8xl font-extrabold tracking-tight mb-4 sm:mb-6 animate-fade-in-up delay-2">
        I Build<br/>
        <span class="text-gradient">Systems, Not Apps</span>
      </h1>

      <p class="text-sm sm:text-lg lg:text-xl text-text-muted leading-relaxed max-w-2xl mx-auto mb-8 sm:mb-12 animate-fade-in-up delay-3">
        I design vehicle systems by day. Nights and weekends, I architect complete digital systems — from AI learning platforms to multi-agent frameworks — then ship them for everyone.
      </p>

      <div class="flex flex-wrap gap-4 justify-center animate-fade-in-up delay-4">
        <a
          href="/projects"
          class="group inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl bg-accent text-white font-semibold text-sm hover:bg-accent-hover hover:shadow-[0_0_30px_rgba(99,102,241,0.3)] transition-all duration-300"
        >
          View Projects
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-border text-text-muted font-semibold text-sm hover:text-text hover:border-accent/50 hover:bg-accent/5 transition-all duration-300"
        >
          My Story
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="hidden sm:block absolute bottom-8 left-1/2 -translate-x-1/2 animate-fade-in delay-6">
      <div class="flex flex-col items-center gap-2 text-text-muted/50">
        <span class="text-[10px] font-mono uppercase tracking-widest">Scroll</span>
        <svg class="w-4 h-4 animate-scroll-hint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- ═══════════════ STATS ═══════════════ -->
  <section class="pb-24 -mt-8">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        {stats.map(({ value, suffix, label, icon }, i) => (
          <div
            class="reveal group relative rounded-xl border border-border/60 bg-surface/50 backdrop-blur-sm p-5 sm:p-6 text-center overflow-hidden hover:border-accent/30 transition-all duration-300"
            style={`transition-delay: ${i * 100}ms;`}
          >
            <!-- Hover glow -->
            <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/5 transition-colors duration-300 rounded-xl"></div>
            <div class="relative">
              <span class="text-lg mb-2 block">{icon}</span>
              <p
                class="text-2xl sm:text-3xl font-display font-bold text-accent"
                data-count-target={value}
                data-count-suffix={suffix}
              >
                0{suffix}
              </p>
              <p class="text-[10px] sm:text-xs text-text-muted mt-1.5 font-medium uppercase tracking-wider">{label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ RESOURCES ═══════════════ -->
  <section class="pb-20 -mt-8">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-3 gap-3 sm:gap-4">
        <a
          href="/templates"
          class="reveal group relative rounded-xl border border-border/60 bg-surface/50 backdrop-blur-sm p-4 sm:p-5 text-center overflow-hidden hover:border-accent/40 transition-all duration-300"
        >
          <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/5 transition-colors duration-300 rounded-xl"></div>
          <div class="relative">
            <span class="text-lg mb-1.5 block">🎬</span>
            <p class="text-xl sm:text-2xl font-display font-bold text-accent" data-count-target={templateCount} data-count-suffix="">0</p>
            <p class="text-[10px] sm:text-xs text-text-muted mt-1 font-medium uppercase tracking-wider">Live Templates</p>
          </div>
        </a>
        <a
          href="/video-catalog"
          class="reveal group relative rounded-xl border border-border/60 bg-surface/50 backdrop-blur-sm p-4 sm:p-5 text-center overflow-hidden hover:border-accent/40 transition-all duration-300"
          style="transition-delay: 100ms;"
        >
          <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/5 transition-colors duration-300 rounded-xl"></div>
          <div class="relative">
            <span class="text-lg mb-1.5 block">📋</span>
            <p class="text-xl sm:text-2xl font-display font-bold text-accent" data-count-target={catalogCount} data-count-suffix="">0</p>
            <p class="text-[10px] sm:text-xs text-text-muted mt-1 font-medium uppercase tracking-wider">Video Recipes</p>
          </div>
        </a>
        <a
          href="/prompts"
          class="reveal group relative rounded-xl border border-border/60 bg-surface/50 backdrop-blur-sm p-4 sm:p-5 text-center overflow-hidden hover:border-accent/40 transition-all duration-300"
          style="transition-delay: 200ms;"
        >
          <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/5 transition-colors duration-300 rounded-xl"></div>
          <div class="relative">
            <span class="text-lg mb-1.5 block">💡</span>
            <p class="text-xl sm:text-2xl font-display font-bold text-accent" data-count-target={promptCount} data-count-suffix="">0</p>
            <p class="text-[10px] sm:text-xs text-text-muted mt-1 font-medium uppercase tracking-wider">AI Prompts</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FLAGSHIP PROJECTS ═══════════════ -->
  <section class="pb-28">
    <div class="mx-auto max-w-5xl px-6">
      <div class="reveal flex items-center gap-4 mb-12">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-border to-transparent"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-[0.2em]">Shipped Products</h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-border to-transparent"></div>
      </div>

      <div class="space-y-10">
        {flagships.map((project, i) => (
          <a
            href={`/projects/${project.id}`}
            class="reveal group block rounded-2xl border border-border/60 bg-surface/40 backdrop-blur-sm overflow-hidden hover:border-accent/40 transition-all duration-500"
            style={`transition-delay: ${i * 150}ms;`}
          >
            <!-- Glow on hover -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style="background: radial-gradient(ellipse at 30% 50%, rgba(99,102,241,0.06) 0%, transparent 70%);"
            ></div>

            <div class:list={['grid gap-0', project.data.image ? 'lg:grid-cols-2' : '']}>
              <!-- Text side -->
              <div class="relative p-5 sm:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-2.5 mb-5 flex-wrap">
                  {project.data.domain && (
                    <span class="inline-flex items-center gap-1.5">
                      <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                      </span>
                      <span class="font-mono text-xs text-emerald-400">{project.data.domain}</span>
                    </span>
                  )}
                  {project.data.projectType && (
                    <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium border ${typeColors[project.data.projectType] || ''}`}>
                      {project.data.projectType === 'Client' ? 'Client Project' : 'Personal Project'}
                    </span>
                  )}
                </div>

                <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold mb-3 group-hover:text-accent transition-colors duration-300">
                  {project.data.title}
                </h3>

                {project.data.tagline && (
                  <p class="text-sm text-text-muted/80 italic mb-4">{project.data.tagline}</p>
                )}

                <p class="text-text-muted leading-relaxed mb-6">
                  {project.data.description}
                </p>

                <div class="flex flex-wrap gap-1.5 mb-6">
                  {project.data.stack.slice(0, 5).map((tech) => (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted/80 bg-bg/80 border border-border/60 hover:border-accent/30 transition-colors">
                      {tech}
                    </span>
                  ))}
                  {project.data.stack.length > 5 && (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted/60 bg-bg/80 border border-border/60">
                      +{project.data.stack.length - 5}
                    </span>
                  )}
                </div>

                <div class="flex items-center gap-3">
                  {project.data.live && (
                    <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent group-hover:gap-3 transition-all">
                      View Project
                      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </span>
                  )}
                </div>
              </div>

              <!-- Image side -->
              {project.data.image && (
                <div class="relative bg-bg/30 overflow-hidden">
                  <img
                    src={project.data.image}
                    alt={`${project.data.title} screenshot`}
                    class="w-full h-full object-cover object-top opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent lg:bg-gradient-to-r lg:from-surface/80 lg:via-surface/20 lg:to-transparent"></div>
                </div>
              )}
              {!project.data.image && project.data.domain && (
                <div class="hidden lg:flex items-center justify-center bg-bg/20 p-10">
                  <div class="text-center">
                    <p class="font-mono text-4xl font-bold text-accent/20 mb-2">{project.data.domain}</p>
                    <p class="text-sm text-text-muted/60">Live on the web</p>
                  </div>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ CURRENTLY BUILDING ═══════════════ -->
  {concepts.length > 0 && (
    <section class="pb-28">
      <div class="mx-auto max-w-5xl px-6">
        <div class="reveal flex items-center gap-4 mb-4">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-teal-500/30 to-transparent"></div>
          <h2 class="text-sm font-mono text-teal-400 uppercase tracking-[0.2em]">Currently Building</h2>
          <div class="h-px flex-1 bg-gradient-to-l from-transparent via-teal-500/30 to-transparent"></div>
        </div>
        <p class="reveal text-center text-text-muted text-sm mb-10">Active client projects in development. Working demos available.</p>

        <div class="space-y-8">
        {concepts.map((project, i) => (
          <a
            href={`/projects/${project.id}`}
            class="reveal group block rounded-2xl border border-teal-500/20 bg-surface/40 backdrop-blur-sm overflow-hidden hover:border-teal-500/40 transition-all duration-500"
            style={`transition-delay: ${i * 150}ms;`}
          >
            <div class:list={['grid gap-0', project.data.image ? 'lg:grid-cols-2' : '']}>
              <div class="p-5 sm:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-2.5 mb-5 flex-wrap">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-400"></span>
                    </span>
                    <span class="font-mono text-xs text-teal-400">In Development</span>
                  </span>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium border text-emerald-400 bg-emerald-400/10 border-emerald-400/20">
                    Client Project
                  </span>
                </div>
                <h3 class="font-display text-2xl sm:text-3xl font-bold mb-3 group-hover:text-teal-400 transition-colors duration-300">
                  {project.data.title}
                </h3>
                {project.data.tagline && (
                  <p class="text-sm text-text-muted/80 italic mb-4">{project.data.tagline}</p>
                )}
                <p class="text-text-muted leading-relaxed mb-6">
                  {project.data.description}
                </p>
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {project.data.stack.slice(0, 5).map((tech) => (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted/80 bg-bg/80 border border-border/60">
                      {tech}
                    </span>
                  ))}
                  {project.data.stack.length > 5 && (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted/60 bg-bg/80 border border-border/60">
                      +{project.data.stack.length - 5}
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center gap-2 text-sm font-semibold text-teal-400 group-hover:gap-3 transition-all">
                    View Working Demo
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </span>
                </div>
              </div>
              {project.data.image && (
                <div class="relative bg-bg/30 overflow-hidden">
                  <img
                    src={project.data.image}
                    alt={`${project.data.title} screenshot`}
                    class="w-full h-full object-cover object-top opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent lg:bg-gradient-to-r lg:from-surface/80 lg:via-surface/20 lg:to-transparent"></div>
                </div>
              )}
            </div>
          </a>
        ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════ MORE PROJECTS ═══════════════ -->
  <section class="pb-28">
    <div class="mx-auto max-w-5xl px-6">
      <div class="reveal flex items-center gap-4 mb-12">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-border to-transparent"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-[0.2em]">More Projects</h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-border to-transparent"></div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {others.slice(0, 3).map((project, i) => (
          <div class="reveal" style={`transition-delay: ${i * 120}ms;`}>
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              slug={project.id}
              category={project.data.category}
              stack={project.data.stack}
              image={project.data.image}
              projectType={project.data.projectType}
            />
          </div>
        ))}
      </div>

      <div class="reveal text-center mt-10">
        <a href="/projects" class="group inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-all">
          View all projects
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ OFF THE CLOCK ═══════════════ -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="reveal flex items-center gap-4 mb-4">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-border to-transparent"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-[0.2em]">Off the Clock</h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-border to-transparent"></div>
      </div>
      <p class="reveal text-center text-text-muted text-sm mb-10">Software is where I build. Reading and running are where I think.</p>

      <div class="grid gap-5 sm:grid-cols-2">
        <a href="/archive/reading" class="reveal group relative block rounded-2xl border border-border/60 bg-surface/40 backdrop-blur-sm p-7 overflow-hidden hover:border-accent/30 transition-all duration-300">
          <!-- Background decoration -->
          <div class="absolute top-0 right-0 w-32 h-32 opacity-5 pointer-events-none"
            style="background: radial-gradient(circle, var(--color-warm) 0%, transparent 70%);"
          ></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-warm/10 border border-warm/20 flex items-center justify-center text-lg group-hover:scale-110 transition-transform duration-300">
                📚
              </div>
              <h3 class="font-display text-lg font-bold group-hover:text-accent transition-colors">Reading</h3>
            </div>
            <p class="text-sm text-text-muted leading-relaxed mb-4">
              One book, 100 times. Depth over breadth.
            </p>
            <!-- Mini progress bar -->
            <div class="flex items-center gap-3">
              <div class="flex-1 h-1.5 rounded-full bg-border/40 overflow-hidden">
                <div class="h-full rounded-full bg-warm/60" style="width: 3%;"></div>
              </div>
              <span class="text-xs font-mono text-warm">3/100</span>
            </div>
          </div>
        </a>

        <a href="/archive/running" class="reveal group relative block rounded-2xl border border-border/60 bg-surface/40 backdrop-blur-sm p-7 overflow-hidden hover:border-accent/30 transition-all duration-300" style="transition-delay: 100ms;">
          <div class="absolute top-0 right-0 w-32 h-32 opacity-5 pointer-events-none"
            style="background: radial-gradient(circle, var(--color-cyan) 0%, transparent 70%);"
          ></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-cyan/10 border border-cyan/20 flex items-center justify-center text-lg group-hover:scale-110 transition-transform duration-300">
                🏃
              </div>
              <h3 class="font-display text-lg font-bold group-hover:text-accent transition-colors">Running</h3>
            </div>
            <p class="text-sm text-text-muted leading-relaxed mb-4">
              173 runs across 6 countries. 1,200+ km tracked.
            </p>
            <!-- Mini stats -->
            <div class="flex gap-4">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-cyan/60"></span>
                <span class="text-xs font-mono text-text-muted">6 countries</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-accent/60"></span>
                <span class="text-xs font-mono text-text-muted">Strava-connected</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ═══════════════ -->
