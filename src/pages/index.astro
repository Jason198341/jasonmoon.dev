---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const flagships = allProjects.filter(p => p.data.flagship).sort((a, b) => a.data.order - b.data.order);
const others = allProjects.filter(p => !p.data.flagship && p.data.featured).sort((a, b) => a.data.order - b.data.order);
const concepts = allProjects.filter(p => p.data.category === 'Concept').sort((a, b) => a.data.order - b.data.order);

const personalCount = allProjects.filter(p => p.data.projectType === 'Personal').length;
const clientCount = allProjects.filter(p => p.data.projectType === 'Client' && p.data.category !== 'Concept').length;

const typeColors: Record<string, string> = {
  Personal: 'text-amber-400 bg-amber-400/10 border-amber-400/20',
  Client: 'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
};

const stats = [
  { value: allProjects.length + '+', label: 'Projects Built' },
  { value: '2', label: 'Live Products' },
  { value: clientCount.toString(), label: 'Client Projects' },
  { value: '15+', label: 'Tech Stack' },
];
---

<Base title="Jason Moon — Automotive Engineer, Systems Designer, Fullstack Builder">

  <!-- Hero -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <!-- Indigo orb glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/20 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative mx-auto max-w-5xl px-6 text-center">
      <p class="font-mono text-sm text-accent mb-6 tracking-wider uppercase">Automotive Engineer &middot; Systems Designer &middot; Fullstack Builder</p>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-6">
        I Build<br/>
        <span class="text-gradient">Systems, Not Apps</span>
      </h1>
      <p class="text-lg sm:text-xl text-text-muted leading-relaxed max-w-2xl mx-auto mb-10">
        I design vehicle systems by day. Nights and weekends, I architect complete digital systems — from AI learning platforms to multi-agent frameworks — then ship them for everyone.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-medium text-sm hover:bg-accent-hover transition-colors"
        >
          View Projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border text-text-muted font-medium text-sm hover:text-text hover:border-text-muted transition-colors"
        >
          My Story
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Row -->
  <section class="pb-20">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {stats.map(({ value, label }) => (
          <div class="rounded-xl border border-border bg-surface p-5 text-center">
            <p class="text-2xl sm:text-3xl font-bold text-accent">{value}</p>
            <p class="text-xs text-text-muted mt-1 font-medium uppercase tracking-wider">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Flagship Projects — Full-width showcase -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-border"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-widest">Shipped Products</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <div class="space-y-8">
        {flagships.map((project, i) => (
          <a
            href={`/projects/${project.id}`}
            class="group block rounded-2xl border border-border bg-surface overflow-hidden hover:border-accent/50 transition-all duration-300 glow-hover"
          >
            <div class:list={['grid gap-0', project.data.image ? 'lg:grid-cols-2' : '']}>
              <!-- Text side -->
              <div class="p-8 sm:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-4 flex-wrap">
                  {project.data.domain && (
                    <span class="inline-flex items-center gap-1.5">
                      <span class="relative flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                      </span>
                      <span class="font-mono text-sm text-emerald-400">{project.data.domain}</span>
                    </span>
                  )}
                  {project.data.projectType && (
                    <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border ${typeColors[project.data.projectType] || ''}`}>
                      {project.data.projectType === 'Client' ? 'Client Project' : 'Personal Project'}
                    </span>
                  )}
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold mb-2 group-hover:text-accent transition-colors">
                  {project.data.title}
                </h3>
                {project.data.tagline && (
                  <p class="text-sm text-text-muted italic mb-3">{project.data.tagline}</p>
                )}
                <p class="text-text-muted leading-relaxed mb-6">
                  {project.data.description}
                </p>
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {project.data.stack.slice(0, 5).map((tech) => (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted bg-bg border border-border">
                      {tech}
                    </span>
                  ))}
                  {project.data.stack.length > 5 && (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted bg-bg border border-border">
                      +{project.data.stack.length - 5}
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-3">
                  {project.data.live && (
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                      Visit Live
                      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </span>
                  )}
                </div>
              </div>
              <!-- Image side -->
              {project.data.image && (
                <div class="relative bg-bg/50 overflow-hidden">
                  <img
                    src={project.data.image}
                    alt={`${project.data.title} screenshot`}
                    class="w-full h-full object-cover object-top opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent lg:bg-gradient-to-r lg:from-surface/60 lg:via-transparent lg:to-transparent"></div>
                </div>
              )}
              {!project.data.image && project.data.domain && (
                <div class="hidden lg:flex items-center justify-center bg-bg/30 p-10">
                  <div class="text-center">
                    <p class="font-mono text-4xl font-bold text-accent/30 mb-2">{project.data.domain}</p>
                    <p class="text-sm text-text-muted">Live on the web</p>
                  </div>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Currently Building -->
  {concepts.length > 0 && (
    <section class="pb-24">
      <div class="mx-auto max-w-5xl px-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-px flex-1 bg-border"></div>
          <h2 class="text-sm font-mono text-teal-400 uppercase tracking-widest">Currently Building</h2>
          <div class="h-px flex-1 bg-border"></div>
        </div>
        <p class="text-center text-text-muted text-sm mb-10">Active client projects in development. Working demos available.</p>

        <div class="space-y-6">
        {concepts.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="group block rounded-2xl border border-teal-500/20 bg-surface overflow-hidden hover:border-teal-500/40 transition-all duration-300 glow-hover"
          >
            <div class:list={['grid gap-0', project.data.image ? 'lg:grid-cols-2' : '']}>
              <div class="p-8 sm:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-4 flex-wrap">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="relative flex h-2.5 w-2.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-teal-400"></span>
                    </span>
                    <span class="font-mono text-sm text-teal-400">In Development</span>
                  </span>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border text-emerald-400 bg-emerald-400/10 border-emerald-400/20">
                    Client Project
                  </span>
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold mb-2 group-hover:text-teal-400 transition-colors">
                  {project.data.title}
                </h3>
                {project.data.tagline && (
                  <p class="text-sm text-text-muted italic mb-3">{project.data.tagline}</p>
                )}
                <p class="text-text-muted leading-relaxed mb-6">
                  {project.data.description}
                </p>
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {project.data.stack.slice(0, 5).map((tech) => (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted bg-bg border border-border">
                      {tech}
                    </span>
                  ))}
                  {project.data.stack.length > 5 && (
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted bg-bg border border-border">
                      +{project.data.stack.length - 5}
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-400">
                    View Working Demo
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </span>
                </div>
              </div>
              {project.data.image && (
                <div class="relative bg-bg/50 overflow-hidden">
                  <img
                    src={project.data.image}
                    alt={`${project.data.title} screenshot`}
                    class="w-full h-full object-cover object-top opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent lg:bg-gradient-to-r lg:from-surface/60 lg:via-transparent lg:to-transparent"></div>
                </div>
              )}
            </div>
          </a>
        ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other Featured Projects -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-border"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-widest">More Projects</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {others.slice(0, 3).map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            slug={project.id}
            category={project.data.category}
            stack={project.data.stack}
            image={project.data.image}
            projectType={project.data.projectType}
          />
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/projects" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors">
          View all projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Beyond Code -->
  <section class="pb-20">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-px flex-1 bg-border"></div>
        <h2 class="text-sm font-mono text-accent uppercase tracking-widest">Off the Clock</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>
      <p class="text-center text-text-muted text-sm mb-8">Software is where I build. Reading and running are where I think.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/archive/reading" class="group block rounded-xl border border-border bg-surface p-6 hover:border-accent/40 transition-all glow-hover">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">📚</span>
            <h3 class="font-semibold group-hover:text-accent transition-colors">Reading</h3>
          </div>
          <p class="text-sm text-text-muted">One book, 100 times. Depth over breadth. <span class="text-text">3/100 completed.</span></p>
        </a>
        <a href="/archive/running" class="group block rounded-xl border border-border bg-surface p-6 hover:border-accent/40 transition-all glow-hover">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🏃</span>
            <h3 class="font-semibold group-hover:text-accent transition-colors">Running</h3>
          </div>
          <p class="text-sm text-text-muted">173 runs across 6 countries. 1,200+ km tracked. <span class="text-text">Strava-connected analytics.</span></p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="relative rounded-2xl border border-border bg-surface p-8 sm:p-12 text-center overflow-hidden">
        <!-- Glow background -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-accent/10 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="relative">
          <h2 class="text-2xl sm:text-3xl font-bold mb-3">Need a System, Not Just an App?</h2>
          <p class="text-text-muted mb-2 max-w-lg mx-auto">
            I design systems that solve real problems — from AI architectures and multi-agent frameworks to data pipelines and browser extensions.
          </p>
          <p class="text-text-muted text-sm mb-6 max-w-lg mx-auto">
            Whether you need a working prototype, a production system, or a proof of concept to pitch investors.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-medium text-sm hover:bg-accent-hover transition-colors"
          >
            Let's Talk
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
