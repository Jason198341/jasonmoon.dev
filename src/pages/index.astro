---
import Base from '../layouts/Base.astro';
import { portfolio } from '../data/portfolio';
import { atlas, atlasTotal } from '../data/styleAtlas';

const KAKAO = 'https://invite.kakao.com/tc/EszOu7fY0i';
const previewSamples = portfolio.slice(0, 6);
const previewStyles = atlas.flatMap((c) => c.styles).slice(0, 14);

const stats = [
  { value: '0', suffix: '원', label: '제작비', unit: 'FREE', id: 'I-01' },
  { value: '2', suffix: '축', label: '홈페이지 + 업무툴', unit: 'TRACKS', id: 'I-02' },
  { value: String(atlasTotal), suffix: '종', label: '스타일 좌표', unit: 'ATLAS', id: 'I-03' },
  { value: '100', suffix: '%', label: '파일까지 드림', unit: 'YOURS', id: 'I-04' },
];
---

<Base
  title="무료 홈페이지 · 업무 자동화 툴 제작 — jasonmoon.dev"
  description="홈페이지와 윈도우 업무 자동화 툴(엑셀·아웃룩·실시간 번역 등)을 무료로 만들어 드립니다. 완성 파일까지 그대로 드립니다. 카카오톡으로 편하게 문의하세요."
>


  <!-- ════════════════ HERO ════════════════ -->
  <section class="relative overflow-hidden border-b border-border-strong">
    <div class="absolute top-4 left-4 text-accent"><span class="reg-mark"></span></div>
    <div class="absolute top-4 right-4 text-accent"><span class="reg-mark"></span></div>

    <div class="mx-auto max-w-6xl px-6 pt-14 pb-16 sm:pt-20 sm:pb-24">
      <div class="flex items-center gap-3 mb-7 font-mono text-[10px] sm:text-[11px] tracking-[0.3em] uppercase">
        <span class="hud-pip hud-pip--amber"></span>
        <span class="text-accent">지금 · 무료 제작 접수중</span>
        <span class="text-text-faint hidden sm:inline">// 포트폴리오를 쌓는 중입니다</span>
      </div>

      <h1 class="font-display font-bold tracking-[-0.03em] text-text leading-[0.95] mb-7" style="font-size: clamp(2.6rem, 8vw, 6rem);">
        홈페이지도<span class="text-accent">,</span><br/>
        업무 프로그램도<br/>
        <span class="text-accent">무료로</span> 만들어 드립니다.
      </h1>

      <p class="text-text-muted text-lg sm:text-2xl leading-relaxed max-w-3xl mb-3">
        빠르고 깔끔하게 만들어, <span class="text-text font-semibold">완성된 파일까지 그대로 드립니다.</span>
        제작비는 <span class="text-accent font-bold">0원</span>입니다.
      </p>
      <p class="text-text-faint text-sm sm:text-base max-w-2xl mb-10">
        "왜 공짜냐고요?" — 솔직히 말씀드리면, 지금은 <span class="text-text-muted">실력을 보여줄 포트폴리오와 후기를 모으는 단계</span>라서요.
        그래서 여러분은 손해 볼 게 없습니다.
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-12">
        <a href={KAKAO} target="_blank" rel="noopener"
          class="group inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-accent text-black font-bold text-base sm:text-lg tracking-tight shadow-[0_4px_24px_rgba(255,176,0,0.4)] hover:bg-accent-hover hover:scale-[1.02] transition-all">
          💬 카카오톡으로 무료 문의하기
        </a>
        <a href="/portfolio"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-border-strong text-text-muted font-mono text-sm tracking-[0.2em] uppercase hover:border-accent hover:text-accent transition-all">
          ► 제작 샘플 먼저 보기
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 border border-border-strong divide-x divide-y sm:divide-y-0 divide-border bg-surface/40">
        {stats.map(({ value, suffix, label, unit, id }) => (
          <div class="px-4 sm:px-6 py-5">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[9px] tracking-[0.2em] uppercase text-text-faint">{id}</span>
              <span class="hud-pip hud-pip--on" style="width:6px;height:6px;"></span>
            </div>
            <p class="font-display text-3xl sm:text-5xl font-bold text-accent leading-none">{value}<span class="text-xl sm:text-3xl">{suffix}</span></p>
            <div class="mt-2 flex items-center justify-between">
              <span class="font-mono text-[9px] sm:text-[10px] text-text-muted tracking-[0.15em] uppercase">{label}</span>
              <span class="font-mono text-[9px] text-text-faint tracking-wider">{unit}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════ 두 축 서비스 ════════════════ -->
  <section class="relative border-b border-border-strong">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-A // SERVICE</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">두 가지를 만들어 드립니다</p>
    </div>

    <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-border-strong">
      <!-- 축 1 -->
      <div class="p-8 sm:p-12 relative reveal">
        <span class="absolute top-6 right-6 font-mono text-[10px] text-text-faint tracking-[0.2em]">01</span>
        <div class="text-5xl mb-5">🌐</div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-text mb-4">홈페이지 제작</h2>
        <p class="text-text-muted leading-relaxed mb-6">
          카페·펜션·학원·헬스장·병원·인테리어 — 매출로 이어지는 <span class="text-text">진짜 홈페이지</span>를
          고퀄리티로 만들어 드립니다. 원하는 분위기를 <a href="/styles" class="text-accent underline underline-offset-2">스타일 도감</a>에서 고르기만 하면 됩니다.
          <span class="block mt-2 text-sm text-text-faint">단골 업종(카페·미용실·헬스장 등)은 <a href="/services" class="text-accent underline underline-offset-2">웹앱(설치 없이 홈화면 추가·푸시·쿠폰)</a>까지 연계 가능합니다.</span>
        </p>
        <ul class="space-y-2.5 text-sm">
          {['업종에 맞는 디자인 시안 제작', '소개·메뉴·가격·사진·연락처 구성', '모바일까지 반응형으로', '완성 파일 그대로 전달 (소유권 100% 고객님)'].map((t) => (
            <li class="flex items-start gap-3 text-text-muted">
              <span class="text-accent mt-0.5">✓</span><span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
      <!-- 축 2 -->
      <div class="p-8 sm:p-12 relative reveal">
        <span class="absolute top-6 right-6 font-mono text-[10px] text-text-faint tracking-[0.2em]">02</span>
        <div class="text-5xl mb-5">⚙️</div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-text mb-4">업무 자동화 윈도우 툴</h2>
        <p class="text-text-muted leading-relaxed mb-6">
          매일 반복하는 귀찮은 작업, <span class="text-text">프로그램으로 만들어 드립니다.</span>
          버튼 한 번이면 끝나게요. 코딩 몰라도 됩니다 — 뭐가 귀찮은지만 말씀하세요.
        </p>
        <ul class="space-y-2.5 text-sm">
          {['엑셀 자동 정리·집계·보고서 생성', '아웃룩 메일 자동 분류·일괄 발송', '실시간 번역 프로그램', '파일 이름 일괄 변경·자료 자동 수집 등 무엇이든'].map((t) => (
            <li class="flex items-start gap-3 text-text-muted">
              <span class="text-accent mt-0.5">✓</span><span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ════════════════ 문의 가이드 (큼직·친절) ════════════════ -->
  <section class="relative border-b border-border-strong bg-surface/20">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id" style="color:var(--color-accent);border-color:var(--color-accent);background:var(--color-accent-dim);">MOD-B // HOW-TO</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">문의는 이렇게 하시면 됩니다</p>
    </div>

    <div class="mx-auto max-w-5xl px-6 py-14 sm:py-20">
      <h2 class="font-display font-bold text-text text-center leading-tight mb-4" style="font-size: clamp(2rem, 6vw, 3.8rem);">
        딱 <span class="text-accent">4가지</span>만 알려주세요
      </h2>
      <p class="text-center text-text-muted text-lg sm:text-xl mb-12 max-w-2xl mx-auto">
        어렵게 생각하지 마세요. 아래 4가지를 <span class="text-text font-semibold">카카오톡으로 편하게</span> 적어 보내주시면 됩니다.
        말로 하셔도 됩니다.
      </p>

      <div class="grid sm:grid-cols-2 gap-4 sm:gap-5 mb-12">
        {[
          { n: '1', icon: '🏪', t: '어떤 가게/일인가요?', d: '예) "성수동에서 작은 카페 해요" / "세무사 사무실입니다"' },
          { n: '2', icon: '🎨', t: '어떤 느낌을 원하세요?', d: '예) "깔끔·고급" — 스타일 도감에서 2~3개 골라 섞어도 OK. 잘 모르면 느낌만 말씀하세요 — 3가지 시안으로 제안드려요' },
          { n: '3', icon: '📝', t: '어떤 내용이 들어가나요?', d: '예) 가게 소개, 메뉴와 가격, 사진 몇 장, 전화번호, 영업시간 — 있는 만큼만' },
          { n: '4', icon: '📞', t: '연락처를 남겨주세요', d: '카카오톡이면 충분합니다. 전화/문자도 좋아요' },
        ].map((s) => (
          <div class="relative border-2 border-border-strong bg-bg p-6 sm:p-7 hover:border-accent transition-colors reveal">
            <div class="flex items-center gap-4 mb-3">
              <span class="flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-accent text-black font-display font-bold text-2xl sm:text-3xl shrink-0">{s.n}</span>
              <span class="text-3xl sm:text-4xl">{s.icon}</span>
            </div>
            <p class="font-bold text-text text-lg sm:text-xl mb-2">{s.t}</p>
            <p class="text-text-muted text-sm sm:text-base leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>

      <div class="text-center">
        <p class="text-text-faint text-sm mb-5 font-mono tracking-wider">＊ 잘 모르겠으면 그냥 "홈페이지 만들고 싶어요" 한 마디만 보내셔도 됩니다. 제가 다 여쭤볼게요.</p>
        <a href={KAKAO} target="_blank" rel="noopener"
          class="inline-flex items-center justify-center gap-3 px-10 sm:px-14 py-5 bg-accent text-black font-bold text-lg sm:text-2xl tracking-tight shadow-[0_4px_28px_rgba(255,176,0,0.45)] hover:bg-accent-hover hover:scale-[1.02] transition-all">
          💬 카카오톡으로 지금 문의하기
        </a>
        <p class="text-text-muted text-sm mt-5">또는 전화 <a href="tel:+821075253511" class="text-accent">010-7525-3511</a> · 이메일 <a href="mailto:skypeople41@gmail.com" class="text-accent">skypeople41@gmail.com</a></p>
      </div>
    </div>
  </section>

  <!-- ════════════════ 포트폴리오 미리보기 ════════════════ -->
  <section class="relative border-b border-border-strong">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-3">
        <span class="hud-id">MOD-C // SAMPLES</span>
        <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">제작 샘플 — 이런 걸 만듭니다</p>
      </div>
      <a href="/portfolio" class="font-mono text-[10px] text-text-faint tracking-[0.2em] uppercase hover:text-accent transition-colors">전체 보기 <span class="text-accent">→</span></a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3">
      {previewSamples.map((s, i) => (
        <a href={`/portfolio/${s.slug}`} target="_blank" rel="noopener"
          class:list={['group relative block border-b border-border p-7 sm:p-8 overflow-hidden hover:bg-surface/40 transition-colors', (i + 1) % 3 !== 0 ? 'lg:border-r' : '', i % 2 === 0 ? 'sm:border-r lg:border-r' : '']}
          style={`background: linear-gradient(135deg, ${s.swatch}14, transparent 70%);`}>
          <div class="flex items-center justify-between mb-5">
            <span class="font-mono text-[10px] text-text-faint tracking-[0.2em]">SAMPLE {s.no}</span>
            <span class="inline-block w-8 h-8 border border-border-strong" style={`background:${s.swatch};`}></span>
          </div>
          <p class="font-mono text-[10px] text-accent tracking-[0.2em] uppercase mb-2">{s.industry}</p>
          <h3 class="font-display text-xl sm:text-2xl font-bold text-text mb-2 group-hover:text-accent transition-colors">{s.business}</h3>
          <p class="text-text-faint text-xs font-mono mb-3">{s.styleRef}</p>
          <p class="text-text-muted text-sm leading-relaxed mb-4">{s.blurb}</p>
          <p class="font-mono text-[10px] text-text-faint tracking-[0.2em] uppercase group-hover:text-accent transition-colors">► 데모 열기</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ════════════════ 스타일 도감 미리보기 ════════════════ -->
  <section class="relative border-b border-border-strong">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-3">
        <span class="hud-id">MOD-D // ATLAS</span>
        <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">스타일 좌표 도감 · {atlasTotal}종</p>
      </div>
      <a href="/styles" class="font-mono text-[10px] text-text-faint tracking-[0.2em] uppercase hover:text-accent transition-colors">전체 보기 <span class="text-accent">→</span></a>
    </div>

    <div class="px-6 sm:px-10 py-10">
      <p class="text-text-muted text-base sm:text-lg max-w-3xl mb-8 leading-relaxed">
        "고급스럽게" 같은 막연한 말 대신, <span class="text-text font-semibold">"이 시대 · 이 기관 · 이 인쇄물처럼"</span>을 고르면
        디자인 방향이 정확히 정해집니다. 마음에 드는 좌표를 골라 보내주세요 —
        <span class="text-accent font-semibold">2~3개를 섞어</span> 달라고 하셔도 됩니다.
        아니면 그냥 <span class="text-text font-semibold">느낌만 말씀해 주셔도</span> 됩니다 —
        <span class="text-accent font-semibold">3가지 시안</span>으로 제안드립니다.
      </p>
      <div class="flex flex-wrap gap-2.5">
        {previewStyles.map((s) => (
          <span class="inline-flex items-center gap-2 border border-border-strong bg-surface/50 px-3 py-2 text-xs sm:text-sm text-text-muted hover:border-accent hover:text-text transition-colors">
            <span class="w-3 h-3 rounded-full shrink-0" style={`background:${s.color};`}></span>
            {s.ko}
          </span>
        ))}
        <a href="/styles" class="inline-flex items-center gap-1 border border-accent bg-accent-dim px-3 py-2 text-xs sm:text-sm text-accent font-mono tracking-wider">+{atlasTotal - previewStyles.length}종 더 →</a>
      </div>
    </div>
  </section>

  <!-- ════════════════ 제작 과정 3단계 ════════════════ -->
  <section class="relative border-b border-border-strong bg-surface/20">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-E // PROCESS</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">제작은 이렇게 진행됩니다</p>
    </div>
    <div class="grid sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-border">
      {[
        { n: '01', t: '카톡으로 문의', d: '위 4가지를 편하게 적어 보내주세요. 제가 부족한 건 여쭤봅니다.' },
        { n: '02', t: '시안 제작·확인', d: '빠르게 시안을 만들어 보여드리고, 원하시는 대로 다듬습니다.' },
        { n: '03', t: '완성 + 파일 전달', d: '완성된 홈페이지/프로그램 파일을 그대로 드립니다. 소유권은 100% 고객님께.' },
      ].map((s) => (
        <div class="p-8 sm:p-10 reveal">
          <p class="font-display text-5xl font-bold text-accent/30 mb-4">{s.n}</p>
          <h3 class="font-display text-xl font-bold text-text mb-3">{s.t}</h3>
          <p class="text-text-muted text-sm leading-relaxed">{s.d}</p>
        </div>
      ))}
    </div>
    <div class="border-t border-border px-6 sm:px-10 py-5 text-center">
      <p class="text-text-muted text-sm">
        도메인 연결·서버 운영까지 원하시면? <a href="/guide" class="text-accent underline underline-offset-2">제작·배포 안내</a>에서 방법과 대행 가능 여부를 확인하세요.
      </p>
    </div>
  </section>

  <!-- ════════════════ 닫는 CTA ════════════════ -->
  <section class="relative px-6 sm:px-10 py-20 sm:py-32 text-center overflow-hidden">
    <div class="absolute inset-0 hud-hatch-dim opacity-40 pointer-events-none"></div>
    <span class="absolute top-8 left-8 w-8 h-8 border-t border-l border-accent"></span>
    <span class="absolute top-8 right-8 w-8 h-8 border-t border-r border-accent"></span>
    <span class="absolute bottom-8 left-8 w-8 h-8 border-b border-l border-accent"></span>
    <span class="absolute bottom-8 right-8 w-8 h-8 border-b border-r border-accent"></span>

    <div class="relative">
      <p class="font-mono text-[10px] text-accent tracking-[0.35em] uppercase mb-8">지금이 첫걸음입니다</p>
      <h2 class="font-display font-bold text-text tracking-[-0.03em] leading-[0.95] mb-10" style="font-size: clamp(2rem, 7vw, 5.5rem);">
        고민하는 동안<br/>남들은 <span class="text-accent">이미 만들고 있습니다.</span>
      </h2>
      <a href={KAKAO} target="_blank" rel="noopener"
        class="inline-flex items-center justify-center gap-3 px-12 sm:px-16 py-5 bg-accent text-black font-bold text-lg sm:text-2xl tracking-tight shadow-[0_4px_28px_rgba(255,176,0,0.45)] hover:bg-accent-hover hover:scale-[1.02] transition-all">
        💬 무료로 시작하기
      </a>
    </div>
  </section>

</Base>
