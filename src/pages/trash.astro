---
import Base from '../layouts/Base.astro';
---
<Base title="휴지통" desc="삭제한 것은 여기 남습니다. 되돌릴 수 있습니다.">
  <h1>휴지통</h1>
  <p class="lead">
    삭제해도 사라지지 않습니다. 여기서 <b>되돌릴 수 있습니다.</b>
  </p>

  <div id="gate"></div>
  <div id="panel" hidden>
    <div id="list" class="tiny" style="margin-top:14px">불러오는 중…</div>
  </div>
</Base>

<script>
  import { listTrash, restore, TRASH_TABLES, TRASH_LABEL, fmtDate, toast, esc, type TrashTable } from '../lib/db';
  import { mountGate } from '../lib/gate';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;

  const titleOf = (t: TrashTable, r: any): string => {
    if (t === 'math_records') return `${r.concept_id} · ${r.session_date}`;
    if (t === 'math_files') return r.title;
    return r.title ?? r.id;
  };
  const bodyOf = (t: TrashTable, r: any): string => {
    if (t === 'math_records') return [r.blank_before, r.blank_after, r.note].filter(Boolean).join('\n---\n');
    return r.body ?? r.note ?? '';
  };

  async function render() {
    const box = $('#list');
    try {
      const groups = await Promise.all(
        TRASH_TABLES.map(async (t) => ({ t, rows: await listTrash(t) })));
      const total = groups.reduce((s, g) => s + g.rows.length, 0);
      if (!total) { box.innerHTML = '<p class="lead">휴지통이 비어 있습니다.</p>'; return; }

      box.innerHTML = groups.filter((g) => g.rows.length).map((g) => `
        <h2>${TRASH_LABEL[g.t]} <span class="tiny">${g.rows.length}개</span></h2>
        <ul class="list">${g.rows.map((r) => `
          <li>
            <div style="display:flex;gap:8px;align-items:baseline;flex-wrap:wrap">
              <b style="font-size:15px">${esc(titleOf(g.t, r))}</b>
              <span class="tiny">삭제 ${fmtDate(r.deleted_at)}</span>
              <button type="button" class="rs" data-t="${g.t}" data-id="${r.id}"
                      style="margin-left:auto;font-size:12px;padding:3px 10px">되돌리기</button>
            </div>
            ${bodyOf(g.t, r) ? `<div style="white-space:pre-wrap;font-size:14px;margin-top:5px;color:var(--soft)">${
              esc(bodyOf(g.t, r).slice(0, 400))}</div>` : ''}
          </li>`).join('')}</ul>`).join('');

      box.querySelectorAll<HTMLButtonElement>('.rs').forEach((b) =>
        b.addEventListener('click', async () => {
          b.disabled = true;
          try {
            await restore(b.dataset.t as TrashTable, b.dataset.id!);
            toast('되돌렸습니다');
            render();
          } catch (e) { toast((e as Error).message); b.disabled = false; }
        }));
    } catch (e) { box.textContent = '불러오지 못했습니다: ' + (e as Error).message; }
  }

  mountGate($('#gate'), $('#panel'), render);
</script>
