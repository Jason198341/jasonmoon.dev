---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, description, category, stack, github, live, domain, image, images, projectType } = project.data;

const categoryColors: Record<string, string> = {
  'Web App': 'text-indigo-400 bg-indigo-500/10',
  'Mobile App': 'text-emerald-400 bg-emerald-500/10',
  'Chrome Extension': 'text-amber-400 bg-amber-500/10',
  'Concept': 'text-teal-400 bg-teal-500/10',
};

const typeColors: Record<string, string> = {
  Personal: 'text-amber-400 bg-amber-400/10 border border-amber-400/20',
  Client: 'text-emerald-400 bg-emerald-400/10 border border-emerald-400/20',
};
---

<Base title={`${title} — Jason Moon`} description={description}>
  <article>
    <!-- Hero area with screenshot -->
    {image && (
      <div class="relative w-full bg-surface border-b border-border overflow-hidden">
        <div class="mx-auto max-w-5xl">
          <img
            src={image}
            alt={`${title} screenshot`}
            class="w-full max-h-[480px] object-cover object-top"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/20 to-transparent"></div>
        </div>
      </div>
    )}

    <div class="mx-auto max-w-3xl px-6">
      <!-- Back link -->
      <a href="/projects" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mt-8 mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to Projects
      </a>

      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class={`inline-block px-2.5 py-1 rounded text-xs font-medium ${categoryColors[category] || ''}`}>
            {category}
          </span>
          {projectType && (
            <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium ${typeColors[projectType] || ''}`}>
              {projectType === 'Client' ? 'Client Project' : 'Personal Project'}
            </span>
          )}
          {domain && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono text-emerald-400 bg-emerald-500/10">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
              </span>
              {domain}
            </span>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold mb-2">{title}</h1>
        {tagline && <p class="text-accent font-medium mb-3">{tagline}</p>}
        <p class="text-lg text-text-muted leading-relaxed">{description}</p>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-wrap gap-3 mb-8">
        {live && (
          <a href={live} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-accent text-white text-sm font-medium hover:bg-accent-hover transition-colors">
            {domain ? `Visit ${domain}` : 'Live Demo'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border text-sm text-text-muted hover:text-text hover:border-text-muted transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            Source Code
          </a>
        )}
      </div>

      <!-- Tech stack -->
      <div class="flex flex-wrap gap-1.5 mb-10 pb-10 border-b border-border">
        {stack.map((tech) => (
          <span class="px-2.5 py-1 rounded-md text-xs font-mono text-text-muted bg-surface border border-border">
            {tech}
          </span>
        ))}
      </div>

      <!-- Content -->
      <div class="prose pb-16">
        <Content />
      </div>

      <!-- Additional screenshots -->
      {images && images.length > 1 && (
        <div class="pb-16">
          <h2 class="text-xl font-bold mb-6">Screenshots</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {images.map((img) => (
              <div class="rounded-xl border border-border overflow-hidden bg-surface">
                <img src={img} alt={`${title} screenshot`} class="w-full" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Base>
