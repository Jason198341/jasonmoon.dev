---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const categories = ['All', 'Web App', 'Mobile App', 'Chrome Extension'] as const;

const categoryColors: Record<string, string> = {
  'Web App': 'text-indigo-700 bg-indigo-50',
  'Mobile App': 'text-emerald-700 bg-emerald-50',
  'Chrome Extension': 'text-amber-700 bg-amber-50',
};
---

<Base title="Projects — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Projects</h1>
      <p class="text-text-muted mb-10 max-w-2xl">
        Everything I've built — from AI-powered learning platforms with custom domains to Chrome extensions and Android apps.
      </p>

      <!-- Category filter -->
      <div class="flex flex-wrap gap-2 mb-8" id="filters">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class:list={[
              'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors border',
              cat === 'All'
                ? 'border-accent text-accent bg-accent-dim'
                : 'border-border text-text-muted hover:text-text hover:border-text-muted',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="space-y-4" id="project-grid">
        {projects.map((project) => (
          <div data-cat={project.data.category}>
            <a
              href={`/projects/${project.id}`}
              class="group block rounded-xl border border-border bg-surface overflow-hidden hover:border-accent/40 transition-all duration-200"
            >
              <div class:list={['flex flex-col', project.data.image ? 'sm:flex-row' : '']}>
                {project.data.image && (
                  <div class="sm:w-64 shrink-0 bg-bg/50 overflow-hidden">
                    <img
                      src={project.data.image}
                      alt={project.data.title}
                      class="w-full h-40 sm:h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-6 flex-1">
                  <div class="flex items-center gap-2 mb-3">
                    <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${categoryColors[project.data.category] || 'text-text-muted bg-surface'}`}>
                      {project.data.category}
                    </span>
                    {project.data.domain && (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono text-emerald-700 bg-emerald-50">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        {project.data.domain}
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-semibold mb-1 group-hover:text-accent transition-colors">
                    {project.data.title}
                  </h3>
                  {project.data.tagline && (
                    <p class="text-sm text-text-muted italic mb-2">{project.data.tagline}</p>
                  )}
                  <p class="text-sm text-text-muted leading-relaxed mb-4">
                    {project.data.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5">
                    {project.data.stack.slice(0, 5).map((tech) => (
                      <span class="px-2 py-0.5 rounded text-xs font-mono text-text-muted bg-bg border border-border">
                        {tech}
                      </span>
                    ))}
                    {project.data.stack.length > 5 && (
                      <span class="px-2 py-0.5 rounded text-xs font-mono text-text-muted bg-bg border border-border">
                        +{project.data.stack.length - 5}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll('#filters button');
  const cards = document.querySelectorAll('#project-grid [data-cat]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');

      buttons.forEach((b) => {
        b.className = 'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors border border-border text-text-muted hover:text-text hover:border-text-muted';
      });
      btn.className = 'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors border border-accent text-accent bg-accent-dim';

      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (cat === 'All' || el.dataset.cat === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
