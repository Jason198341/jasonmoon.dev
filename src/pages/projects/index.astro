---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const categories = ['All', 'Web App', 'Mobile App', 'Chrome Extension'] as const;
---

<Base title="Projects — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Projects</h1>
      <p class="text-text-muted mb-10 max-w-2xl">
        Tools and apps I've built — from visual prompt editors to Chrome extensions that fight doomscrolling.
      </p>

      <!-- Category filter (client-side) -->
      <div class="flex flex-wrap gap-2 mb-8" id="filters">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class:list={[
              'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors border',
              cat === 'All'
                ? 'border-accent text-accent bg-accent-dim'
                : 'border-border text-text-muted hover:text-text hover:border-text-muted',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="grid gap-4 sm:grid-cols-2" id="project-grid">
        {projects.map((project) => (
          <div data-cat={project.data.category}>
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              slug={project.id}
              category={project.data.category}
              stack={project.data.stack}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll('#filters button');
  const cards = document.querySelectorAll('#project-grid [data-cat]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');

      buttons.forEach((b) => {
        b.className = 'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors border border-border text-text-muted hover:text-text hover:border-text-muted';
      });
      btn.className = 'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors border border-accent text-accent bg-accent-dim';

      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (cat === 'All' || el.dataset.cat === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
