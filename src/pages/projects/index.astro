---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const categories = ['All', 'Web App', 'Mobile App', 'Chrome Extension', 'Concept'] as const;

const categoryConfig: Record<string, { color: string; dot: string }> = {
  'Web App': { color: 'text-indigo-400 bg-indigo-500/10', dot: 'bg-indigo-400' },
  'Mobile App': { color: 'text-emerald-400 bg-emerald-500/10', dot: 'bg-emerald-400' },
  'Chrome Extension': { color: 'text-amber-400 bg-amber-500/10', dot: 'bg-amber-400' },
  'Concept': { color: 'text-teal-400 bg-teal-500/10', dot: 'bg-teal-400' },
};
---

<Base title="Projects — Jason Moon">
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4 animate-fade-in-up delay-1">Projects</h1>
      <p class="text-text-muted mb-12 max-w-2xl leading-relaxed animate-fade-in-up delay-2">
        Personal projects built for my family, client projects shipped to production — from AI-powered learning platforms to Chrome extensions and multi-agent systems.
      </p>

      <!-- Category filter (pill tabs) -->
      <div class="flex flex-wrap gap-2 mb-10 animate-fade-in-up delay-3" id="filters">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class:list={[
              'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border',
              cat === 'All'
                ? 'border-accent text-accent bg-accent/10'
                : 'border-border/60 text-text-muted hover:text-text hover:border-accent/30',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="grid gap-5 sm:grid-cols-2" id="project-grid">
        {projects.map((project, i) => {
          const cfg = categoryConfig[project.data.category] || { color: 'text-text-muted bg-surface', dot: 'bg-text-muted' };
          return (
            <div data-cat={project.data.category} class="reveal" style={`transition-delay: ${Math.min(i * 60, 400)}ms;`}>
              <a
                href={`/projects/${project.id}`}
                class="group block rounded-2xl border border-border/60 bg-surface/40 backdrop-blur-sm overflow-hidden hover:border-accent/30 transition-all duration-300 h-full"
              >
                {project.data.image && (
                  <div class="h-40 overflow-hidden bg-bg/30 relative">
                    <img
                      src={project.data.image}
                      alt={project.data.title}
                      class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-700 ease-out"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/10 transition-colors duration-300"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent"></div>
                  </div>
                )}
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-3 flex-wrap">
                    <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-xs font-medium ${cfg.color}`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
                      {project.data.category}
                    </span>
                    {project.data.projectType && (
                      <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-medium ${project.data.projectType === 'Personal' ? 'text-amber-400 bg-amber-400/10' : 'text-emerald-400 bg-emerald-400/10'}`}>
                        {project.data.projectType}
                      </span>
                    )}
                    {project.data.domain && (
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-mono text-emerald-400 bg-emerald-500/10">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        {project.data.domain}
                      </span>
                    )}
                  </div>
                  <h3 class="font-display text-lg font-bold mb-1 group-hover:text-accent transition-colors duration-300">
                    {project.data.title}
                  </h3>
                  {project.data.tagline && (
                    <p class="text-sm text-text-muted/70 italic mb-2">{project.data.tagline}</p>
                  )}
                  <p class="text-sm text-text-muted leading-relaxed mb-4 line-clamp-2">
                    {project.data.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5">
                    {project.data.stack.slice(0, 5).map((tech) => (
                      <span class="px-2 py-0.5 rounded-md text-[11px] font-mono text-text-muted/70 bg-bg/60 border border-border/50">
                        {tech}
                      </span>
                    ))}
                    {project.data.stack.length > 5 && (
                      <span class="px-2 py-0.5 rounded-md text-[11px] font-mono text-text-muted/50 bg-bg/60 border border-border/50">
                        +{project.data.stack.length - 5}
                      </span>
                    )}
                  </div>
                </div>
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll('#filters button');
  const cards = document.querySelectorAll('#project-grid [data-cat]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');

      buttons.forEach((b) => {
        b.className = 'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border border-border/60 text-text-muted hover:text-text hover:border-accent/30';
      });
      btn.className = 'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border border-accent text-accent bg-accent/10';

      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (cat === 'All' || el.dataset.cat === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
