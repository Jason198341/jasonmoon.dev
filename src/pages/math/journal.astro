---
import Base from '../../layouts/Base.astro';
import { JOURNAL, MOOD_LABEL, byDateDesc } from '../../data/content';
import { BY_ID } from '../../data/concepts';
const items = byDateDesc(JOURNAL);
---
<Base title="일지" desc="아빠와 세연이의 수학 일지" subject="math" nav={[
    { href: '/math', label: '홈' },
    { href: '/math/map', label: '개념지도' },
    { href: '/math/prep', label: '아빠 예습' },
    { href: '/math/journal', label: '일지' },
  ]}>
  <h1>일지</h1>
  <p class="lead">
    그날 무엇을 했고, 어디서 막혔고, 무엇이 열렸는지.
    <span class="hand" style="font-size:20px">숫자보다 이게 남습니다.</span>
  </p>

  {items.length === 0 ? (
    <div class="lock" style="margin-top:20px">
      <p style="margin:0"><b>아직 일지가 없습니다.</b><br />
      <span class="tiny">일지는 <code>src/data/content/index.ts</code> 의 <code>JOURNAL</code> 에 씁니다.
      Claude에게 <code>/mathjason</code> 으로 불러주세요.</span></p>
    </div>
  ) : items.map((j) => (
    <article class="card" id={j.id} style="margin-bottom:12px">
      <div style="display:flex;gap:8px;align-items:baseline;flex-wrap:wrap">
        <b style="font-size:18px">{j.title}</b>
        {j.mood && <span class="pill current">{MOOD_LABEL[j.mood]}</span>}
        <span class="tiny" style="margin-left:auto">{j.date}</span>
      </div>
      <div style="white-space:pre-wrap;margin-top:8px;font-size:15px">{j.body}</div>
      {j.conceptIds && j.conceptIds.length > 0 && (
        <div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:10px">
          {j.conceptIds.map((id) => {
            const c = BY_ID[id];
            return c ? <a href={`/math/c/${id}`} class={`chip ${c.lv}`}>{c.name.replace(/ ★.*$/, '')}</a> : null;
          })}
        </div>
      )}
    </article>
  ))}
</Base>
