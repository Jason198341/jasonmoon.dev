---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

const difficultyColors: Record<string, string> = {
  'beginner': 'text-green-700 bg-green-50',
  'easy': 'text-blue-700 bg-blue-50',
  'intermediate': 'text-amber-700 bg-amber-50',
};

const difficultyLabels: Record<string, string> = {
  'beginner': 'Beginner',
  'easy': 'Easy',
  'intermediate': 'Intermediate',
};
---

<Base title="Learn — Jason Moon" description="Build your own tools with AI. A practical guide to fullstack development — no prior coding experience needed.">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <!-- Hero -->
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">Build Your Own Tools with AI</h1>
      <p class="text-lg text-text-muted leading-relaxed mb-4">
        You don't need to know how to code. These guides walk you through building web apps, deploying them, and connecting domains — all by talking to AI.
      </p>
      <p class="text-sm text-text-muted">
        Written so that <strong class="text-text">anyone can follow along</strong>.
        No jargon without explanation. Every concept gets an analogy.
      </p>
    </div>

    <!-- Guide list -->
    <div class="space-y-3">
      {guides.map((guide, i) => (
        <a
          href={`/guides/${guide.id}`}
          class="group flex items-start gap-4 p-5 rounded-xl border border-border bg-bg hover:bg-surface hover:border-border transition-all"
        >
          <span class="text-2xl flex-shrink-0 mt-0.5">{guide.data.emoji}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-text-muted font-mono">#{i + 1}</span>
              <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-medium ${difficultyColors[guide.data.difficulty] || ''}`}>
                {difficultyLabels[guide.data.difficulty] || guide.data.difficulty}
              </span>
            </div>
            <h2 class="text-base font-bold group-hover:text-accent transition-colors">
              {guide.data.title}
            </h2>
            <p class="text-sm text-text-muted mt-1 line-clamp-2">
              {guide.data.description}
            </p>
          </div>
          <svg class="w-5 h-5 text-text-muted group-hover:text-accent transition-colors flex-shrink-0 mt-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 p-6 rounded-xl bg-surface border border-border text-center">
      <p class="text-sm text-text-muted mb-1">
        Done reading? Time to build.
      </p>
      <p class="font-bold">
        Build the tool you need. Yourself.
      </p>
      <div class="flex justify-center gap-3 mt-4">
        <a href="/projects" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent text-white text-sm font-medium hover:bg-accent-hover transition-colors">
          See Examples
        </a>
        <a href="/contact" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-border text-sm text-text-muted hover:text-text transition-colors">
          Ask a Question
        </a>
      </div>
    </div>
  </div>
</Base>
