---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const guidesKo = (await getCollection('guidesKo')).sort((a, b) => a.data.order - b.data.order);

const difficultyColors: Record<string, string> = {
  'beginner': 'text-green-400 bg-green-500/10',
  'easy': 'text-blue-400 bg-blue-500/10',
  'intermediate': 'text-amber-400 bg-amber-500/10',
};

const difficultyLabels: Record<string, { en: string; ko: string }> = {
  'beginner': { en: 'Beginner', ko: '입문' },
  'easy': { en: 'Easy', ko: '쉬움' },
  'intermediate': { en: 'Intermediate', ko: '중급' },
};
---

<Base title="Learn — Jason Moon" description="Build your own tools with AI. A practical guide to fullstack development — no prior coding experience needed.">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <!-- Hero -->
    <div class="mb-12">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div data-lang="en">
            <h1 class="text-3xl sm:text-4xl font-bold mb-3">Build Your Own Tools with AI</h1>
            <p class="text-lg text-text-muted leading-relaxed mb-4">
              You don't need to know how to code. These guides walk you through building web apps, deploying them, and connecting domains — all by talking to AI.
            </p>
            <p class="text-sm text-text-muted">
              Written so that <strong class="text-text">anyone can follow along</strong>.
              No jargon without explanation. Every concept gets an analogy.
            </p>
          </div>
          <div data-lang="ko" class="hidden">
            <h1 class="text-3xl sm:text-4xl font-bold mb-3">AI로 나만의 도구를 만드세요</h1>
            <p class="text-lg text-text-muted leading-relaxed mb-4">
              코딩을 몰라도 됩니다. 이 가이드가 웹앱 만들기, 배포하기, 도메인 연결까지 — 전부 AI와 대화하면서 하는 법을 알려줍니다.
            </p>
            <p class="text-sm text-text-muted">
              <strong class="text-text">누구나 따라할 수 있게</strong> 쓰였습니다.
              설명 없는 전문 용어는 없습니다. 모든 개념에 비유가 있습니다.
            </p>
          </div>
        </div>

        <!-- Language toggle -->
        <div class="flex-shrink-0 flex items-center rounded-full border border-border bg-bg p-0.5 mt-1">
          <button data-lang-btn="en" class="px-3 py-1 rounded-full text-xs font-medium transition-colors bg-accent text-white">
            EN
          </button>
          <button data-lang-btn="ko" class="px-3 py-1 rounded-full text-xs font-medium transition-colors text-text-muted">
            한국어
          </button>
        </div>
      </div>
    </div>

    <!-- Guide list (EN) -->
    <div data-lang="en" class="space-y-3">
      {guides.map((guide, i) => (
        <a
          href={`/guides/${guide.id}`}
          class="group flex items-start gap-4 p-5 rounded-xl border border-border bg-bg hover:bg-surface hover:border-border transition-all"
        >
          <span class="text-2xl flex-shrink-0 mt-0.5">{guide.data.emoji}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-text-muted font-mono">#{i + 1}</span>
              <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-medium ${difficultyColors[guide.data.difficulty] || ''}`}>
                {difficultyLabels[guide.data.difficulty]?.en || guide.data.difficulty}
              </span>
            </div>
            <h2 class="text-base font-bold group-hover:text-accent transition-colors">
              {guide.data.title}
            </h2>
            <p class="text-sm text-text-muted mt-1 line-clamp-2">
              {guide.data.description}
            </p>
          </div>
          <svg class="w-5 h-5 text-text-muted group-hover:text-accent transition-colors flex-shrink-0 mt-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </div>

    <!-- Guide list (KO) -->
    <div data-lang="ko" class="hidden space-y-3">
      {guidesKo.map((guide, i) => (
        <a
          href={`/guides/${guide.id}`}
          class="group flex items-start gap-4 p-5 rounded-xl border border-border bg-bg hover:bg-surface hover:border-border transition-all"
        >
          <span class="text-2xl flex-shrink-0 mt-0.5">{guide.data.emoji}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-text-muted font-mono">#{i + 1}</span>
              <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-medium ${difficultyColors[guide.data.difficulty] || ''}`}>
                {difficultyLabels[guide.data.difficulty]?.ko || guide.data.difficulty}
              </span>
            </div>
            <h2 class="text-base font-bold group-hover:text-accent transition-colors">
              {guide.data.title}
            </h2>
            <p class="text-sm text-text-muted mt-1 line-clamp-2">
              {guide.data.description}
            </p>
          </div>
          <svg class="w-5 h-5 text-text-muted group-hover:text-accent transition-colors flex-shrink-0 mt-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </div>

    <!-- CTA (EN) -->
    <div data-lang="en" class="mt-12 p-6 rounded-xl bg-surface border border-border text-center">
      <p class="text-sm text-text-muted mb-1">
        Done reading? Time to build.
      </p>
      <p class="font-bold">
        Build the tool you need. Yourself.
      </p>
      <div class="flex justify-center gap-3 mt-4">
        <a href="/projects" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent text-white text-sm font-medium hover:bg-accent-hover transition-colors">
          See Examples
        </a>
        <a href="/contact" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-border text-sm text-text-muted hover:text-text transition-colors">
          Ask a Question
        </a>
      </div>
    </div>

    <!-- CTA (KO) -->
    <div data-lang="ko" class="hidden mt-12 p-6 rounded-xl bg-surface border border-border text-center">
      <p class="text-sm text-text-muted mb-1">
        다 읽었으면? 이제 만들 차례.
      </p>
      <p class="font-bold">
        필요한 도구를 직접 만드세요.
      </p>
      <div class="flex justify-center gap-3 mt-4">
        <a href="/projects" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent text-white text-sm font-medium hover:bg-accent-hover transition-colors">
          예시 보기
        </a>
        <a href="/contact" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-border text-sm text-text-muted hover:text-text transition-colors">
          질문하기
        </a>
      </div>
    </div>
  </div>
</Base>

<script>
  const STORAGE_KEY = 'guide_lang';
  const lang = localStorage.getItem(STORAGE_KEY) || 'en';

  function setLang(l: string) {
    document.querySelectorAll<HTMLElement>('[data-lang]').forEach(el => {
      el.classList.toggle('hidden', el.dataset.lang !== l);
    });
    document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach(btn => {
      const isActive = btn.dataset.langBtn === l;
      btn.classList.toggle('bg-accent', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('text-text-muted', !isActive);
    });
    localStorage.setItem(STORAGE_KEY, l);
  }

  setLang(lang);

  document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach(btn => {
    btn.addEventListener('click', () => setLang(btn.dataset.langBtn!));
  });
</script>
