---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, emoji, difficulty } = guide.data;

const allGuides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allGuides.findIndex((g) => g.id === guide.id);
const prev = currentIndex > 0 ? allGuides[currentIndex - 1] : null;
const next = currentIndex < allGuides.length - 1 ? allGuides[currentIndex + 1] : null;

const difficultyColors: Record<string, string> = {
  '입문': 'text-green-700 bg-green-50',
  '초급': 'text-blue-700 bg-blue-50',
  '중급': 'text-amber-700 bg-amber-50',
};
---

<Base title={`${title} — Guides`} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <!-- Back link -->
    <a href="/guides" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      가이드 목록
    </a>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">{emoji}</span>
        <span class={`inline-block px-2.5 py-1 rounded text-xs font-medium ${difficultyColors[difficulty] || ''}`}>
          {difficulty}
        </span>
        <span class="text-xs text-text-muted font-mono">
          #{currentIndex + 1} / {allGuides.length}
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold mb-2">{title}</h1>
      <p class="text-text-muted leading-relaxed">{description}</p>
    </div>

    <!-- Content -->
    <div class="prose pb-12">
      <Content />
    </div>

    <!-- Prev / Next navigation -->
    <div class="border-t border-border pt-6 flex justify-between gap-4">
      {prev ? (
        <a href={`/guides/${prev.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-left">
          <span class="text-xs text-text-muted">이전</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {prev.data.emoji} {prev.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
      {next ? (
        <a href={`/guides/${next.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-right">
          <span class="text-xs text-text-muted">다음</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {next.data.emoji} {next.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
    </div>
  </article>
</Base>
