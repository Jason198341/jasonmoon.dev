---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, emoji, difficulty } = guide.data;

// Load matching Korean guide
const allGuidesKo = await getCollection('guidesKo');
const guideKo = allGuidesKo.find((g) => g.id === guide.id);
let ContentKo: any = null;
if (guideKo) {
  const rendered = await render(guideKo);
  ContentKo = rendered.Content;
}

const allGuides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const allGuidesKoSorted = allGuidesKo.sort((a, b) => a.data.order - b.data.order);
const currentIndex = allGuides.findIndex((g) => g.id === guide.id);
const prev = currentIndex > 0 ? allGuides[currentIndex - 1] : null;
const next = currentIndex < allGuides.length - 1 ? allGuides[currentIndex + 1] : null;
const prevKo = currentIndex > 0 ? allGuidesKoSorted[currentIndex - 1] : null;
const nextKo = currentIndex < allGuidesKoSorted.length - 1 ? allGuidesKoSorted[currentIndex + 1] : null;

const difficultyColors: Record<string, string> = {
  'beginner': 'text-green-700 bg-green-50',
  'easy': 'text-blue-700 bg-blue-50',
  'intermediate': 'text-amber-700 bg-amber-50',
};

const difficultyLabels: Record<string, { en: string; ko: string }> = {
  'beginner': { en: 'Beginner', ko: '입문' },
  'easy': { en: 'Easy', ko: '쉬움' },
  'intermediate': { en: 'Intermediate', ko: '중급' },
};
---

<Base title={`${title} — Guides`} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <!-- Back link + Toggle row -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <a data-lang="en" href="/guides" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          All Guides
        </a>
        <a data-lang="ko" href="/guides" class="hidden inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          전체 가이드
        </a>
      </div>

      <!-- Language toggle -->
      <div class="flex items-center rounded-full border border-border bg-bg p-0.5">
        <button data-lang-btn="en" class="px-3 py-1 rounded-full text-xs font-medium transition-colors bg-accent text-white">
          EN
        </button>
        <button data-lang-btn="ko" class="px-3 py-1 rounded-full text-xs font-medium transition-colors text-text-muted">
          한국어
        </button>
      </div>
    </div>

    <!-- Header (EN) -->
    <div data-lang="en" class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">{emoji}</span>
        <span class={`inline-block px-2.5 py-1 rounded text-xs font-medium ${difficultyColors[difficulty] || ''}`}>
          {difficultyLabels[difficulty]?.en || difficulty}
        </span>
        <span class="text-xs text-text-muted font-mono">
          #{currentIndex + 1} / {allGuides.length}
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold mb-2">{title}</h1>
      <p class="text-text-muted leading-relaxed">{description}</p>
    </div>

    <!-- Header (KO) -->
    {guideKo && (
      <div data-lang="ko" class="hidden mb-8">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-3xl">{guideKo.data.emoji}</span>
          <span class={`inline-block px-2.5 py-1 rounded text-xs font-medium ${difficultyColors[guideKo.data.difficulty] || ''}`}>
            {difficultyLabels[guideKo.data.difficulty]?.ko || guideKo.data.difficulty}
          </span>
          <span class="text-xs text-text-muted font-mono">
            #{currentIndex + 1} / {allGuidesKoSorted.length}
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold mb-2">{guideKo.data.title}</h1>
        <p class="text-text-muted leading-relaxed">{guideKo.data.description}</p>
      </div>
    )}

    <!-- Content (EN) -->
    <div data-lang="en" class="prose pb-12">
      <Content />
    </div>

    <!-- Content (KO) -->
    {ContentKo && (
      <div data-lang="ko" class="hidden prose pb-12">
        <ContentKo />
      </div>
    )}

    <!-- Prev / Next navigation (EN) -->
    <div data-lang="en" class="border-t border-border pt-6 flex justify-between gap-4">
      {prev ? (
        <a href={`/guides/${prev.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-left">
          <span class="text-xs text-text-muted">Previous</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {prev.data.emoji} {prev.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
      {next ? (
        <a href={`/guides/${next.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-right">
          <span class="text-xs text-text-muted">Next</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {next.data.emoji} {next.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
    </div>

    <!-- Prev / Next navigation (KO) -->
    <div data-lang="ko" class="hidden border-t border-border pt-6 flex justify-between gap-4">
      {prevKo ? (
        <a href={`/guides/${prevKo.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-left">
          <span class="text-xs text-text-muted">이전</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {prevKo.data.emoji} {prevKo.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
      {nextKo ? (
        <a href={`/guides/${nextKo.id}`} class="group flex-1 p-4 rounded-xl border border-border hover:bg-surface transition-all text-right">
          <span class="text-xs text-text-muted">다음</span>
          <p class="text-sm font-medium group-hover:text-accent transition-colors mt-1">
            {nextKo.data.emoji} {nextKo.data.title}
          </p>
        </a>
      ) : <div class="flex-1" />}
    </div>
  </article>
</Base>

<script>
  const STORAGE_KEY = 'guide_lang';
  const lang = localStorage.getItem(STORAGE_KEY) || 'en';

  function setLang(l: string) {
    document.querySelectorAll<HTMLElement>('[data-lang]').forEach(el => {
      el.classList.toggle('hidden', el.dataset.lang !== l);
    });
    document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach(btn => {
      const isActive = btn.dataset.langBtn === l;
      btn.classList.toggle('bg-accent', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('text-text-muted', !isActive);
    });
    localStorage.setItem(STORAGE_KEY, l);
  }

  setLang(lang);

  document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach(btn => {
    btn.addEventListener('click', () => setLang(btn.dataset.langBtn!));
  });
</script>
