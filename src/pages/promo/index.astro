<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>홍보 카드 — 캡처용 | jasonmoon.dev</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    :root {
      --ink: #070b14;
      --amber: #ffb000;
      --amber-soft: #ffce5a;
      --carrot: #ff6f0f;
      --carrot-deep: #e85d04;
      --cream: #fff8ef;
      --cream-line: #f0e2cf;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { -webkit-text-size-adjust: 100%; }

    body {
      font-family: "Pretendard", -apple-system, BlinkMacSystemFont,
        "Apple SD Gothic Neo", "Malgun Gothic", "Segoe UI", system-ui, sans-serif;
      background: #11151d;
      color: #e7ecf3;
      line-height: 1.5;
      padding: 32px 16px 96px;
      word-break: keep-all;
    }

    /* ── 페이지 안내 ───────────────────────── */
    .page-guide {
      max-width: 560px;
      margin: 0 auto 48px;
      text-align: center;
    }
    .page-guide h1 {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }
    .page-guide p {
      font-size: 15px;
      color: #aab4c2;
      line-height: 1.6;
    }
    .page-guide .accent { color: var(--amber); font-weight: 700; }

    .section-title {
      max-width: 560px;
      margin: 64px auto 28px;
      text-align: center;
      font-size: 17px;
      font-weight: 700;
      color: #c6d0dc;
      letter-spacing: 0.02em;
    }
    .section-title span {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: #7e8a99;
      margin-top: 6px;
    }

    /* ── 카드 공통 래퍼 ─────────────────────── */
    .card-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 56px;
    }
    .capture-label {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: #6f7b8a;
      margin-bottom: 12px;
      text-align: center;
    }
    .capture-label b { color: #9aa6b5; }

    /* ── 인스타 카드 (4:5) ──────────────────── */
    .insta {
      container-type: inline-size;
      width: min(432px, 92vw);
      aspect-ratio: 4 / 5;
      background:
        radial-gradient(120% 80% at 85% -10%, rgba(255,176,0,0.16), transparent 55%),
        radial-gradient(90% 60% at 0% 110%, rgba(255,176,0,0.08), transparent 50%),
        var(--ink);
      border: 1px solid rgba(255,176,0,0.22);
      border-radius: 22px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 18px 50px rgba(0,0,0,0.45);
      color: #f3f6fa;
    }
    .insta .inner {
      position: absolute;
      inset: 0;
      padding: 8.5cqw 8cqw;
      display: flex;
      flex-direction: column;
    }
    .insta .toplabel {
      font-size: 3.3cqw;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--amber);
      text-transform: none;
      display: flex;
      align-items: center;
      gap: 1.6cqw;
    }
    .insta .toplabel::before {
      content: "";
      width: 2.6cqw; height: 2.6cqw;
      border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 0 1.2cqw rgba(255,176,0,0.18);
    }
    .insta .copy {
      margin-top: auto;
      font-size: 11cqw;
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
    }
    .insta .copy .lead { color: #f3f6fa; }
    .insta .copy .hl { color: var(--amber); }
    .insta .meta {
      margin-top: 5cqw;
      font-size: 3.5cqw;
      line-height: 1.5;
      color: #b8c2d0;
    }
    .insta .meta .biz {
      font-weight: 700;
      color: #f3f6fa;
      font-size: 4.2cqw;
    }
    .insta .swatch-band {
      margin-top: 4cqw;
      height: 5.6cqw;
      border-radius: 99px;
      display: flex;
      align-items: center;
      padding: 0 3.4cqw;
      font-size: 2.6cqw;
      font-weight: 700;
      letter-spacing: 0.05em;
    }
    .insta .footer {
      margin-top: auto;
      padding-top: 5cqw;
      display: flex;
      flex-direction: column;
      gap: 3cqw;
    }
    .insta .price {
      font-size: 4cqw;
      font-weight: 700;
      color: #e7ecf3;
    }
    .insta .price b { color: var(--amber); }
    .insta .cta {
      align-self: flex-start;
      background: var(--amber);
      color: #1a1206;
      font-weight: 800;
      font-size: 3.8cqw;
      padding: 2.8cqw 5cqw;
      border-radius: 99px;
      letter-spacing: -0.01em;
    }

    /* ── 당근 카드 (1:1) ────────────────────── */
    .danggeun {
      container-type: inline-size;
      width: min(432px, 92vw);
      aspect-ratio: 1 / 1;
      background:
        radial-gradient(120% 90% at 90% -10%, rgba(255,111,15,0.12), transparent 55%),
        var(--cream);
      border: 1px solid var(--cream-line);
      border-radius: 22px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 18px 50px rgba(0,0,0,0.4);
      color: #2a2218;
    }
    .danggeun .inner {
      position: absolute; inset: 0;
      padding: 8.5cqw;
      display: flex;
      flex-direction: column;
    }
    .danggeun .kicker {
      display: inline-flex;
      align-items: center;
      gap: 1.4cqw;
      align-self: flex-start;
      background: var(--carrot);
      color: #fff;
      font-size: 3.2cqw;
      font-weight: 800;
      letter-spacing: 0.02em;
      padding: 2cqw 4cqw;
      border-radius: 99px;
    }
    .danggeun .pageno {
      position: absolute;
      top: 8.5cqw; right: 8.5cqw;
      font-size: 3cqw;
      font-weight: 800;
      color: #c4a98a;
    }
    .danggeun h2 {
      font-size: 8.6cqw;
      font-weight: 800;
      line-height: 1.18;
      letter-spacing: -0.03em;
      margin-top: 5cqw;
    }
    .danggeun h2 .o { color: var(--carrot-deep); }
    .danggeun .body {
      margin-top: 5cqw;
      font-size: 4cqw;
      line-height: 1.6;
      color: #5a4d3c;
    }
    .danggeun .body b { color: #2a2218; font-weight: 700; }

    .danggeun .chips {
      margin-top: 5.5cqw;
      display: flex;
      flex-wrap: wrap;
      gap: 2.6cqw;
    }
    .danggeun .chip {
      background: #fff;
      border: 1.2px solid var(--cream-line);
      border-radius: 14px;
      padding: 2.8cqw 3.4cqw;
      font-size: 3.5cqw;
      font-weight: 700;
      color: #3a3020;
      display: flex;
      align-items: center;
      gap: 1.6cqw;
    }
    .danggeun .chip .em { font-size: 4.6cqw; }

    .danggeun .steps {
      margin-top: 5cqw;
      display: flex;
      flex-direction: column;
      gap: 3cqw;
    }
    .danggeun .step {
      display: flex;
      align-items: center;
      gap: 3.4cqw;
      background: #fff;
      border: 1.2px solid var(--cream-line);
      border-radius: 16px;
      padding: 3.4cqw 4cqw;
    }
    .danggeun .step .n {
      flex: none;
      width: 8cqw; height: 8cqw;
      border-radius: 50%;
      background: var(--carrot);
      color: #fff;
      font-weight: 800;
      font-size: 4cqw;
      display: grid;
      place-items: center;
    }
    .danggeun .step .t { font-size: 4cqw; font-weight: 700; color: #2a2218; }
    .danggeun .step .t span { display: block; font-size: 3.1cqw; font-weight: 500; color: #7a6c58; margin-top: 0.4cqw; }

    .danggeun .spacer { margin-top: auto; }
    .danggeun .bigbtn {
      margin-top: 5cqw;
      background: var(--carrot);
      color: #fff;
      border-radius: 18px;
      padding: 5cqw;
      text-align: center;
      font-size: 5.4cqw;
      font-weight: 800;
      letter-spacing: -0.01em;
      box-shadow: 0 8px 20px rgba(255,111,15,0.3);
    }
    .danggeun .bigbtn span { display:block; font-size: 3.2cqw; font-weight: 600; opacity: 0.9; margin-top: 1.4cqw; }
    .danggeun .sub {
      margin-top: 4cqw;
      font-size: 3.4cqw;
      color: #7a6c58;
      text-align: center;
      line-height: 1.5;
    }
    .danggeun .sub b { color: var(--carrot-deep); }

    .footer-note {
      max-width: 560px;
      margin: 80px auto 0;
      text-align: center;
      font-size: 13px;
      color: #6f7b8a;
      line-height: 1.7;
    }
    .footer-note code {
      color: var(--amber-soft);
      background: rgba(255,176,0,0.08);
      padding: 2px 7px;
      border-radius: 6px;
      font-size: 12px;
    }
  </style>
</head>
