---
import Base from '../../layouts/Base.astro';
import PrepView from '../../components/PrepView.astro';
import Widget from '../../components/Widget.astro';
import { CONCEPTS, BY_ID, LEVEL_NAME } from '../../data/concepts';
import { schoolStatus, stageOf, STAGE_BY_N, SCHOOL_LABEL } from '../../data/curriculum';
import { getDeep } from '../../data/deep';
import { getPrep, PREP_LABEL } from '../../data/prep';
import { PROGRESS, recordsOf } from '../../data/content';
import { hasWidget } from '../../data/widgets';
import { en } from '../../data/english';

export function getStaticPaths() {
  return CONCEPTS.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const st = schoolStatus(c);
const stage = STAGE_BY_N[stageOf(c)];
const pre = c.pre.map((id) => BY_ID[id]).filter(Boolean);
const next = c.next.map((id) => BY_ID[id]).filter(Boolean);
const cleanName = c.name.replace(/ ★.*$/, '');
const d = getDeep(c.id);
const p = getPrep(c.id);
const prog = PROGRESS[c.id];
const records = recordsOf(c.id);
const eng = en(c.id);
---
<Base title={cleanName} desc={d?.intuition ?? c.def}>
  <p class="tiny" style="margin:0">
    <a href="/map">개념지도</a> / {LEVEL_NAME[c.lv]} / {c.area}
  </p>

  <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;margin-top:4px">
    <h1 style="margin:0">{cleanName}</h1>
    {eng && <span class="eng-term">{eng}</span>}
    <span class={`chip ${c.lv}`}>{stage.short}</span>
    <span class={`pill ${st}`}>{SCHOOL_LABEL[st]}</span>
    {prog && prog.status !== 'todo' && (
      <span class={`pill ${prog.status === 'done' ? 'learned' : 'current'}`}>
        백지 {prog.status === 'done' ? '완료' : '진행'} {prog.mastery}/5
      </span>
    )}
    {p && (
      <span class={`pill ${p.status === 'ready' || p.status === 'taught' ? 'learned' : 'current'}`}>
        예습 {PREP_LABEL[p.status]}
      </span>
    )}
  </div>
  <p class="lead" style="font-size:17px;margin:6px 0 0">{c.def}</p>

  {d?.intuition && (
    <div class="card lift" style="margin-top:14px;background:#F5F9FF;border-color:#C9DDF5">
      <div class="tiny" style="font-weight:700">한 문장 직관 — 이것만 남으면 성공</div>
      <p class="hand" style="font-size:24px;margin:4px 0 0;line-height:1.5">{d.intuition}</p>
    </div>
  )}

  {hasWidget(c.id) && <Widget id={c.id} />}

  <div style="display:flex;gap:6px;flex-wrap:wrap;margin:20px 0 14px;border-bottom:2px solid var(--graphite);padding-bottom:10px">
    <button type="button" class="vtab primary" data-v="learn">개념</button>
    <button type="button" class="vtab" data-v="prep">아빠 예습{p ? ' ✓' : ''}</button>
    <button type="button" class="vtab" data-v="blank">백지 기록{records.length ? ` (${records.length})` : ''}</button>
  </div>

  <!-- ============ 개념 ============ -->
  <section data-view="learn">
    <div class="grid c2">
      <div class={`card band-${c.lv}`}>
        <h3 style="margin-top:0">왜 중요한가</h3>
        <p style="margin:0">{c.why}</p>
        <h3>예시</h3>
        <p style="margin:0">{c.ex}</p>
        {d?.formal && (<><h3>형식적 정의</h3><p style="margin:0">{d.formal}</p></>)}
      </div>
      <div class="card" style="background:#FFFDF0;border-color:#EBDFA8">
        <h3 style="margin-top:0">백지에 해볼 것 <span class="hand" style="font-size:20px;color:var(--soft)">A4 한 장</span></h3>
        <p style="margin:0">{c.a4}</p>
        {d?.props && d.props.length > 0 && (
          <p style="margin:10px 0 0" class="tiny"><b>준비물</b> · {d.props.join(' / ')}</p>
        )}
      </div>
    </div>

    {d?.formulas && d.formulas.length > 0 && (<>
      <h2>핵심 식</h2>
      <div class="grid">
        {d.formulas.map((f) => (
          <div class="card" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
            <div class="katex-here" data-tex={f.tex} style="font-size:19px;min-width:200px"></div>
            <div class="lead" style="flex:1;min-width:200px;font-size:14.5px">{f.say}</div>
          </div>
        ))}
      </div>
    </>)}

    {d?.misconceptions && d.misconceptions.length > 0 && (<>
      <h2>흔한 오개념 — 여기서 막힌다</h2>
      <div class="grid">
        {d.misconceptions.map((m) => (
          <div class="card" style="border-left:6px solid var(--red)">
            <div style="font-weight:700;color:var(--red)">✗ {m.wrong}</div>
            <p style="margin:8px 0 0;font-size:14.5px"><b class="tiny">왜 이렇게 생각하나</b><br />{m.why}</p>
            <p style="margin:8px 0 0;font-size:14.5px;background:var(--hl);padding:8px 10px;border-radius:3px">
              <b class="tiny">어떻게 깨뜨리나</b><br />{m.fix}</p>
          </div>
        ))}
      </div>
    </>)}

    {d?.examples && d.examples.length > 0 && (<>
      <h2>대표 예제</h2>
      <ul class="list">
        {d.examples.map((e) => (
          <li>
            <div style="font-weight:700">Q. {e.q}</div>
            <div style="margin-top:3px">A. {e.a}</div>
            {e.note && <div class="tiny" style="margin-top:3px">→ {e.note}</div>}
          </li>
        ))}
      </ul>
    </>)}

    {d?.traps && d.traps.length > 0 && (<>
      <h2>함정</h2>
      <ul class="list">{d.traps.map((t) => <li style="padding:8px 0">{t}</li>)}</ul>
    </>)}

    {d?.blankSteps && d.blankSteps.length > 0 && (<>
      <h2>백지 훈련 단계 — 순서대로 시키면 됨</h2>
      <ol style="padding-left:22px">{d.blankSteps.map((s) => <li style="margin:7px 0">{s}</li>)}</ol>
    </>)}

    {d?.checks && d.checks.length > 0 && (<>
      <h2>확인 질문 — 답하면 통과</h2>
      <ul class="list">{d.checks.map((q) => <li style="padding:9px 0;font-weight:500">{q}</li>)}</ul>
    </>)}

    <div class="grid c2" style="margin-top:20px">
      {d?.history && (
        <div class="card">
          <h3 style="margin-top:0">발견의 순서 — 왜 이게 필요했나</h3>
          <p style="margin:0;font-size:14.5px">{d.history}</p>
        </div>
      )}
      {d?.realworld && d.realworld.length > 0 && (
        <div class="card">
          <h3 style="margin-top:0">어디에 쓰이나</h3>
          <ul style="margin:0;padding-left:20px">
            {d.realworld.map((r) => <li style="margin:4px 0;font-size:14.5px">{r}</li>)}
          </ul>
        </div>
      )}
    </div>

    {d?.bridge && (
      <div class="card lift" style="margin-top:14px;border-left:6px solid var(--ink)">
        <h3 style="margin-top:0">다음으로 어떻게 이어지는가</h3>
        <p style="margin:0">{d.bridge}</p>
      </div>
    )}

    {(pre.length > 0 || next.length > 0) && (
      <div class="card" style="margin-top:18px">
        {pre.length > 0 && (
          <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
            <span class="tiny" style="font-weight:700">먼저 알아야 할 것</span>
            {pre.map((x) => <a href={`/c/${x.id}`} class={`chip ${x.lv}`}>{x.name.replace(/ ★.*$/, '')}</a>)}
          </div>
        )}
        {next.length > 0 && (
          <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-top:8px">
            <span class="tiny" style="font-weight:700">이걸 알면 갈 수 있는 곳</span>
            {next.map((x) => <a href={`/c/${x.id}`} class={`chip ${x.lv}`}>{x.name.replace(/ ★.*$/, '')}</a>)}
          </div>
        )}
      </div>
    )}
  </section>

  <!-- ============ 아빠 예습 ============ -->
  <section data-view="prep" hidden>
    <p class="lead" style="margin-top:0">
      가르치기 전에 <b>제1원칙으로 내가 먼저 재구성</b>한다.
      이름 붙이기로 때우지 않고, 논리 비약 없이, 세연이가 나 없이 재도출할 수 있게.
    </p>
    <PrepView id={c.id} />
  </section>

  <!-- ============ 백지 기록 ============ -->
  <section data-view="blank" hidden>
    {records.length === 0 ? (
      <p class="lead">
        아직 백지 기록이 없습니다.
        <span class="tiny">기록은 <code>src/data/content/index.ts</code> 의 <code>RECORDS</code> 에 추가합니다.</span>
      </p>
    ) : (
      <ul class="list">
        {records.map((r) => (
          <li>
            <div style="display:flex;gap:8px;align-items:baseline;flex-wrap:wrap">
              <b style="font-size:15px">{r.date}</b>
              <span class="chip">{r.who}</span>
              {r.score != null && (
                <span class={`pill ${r.score >= 4 ? 'learned' : 'current'}`}>자평 {r.score}/5</span>
              )}
            </div>
            {r.before && (<div style="margin-top:8px">
              <span class="tiny" style="font-weight:700">① 설명 전</span>
              <div class="blank-sheet" style="min-height:auto;padding:6px 12px;white-space:pre-wrap">{r.before}</div>
            </div>)}
            {r.after && (<div style="margin-top:8px">
              <span class="tiny" style="font-weight:700">② 설명 후</span>
              <div class="blank-sheet" style="min-height:auto;padding:6px 12px;white-space:pre-wrap">{r.after}</div>
            </div>)}
            {r.note && (<div style="margin-top:8px">
              <span class="tiny" style="font-weight:700">아빠 관찰</span>
              <div style="white-space:pre-wrap;font-size:14.5px">{r.note}</div>
            </div>)}
            {r.images && r.images.length > 0 && (
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
                {r.images.map((src) => (
                  <a href={src} target="_blank" rel="noopener">
                    <img src={src} alt="" loading="lazy"
                         style="height:120px;border:1px solid var(--hairline);border-radius:3px" />
                  </a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
</Base>

<script>
  // 탭
  document.querySelectorAll<HTMLButtonElement>('.vtab').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.vtab').forEach((x) => x.classList.remove('primary'));
      b.classList.add('primary');
      document.querySelectorAll<HTMLElement>('[data-view]').forEach((s) => {
        s.hidden = s.dataset.view !== b.dataset.v;
      });
      history.replaceState(null, '', '#' + b.dataset.v);
    }));
  if (location.hash) {
    document.querySelector<HTMLButtonElement>(`.vtab[data-v="${location.hash.slice(1)}"]`)?.click();
  }

  // KaTeX
  const texNodes = document.querySelectorAll<HTMLElement>('.katex-here');
  if (texNodes.length) {
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js';
    s.onload = () => {
      const k = (window as any).katex;
      texNodes.forEach((n) => {
        try { k.render(n.dataset.tex!, n, { throwOnError: false, displayMode: true }); }
        catch { n.textContent = n.dataset.tex!; }
      });
    };
    s.onerror = () => texNodes.forEach((n) => { n.textContent = n.dataset.tex!; });
    document.head.appendChild(s);
  }
</script>
