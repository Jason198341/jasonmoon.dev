---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Let's Build Something</h1>
      <p class="text-text-muted mb-10 max-w-xl">
        I'm an automotive engineer who builds fullstack products nights and weekends.
        Whether you need a working prototype, a production web app, or a proof of concept to pitch investors — let's talk.
      </p>

      <!-- What I Can Build -->
      <div class="grid gap-4 sm:grid-cols-2 mb-12">
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">Web Applications</p>
          <p class="text-sm text-text-muted">React, Next.js, Astro — from AI-powered platforms to data dashboards. Shipped 2 products with custom domains.</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">AI / Multi-Agent Systems</p>
          <p class="text-sm text-text-muted">LLM integration, multi-agent debate frameworks, RAG systems, intelligent tutoring. Real production experience.</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">Mobile Apps</p>
          <p class="text-sm text-text-muted">Android native with Kotlin. AI-powered memo apps, vocabulary builders, clipboard intelligence.</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">Browser Extensions</p>
          <p class="text-sm text-text-muted">Chrome Manifest V3. Built a habit-tracking extension with cross-tab sync and progressive lockdown mechanics.</p>
        </div>
      </div>

      <!-- Contact Methods -->
      <div class="space-y-4 mb-12">
        <h2 class="text-lg font-semibold">Reach Out</h2>
        <a
          href="mailto:skypeople41@gmail.com"
          class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-accent-dim flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium group-hover:text-accent transition-colors">Email</p>
            <p class="text-sm text-text-muted">skypeople41@gmail.com</p>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-accent ml-auto transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

        <a
          href="https://wa.me/919154369924"
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium group-hover:text-emerald-500 transition-colors">WhatsApp</p>
            <p class="text-sm text-text-muted">+91 91543 69924</p>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-emerald-500 ml-auto transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

        <div class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5">
          <div class="w-10 h-10 rounded-lg bg-yellow-500/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.125 0H1.875C.839 0 0 .84 0 1.875v20.25C0 23.161.84 24 1.875 24h20.25C23.161 24 24 23.16 24 22.125V1.875C24 .839 23.16 0 22.125 0zM12 18.75c-.621 0-1.125-.504-1.125-1.125v-.375c-2.344-.281-3.75-1.852-3.75-3.75h2.25c0 1.125.844 1.875 2.25 1.875 1.125 0 1.875-.469 1.875-1.125 0-.75-.469-1.031-2.063-1.406C9.75 12.375 8.25 11.625 8.25 9.75c0-1.594 1.125-2.906 3-3.281V6c0-.621.504-1.125 1.125-1.125S13.5 5.379 13.5 6v.469c1.875.375 3 1.688 3 3.281h-2.25c0-.937-.656-1.5-1.875-1.5-.937 0-1.5.469-1.5 1.031 0 .656.469.938 2.063 1.313 1.687.469 3.187 1.125 3.187 3.156 0 1.688-1.219 3.094-3.375 3.469v.406c0 .621-.504 1.125-1.125 1.125z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium">KakaoTalk</p>
            <p class="text-sm text-text-muted">ID: kcmsun</p>
          </div>
        </div>

        <a
          href="tel:+821075253511"
          class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-accent-dim flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium group-hover:text-accent transition-colors">Phone (Korea)</p>
            <p class="text-sm text-text-muted">+82 10 7525 3511</p>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-accent ml-auto transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

        <a
          href="https://www.youtube.com/@PeopleSky"
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 hover:border-red-500/40 hover:bg-surface-hover transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium group-hover:text-red-500 transition-colors">YouTube</p>
            <p class="text-sm text-text-muted">@PeopleSky — AI & Code</p>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-red-500 ml-auto transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>

        <a
          href="https://github.com/Jason198341"
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-accent-dim flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium group-hover:text-accent transition-colors">GitHub</p>
            <p class="text-sm text-text-muted">github.com/Jason198341</p>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-accent ml-auto transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>

      <!-- Board Link -->
      <a
        href="/board"
        class="group block rounded-xl border border-accent/20 bg-accent/5 p-6 hover:border-accent/40 transition-all mb-12"
      >
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold group-hover:text-accent transition-colors">Collaboration Board</h2>
            <p class="text-sm text-text-muted mt-1">Submit a project inquiry or browse past collaborations. All posts are password-protected.</p>
          </div>
          <svg class="w-5 h-5 text-accent shrink-0 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </div>
      </a>

      <!-- Process -->
      <div class="rounded-xl border border-border bg-surface p-6 sm:p-8">
        <h2 class="text-lg font-semibold mb-4">How I Work</h2>
        <div class="space-y-4 text-sm text-text-muted">
          <div class="flex gap-4">
            <span class="shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent flex items-center justify-center text-xs font-bold">1</span>
            <div><span class="text-text font-medium">Tell me the problem.</span> What are you trying to build? Who is it for? What does success look like?</div>
          </div>
          <div class="flex gap-4">
            <span class="shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent flex items-center justify-center text-xs font-bold">2</span>
            <div><span class="text-text font-medium">I build a working prototype.</span> Not wireframes or slide decks — actual running code you can click through and test.</div>
          </div>
          <div class="flex gap-4">
            <span class="shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent flex items-center justify-center text-xs font-bold">3</span>
            <div><span class="text-text font-medium">We iterate to production.</span> Feedback, polish, deploy. I ship to custom domains with real users.</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
