---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Let's Build Something</h1>
      <p class="text-text-muted mb-10 max-w-xl">
        I'm an automotive engineer who builds fullstack products nights and weekends.
        Whether you need a working prototype, a production web app, or a proof of concept to pitch investors — let's talk.
      </p>

      <!-- What I Can Build -->
      <div class="grid gap-4 sm:grid-cols-2 mb-12">
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">Web Applications</p>
          <p class="text-sm text-text-muted">React, Next.js, Astro — from AI-powered platforms to data dashboards. Shipped 2 products with custom domains.</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">AI / Multi-Agent Systems</p>
          <p class="text-sm text-text-muted">LLM integration, multi-agent debate frameworks, RAG systems, intelligent tutoring. Real production experience.</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">Mobile Apps</p>
          <p class="text-sm text-text-muted">Android native with Kotlin. AI-powered memo apps, vocabulary builders, clipboard intelligence.</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="font-medium mb-2">Browser Extensions</p>
          <p class="text-sm text-text-muted">Chrome Manifest V3. Built a habit-tracking extension with cross-tab sync and progressive lockdown mechanics.</p>
        </div>
      </div>

      <!-- Contact Methods -->
      <div class="space-y-4 mb-12">
        <h2 class="text-lg font-semibold">Reach Out</h2>
        <a
          href="mailto:skypeople41@gmail.com"
          class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-accent-dim flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium group-hover:text-accent transition-colors">Email</p>
            <p class="text-sm text-text-muted">skypeople41@gmail.com</p>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-accent ml-auto transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

        <a
          href="https://github.com/Jason198341"
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover transition-all"
        >
          <div class="w-10 h-10 rounded-lg bg-accent-dim flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </div>
          <div>
            <p class="font-medium group-hover:text-accent transition-colors">GitHub</p>
            <p class="text-sm text-text-muted">github.com/Jason198341</p>
          </div>
          <svg class="w-4 h-4 text-text-muted group-hover:text-accent ml-auto transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>

      <!-- Process -->
      <div class="rounded-xl border border-border bg-surface p-6 sm:p-8">
        <h2 class="text-lg font-semibold mb-4">How I Work</h2>
        <div class="space-y-4 text-sm text-text-muted">
          <div class="flex gap-4">
            <span class="shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent flex items-center justify-center text-xs font-bold">1</span>
            <div><span class="text-text font-medium">Tell me the problem.</span> What are you trying to build? Who is it for? What does success look like?</div>
          </div>
          <div class="flex gap-4">
            <span class="shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent flex items-center justify-center text-xs font-bold">2</span>
            <div><span class="text-text font-medium">I build a working prototype.</span> Not wireframes or slide decks — actual running code you can click through and test.</div>
          </div>
          <div class="flex gap-4">
            <span class="shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent flex items-center justify-center text-xs font-bold">3</span>
            <div><span class="text-text font-medium">We iterate to production.</span> Feedback, polish, deploy. I ship to custom domains with real users.</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
