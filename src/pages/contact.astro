---
import Base from '../layouts/Base.astro';

const KAKAO = 'https://invite.kakao.com/tc/EszOu7fY0i';

const guide = [
  { n: '1', icon: '🏪', t: '어떤 가게/일인가요?', d: '예) "성수동 작은 카페예요" · "세무사 사무실입니다" · "헬스장 운영해요"' },
  { n: '2', icon: '🎨', t: '어떤 느낌을 원하세요?', d: '예) "깔끔·고급" · 스타일 도감에서 2~3개 골라 섞어도 OK · 잘 모르면 느낌만 말씀하세요 — 3가지 시안으로 제안드립니다' },
  { n: '3', icon: '📝', t: '어떤 내용이 들어가나요?', d: '가게 소개 · 메뉴/가격 · 사진 몇 장 · 전화번호 · 영업시간 — 있는 만큼만' },
  { n: '4', icon: '📞', t: '연락처를 남겨주세요', d: '카카오톡이면 충분합니다. 전화/문자도 좋아요' },
];

const toolGuide = [
  '어떤 작업이 매일 반복돼서 귀찮은지 (예: 엑셀 정리, 메일 발송, 번역)',
  '지금은 그걸 어떻게 하고 계신지',
  '쓰시는 프로그램 (엑셀 / 아웃룩 / 한글 등)',
];
---

<Base title="무료 제작 문의 — jasonmoon.dev" description="홈페이지·업무 자동화 툴 무료 제작 문의. 카카오톡으로 편하게 연락하세요.">
  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">

      <div class="flex items-center gap-3 mb-6 font-mono text-[10px] tracking-[0.3em] uppercase">
        <span class="hud-pip hud-pip--amber"></span>
        <span class="text-accent">무료 제작 접수중</span>
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-bold text-text mb-4">편하게 문의하세요</h1>
      <p class="text-text-muted text-lg mb-10 max-w-xl leading-relaxed">
        홈페이지든, 업무를 편하게 해줄 윈도우 프로그램이든 — <span class="text-text font-semibold">무료로 만들어 드립니다.</span>
        완성 파일까지 그대로요. 카카오톡 한 줄이면 시작됩니다.
      </p>

      <!-- 큰 카톡 버튼 -->
      <a href={KAKAO} target="_blank" rel="noopener"
        class="flex items-center justify-center gap-3 w-full px-8 py-6 bg-accent text-black font-bold text-xl sm:text-2xl tracking-tight shadow-[0_4px_28px_rgba(255,176,0,0.45)] hover:bg-accent-hover hover:scale-[1.01] transition-all mb-4">
        💬 카카오톡 오픈채팅으로 문의하기
      </a>
      <p class="text-center text-text-faint text-sm mb-12">위 버튼을 누르면 바로 대화창이 열립니다. 아무 말이나 먼저 남기셔도 돼요.</p>

      <!-- 문의 가이드 (홈페이지) -->
      <div class="border-2 border-accent/40 bg-accent/5 p-6 sm:p-8 mb-8">
        <h2 class="font-display text-xl sm:text-2xl font-bold text-text mb-2">🌐 홈페이지 문의 — 딱 4가지만</h2>
        <p class="text-text-muted text-sm mb-6">어렵게 생각 마세요. 아래만 적어 보내주시면 됩니다. 말로 하셔도 됩니다.</p>
        <div class="grid sm:grid-cols-2 gap-4">
          {guide.map((s) => (
            <div class="bg-bg border border-border-strong p-5">
              <div class="flex items-center gap-3 mb-2">
                <span class="flex items-center justify-center w-10 h-10 rounded-full bg-accent text-black font-display font-bold text-xl shrink-0">{s.n}</span>
                <span class="text-2xl">{s.icon}</span>
              </div>
              <p class="font-bold text-text mb-1">{s.t}</p>
              <p class="text-text-muted text-sm leading-relaxed">{s.d}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 문의 가이드 (업무툴) -->
      <div class="border-2 border-border-strong bg-surface/40 p-6 sm:p-8 mb-12">
        <h2 class="font-display text-xl sm:text-2xl font-bold text-text mb-2">⚙️ 업무 자동화 툴 문의</h2>
        <p class="text-text-muted text-sm mb-5">반복되는 귀찮은 일, 프로그램으로 만들어 드립니다. 이렇게만 알려주세요.</p>
        <ul class="space-y-3">
          {toolGuide.map((t, i) => (
            <li class="flex items-start gap-3 text-text-muted">
              <span class="flex items-center justify-center w-7 h-7 rounded-full bg-accent/15 text-accent font-bold text-sm shrink-0">{i + 1}</span>
              <span class="pt-0.5">{t}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 연락 수단 -->
      <h2 class="font-mono text-[11px] tracking-[0.3em] uppercase text-accent mb-4">다른 연락 방법</h2>
      <div class="space-y-3 mb-12">
        <a href={KAKAO} target="_blank" rel="noopener"
          class="group flex items-center gap-4 border border-border-strong bg-surface p-5 hover:border-accent transition-all">
          <span class="w-11 h-11 rounded-lg bg-yellow-400/15 flex items-center justify-center text-2xl shrink-0">💬</span>
          <div><p class="font-bold text-text group-hover:text-accent transition-colors">카카오톡 오픈채팅</p><p class="text-sm text-text-muted">가장 빠릅니다 · 24시간 접수 · 개인 ID <b class="text-accent">kcmsun</b></p></div>
          <span class="ml-auto text-text-faint group-hover:text-accent transition-colors">→</span>
        </a>

        <a href="tel:+821075253511" class="group flex items-center gap-4 border border-border-strong bg-surface p-5 hover:border-accent transition-all">
          <span class="w-11 h-11 rounded-lg bg-accent-dim flex items-center justify-center text-xl shrink-0">📞</span>
          <div><p class="font-bold text-text group-hover:text-accent transition-colors">전화 / 문자</p><p class="text-sm text-text-muted">010-7525-3511 (한국)</p></div>
          <span class="ml-auto text-text-faint group-hover:text-accent transition-colors">→</span>
        </a>

        <a href="mailto:skypeople41@gmail.com" class="group flex items-center gap-4 border border-border-strong bg-surface p-5 hover:border-accent transition-all">
          <span class="w-11 h-11 rounded-lg bg-accent-dim flex items-center justify-center text-xl shrink-0">✉️</span>
          <div><p class="font-bold text-text group-hover:text-accent transition-colors">이메일</p><p class="text-sm text-text-muted">skypeople41@gmail.com</p></div>
          <span class="ml-auto text-text-faint group-hover:text-accent transition-colors">→</span>
        </a>

        <a href="https://wa.me/919154369924" target="_blank" rel="noopener" class="group flex items-center gap-4 border border-border-strong bg-surface p-5 hover:border-accent transition-all">
          <span class="w-11 h-11 rounded-lg bg-emerald-500/10 flex items-center justify-center text-xl shrink-0">🟢</span>
          <div><p class="font-bold text-text group-hover:text-accent transition-colors">WhatsApp</p><p class="text-sm text-text-muted">+91 91543 69924 (해외/영어)</p></div>
          <span class="ml-auto text-text-faint group-hover:text-accent transition-colors">→</span>
        </a>
      </div>

      <!-- 무료 범위 안내 -->
      <div class="border border-border bg-surface/30 p-6 sm:p-8">
        <h2 class="font-display text-lg font-bold text-text mb-4">💡 무엇이 무료인가요?</h2>
        <ul class="space-y-2.5 text-sm text-text-muted mb-4">
          <li class="flex gap-3"><span class="text-accent">✓</span> 홈페이지/프로그램 <span class="text-text">제작 + 완성 파일 전달</span> — 무료</li>
          <li class="flex gap-3"><span class="text-accent">✓</span> 직접 인터넷에 올리는 방법(배포) <span class="text-text">상세 매뉴얼</span> — 무료 제공</li>
          <li class="flex gap-3"><span class="text-text-faint">·</span> 도메인 구매·연결, 서버 운영 <span class="text-text">대행</span>은 요청 시 별도 협의 (가능 여부 확인)</li>
        </ul>
        <a href="/guide" class="font-mono text-xs text-accent tracking-wider hover:underline">→ 제작·배포·도메인 안내 자세히 보기</a>
      </div>

    </div>
  </section>
</Base>
