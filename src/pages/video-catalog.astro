---
import Base from '../layouts/Base.astro';
import { catalog, getTotalCount } from '../data/video-catalog';
---

<Base title="Video Creation Catalog — 60 Templates with Claude Code Prompts" description="60 copy-paste ready video templates for Claude Code. From portfolio trailers to AI-generated shorts, each with exact prompts, required skills, and tech stack.">

  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden pt-24 pb-12">
    <div class="absolute inset-0 pointer-events-none opacity-[0.025]"
      style="background-image: linear-gradient(rgba(129,140,248,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(129,140,248,0.3) 1px, transparent 1px); background-size: 48px 48px;"
    ></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(99,102,241,0.06) 0%, transparent 70%);"
    ></div>

    <div class="relative z-10 text-center max-w-3xl mx-auto px-6">
      <a href="/templates" class="inline-flex items-center gap-1.5 text-sm text-text-muted hover:text-accent transition-colors mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Back to Live Templates
      </a>
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-medium mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        {getTotalCount()} Copy-Paste Prompts
      </div>
      <h1 class="text-4xl sm:text-5xl font-display font-extrabold text-text leading-tight mb-4" style="letter-spacing: -0.03em;">
        Video Creation Catalog
      </h1>
      <p class="text-lg text-text-muted max-w-xl mx-auto mb-8 leading-relaxed">
        Every video type you can make with Claude Code.<br/>
        Copy the prompt. Install the skill. Hit enter.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-text-muted">
        <span><strong class="text-text">{getTotalCount()}</strong> Templates</span>
        <span class="w-1 h-1 rounded-full bg-border"></span>
        <span><strong class="text-text">{catalog.length}</strong> Categories</span>
        <span class="w-1 h-1 rounded-full bg-border"></span>
        <span><strong class="text-text">Copy & Paste</strong> Ready</span>
      </div>
    </div>
  </section>

  <!-- Category Navigation -->
  <nav class="sticky top-16 z-30 bg-bg/80 backdrop-blur-xl border-b border-border/50">
    <div class="max-w-6xl mx-auto px-6 py-3 overflow-x-auto">
      <div class="flex gap-2 min-w-max">
        {catalog.map((cat) => (
          <a
            href={`#${cat.id}`}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium border transition-all hover:brightness-125"
            style={`color: ${cat.color}; border-color: ${cat.color}30; background: ${cat.color}08;`}
          >
            <span>{cat.icon}</span>
            <span class="hidden sm:inline">{cat.label}</span>
            <span class="sm:hidden">{cat.labelKo}</span>
            <span class="opacity-50">({cat.templates.length})</span>
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Catalog Content -->
  <section class="max-w-6xl mx-auto px-6 pt-8 pb-24">

    {catalog.map((cat, catIdx) => (
      <div id={cat.id} class="mb-16 scroll-mt-32 reveal">
        <!-- Category Header -->
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">{cat.icon}</span>
          <div>
            <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-text" style="letter-spacing: -0.02em;">
              {cat.label}
            </h2>
            <p class="text-sm text-text-muted">{cat.labelKo}</p>
          </div>
          <div
            class="ml-auto px-3 py-1 rounded-full text-xs font-bold"
            style={`color: ${cat.color}; background: ${cat.color}15; border: 1px solid ${cat.color}25;`}
          >
            {cat.templates.length} templates
          </div>
        </div>
        <p class="text-text-muted text-sm mb-6 max-w-2xl">{cat.description}</p>

        <!-- Template Cards -->
        <div class="space-y-4">
          {cat.templates.map((t) => (
            <article class="group rounded-xl border border-border/60 bg-surface/40 hover:bg-surface/60 hover:border-border transition-all overflow-hidden">
              <!-- Card Header -->
              <div class="px-5 py-4">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <span
                      class="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold"
                      style={`color: ${cat.color}; background: ${cat.color}15; border: 1px solid ${cat.color}25;`}
                    >
                      {t.id}
                    </span>
                    <div class="min-w-0">
                      <h3 class="text-base font-bold text-text truncate">{t.title}</h3>
                      <p class="text-xs text-text-muted truncate">{t.titleKo}</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-white/5 border border-white/10 text-text-muted">
                      {t.format}
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium text-text-muted bg-white/5 border border-white/10">
                      {t.duration}
                    </span>
                  </div>
                </div>

                <!-- Skills -->
                <div class="flex flex-wrap items-center gap-1.5 mb-2">
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-text-muted mr-1">Skills:</span>
                  {t.skills.map((skill) => (
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium text-accent bg-accent/10 border border-accent/20">
                      {skill}
                    </span>
                  ))}
                </div>

                <!-- Stack -->
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-text-muted mr-1">Stack:</span>
                  {t.stack.map((tech) => (
                    <span class="px-2 py-0.5 rounded text-[11px] font-medium text-text-muted bg-white/5 border border-white/8">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Prompt Block -->
              <div class="relative border-t border-border/40 bg-black/20">
                <div class="absolute top-2 right-2 z-10">
                  <button
                    class="copy-btn flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-medium text-text-muted bg-white/5 border border-white/10 hover:bg-accent/20 hover:text-accent hover:border-accent/30 transition-all cursor-pointer"
                    data-prompt={t.prompt}
                  >
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                    <span class="copy-label">Copy</span>
                  </button>
                </div>
                <pre class="px-5 py-4 pr-20 text-[12px] leading-relaxed font-mono text-text-muted overflow-x-auto whitespace-pre-wrap break-words"><code>{t.prompt}</code></pre>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}

    <!-- Quick Start Guide -->
    <div class="mt-8 reveal">
      <h2 class="text-2xl font-display font-bold text-text text-center mb-8">Quick Start</h2>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div class="text-center p-5 rounded-xl border border-border bg-surface/30">
          <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent font-display font-bold">1</div>
          <h3 class="font-bold text-text text-sm mb-1">Install Skill</h3>
          <p class="text-xs text-text-muted">Install the required Claude Code skills listed in each template.</p>
        </div>
        <div class="text-center p-5 rounded-xl border border-border bg-surface/30">
          <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent font-display font-bold">2</div>
          <h3 class="font-bold text-text text-sm mb-1">Copy Prompt</h3>
          <p class="text-xs text-text-muted">Click the Copy button on any template to grab the full prompt.</p>
        </div>
        <div class="text-center p-5 rounded-xl border border-border bg-surface/30">
          <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent font-display font-bold">3</div>
          <h3 class="font-bold text-text text-sm mb-1">Paste in Claude Code</h3>
          <p class="text-xs text-text-muted">Paste into your terminal. Claude Code handles the rest.</p>
        </div>
        <div class="text-center p-5 rounded-xl border border-border bg-surface/30">
          <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent font-display font-bold">4</div>
          <h3 class="font-bold text-text text-sm mb-1">Get Your Video</h3>
          <p class="text-xs text-text-muted">Rendered MP4 ready for YouTube, Shorts, or Instagram Reels.</p>
        </div>
      </div>
    </div>

    <!-- Skill Install Reference -->
    <div class="mt-12 rounded-xl border border-accent/20 bg-surface/40 p-6 reveal">
      <h3 class="text-lg font-display font-bold text-text mb-4">Skill Installation</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <span class="shrink-0 px-2 py-0.5 rounded text-[11px] font-mono font-medium text-accent bg-accent/10 border border-accent/20 mt-0.5">remotion-master</span>
          <div>
            <p class="text-sm text-text-muted">All-in-one video production skill. Covers Remotion patterns, TTS integration, rendering, and deployment pipelines.</p>
            <code class="text-xs text-text-muted/60 font-mono">~/.claude/skills/remotion-master/SKILL.md</code>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="shrink-0 px-2 py-0.5 rounded text-[11px] font-mono font-medium text-accent bg-accent/10 border border-accent/20 mt-0.5">remotion-best-practices</span>
          <div>
            <p class="text-sm text-text-muted">Official Remotion rules. 30+ rule files covering animations, audio, 3D, charts, fonts, transitions, and more.</p>
            <code class="text-xs text-text-muted/60 font-mono">~/.claude/skills/remotion-best-practices/SKILL.md</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Tech Stack -->
    <div class="mt-8 text-center">
      <p class="text-sm text-text-muted">
        Powered by
        <span class="text-text font-medium"> Claude Code</span> +
        <span class="text-text font-medium"> Remotion 4</span> +
        <span class="text-text font-medium"> Gemini TTS</span> +
        <span class="text-text font-medium"> ffmpeg</span>
      </p>
    </div>
  </section>

  <!-- Copy to clipboard script -->
  <script>
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.copy-btn') as HTMLButtonElement | null;
      if (!btn) return;

      const prompt = btn.dataset.prompt;
      if (!prompt) return;

      navigator.clipboard.writeText(prompt).then(() => {
        const label = btn.querySelector('.copy-label');
        if (label) {
          label.textContent = 'Copied!';
          btn.classList.add('!text-accent', '!border-accent/40');
          setTimeout(() => {
            label.textContent = 'Copy';
            btn.classList.remove('!text-accent', '!border-accent/40');
          }, 2000);
        }
      });
    });
  </script>
</Base>
