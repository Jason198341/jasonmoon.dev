<!-- CHATBOT FAB -->
<div class="chat-fab">
  <div class="chat-mini-note">🔧 <b>AI 챗봇</b> — 손님 질문에 24시간 자동 응대 (영업시간·메뉴·예약) <b>· 25만원</b></div>
  <div class="chat-panel" id="chatPanel">
    <div class="chat-top">🤖 브레드봇 · 자동 응대</div>
    <div class="chat-msgs" id="chatMsgs">
      <div class="bubble bot">안녕하세요! 브레드랩입니다 🥐 무엇을 도와드릴까요?</div>
    </div>
    <div class="chat-quick">
      <button onclick="chatAsk('영업시간')">영업시간?</button>
      <button onclick="chatAsk('주차')">주차되나요?</button>
      <button onclick="chatAsk('예약')">예약하고싶어요</button>
    </div>
  </div>
  <button class="chat-btn" onclick="toggleChat()" aria-label="챗봇 열기">💬</button>
</div>

<script>
/* ===== 1. LANGUAGE TOGGLE ===== */
const I18N={
  brand:{ko:"브레드랩 베이커리",en:"BREADLAB Bakery"},
  nav_menu:{ko:"메뉴",en:"Menu"},
  nav_reserve:{ko:"예약",en:"Booking"},
  nav_news:{ko:"소식",en:"News"},
  nav_map:{ko:"오시는 길",en:"Location"},
  hero_h1:{ko:"매일 새벽 굽는<br><span class='accent'>진짜 발효빵</span>, 성수동에서.",en:"Real <span class='accent'>slow-fermented bread</span>,<br>baked fresh every dawn."},
  hero_lede:{ko:"48시간 저온 숙성 도우와 프랑스산 버터. 작은 공방에서 손으로 빚어 매일 한정 수량만 구워냅니다.",en:"48-hour cold-fermented dough and French butter. Handcrafted in a small studio, limited batches daily."},
  hero_cta1:{ko:"테이블 예약하기",en:"Book a table"},
  hero_cta2:{ko:"메뉴 둘러보기",en:"See the menu"},
  hero_open:{ko:"🟢 영업 중 · ~21:00",en:"🟢 Open now · until 21:00"},
  hero_tag:{ko:"⭐ 4.9 · 성수동 빵집 1위",en:"⭐ 4.9 · #1 in Seongsu"}
};
function setLang(lang){
  document.querySelectorAll('.lang-toggle button').forEach(b=>b.classList.toggle('on',b.dataset.lang===lang));
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k=el.getAttribute('data-i18n');
    if(I18N[k]&&I18N[k][lang]!==undefined){
      const v=I18N[k][lang];
      if(k==='brand'){el.innerHTML=v+"<small>BREADLAB · SEONGSU</small>";}
      else el.innerHTML=v;
    }
  });
  document.documentElement.lang=lang;
}

/* ===== 2. GALLERY + LIGHTBOX ===== */
const BREADS=[
  {e:"🥐",bg:"linear-gradient(135deg,#f3c879,#d99b53)",t:"버터 크루아상",d:"24겹 결결이 살아있는 프랑스 정통 크루아상."},
  {e:"🍞",bg:"linear-gradient(135deg,#e8c99a,#c79a64)",t:"소금빵",d:"겉은 바삭, 속은 촉촉. 프랑스산 버터로 구운 시그니처."},
  {e:"🥖",bg:"linear-gradient(135deg,#e2b878,#bd8a4e)",t:"바게트",d:"48시간 저온 숙성. 겉바속쫄의 정석."},
  {e:"🥯",bg:"linear-gradient(135deg,#ecd2a0,#cda063)",t:"플레인 베이글",d:"쫀득한 식감, 크림치즈와 완벽 페어링."},
  {e:"🧁",bg:"linear-gradient(135deg,#f0b6a0,#d98a72)",t:"무화과 캄파뉴",d:"여름 한정. 생무화과를 통째로 넣은 호밀빵."},
  {e:"🍰",bg:"linear-gradient(135deg,#e6a7b8,#c97f96)",t:"바스크 치즈케이크",d:"겉은 까맣게, 속은 부드럽게 흐르는."},
  {e:"🥧",bg:"linear-gradient(135deg,#e7c382,#c4914f)",t:"에그타르트",d:"바삭한 페이스트리 위 부드러운 커스터드."},
  {e:"🍪",bg:"linear-gradient(135deg,#dcb985,#b8884e)",t:"청크 쿠키",d:"벨기에 다크초콜릿이 듬뿍."},
  {e:"🥨",bg:"linear-gradient(135deg,#e0b06f,#b67f42)",t:"프레첼",d:"겉은 짭짤, 속은 부드러운 독일식."}
];
const galGrid=document.getElementById('galGrid');
BREADS.forEach((b,i)=>{
  const d=document.createElement('div');
  d.className='gal-item';d.style.background=b.bg;
  d.innerHTML=b.e+"<span class='cap'>"+b.t+"</span>";
  d.onclick=()=>openLightbox(i);
  galGrid.appendChild(d);
});
function openLightbox(i){
  const b=BREADS[i];
  document.getElementById('lbEmoji').textContent=b.e;
  document.getElementById('lbTitle').textContent=b.t;
  document.getElementById('lbDesc').textContent=b.d;
  document.getElementById('lightbox').classList.add('show');
}
function closeLightbox(ev,force){
  if(force||ev.target.id==='lightbox'){document.getElementById('lightbox').classList.remove('show');}
}

/* ===== 3. RESERVE CALENDAR ===== */
const calGrid=document.getElementById('calGrid');
['일','월','화','수','목','금','토'].forEach(d=>{
  const c=document.createElement('div');c.className='dow';c.textContent=d;calGrid.appendChild(c);
});
// July 2026 starts on Wednesday (index 3)
const startOffset=3,daysInMonth=31;
let selDate=null,selTime=null;
for(let i=0;i<startOffset;i++){const c=document.createElement('div');c.className='cal-day muted';calGrid.appendChild(c);}
for(let d=1;d<=daysInMonth;d++){
  const c=document.createElement('div');c.className='cal-day';c.textContent=d;
  if(d<27){c.classList.add('muted');}
  else{c.onclick=()=>{document.querySelectorAll('.cal-day').forEach(x=>x.classList.remove('sel'));c.classList.add('sel');selDate=d;updateReserve();};}
  calGrid.appendChild(c);
}
const timeRow=document.getElementById('timeRow');
['11:00','13:00','15:00','17:00','19:00'].forEach(t=>{
  const c=document.createElement('button');c.className='time-chip';c.textContent=t;
  c.onclick=()=>{document.querySelectorAll('.time-chip').forEach(x=>x.classList.remove('sel'));c.classList.add('sel');selTime=t;updateReserve();};
  timeRow.appendChild(c);
});
function updateReserve(){
  const s=document.getElementById('reserveSummary');
  if(selDate&&selTime){s.innerHTML="✅ <b>7월 "+selDate+"일 "+selTime+"</b> 예약 준비 완료! (데모) 실제로는 여기서 예약이 확정됩니다.";}
  else if(selDate){s.innerHTML="7월 <b>"+selDate+"일</b> 선택됨 · 시간을 골라주세요.";}
  else{s.textContent="날짜와 시간을 선택해 주세요.";}
}

/* ===== 4. FORM ===== */
function submitForm(){document.getElementById('formToast').classList.add('show');}

/* ===== 8. INSTAGRAM ===== */
const INSTA=[
  ["🥐","linear-gradient(135deg,#f3c879,#d99b53)"],["🍰","linear-gradient(135deg,#e6a7b8,#c97f96)"],
  ["☕","linear-gradient(135deg,#c79a6a,#8a6440)"],["🍞","linear-gradient(135deg,#e8c99a,#c79a64)"],
  ["🥖","linear-gradient(135deg,#e2b878,#bd8a4e)"],["🧁","linear-gradient(135deg,#f0b6a0,#d98a72)"],
  ["🥯","linear-gradient(135deg,#ecd2a0,#cda063)"],["🍪","linear-gradient(135deg,#dcb985,#b8884e)"]
];
const ig=document.getElementById('instaGrid');
INSTA.forEach(([e,bg])=>{
  const d=document.createElement('div');d.className='insta-item';d.style.background=bg;
  const likes=(Math.floor(Math.random()*800)+120);
  d.innerHTML=e+"<div class='lk'>❤️ "+likes+"</div>";
  d.onclick=()=>alert('인스타그램 게시물로 이동합니다 (데모)');
  ig.appendChild(d);
});

/* ===== 9. CART ===== */
const CART=[
  {e:"🥐",n:"버터 크루아상",d:"개당",p:4500,q:2},
  {e:"🍞",n:"소금빵",d:"개당",p:3800,q:3},
  {e:"🍰",n:"바스크 치즈케이크",d:"1조각",p:6500,q:1}
];
const cartEl=document.getElementById('cart');
function renderCart(){
  cartEl.innerHTML='';
  CART.forEach((it,i)=>{
    const row=document.createElement('div');row.className='cart-row';
    row.innerHTML="<div class='emoji'>"+it.e+"</div>"+
      "<div class='nm'><b>"+it.n+"</b><small>"+it.d+" "+it.p.toLocaleString()+"원</small></div>"+
      "<div class='qty'><button>−</button><span>"+it.q+"</span><button>+</button></div>"+
      "<div class='pr'>"+(it.p*it.q).toLocaleString()+"원</div>";
    const [minus,plus]=row.querySelectorAll('.qty button');
    minus.onclick=()=>{if(it.q>0){it.q--;renderCart();}};
    plus.onclick=()=>{it.q++;renderCart();};
    cartEl.appendChild(row);
  });
  const total=CART.reduce((s,it)=>s+it.p*it.q,0);
  document.getElementById('cartTotal').textContent=total.toLocaleString()+"원";
}
renderCart();

/* ===== CHATBOT ===== */
function toggleChat(){document.getElementById('chatPanel').classList.toggle('show');}
const CHAT_A={
  "영업시간":"평일·주말 10:00~21:00 영업합니다. 매주 월요일은 정기휴무예요 🗓️",
  "주차":"네! 건물 뒤편에 전용 주차 4면이 있고 2시간 무료입니다 🅿️",
  "예약":"홈페이지 ‘테이블 예약’에서 날짜·시간을 고르시면 바로 예약돼요. 도와드릴까요? 📅"
};
function chatAsk(key){
  const box=document.getElementById('chatMsgs');
  const me=document.createElement('div');me.className='bubble me';me.textContent=key;box.appendChild(me);
  setTimeout(()=>{
    const bot=document.createElement('div');bot.className='bubble bot';bot.textContent=CHAT_A[key]||"죄송해요, 다시 한 번 말씀해 주시겠어요?";
    box.appendChild(bot);box.scrollTop=box.scrollHeight;
  },450);
  box.scrollTop=box.scrollHeight;
}
</script>
</body>
</html>
