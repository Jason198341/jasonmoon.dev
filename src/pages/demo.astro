  <div class="wrap"><b>브레드랩 베이커리 카페</b> 는 데모용 가상 업체입니다 · 실제 매장이 아닙니다 · made by jasonmoon.dev</div>
</footer>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" onclick="closeLightbox(event)">
  <div class="lb-card">
    <div class="lb-emoji" id="lbEmoji">🍞</div>
