<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>브레드랩 베이커리 카페 · 기능 종합 풀데모</title>
<meta name="description" content="9가지 웹기능을 한 페이지에서 — 가상 베이커리 카페로 보는 기능 풀데모" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
<style>
:root{
  --cream:#faf4ea;
  --cream-2:#f3e8d6;
  --paper:#fffdf8;
  --brown:#5a4634;
  --brown-2:#7a6450;
  --brown-soft:#9c8569;
  --sage:#8a9a7b;
  --sage-deep:#6f8060;
  --sage-soft:#dfe6d6;
  --amber:#e0982f;
  --amber-line:#c97f1a;
  --ink:#3a2e22;
  --line:#e7d9c4;
  --shadow:0 18px 40px -22px rgba(90,70,52,0.45);
  --serif:"Gowun Batang",ui-serif,Georgia,serif;
  --sans:"Noto Sans KR",ui-sans-serif,system-ui,sans-serif;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  font-family:var(--sans);
  color:var(--ink);
  background:var(--cream);
  -webkit-font-smoothing:antialiased;
  line-height:1.6;
}
img{max-width:100%;}
a{color:inherit;}
h1,h2,h3{font-family:var(--serif);line-height:1.2;margin:0;}
.wrap{max-width:1140px;margin:0 auto;padding:0 22px;}
.section{padding:84px 0;border-bottom:1px solid var(--line);}
.section:nth-child(even){background:var(--paper);}
.eyebrow{
  font-size:12px;letter-spacing:0.22em;text-transform:uppercase;
  color:var(--sage-deep);font-weight:700;margin-bottom:14px;
}
.sec-title{font-size:clamp(26px,4vw,38px);color:var(--brown);margin-bottom:10px;}
.sec-sub{color:var(--brown-2);font-size:15px;max-width:560px;}

/* layout split: demo + feature box */
.split{display:grid;grid-template-columns:1.55fr 1fr;gap:36px;align-items:start;margin-top:34px;}
@media(max-width:860px){.split{grid-template-columns:1fr;gap:26px;}}

/* feature explainer box */
.fbox{
  position:relative;
  background:linear-gradient(180deg,#fff8ec,#fdf0d8);
  border:2px solid var(--amber);
  border-radius:16px;
  padding:24px 22px 22px;
  box-shadow:0 14px 30px -20px rgba(201,127,26,0.6);
}
.fbox::before{
  content:"기능 설명";
  position:absolute;top:-12px;left:18px;
  background:var(--amber);color:#3a2410;
  font-size:11px;font-weight:900;letter-spacing:0.12em;
  padding:3px 10px;border-radius:20px;
}
.fbox .flabel{
  font-family:var(--serif);font-weight:700;font-size:19px;color:#8a5a12;
  margin:6px 0 10px;display:flex;align-items:center;gap:8px;
}
.fbox p{margin:0 0 12px;font-size:14px;color:#6a4d22;}
.fbox .good{
  background:rgba(255,255,255,0.65);border:1px dashed var(--amber-line);
  border-radius:10px;padding:9px 12px;font-size:13px;color:#7a5a1e;margin-bottom:14px;
}
.fbox .good b{color:#8a5a12;}
.fbox .price{
  display:inline-flex;align-items:baseline;gap:6px;
  background:#3a2e22;color:#ffe9c7;border-radius:10px;
  padding:8px 14px;font-weight:800;font-size:15px;
}
.fbox .price small{font-size:11px;font-weight:500;color:#cbb48f;}

/* demo card shell */
.demo{
  background:var(--paper);border:1px solid var(--line);border-radius:18px;
  box-shadow:var(--shadow);overflow:hidden;
}
.demo-bar{
  display:flex;align-items:center;gap:7px;
  padding:11px 16px;background:var(--cream-2);border-bottom:1px solid var(--line);
}
.demo-bar .dot{width:11px;height:11px;border-radius:50%;background:#cdb48f;}
.demo-bar .dot:nth-child(1){background:#e2a07c;}
.demo-bar .dot:nth-child(2){background:#e3c878;}
.demo-bar .dot:nth-child(3){background:#a7bd8e;}
.demo-bar .url{
  margin-left:10px;font-size:11px;color:var(--brown-soft);
  font-family:ui-monospace,monospace;letter-spacing:0.02em;
}
.demo-body{padding:24px;}

/* buttons */
.btn{
  font-family:var(--sans);font-weight:700;cursor:pointer;border:none;
  border-radius:999px;padding:12px 22px;font-size:14px;
  transition:transform .15s ease,box-shadow .15s ease,background .2s ease;
}
.btn-primary{background:var(--brown);color:#fdf2e0;box-shadow:0 10px 20px -12px rgba(90,70,52,0.8);}
.btn-primary:hover{transform:translateY(-2px);background:#6b5440;}
.btn-sage{background:var(--sage-deep);color:#f3f7ee;}
.btn-sage:hover{transform:translateY(-2px);background:#7c8f6b;}
.btn-ghost{background:transparent;border:1.5px solid var(--brown-soft);color:var(--brown);}
.btn-ghost:hover{background:var(--cream-2);}

/* ===== HERO ===== */
.hero{
  position:relative;overflow:hidden;
  background:
    radial-gradient(900px 420px at 82% -10%,rgba(224,152,47,0.18),transparent 60%),
    radial-gradient(700px 500px at 8% 110%,rgba(138,154,123,0.22),transparent 60%),
    linear-gradient(180deg,#fbf5ec,#f3e8d6);
  border-bottom:1px solid var(--line);
  padding:72px 0 80px;
}
.hero-nav{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:54px;flex-wrap:wrap;gap:14px;
}
.brand{display:flex;align-items:center;gap:12px;}
.brand .logo{
  width:46px;height:46px;border-radius:14px;display:grid;place-items:center;font-size:24px;
  background:var(--brown);box-shadow:0 8px 18px -10px rgba(90,70,52,0.9);
}
.brand .bn{font-family:var(--serif);font-weight:700;font-size:20px;color:var(--brown);line-height:1.1;}
.brand .bn small{display:block;font-family:var(--sans);font-size:11px;letter-spacing:0.18em;color:var(--sage-deep);font-weight:700;}
.hero-menu{display:flex;gap:26px;font-size:14px;color:var(--brown-2);font-weight:500;}
.hero-menu a{text-decoration:none;}
.hero-menu a:hover{color:var(--amber-line);}
@media(max-width:720px){.hero-menu{display:none;}}
.lang-toggle{display:inline-flex;background:#fff;border:1px solid var(--line);border-radius:999px;padding:3px;}
.lang-toggle button{
  border:none;background:transparent;cursor:pointer;border-radius:999px;
  padding:7px 14px;font-size:12px;font-weight:700;color:var(--brown-soft);font-family:var(--sans);
}
.lang-toggle button.on{background:var(--brown);color:#fdf2e0;}
.hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:40px;align-items:center;}
@media(max-width:860px){.hero-grid{grid-template-columns:1fr;}}
.hero h1{font-size:clamp(36px,6vw,62px);color:var(--brown);margin-bottom:18px;}
.hero h1 .accent{color:var(--amber-line);}
.hero .lede{font-size:17px;color:var(--brown-2);max-width:480px;margin-bottom:26px;}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap;}
.hero-visual{
  position:relative;aspect-ratio:4/3;border-radius:24px;overflow:hidden;
  background:linear-gradient(140deg,#e9c98a,#d99b53 60%,#b9743a);
  box-shadow:0 30px 60px -30px rgba(120,80,40,0.7);
  display:grid;place-items:center;
}
.hero-visual .big{font-size:120px;filter:drop-shadow(0 10px 14px rgba(80,40,10,0.35));}
.hero-visual .tag{
  position:absolute;bottom:16px;left:16px;background:rgba(255,253,248,0.92);
  border-radius:12px;padding:10px 14px;font-size:12px;color:var(--brown);font-weight:700;
  box-shadow:0 8px 18px -10px rgba(0,0,0,0.4);
}
.hero-visual .float{
  position:absolute;top:16px;right:16px;background:rgba(58,46,34,0.85);color:#ffe9c7;
  border-radius:12px;padding:8px 13px;font-size:12px;font-weight:700;
}

/* ===== GALLERY ===== */
.gal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
@media(max-width:520px){.gal-grid{grid-template-columns:repeat(2,1fr);}}
.gal-item{
  aspect-ratio:1;border-radius:14px;cursor:pointer;position:relative;overflow:hidden;
  display:grid;place-items:center;font-size:46px;border:1px solid rgba(255,255,255,0.4);
  transition:transform .2s ease,box-shadow .2s ease;
}
.gal-item:hover{transform:scale(1.04);box-shadow:0 16px 30px -16px rgba(90,70,52,0.6);z-index:2;}
.gal-item span.cap{
  position:absolute;bottom:0;left:0;right:0;font-size:11px;font-family:var(--sans);
  color:#fff;font-weight:700;background:rgba(58,46,34,0.55);padding:5px;text-align:center;
  opacity:0;transition:opacity .2s ease;
}
.gal-item:hover span.cap{opacity:1;}
.lightbox{
  position:fixed;inset:0;z-index:10000;display:none;place-items:center;
  background:rgba(40,30,20,0.82);backdrop-filter:blur(4px);padding:24px;
}
.lightbox.show{display:grid;}
.lightbox .lb-card{
  background:var(--paper);border-radius:20px;padding:30px;text-align:center;max-width:420px;width:100%;
  box-shadow:0 30px 60px -20px rgba(0,0,0,0.6);
}
.lightbox .lb-emoji{font-size:120px;line-height:1;margin-bottom:14px;}
.lightbox h3{color:var(--brown);font-size:24px;margin-bottom:6px;}
.lightbox p{color:var(--brown-2);font-size:14px;margin:0 0 18px;}
.lightbox .lb-close{cursor:pointer;}

/* ===== RESERVE ===== */
.cal{background:var(--cream);border:1px solid var(--line);border-radius:14px;padding:16px;}
.cal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-weight:700;color:var(--brown);}
.cal-head button{border:none;background:#fff;border-radius:8px;width:30px;height:30px;cursor:pointer;color:var(--brown);font-size:16px;}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
.cal-grid .dow{text-align:center;font-size:11px;color:var(--brown-soft);font-weight:700;padding:4px 0;}
.cal-day{
  aspect-ratio:1;display:grid;place-items:center;border-radius:9px;font-size:13px;cursor:pointer;
  background:#fff;color:var(--ink);border:1px solid transparent;transition:.15s;
}
.cal-day:hover{border-color:var(--sage);}
.cal-day.muted{color:#cdbfa9;cursor:default;background:transparent;}
.cal-day.sel{background:var(--sage-deep);color:#fff;font-weight:700;}
.time-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
.time-chip{
  border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 15px;font-size:13px;cursor:pointer;
  color:var(--brown);transition:.15s;font-family:var(--sans);
}
.time-chip:hover{border-color:var(--sage);}
.time-chip.sel{background:var(--sage-deep);color:#fff;border-color:var(--sage-deep);font-weight:700;}
.reserve-summary{margin-top:18px;font-size:14px;color:var(--brown-2);background:var(--sage-soft);border-radius:12px;padding:12px 14px;}
.reserve-summary b{color:var(--sage-deep);}

/* ===== FORM ===== */
.field{margin-bottom:14px;}
.field label{display:block;font-size:13px;font-weight:700;color:var(--brown);margin-bottom:6px;}
.field input,.field textarea,.field select{
  width:100%;border:1px solid var(--line);border-radius:11px;padding:12px 14px;
  font-family:var(--sans);font-size:14px;background:#fff;color:var(--ink);
}
.field input:focus,.field textarea:focus,.field select:focus{outline:none;border-color:var(--sage);box-shadow:0 0 0 3px rgba(138,154,123,0.18);}
.form-note{font-size:12px;color:var(--brown-soft);margin-top:6px;}
.toast{
  margin-top:14px;background:var(--sage-soft);border:1px solid var(--sage);border-radius:12px;
  padding:12px 14px;font-size:13px;color:var(--sage-deep);display:none;
}
.toast.show{display:block;}

/* ===== MEMBER ===== */
.member-card{
  background:linear-gradient(135deg,#5a4634,#7a6450);color:#fdf2e0;border-radius:18px;
  padding:22px;position:relative;overflow:hidden;box-shadow:var(--shadow);
}
.member-card::after{content:"🥐";position:absolute;right:-10px;bottom:-18px;font-size:110px;opacity:0.15;}
.member-card .tier{font-size:12px;letter-spacing:0.2em;color:#e9c98a;font-weight:700;}
.member-card .name{font-family:var(--serif);font-size:24px;margin:6px 0 2px;}
.member-card .pts{font-size:13px;color:#e6d3b6;}
.member-card .bar{height:8px;border-radius:99px;background:rgba(255,255,255,0.2);margin:14px 0 8px;overflow:hidden;}
.member-card .bar i{display:block;height:100%;width:72%;background:var(--amber);}
.member-card .next{font-size:12px;color:#e6d3b6;}
.member-actions{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;}
.tier-list{margin-top:18px;display:grid;gap:8px;}
.tier-row{display:flex;justify-content:space-between;align-items:center;background:var(--cream);border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:13px;}
.tier-row .b{font-weight:700;color:var(--brown);}
.tier-row.cur{border-color:var(--amber);background:#fff8ec;}

/* ===== BOARD ===== */
.board{border:1px solid var(--line);border-radius:14px;overflow:hidden;}
.board-row{display:flex;align-items:center;gap:14px;padding:14px 16px;border-bottom:1px solid var(--line);background:#fff;cursor:pointer;transition:.15s;}
.board-row:last-child{border-bottom:none;}
.board-row:hover{background:var(--cream);}
.board-row .tag{font-size:11px;font-weight:700;padding:3px 9px;border-radius:99px;white-space:nowrap;}
.tag-notice{background:#fdebcf;color:#b5781a;}
.tag-event{background:var(--sage-soft);color:var(--sage-deep);}
.tag-news{background:#e8ddf0;color:#7a5a9a;}
.board-row .t{flex:1;font-size:14px;color:var(--brown);font-weight:500;}
.board-row .d{font-size:12px;color:var(--brown-soft);white-space:nowrap;}
.board-row .new{font-size:10px;background:var(--amber);color:#3a2410;border-radius:5px;padding:1px 5px;font-weight:900;}

/* ===== MAP ===== */
.map{
  position:relative;aspect-ratio:16/10;border-radius:16px;overflow:hidden;border:1px solid var(--line);
  background:
    linear-gradient(transparent 49.5%,rgba(138,154,123,0.25) 50%,transparent 50.5%) 0 0/100% 38px,
    linear-gradient(90deg,transparent 49.5%,rgba(138,154,123,0.25) 50%,transparent 50.5%) 0 0/52px 100%,
    linear-gradient(120deg,#eef2e8,#e3ead9);
}
.map .road{position:absolute;background:#fbf6ec;box-shadow:0 0 0 1px rgba(150,130,100,0.15);}
.map .road.h{height:26px;left:0;right:0;top:54%;}
.map .road.v{width:26px;top:0;bottom:0;left:38%;}
.map .pin{
  position:absolute;top:46%;left:42%;transform:translate(-50%,-100%);
  font-size:40px;filter:drop-shadow(0 6px 6px rgba(0,0,0,0.3));animation:bob 1.8s ease-in-out infinite;
}
@keyframes bob{50%{transform:translate(-50%,-112%);}}
.map .badge{position:absolute;top:12px;left:12px;background:rgba(255,253,248,0.94);border-radius:10px;padding:7px 12px;font-size:12px;font-weight:700;color:var(--brown);box-shadow:0 6px 14px -8px rgba(0,0,0,0.4);}
.addr-list{margin-top:16px;display:grid;gap:10px;}
.addr-row{display:flex;gap:12px;align-items:flex-start;font-size:14px;color:var(--brown-2);}
.addr-row .ico{font-size:18px;}
.addr-row b{color:var(--brown);}

/* ===== INSTA ===== */
.insta-head{display:flex;align-items:center;gap:12px;margin-bottom:16px;}
.insta-head .ava{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font-size:22px;background:linear-gradient(135deg,#f9ce6e,#d9694f);}
.insta-head .h{font-weight:800;color:var(--brown);font-size:15px;}
.insta-head .h small{display:block;font-weight:500;color:var(--brown-soft);font-size:12px;}
.insta-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
@media(max-width:520px){.insta-grid{grid-template-columns:repeat(3,1fr);}}
.insta-item{
  aspect-ratio:1;border-radius:12px;display:grid;place-items:center;font-size:34px;position:relative;
  cursor:pointer;overflow:hidden;transition:.2s;
}
.insta-item:hover{transform:translateY(-3px);}
.insta-item .lk{
  position:absolute;inset:0;display:grid;place-items:center;gap:4px;color:#fff;font-weight:800;font-size:14px;
  background:rgba(40,30,20,0.45);opacity:0;transition:.2s;
}
.insta-item:hover .lk{opacity:1;}

/* ===== PAYMENT ===== */
.cart{border:1px solid var(--line);border-radius:14px;overflow:hidden;}
.cart-row{display:flex;align-items:center;gap:14px;padding:13px 16px;border-bottom:1px solid var(--line);background:#fff;}
.cart-row .emoji{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;font-size:26px;background:var(--cream-2);}
.cart-row .nm{flex:1;}
.cart-row .nm b{color:var(--brown);font-size:14px;}
.cart-row .nm small{display:block;color:var(--brown-soft);font-size:12px;}
.qty{display:flex;align-items:center;gap:8px;}
.qty button{width:26px;height:26px;border-radius:8px;border:1px solid var(--line);background:var(--cream);cursor:pointer;color:var(--brown);font-weight:700;}
.qty span{min-width:18px;text-align:center;font-weight:700;color:var(--brown);}
.cart-row .pr{font-weight:700;color:var(--brown);width:80px;text-align:right;}
.cart-foot{padding:16px;background:var(--cream);}
.cart-total{display:flex;justify-content:space-between;font-size:16px;font-weight:800;color:var(--brown);margin-bottom:14px;}
.pay-btn{width:100%;background:linear-gradient(135deg,#e0982f,#c97f1a);color:#fff;border:none;border-radius:12px;padding:15px;font-size:15px;font-weight:800;cursor:pointer;font-family:var(--sans);transition:.15s;}
.pay-btn:hover{filter:brightness(1.05);transform:translateY(-1px);}
.pay-methods{display:flex;justify-content:center;gap:14px;margin-top:12px;font-size:11px;color:var(--brown-soft);}

/* ===== CHATBOT ===== */
.chat-fab{
  position:fixed;right:20px;bottom:20px;z-index:9000;
  display:flex;flex-direction:column;align-items:flex-end;gap:10px;
}
.chat-panel{
  width:280px;background:var(--paper);border:1px solid var(--line);border-radius:18px;overflow:hidden;
  box-shadow:0 24px 50px -20px rgba(90,70,52,0.6);display:none;transform-origin:bottom right;
}
.chat-panel.show{display:block;animation:pop .2s ease;}
@keyframes pop{from{opacity:0;transform:scale(0.9) translateY(8px);}}
.chat-top{background:var(--brown);color:#fdf2e0;padding:13px 16px;font-weight:700;font-size:14px;display:flex;align-items:center;gap:8px;}
.chat-msgs{padding:14px;display:flex;flex-direction:column;gap:10px;max-height:240px;overflow-y:auto;}
.bubble{font-size:13px;padding:9px 12px;border-radius:14px;max-width:85%;}
.bubble.bot{background:var(--cream-2);color:var(--brown);align-self:flex-start;border-bottom-left-radius:4px;}
.bubble.me{background:var(--sage-deep);color:#fff;align-self:flex-end;border-bottom-right-radius:4px;}
.chat-quick{padding:0 14px 14px;display:flex;flex-wrap:wrap;gap:6px;}
.chat-quick button{font-size:12px;border:1px solid var(--sage);background:#fff;color:var(--sage-deep);border-radius:99px;padding:6px 11px;cursor:pointer;font-family:var(--sans);}
.chat-quick button:hover{background:var(--sage-soft);}
.chat-btn{
  width:60px;height:60px;border-radius:50%;border:none;cursor:pointer;font-size:28px;
  background:var(--brown);color:#fff;box-shadow:0 14px 26px -10px rgba(90,70,52,0.9);
  transition:transform .2s ease;
}
.chat-btn:hover{transform:scale(1.08) rotate(6deg);}
.chat-mini-note{
  background:rgba(58,46,34,0.92);color:#ffe9c7;font-size:11px;border-radius:10px;padding:7px 11px;
  max-width:200px;line-height:1.4;border:1px solid var(--amber);
}
.chat-mini-note b{color:var(--amber);}

/* ===== CLOSING ===== */
.closing{
  text-align:center;padding:96px 0;
  background:
    radial-gradient(700px 360px at 50% -10%,rgba(224,152,47,0.18),transparent 60%),
    linear-gradient(180deg,#5a4634,#433425);
  color:#fdf2e0;border-bottom:none;
}
.closing h2{font-size:clamp(28px,4.5vw,44px);color:#fff;margin-bottom:16px;}
.closing p{color:#e6d3b6;font-size:16px;max-width:560px;margin:0 auto 30px;}
.closing .kakao{
  display:inline-flex;align-items:center;gap:10px;background:#fee500;color:#3c1e1e;
  font-weight:800;font-size:16px;border-radius:14px;padding:16px 30px;text-decoration:none;
  box-shadow:0 16px 30px -14px rgba(254,229,0,0.6);transition:transform .2s ease;
}
