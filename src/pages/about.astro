---
import Base from '../layouts/Base.astro';

const principles = [
  {
    korean: '도구를 넘어 시스템으로',
    english: 'Beyond tools — think in systems',
    evidence: 'SAT Crusher isn\'t a quiz app — it\'s a spaced repetition engine with trap detection. Investment Agent Swarm isn\'t a stock screener — it\'s four AI agents debating in a boardroom.',
    link: '/projects/sat-crusher',
  },
  {
    korean: '복잡함을 명확함으로',
    english: 'Complexity to clarity',
    evidence: 'Prompt Garden turns messy prompting into visual components. Family Graph maps relationships into interactive nodes.',
    link: '/projects/prompt-garden',
  },
  {
    korean: '사람을 바꾸지 않는다. 환경을 만든다.',
    english: "Don't change people. Build better environments.",
    evidence: "The Parasite doesn't lecture about screen time — it adds friction until the habit breaks itself.",
    link: '/projects/the-parasite',
  },
  {
    korean: '보람은 정의되는 순간부터 작동한다',
    english: 'Fulfillment activates the moment you define it',
    evidence: 'Reading a book 100 times isn\'t obsessive when you define fulfillment as noticing new sentences each time.',
    link: '/archive/reading',
  },
];

const skills = [
  { category: 'Frontend', items: ['React', 'TypeScript', 'Tailwind CSS', 'Astro', 'Next.js'] },
  { category: 'State & Data', items: ['Zustand', 'Supabase', 'localStorage', 'Room DB'] },
  { category: 'AI & APIs', items: ['Fireworks AI', 'OpenAI', 'Chrome Extension API'] },
  { category: 'Tools', items: ['Vite', 'esbuild', 'Git', 'Vercel', 'Figma'] },
  { category: 'Languages', items: ['TypeScript', 'Kotlin', 'Python', 'SQL'] },
  { category: 'Other', items: ['@xyflow/react', 'Recharts', 'KaTeX', 'react-markdown'] },
];

const timeline = [
  {
    year: '2025–Present',
    title: 'Independent Builder',
    desc: 'Building web apps, mobile apps, and browser extensions — from SAT prep tools to knowledge graphs.',
  },
  {
    year: '2010s–Present',
    title: 'Automotive Engineer',
    desc: 'Designing and analyzing vehicle systems — body, interior, closures, electronics, and more.',
  },
];
---

<Base title="About — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-6">About</h1>

      <div class="prose mb-16">
        <p>
          I'm Jason Moon — an automotive engineer, father of two, and systems thinker.
          By day, I design vehicle systems. Nights and weekends, I don't just write code — I design
          complete systems for my family's education, daily life, and growth.
        </p>
        <p>
          Most of my projects started at the dinner table — my kids struggling with SAT prep,
          my family losing hours to YouTube Shorts, or my own desire to learn English better.
          When the right tool doesn't exist, I build it.
        </p>
        <p>
          I believe the leap from good developer to great one isn't about learning more tools — it's about
          thinking in systems. Every project I build is an architecture, not just an app.
          SAT Crusher isn't a quiz — it's a spaced repetition engine with trap detection.
          The Parasite isn't a blocker — it's a behavioral friction system.
          That shift in perspective is what I bring to every build.
        </p>
      </div>

      <!-- What I Optimize For -->
      <h2 class="text-2xl font-bold mb-6">What I Optimize For</h2>
      <div class="space-y-4 mb-16">
        {principles.map(({ korean, english, evidence, link }) => (
          <a href={link} class="group block rounded-xl border border-border bg-surface p-6 hover:border-accent/40 transition-all">
            <p class="font-semibold text-accent mb-1">{korean}</p>
            <p class="text-sm text-text font-medium mb-3">{english}</p>
            <p class="text-sm text-text-muted leading-relaxed">{evidence}</p>
            <span class="inline-flex items-center gap-1 text-xs text-accent mt-3 opacity-0 group-hover:opacity-100 transition-opacity">
              See project
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Tech Stack -->
      <h2 class="text-2xl font-bold mb-6">Tech Stack</h2>
      <div class="grid gap-4 sm:grid-cols-2 mb-16">
        {skills.map(({ category, items }) => (
          <div class="rounded-xl border border-border bg-surface p-5">
            <h3 class="text-sm font-semibold text-accent mb-3">{category}</h3>
            <div class="flex flex-wrap gap-1.5">
              {items.map((item) => (
                <span class="px-2 py-0.5 rounded text-xs font-mono text-text-muted bg-bg border border-border">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Timeline -->
      <h2 class="text-2xl font-bold mb-6">Timeline</h2>
      <div class="space-y-8">
        {timeline.map(({ year, title, desc }) => (
          <div class="relative pl-8 border-l-2 border-border">
            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-accent border-4 border-bg" />
            <p class="text-sm font-mono text-accent mb-1">{year}</p>
            <h3 class="text-lg font-semibold mb-1">{title}</h3>
            <p class="text-sm text-text-muted">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
