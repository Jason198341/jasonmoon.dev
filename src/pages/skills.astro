---
import Base from '../layouts/Base.astro';

const categories = [
  { id: 'all', label: 'All' },
  { id: 'planning', label: 'Planning' },
  { id: 'review', label: 'Code Review' },
  { id: 'build', label: 'Build & Fix' },
  { id: 'testing', label: 'Testing' },
  { id: 'ai', label: 'AI & Skills' },
  { id: 'session', label: 'Session' },
  { id: 'util', label: 'Utilities' },
];

const skills = [
  // Planning & Orchestration
  {
    cmd: 'plan',
    cat: 'planning',
    title: 'Plan',
    desc: 'Restate requirements, assess risks, create step-by-step implementation plan. Waits for confirmation before touching code.',
    tags: ['workflow', 'strategy'],
  },
  {
    cmd: 'aside',
    cat: 'planning',
    title: 'Aside',
    desc: 'Answer a quick side question without interrupting or losing context from the current task. Resumes work automatically.',
    tags: ['focus', 'context'],
  },
  {
    cmd: 'orchestrate',
    cat: 'planning',
    title: 'Orchestrate',
    desc: 'Sequential and tmux/worktree orchestration guidance for multi-agent workflows.',
    tags: ['agents', 'parallel'],
  },
  {
    cmd: 'devfleet',
    cat: 'planning',
    title: 'DevFleet',
    desc: 'Orchestrate parallel Claude Code agents via Claude DevFleet — plan from natural language, dispatch agents in isolated worktrees, monitor and read reports.',
    tags: ['agents', 'parallel', 'advanced'],
  },
  {
    cmd: 'multi-workflow',
    cat: 'planning',
    title: 'Multi Workflow',
    desc: 'Multi-model collaborative development: Research → Ideation → Plan → Execute → Optimize → Review. Routes Frontend to Gemini, Backend to Codex.',
    tags: ['multi-model', 'workflow'],
  },
  {
    cmd: 'multi-plan',
    cat: 'planning',
    title: 'Multi Plan',
    desc: 'Multi-model collaborative planning phase. Coordinates multiple AI models to produce a unified implementation plan.',
    tags: ['multi-model', 'planning'],
  },
  {
    cmd: 'multi-execute',
    cat: 'planning',
    title: 'Multi Execute',
    desc: 'Multi-model collaborative execution. Dispatches frontend and backend tasks to specialized models in parallel.',
    tags: ['multi-model', 'execution'],
  },
  {
    cmd: 'multi-frontend',
    cat: 'planning',
    title: 'Multi Frontend',
    desc: 'Frontend-focused multi-model development. Routes UI/UX tasks to the optimal model.',
    tags: ['multi-model', 'frontend'],
  },
  {
    cmd: 'multi-backend',
    cat: 'planning',
    title: 'Multi Backend',
    desc: 'Backend-focused multi-model development. Routes API, DB, and server tasks to the optimal model.',
    tags: ['multi-model', 'backend'],
  },

  // Code Review
  {
    cmd: 'code-review',
    cat: 'review',
    title: 'Code Review',
    desc: 'General-purpose code review for quality, security, and maintainability. Flags critical, high, and medium issues.',
    tags: ['quality', 'security'],
  },
  {
    cmd: 'python-review',
    cat: 'review',
    title: 'Python Review',
    desc: 'PEP 8 compliance, Pythonic idioms, type hints, security, and performance review for Python projects.',
    tags: ['python', 'quality'],
  },
  {
    cmd: 'cpp-review',
    cat: 'review',
    title: 'C++ Review',
    desc: 'Memory safety, modern C++ idioms (C++17/20), concurrency, and performance review based on C++ Core Guidelines.',
    tags: ['cpp', 'memory-safety'],
  },
  {
    cmd: 'go-review',
    cat: 'review',
    title: 'Go Review',
    desc: 'Idiomatic Go patterns, concurrency safety, error handling, and interface design review.',
    tags: ['go', 'concurrency'],
  },
  {
    cmd: 'kotlin-review',
    cat: 'review',
    title: 'Kotlin Review',
    desc: 'Idiomatic Kotlin patterns, null safety, coroutine correctness, and Compose best practices review.',
    tags: ['kotlin', 'android'],
  },
  {
    cmd: 'rust-review',
    cat: 'review',
    title: 'Rust Review',
    desc: 'Ownership, lifetimes, error handling, unsafe usage, and idiomatic Rust patterns review.',
    tags: ['rust', 'ownership'],
  },

  // Build & Fix
  {
    cmd: 'build-fix',
    cat: 'build',
    title: 'Build Fix',
    desc: 'Resolves TypeScript and build errors incrementally with minimal diffs. Focuses on getting the build green fast.',
    tags: ['typescript', 'errors'],
  },
  {
    cmd: 'cpp-build',
    cat: 'build',
    title: 'C++ Build',
    desc: 'Fixes CMake, linker, and template errors in C++ projects with minimal changes.',
    tags: ['cpp', 'cmake'],
  },
  {
    cmd: 'go-build',
    cat: 'build',
    title: 'Go Build',
    desc: 'Fixes go build, go vet warnings, and linter issues incrementally.',
    tags: ['go', 'linter'],
  },
  {
    cmd: 'kotlin-build',
    cat: 'build',
    title: 'Kotlin Build',
    desc: 'Fixes Kotlin/Gradle build errors, compiler warnings, and dependency issues.',
    tags: ['kotlin', 'gradle'],
  },
  {
    cmd: 'rust-build',
    cat: 'build',
    title: 'Rust Build',
    desc: 'Fixes cargo build errors, borrow checker issues, and Cargo.toml problems.',
    tags: ['rust', 'cargo'],
  },
  {
    cmd: 'gradle-build',
    cat: 'build',
    title: 'Gradle Build',
    desc: 'Resolves Gradle build errors for Android and KMP projects.',
    tags: ['android', 'gradle'],
  },

  // Testing
  {
    cmd: 'tdd',
    cat: 'testing',
    title: 'TDD',
    desc: 'Enforces test-driven development. Scaffolds interfaces, generates failing tests first (RED), then implements minimal code (GREEN), then refactors.',
    tags: ['workflow', '80% coverage'],
    featured: true,
  },
  {
    cmd: 'e2e',
    cat: 'testing',
    title: 'E2E',
    desc: 'Generates and runs end-to-end tests with Playwright. Creates test journeys, quarantines flaky tests, uploads artifacts.',
    tags: ['playwright', 'e2e'],
  },
  {
    cmd: 'test-coverage',
    cat: 'testing',
    title: 'Test Coverage',
    desc: 'Analyzes test coverage and identifies uncovered paths. Reports gaps with actionable remediation suggestions.',
    tags: ['coverage', 'analysis'],
  },
  {
    cmd: 'cpp-test',
    cat: 'testing',
    title: 'C++ Test',
    desc: 'TDD workflow for C++. Writes GoogleTest tests first, then implements. Validates with ctest.',
    tags: ['cpp', 'googletest'],
  },
  {
    cmd: 'go-test',
    cat: 'testing',
    title: 'Go Test',
    desc: 'Table-driven tests first, then implement. Validates with go test and race detector.',
    tags: ['go', 'table-driven'],
  },
  {
    cmd: 'kotlin-test',
    cat: 'testing',
    title: 'Kotlin Test',
    desc: 'TDD with Kotest. Writes Kotest specs first, then implements. Validates with Gradle test task.',
    tags: ['kotlin', 'kotest'],
  },
  {
    cmd: 'rust-test',
    cat: 'testing',
    title: 'Rust Test',
    desc: 'TDD for Rust. Writes unit and integration tests first, then implements. Validates with cargo test.',
    tags: ['rust', 'cargo-test'],
  },

  // AI & Skills
  {
    cmd: 'learn',
    cat: 'ai',
    title: 'Learn',
    desc: 'Extracts reusable patterns from the current session and saves them as instincts or skill fragments.',
    tags: ['meta', 'learning'],
    featured: true,
  },
  {
    cmd: 'learn-eval',
    cat: 'ai',
    title: 'Learn + Eval',
    desc: 'Extracts patterns from the session, self-evaluates quality before saving. Higher signal-to-noise than /learn alone.',
    tags: ['meta', 'quality'],
  },
  {
    cmd: 'skill-create',
    cat: 'ai',
    title: 'Skill Create',
    desc: 'Analyzes local git history to extract coding patterns and generate SKILL.md files. Local version of the Skill Creator GitHub App.',
    tags: ['meta', 'codegen'],
  },
  {
    cmd: 'skill-health',
    cat: 'ai',
    title: 'Skill Health',
    desc: 'Shows skill portfolio health dashboard with charts, analytics, and maintenance suggestions.',
    tags: ['meta', 'analytics'],
  },
  {
    cmd: 'prompt-optimize',
    cat: 'ai',
    title: 'Prompt Optimize',
    desc: 'Analyzes a draft prompt and outputs an optimized, ECC-enriched version ready to paste and run. Advisory only — does not execute.',
    tags: ['prompts', 'optimization'],
  },
  {
    cmd: 'instinct-status',
    cat: 'ai',
    title: 'Instinct Status',
    desc: 'Shows all learned instincts (project + global scope) with confidence scores.',
    tags: ['instincts', 'memory'],
  },
  {
    cmd: 'instinct-export',
    cat: 'ai',
    title: 'Instinct Export',
    desc: 'Exports instincts from project or global scope to a shareable file.',
    tags: ['instincts', 'export'],
  },
  {
    cmd: 'instinct-import',
    cat: 'ai',
    title: 'Instinct Import',
    desc: 'Imports instincts from a file or URL into project or global scope.',
    tags: ['instincts', 'import'],
  },
  {
    cmd: 'promote',
    cat: 'ai',
    title: 'Promote',
    desc: 'Promotes project-scoped instincts to global scope so they apply across all projects.',
    tags: ['instincts', 'global'],
  },
  {
    cmd: 'evolve',
    cat: 'ai',
    title: 'Evolve',
    desc: 'Analyzes instinct usage patterns and suggests or generates evolved, consolidated structures.',
    tags: ['instincts', 'refactor'],
  },

  // Session & Memory
  {
    cmd: 'save-session',
    cat: 'session',
    title: 'Save Session',
    desc: 'Saves current session state to a dated file in ~/.claude/sessions/ for cross-session continuity.',
    tags: ['persistence', 'context'],
  },
  {
    cmd: 'resume-session',
    cat: 'session',
    title: 'Resume Session',
    desc: 'Loads the most recent session file and resumes work with full context from where the last session ended.',
    tags: ['persistence', 'context'],
  },
  {
    cmd: 'sessions',
    cat: 'session',
    title: 'Sessions',
    desc: 'Manages Claude Code session history, aliases, and metadata. Browse, tag, and retrieve past sessions.',
    tags: ['history', 'management'],
  },
  {
    cmd: 'checkpoint',
    cat: 'session',
    title: 'Checkpoint',
    desc: 'Saves a working state checkpoint: git state, decisions made, and next steps. Resume from any checkpoint.',
    tags: ['git', 'state'],
  },
  {
    cmd: 'projects',
    cat: 'session',
    title: 'Projects',
    desc: 'Lists all known projects with their instinct statistics and last-active timestamps.',
    tags: ['overview', 'instincts'],
  },

  // Utilities
  {
    cmd: 'docs',
    cat: 'util',
    title: 'Docs',
    desc: 'Looks up current documentation for any library or topic via Context7 MCP. Returns accurate, version-specific API examples.',
    tags: ['docs', 'context7'],
    featured: true,
  },
  {
    cmd: 'verify',
    cat: 'util',
    title: 'Verify',
    desc: 'Runs a full verification loop: type checks, tests, lints, and reports the overall health status of the project.',
    tags: ['quality', 'ci'],
  },
  {
    cmd: 'quality-gate',
    cat: 'util',
    title: 'Quality Gate',
    desc: 'Enforces quality gate before merge: coverage, lint errors, type errors, and security checks must all pass.',
    tags: ['gate', 'ci'],
  },
  {
    cmd: 'refactor-clean',
    cat: 'util',
    title: 'Refactor Clean',
    desc: 'Removes dead code, unused imports, and duplicate logic. Runs knip/depcheck/ts-prune to identify what is safe to delete.',
    tags: ['cleanup', 'dead-code'],
  },
  {
    cmd: 'update-docs',
    cat: 'util',
    title: 'Update Docs',
    desc: 'Reads all project docs and cross-references with actual code to update stale documentation automatically.',
    tags: ['docs', 'maintenance'],
  },
  {
    cmd: 'update-codemaps',
    cat: 'util',
    title: 'Update Codemaps',
    desc: 'Generates or updates codemap files that give Claude accurate knowledge of the project\'s file and module structure.',
    tags: ['codemaps', 'context'],
  },
  {
    cmd: 'context-budget',
    cat: 'util',
    title: 'Context Budget',
    desc: 'Analyzes context window usage across agents, skills, and MCP servers. Surfaces which items consume the most tokens.',
    tags: ['tokens', 'optimization'],
  },
  {
    cmd: 'rules-distill',
    cat: 'util',
    title: 'Rules Distill',
    desc: 'Scans all active skills and extracts cross-cutting principles to distill into a unified rule file.',
    tags: ['rules', 'meta'],
  },
  {
    cmd: 'email-checklist',
    cat: 'util',
    title: 'Email Checklist',
    desc: 'Converts a draft email into a preventive checklist — flags tone, missing context, implicit assumptions, and risk phrases.',
    tags: ['communication', 'review'],
  },
];

const totalCount = skills.length;
const featuredCount = skills.filter((s) => s.featured).length;
---

<Base
  title="Claude Skills — Jason Moon"
  description={`${totalCount} custom Claude Code skills for planning, code review, testing, AI self-improvement, and session management.`}
>
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">

      <!-- Header -->
      <div class="mb-12 animate-fade-in-up delay-1">
        <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">Claude Code</p>
        <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">
          Skills
        </h1>
        <p class="text-text-muted leading-relaxed max-w-xl mb-6">
          Custom slash commands wired into my Claude Code workflow.
          Each skill is a <code class="font-mono text-xs bg-surface px-1.5 py-0.5 rounded border border-border">.md</code> file
          that shapes Claude's behavior for a specific task.
        </p>
        <div class="flex flex-wrap gap-4 text-sm">
          <span class="inline-flex items-center gap-2 text-text-muted">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            <span class="font-mono font-semibold text-text">{totalCount}</span> skills active
          </span>
          <span class="inline-flex items-center gap-2 text-text-muted">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span class="font-mono font-semibold text-text">{featuredCount}</span> featured
          </span>
        </div>
      </div>

      <!-- Category filter -->
      <div class="flex flex-wrap gap-2 mb-10 animate-fade-in-up delay-2" id="filter-bar">
        {categories.map((cat) => (
          <button
            data-cat={cat.id}
            class:list={[
              'filter-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition-all duration-200 border',
              cat.id === 'all'
                ? 'active bg-accent text-white border-accent'
                : 'text-text-muted border-border bg-surface hover:text-text hover:border-border-hover',
            ]}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Skills grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-fade-in-up delay-3" id="skills-grid">
        {skills.map((s) => (
          <article
            data-cat={s.cat}
            class:list={[
              'skill-card group relative rounded-xl border transition-all duration-200 p-5',
              s.featured
                ? 'border-accent/30 bg-accent/5 hover:border-accent/50'
                : 'border-border bg-surface hover:border-border-hover hover:bg-surface-hover',
            ]}
          >
            <!-- Command -->
            <div class="flex items-start justify-between gap-2 mb-3">
              <span class:list={[
                'font-mono text-sm font-semibold',
                s.featured ? 'text-accent' : 'text-text',
              ]}>
                /{s.cmd}
              </span>
              {s.featured && (
                <span class="inline-flex items-center gap-1 text-[9px] font-mono uppercase tracking-wider text-accent/70 border border-accent/20 rounded-full px-2 py-0.5 shrink-0">
                  ★
                </span>
              )}
            </div>

            <!-- Description -->
            <p class="text-text-muted text-xs leading-relaxed mb-4">
              {s.desc}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {s.tags.map((tag) => (
                <span class="text-[10px] font-mono text-text-muted/60 bg-bg border border-border/60 rounded px-1.5 py-0.5">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>

      <!-- Empty state (hidden by default) -->
      <div id="empty-state" class="hidden py-20 text-center text-text-muted text-sm">
        No skills in this category.
      </div>

      <!-- Footer -->
      <div class="mt-16 pt-8 border-t border-border animate-fade-in-up">
        <p class="text-xs text-text-muted/50 font-mono text-center leading-relaxed">
          Skills are stored as <code class="text-text-muted/70">~/.claude/commands/*.md</code><br />
          Invoked with <code class="text-text-muted/70">/skill-name</code> inside Claude Code CLI
        </p>
      </div>

    </div>
  </section>
</Base>

<script>
  const filterBar = document.getElementById('filter-bar');
  const grid = document.getElementById('skills-grid');
  const emptyState = document.getElementById('empty-state');

  filterBar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filter-btn');
    if (!btn) return;
    const cat = btn.getAttribute('data-cat');

    // Update active button
    filterBar.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.remove('active', 'bg-accent', 'text-white', 'border-accent');
      b.classList.add('text-text-muted', 'border-border', 'bg-surface');
    });
    btn.classList.add('active', 'bg-accent', 'text-white', 'border-accent');
    btn.classList.remove('text-text-muted', 'border-border', 'bg-surface');

    // Filter cards
    const cards = grid?.querySelectorAll('.skill-card');
    let visible = 0;
    cards?.forEach((card) => {
      const cardCat = card.getAttribute('data-cat');
      const show = cat === 'all' || cardCat === cat;
      (card as HTMLElement).style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
    }
  });
</script>
