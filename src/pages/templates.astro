---
import Base from '../layouts/Base.astro';
import TemplatePlayer from '../components/templates/TemplatePlayer.tsx';

const templates = [
  {
    id: 'music-visualizer' as const,
    name: 'Music Visualizer',
    tagline: 'Audio-reactive visuals.',
    description: 'Drop your track, get a Shorts-ready video. Circular spectrum, floating particles, and progress bar — all driven by your audio data.',
    format: '9:16 Shorts',
    tags: ['Audio Reactive', 'Particles', 'Spectrum'],
    color: '#06b6d4',
    features: ['Circular spectrum from audio data', 'Floating reactive particles', 'Auto-duration from audio file', 'Progress bar with timestamps'],
  },
  {
    id: 'portfolio-trailer' as const,
    name: 'Portfolio Trailer',
    tagline: 'Your work, cinematic.',
    description: 'Auto-generate a project showcase with Ken Burns panning, glass overlays, and tech badges. List your projects in config, get a trailer.',
    format: '16:9 YouTube',
    tags: ['Ken Burns', 'Glass UI', 'Cinematic'],
    color: '#6366f1',
    features: ['Per-project Ken Burns + glass overlay', 'Typewriter text effect', 'Auto intro/outro generation', 'Tech tag badges per project'],
  },
  {
    id: 'presentation' as const,
    name: 'Presentation',
    tagline: 'Slides that move.',
    description: 'Turn content into animated video. Multiple slide layouts — bullets, code blocks, images — with staggered spring animations and progress tracking.',
    format: '16:9 YouTube',
    tags: ['Slides', 'Education', 'Auto-animate'],
    color: '#a855f7',
    features: ['Staggered bullet animations', 'Code syntax display', 'Auto slide numbering', 'Multiple layout types'],
  },
  {
    id: 'shorts-reels' as const,
    name: 'Shorts / Reels',
    tagline: 'Vertical, automated.',
    description: 'Image + subtitle auto-composition. Three subtitle styles — box, outline, glow — with Ken Burns transitions and per-scene duration control.',
    format: '9:16 Shorts',
    tags: ['Subtitles', 'Vertical', 'Auto-compose'],
    color: '#f97316',
    features: ['3 subtitle styles cycling', 'Ken Burns on images', 'Optional title card', 'Per-scene duration control'],
  },
  {
    id: 'youtube-intro' as const,
    name: 'YouTube Intro',
    tagline: '5 seconds. Instant impact.',
    description: 'Channel branding done right. Logo reveal with spring physics, neon glow pulse, and text clip animation. 4 visual styles included.',
    format: '16:9 YouTube',
    tags: ['Branding', '4 Styles', 'Logo Reveal'],
    color: '#ef4444',
    features: ['Spring-based logo reveal', 'Neon glow pulse effect', 'Subscribe CTA (outro variant)', '4 visual styles'],
  },
  {
    id: 'sns-ad' as const,
    name: 'SNS Ad / Promo',
    tagline: 'Scroll-stopping ads.',
    description: 'Social media promo with product spotlight, price tag animation, badge slides, and animated CTA. Portrait and square formats.',
    format: '9:16 + 1:1',
    tags: ['E-commerce', 'CTA', 'Multi-format'],
    color: '#ec4899',
    features: ['Portrait + square variants', 'Badge & price animations', 'Product spotlight', 'Animated CTA button'],
  },
  {
    id: 'product-showcase' as const,
    name: 'Product Showcase',
    tagline: 'Premium product video.',
    description: 'Hero reveal, animated feature grid, and pricing CTA. Clean, premium feel with staggered spring entries. Perfect for SaaS and e-commerce.',
    format: '16:9 YouTube',
    tags: ['Product', 'Features', 'Premium'],
    color: '#22c55e',
    features: ['Hero product reveal', 'Animated feature grid', 'Multi-image support', 'Price & CTA closing scene'],
  },
  {
    id: 'data-viz' as const,
    name: 'Data Visualization',
    tagline: 'Charts in motion.',
    description: 'Animated bar charts, pie charts, and big-number counters. Turn your data into compelling video with spring-driven animations.',
    format: '16:9 YouTube',
    tags: ['Charts', 'Business', 'Animation'],
    color: '#eab308',
    features: ['Bar chart grow animation', 'Count-up numbers', 'Multiple chart types', 'Per-bar staggered timing'],
  },
];
---

<Base title="Remotion Templates — Live Demos" description="8 Remotion video templates with live interactive previews. Music visualizers, portfolio trailers, presentations, and more.">

  <!-- Hero -->
  <section class="relative min-h-[45vh] flex items-center justify-center overflow-hidden pt-24 pb-8">
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
      style="background-image: linear-gradient(rgba(129,140,248,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(129,140,248,0.3) 1px, transparent 1px); background-size: 60px 60px;"
    ></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(99,102,241,0.08) 0%, transparent 70%);"
    ></div>

    <div class="relative z-10 text-center max-w-3xl mx-auto px-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-medium mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        Live Previews
      </div>
      <h1 class="text-4xl sm:text-5xl font-display font-extrabold text-text leading-tight mb-4">
        Remotion Templates
      </h1>
      <p class="text-lg text-text-muted max-w-xl mx-auto mb-6">
        8 video templates running live in your browser.
        What you see below is real Remotion rendering — not a recording.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <div class="flex items-center gap-6 text-sm text-text-muted">
          <span><strong class="text-text">8</strong> Templates</span>
          <span class="w-1 h-1 rounded-full bg-border"></span>
          <span><strong class="text-text">React 19</strong> + Remotion 4</span>
          <span class="w-1 h-1 rounded-full bg-border"></span>
          <span><strong class="text-text">TypeScript</strong></span>
        </div>
      </div>
      <a
        href="/video-catalog"
        class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 rounded-xl bg-accent/10 border border-accent/20 text-accent text-sm font-semibold hover:bg-accent/20 hover:border-accent/30 transition-all"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0l-4-4m4 4l-4 4"/></svg>
        60 Video Recipes — Copy-Paste Claude Code Prompts
      </a>
    </div>
  </section>

  <!-- Template Sections -->
  <section class="max-w-6xl mx-auto px-6 pb-24">
    {templates.map((t, idx) => {
      const isReversed = idx % 2 === 1;
      const isVertical = t.id === 'music-visualizer' || t.id === 'shorts-reels' || t.id === 'sns-ad';

      return (
        <article
          class="reveal py-16 first:pt-8"
          style={`border-top: 1px solid ${idx === 0 ? 'transparent' : 'rgba(34,34,48,0.5)'};`}
        >
          <div class={`grid grid-cols-1 ${isVertical ? 'lg:grid-cols-[1fr_320px]' : 'lg:grid-cols-2'} gap-12 items-center ${isReversed && !isVertical ? 'lg:[direction:rtl]' : ''}`}>

            {/* Info */}
            <div class={isReversed && !isVertical ? 'lg:[direction:ltr]' : ''}>
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="px-3 py-1 rounded-full text-xs font-semibold border"
                  style={`color: ${t.color}; border-color: ${t.color}30; background: ${t.color}10;`}
                >
                  {t.format}
                </div>
              </div>

              <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-text mb-2" style={`letter-spacing: -0.03em;`}>
                {t.name}
              </h2>
              <p class="text-lg font-medium mb-3" style={`color: ${t.color};`}>{t.tagline}</p>
              <p class="text-text-muted leading-relaxed mb-6">{t.description}</p>

              {/* Tags */}
              <div class="flex flex-wrap gap-2 mb-6">
                {t.tags.map((tag) => (
                  <span
                    class="text-xs px-2.5 py-1 rounded-full font-medium"
                    style={`color: ${t.color}; background: ${t.color}12; border: 1px solid ${t.color}25;`}
                  >
                    {tag}
                  </span>
                ))}
              </div>

              {/* Features */}
              <ul class="space-y-2">
                {t.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-text-muted">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style={`color: ${t.color};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>

            {/* Player */}
            <div class={isReversed && !isVertical ? 'lg:[direction:ltr]' : ''}>
              <TemplatePlayer client:only="react" templateId={t.id} />
            </div>
          </div>
        </article>
      );
    })}

    {/* How it works */}
    <div class="mt-16 reveal">
      <h2 class="text-2xl font-display font-bold text-text text-center mb-8">How It Works</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="text-center p-6 rounded-xl border border-border bg-surface/30">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent font-display font-bold text-lg">1</div>
          <h3 class="font-bold text-text mb-1">Edit Config</h3>
          <p class="text-sm text-text-muted">Change colors, text, images in a simple TypeScript config file.</p>
        </div>
        <div class="text-center p-6 rounded-xl border border-border bg-surface/30">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent font-display font-bold text-lg">2</div>
          <h3 class="font-bold text-text mb-1">Preview in Studio</h3>
          <p class="text-sm text-text-muted">See real-time preview with <code class="text-accent">npm run studio</code>.</p>
        </div>
        <div class="text-center p-6 rounded-xl border border-border bg-surface/30">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent font-display font-bold text-lg">3</div>
          <h3 class="font-bold text-text mb-1">Render MP4</h3>
          <p class="text-sm text-text-muted">Export production-quality video with one command.</p>
        </div>
      </div>
    </div>

    {/* CTA */}
    <div class="mt-16 rounded-2xl border border-accent/20 bg-surface/50 p-8 text-center reveal">
      <h2 class="text-3xl font-display font-extrabold text-text mb-2">All 8 Templates</h2>
      <p class="text-text-muted mb-6 max-w-md mx-auto">
        One bundle. TypeScript configs. React components. Infinite renders. Lifetime updates.
      </p>
      <button
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-accent text-white text-base font-semibold transition-all hover:brightness-110 cursor-pointer"
        disabled
      >
        Coming Soon
      </button>
    </div>

    {/* Tech stack */}
    <div class="mt-12 text-center">
      <p class="text-sm text-text-muted">
        Built with
        <span class="text-text font-medium"> React 19</span> +
        <span class="text-text font-medium"> Remotion 4</span> +
        <span class="text-text font-medium"> TypeScript</span> +
        <span class="text-text font-medium"> Zod schemas</span>
      </p>
    </div>
  </section>

</Base>
