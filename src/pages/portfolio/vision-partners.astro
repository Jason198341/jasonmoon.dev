---
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>비전파트너스 — Strategy & Management Consulting</title>
  <meta name="description" content="비전파트너스: 전략·운영·조직·디지털 컨설팅. 경영진을 위한 의사결정 파트너." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=PT+Serif:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&family=Archivo:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --navy: #0f2a43;
      --navy-deep: #0a1f33;
      --navy-line: #234a6b;
      --ink: #e8eef4;
      --muted: #9fb3c8;
      --gold: #c8a24a;
      --gold-bright: #e0bd66;
      --silver: #b8c4d0;
      --paper: #f4f1e9;
      --serif: 'PT Serif', Georgia, 'Times New Roman', serif;
      --sans: 'Inter', system-ui, sans-serif;
      --label: 'Archivo', 'Inter', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--navy);
      color: var(--ink);
      font-family: var(--sans);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, .serif { font-family: var(--serif); }

    .wrap { max-width: 1180px; margin: 0 auto; padding: 0 40px; }

    /* ---- shared eyebrow / exhibit labels ---- */
    .eyebrow {
      font-family: var(--label);
      font-size: 11px;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 700;
    }

    .exhibit-tag {
      font-family: var(--label);
      font-size: 10.5px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--navy-deep);
      background: var(--gold);
      font-weight: 800;
      padding: 3px 9px;
      display: inline-block;
    }

    .exhibit-cap {
      font-family: var(--label);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--muted);
      text-transform: uppercase;
      border-top: 1px solid var(--navy-line);
      padding-top: 10px;
      margin-top: 18px;
    }

    .section-num {
      font-family: var(--label);
      font-size: 13px;
      letter-spacing: 0.2em;
      color: var(--gold);
      font-weight: 700;
    }

    /* action title (bullet headline, McKinsey style) */
    .action-title {
      font-family: var(--serif);
      font-size: clamp(1.4rem, 1rem + 1.6vw, 2.1rem);
      line-height: 1.28;
      font-weight: 700;
      letter-spacing: -0.01em;
      max-width: 24ch;
    }
    .action-title em { color: var(--gold-bright); font-style: italic; }

    .lede {
      color: var(--muted);
      font-size: 1.02rem;
      max-width: 56ch;
    }

    section { border-top: 1px solid var(--navy-line); }

    /* =================== TOPBAR offset already handled inline =================== */

    /* =================== MASTHEAD =================== */
    .masthead {
      display: flex; justify-content: space-between; align-items: baseline;
      padding: 26px 0 22px;
      border-bottom: 2px solid var(--gold);
    }
    .brandmark {
      font-family: var(--serif);
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .brandmark b { color: var(--gold); }
    .brand-en {
      font-family: var(--label);
      font-size: 10px;
      letter-spacing: 0.3em;
      color: var(--muted);
      text-transform: uppercase;
      display: block;
      margin-top: 2px;
    }
    .masthead nav {
      font-family: var(--label);
      font-size: 11.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--silver);
      display: flex; gap: 26px;
    }
    .masthead nav span:last-child { color: var(--gold); }

    /* =================== HERO / EXHIBIT 0 =================== */
    .hero { padding: 70px 0 84px; position: relative; }
    .hero::after {
      content: "";
      position: absolute; inset: 0;
      background:
        linear-gradient(0deg, transparent 0, transparent calc(100% - 1px), rgba(35,74,107,0.35) 100%),
        repeating-linear-gradient(90deg, transparent, transparent 79px, rgba(35,74,107,0.13) 79px, rgba(35,74,107,0.13) 80px);
      pointer-events: none;
    }
    .hero-grid {
      display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center;
      position: relative; z-index: 1;
    }
    .hero h1 {
      font-size: clamp(2.5rem, 1.4rem + 4.6vw, 4.6rem);
      line-height: 1.04;
      letter-spacing: -0.025em;
      margin: 20px 0 22px;
    }
    .hero h1 .hl { color: var(--gold-bright); }
    .hero .lede { font-size: 1.12rem; }
    .hero-meta {
      margin-top: 34px;
      display: flex; gap: 0; border: 1px solid var(--navy-line);
    }
    .hero-meta div {
      flex: 1; padding: 16px 20px;
      border-right: 1px solid var(--navy-line);
    }
    .hero-meta div:last-child { border-right: none; }
    .hero-meta .k {
      font-family: var(--label); font-size: 10px; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--muted);
    }
    .hero-meta .v {
      font-family: var(--serif); font-size: 1.7rem; color: var(--gold);
      font-weight: 700; line-height: 1.1; margin-top: 4px;
    }
    .hero-meta .v small { font-size: 0.85rem; color: var(--silver); }

    /* hero side: a "synthesis" governing-thought card */
    .gov-card {
      background: linear-gradient(160deg, #12314e 0%, #0c2238 100%);
      border: 1px solid var(--navy-line);
      border-top: 3px solid var(--gold);
      padding: 30px 28px;
      box-shadow: 0 26px 60px -28px rgba(0,0,0,0.7);
    }
    .gov-card .exhibit-tag { margin-bottom: 16px; }
    .gov-card h3 {
      font-size: 1.18rem; line-height: 1.45; font-weight: 700;
    }
    .gov-card ol {
      list-style: none; margin-top: 20px; counter-reset: g;
    }
    .gov-card li {
      counter-increment: g;
      display: flex; gap: 14px; padding: 12px 0;
      border-top: 1px solid rgba(35,74,107,0.6);
      font-size: 0.92rem; color: var(--silver);
    }
    .gov-card li::before {
      content: counter(g);
      font-family: var(--label); font-weight: 800; font-size: 0.78rem;
      color: var(--navy-deep); background: var(--gold);
      width: 22px; height: 22px; flex: 0 0 22px; border-radius: 50%;
      display: grid; place-items: center;
    }

    /* =================== GENERIC SECTION HEAD =================== */
    .sec-head {
      display: flex; justify-content: space-between; align-items: flex-end;
      gap: 30px; flex-wrap: wrap; margin-bottom: 44px;
    }
    .sec-head .left { max-width: 60%; }
    .sec-head .exhibit-tag { margin-bottom: 14px; }
    .pad { padding: 86px 0; }

    /* =================== 2x2 MATRIX =================== */
    .matrix-wrap {
      display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: start;
    }
    .matrix {
      position: relative;
      aspect-ratio: 1 / 1;
      border-left: 2px solid var(--silver);
      border-bottom: 2px solid var(--silver);
      margin: 30px 0 0 96px;
    }
    .matrix .cell {
      position: absolute; width: 50%; height: 50%;
      border: 1px solid var(--navy-line);
      padding: 18px;
      display: flex; flex-direction: column; justify-content: space-between;
      transition: background 0.25s, transform 0.25s;
    }
    .matrix .cell:hover { background: rgba(200,162,74,0.1); transform: scale(1.012); z-index: 2; }
    .cell.tl { top: 0; left: 0; }
    .cell.tr { top: 0; left: 50%; background: rgba(200,162,74,0.07); }
    .cell.bl { top: 50%; left: 0; }
    .cell.br { top: 50%; left: 50%; }
    .cell .q {
      font-family: var(--label); font-size: 10px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--gold);
    }
    .cell h4 { font-family: var(--serif); font-size: 1.22rem; margin: 6px 0 4px; }
    .cell p { font-size: 0.82rem; color: var(--muted); line-height: 1.5; }
    .cell .dot {
      align-self: flex-end;
      font-family: var(--label); font-size: 0.7rem; letter-spacing: 0.1em;
      color: var(--silver); border: 1px solid var(--navy-line); padding: 2px 7px;
    }
    /* axis labels */
    .axis-y {
      position: absolute; left: -86px; top: 50%; transform: translateY(-50%) rotate(-90deg);
      transform-origin: center; white-space: nowrap;
      font-family: var(--label); font-size: 10.5px; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--silver);
    }
    .axis-x {
      position: absolute; bottom: -34px; left: 0; right: 0; text-align: center;
      font-family: var(--label); font-size: 10.5px; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--silver);
    }
    .axis-end { position: absolute; font-family: var(--label); font-size: 9.5px; letter-spacing: 0.1em; color: var(--muted); text-transform: uppercase; }
    .axis-end.x0 { bottom: -18px; left: 0; }
    .axis-end.x1 { bottom: -18px; right: 0; }
    .axis-end.y0 { left: -30px; bottom: 0; }
    .axis-end.y1 { left: -30px; top: 0; }

    .matrix-note h3 { font-size: 1.3rem; line-height: 1.4; margin-bottom: 16px; }
    .matrix-note ul { list-style: none; }
    .matrix-note li {
      padding: 14px 0 14px 26px; position: relative;
      border-top: 1px solid var(--navy-line); font-size: 0.94rem; color: var(--silver);
    }
    .matrix-note li::before {
      content: "▸"; position: absolute; left: 0; color: var(--gold); font-size: 0.8rem; top: 15px;
    }
    .matrix-note li b { color: var(--ink); font-family: var(--serif); }

    /* =================== PYRAMID =================== */
    .pyr-wrap { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: center; }
    .pyramid { display: flex; flex-direction: column; gap: 10px; }
    .pyr-row {
      display: flex; align-items: center; gap: 18px;
    }
    .pyr-bar {
      background: linear-gradient(90deg, #163a5b, #1d4d77);
      border: 1px solid var(--navy-line);
      border-left: 3px solid var(--gold);
      padding: 16px 20px; margin: 0 auto;
      display: flex; align-items: center; gap: 14px;
      transition: transform 0.2s;
    }
    .pyr-bar:hover { transform: translateX(4px); border-left-color: var(--gold-bright); }
    .pyr-row.l0 .pyr-bar { width: 42%; background: linear-gradient(90deg, #c8a24a, #e0bd66); border-left-color: var(--navy-deep); }
    .pyr-row.l0 .pyr-bar h4, .pyr-row.l0 .pyr-bar p, .pyr-row.l0 .step { color: var(--navy-deep); }
    .pyr-row.l1 .pyr-bar { width: 64%; }
    .pyr-row.l2 .pyr-bar { width: 86%; }
    .pyr-row.l3 .pyr-bar { width: 100%; }
    .step {
      font-family: var(--label); font-weight: 800; font-size: 0.95rem;
      color: var(--gold); flex: 0 0 auto;
    }
    .pyr-bar h4 { font-family: var(--serif); font-size: 1.02rem; }
    .pyr-bar p { font-size: 0.78rem; color: var(--muted); }
    .pyr-bar .txt h4 { line-height: 1.2; }

    .pyr-note h3 { font-size: 1.4rem; line-height: 1.4; margin-bottom: 18px; }
    .mece-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
    .mece-chip {
      font-family: var(--label); font-size: 11px; letter-spacing: 0.08em;
      border: 1px solid var(--navy-line); padding: 8px 14px; color: var(--silver);
      text-transform: uppercase;
    }
    .mece-chip b { color: var(--gold); }

    /* =================== RESULTS / CHARTS =================== */
    .kpi-row {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
      border: 1px solid var(--navy-line); margin-bottom: 56px;
    }
    .kpi {
      padding: 26px 24px; border-right: 1px solid var(--navy-line);
    }
    .kpi:last-child { border-right: none; }
    .kpi .v { font-family: var(--serif); font-size: 2.5rem; color: var(--gold); font-weight: 700; line-height: 1; }
    .kpi .v small { font-size: 1.1rem; }
    .kpi .k { font-family: var(--label); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 10px; }
    .kpi .d { font-size: 0.82rem; color: var(--silver); margin-top: 4px; }

    .charts { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
    .chart-card {
      border: 1px solid var(--navy-line); padding: 28px 30px 24px;
      background: linear-gradient(160deg, #0e2942, #0b2034);
    }
    .chart-card .ctitle { font-family: var(--serif); font-size: 1.12rem; margin-bottom: 4px; }
    .chart-card .csub { font-family: var(--label); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
    .chart-svg { width: 100%; height: auto; margin-top: 18px; display: block; }

    /* CSS bar chart */
    .bars { display: flex; align-items: flex-end; gap: 16px; height: 220px; margin-top: 22px; padding-bottom: 28px; border-bottom: 1px solid var(--navy-line); position: relative; }
    .bar { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; position: relative; }
    .bar .col {
      width: 70%; background: linear-gradient(180deg, #1d4d77, #133a5b);
      border-top: 3px solid var(--silver);
      position: relative; transition: filter 0.2s;
    }
    .bar:last-child .col { background: linear-gradient(180deg, #e0bd66, #c8a24a); border-top-color: #fff; }
    .bar:hover .col { filter: brightness(1.18); }
    .bar .val { position: absolute; top: -22px; width: 100%; text-align: center; font-family: var(--label); font-weight: 700; font-size: 0.82rem; color: var(--gold-bright); }
    .bar .lab { position: absolute; bottom: -24px; font-family: var(--label); font-size: 10px; letter-spacing: 0.06em; color: var(--muted); text-transform: uppercase; }

    /* =================== PARTNERS =================== */
    .partners { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
    .partner {
      border: 1px solid var(--navy-line); border-top: 3px solid var(--gold);
      padding: 0; overflow: hidden;
      background: linear-gradient(160deg, #0e2942, #0a1d31);
    }
    .partner .avatar {
      height: 120px; display: grid; place-items: center;
      background:
        repeating-linear-gradient(45deg, rgba(35,74,107,0.25) 0 10px, transparent 10px 20px),
        linear-gradient(160deg, #14334f, #0c2138);
      border-bottom: 1px solid var(--navy-line);
    }
    .monogram {
      width: 60px; height: 60px; border: 2px solid var(--gold);
      display: grid; place-items: center; border-radius: 50%;
      font-family: var(--serif); font-size: 1.5rem; font-weight: 700; color: var(--gold);
    }
    .partner .body { padding: 22px 24px 26px; }
    .partner h4 { font-family: var(--serif); font-size: 1.2rem; }
    .partner .role { font-family: var(--label); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin-top: 4px; }
    .partner p { font-size: 0.86rem; color: var(--muted); margin-top: 14px; line-height: 1.55; }
    .partner .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 16px; }
    .partner .tags span { font-family: var(--label); font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--silver); border: 1px solid var(--navy-line); padding: 3px 8px; }

    /* =================== CTA =================== */
    .cta { background: linear-gradient(165deg, #0c2238 0%, #081a2c 100%); position: relative; }
    .cta-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 56px; align-items: center; }
    .cta h2 { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 18px; }
    .cta h2 .hl { color: var(--gold-bright); }
    .cta .lede { font-size: 1.08rem; }
    .cta-actions { margin-top: 30px; display: flex; gap: 14px; flex-wrap: wrap; }
    .btn {
      font-family: var(--label); font-weight: 700; font-size: 12px; letter-spacing: 0.12em;
      text-transform: uppercase; padding: 15px 26px; text-decoration: none; display: inline-block;
      transition: transform 0.2s, background 0.2s;
    }
    .btn.primary { background: var(--gold); color: var(--navy-deep); }
    .btn.primary:hover { background: var(--gold-bright); transform: translateY(-2px); }
    .btn.ghost { border: 1px solid var(--silver); color: var(--ink); }
    .btn.ghost:hover { border-color: var(--gold); color: var(--gold); }

    .contact-card {
      border: 1px solid var(--navy-line); border-top: 3px solid var(--gold);
      padding: 30px 30px;
      background: rgba(7,18,30,0.5);
    }
    .contact-card .exhibit-tag { margin-bottom: 18px; }
    .contact-row { display: flex; gap: 14px; padding: 14px 0; border-top: 1px solid var(--navy-line); }
    .contact-row:first-of-type { border-top: none; }
    .contact-row .k { font-family: var(--label); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); flex: 0 0 84px; padding-top: 3px; }
    .contact-row .v { font-size: 0.96rem; color: var(--ink); }
    .contact-row .v b { font-family: var(--serif); color: var(--gold); font-size: 1.1rem; }

    /* =================== FOOTER =================== */
    footer { border-top: 2px solid var(--gold); padding: 40px 0; }
    .foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
    .foot .brandmark { font-size: 1.1rem; }
    .foot p { font-family: var(--label); font-size: 10.5px; letter-spacing: 0.1em; color: var(--muted); text-transform: uppercase; }

    /* =================== RESPONSIVE =================== */
    @media (max-width: 860px) {
      .wrap { padding: 0 22px; }
      .pad { padding: 56px 0; }
      .masthead nav { display: none; }
      .hero { padding: 44px 0 56px; }
      .hero-grid, .matrix-wrap, .pyr-wrap, .cta-grid { grid-template-columns: 1fr; gap: 38px; }
      .hero-meta { flex-wrap: wrap; }
      .hero-meta div { flex: 1 1 50%; border-bottom: 1px solid var(--navy-line); }
      .matrix { margin: 30px 0 30px 70px; }
      .sec-head .left { max-width: 100%; }
      .kpi-row { grid-template-columns: 1fr 1fr; }
      .kpi:nth-child(2) { border-right: none; }
      .kpi:nth-child(1), .kpi:nth-child(2) { border-bottom: 1px solid var(--navy-line); }
      .charts { grid-template-columns: 1fr; }
      .partners { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .kpi-row { grid-template-columns: 1fr; }
      .kpi { border-right: none; border-bottom: 1px solid var(--navy-line); }
      .matrix { margin-left: 60px; }
    }
  </style>
</head>
<body>
  <!-- ====== COMMON DEMO BAR ====== -->
  <div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
    <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
    <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 03 · 비전파트너스 — 1980년대 전략 컨설팅 보고서 스타일</span>
    <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
  </div>
  <div style="height:40px;"></div>

  <!-- ====== MASTHEAD ====== -->
  <div class="wrap">
    <header class="masthead">
      <div>
        <div class="brandmark">비전<b>파트너스</b></div>
        <span class="brand-en">Vision Partners · Strategy & Management Consulting</span>
      </div>
      <nav>
        <span>Services</span>
        <span>Approach</span>
        <span>Impact</span>
        <span>Contact</span>
      </nav>
    </header>
  </div>

  <!-- ====== HERO / EXHIBIT 0 ====== -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Exhibit 0 · Governing Thought</span>
          <h1>경영진의 결정에<br /><span class="hl">근거</span>를 더합니다.</h1>
          <p class="lede">
            비전파트너스는 1992년 이래 한국 대기업·중견기업의 전략·운영·조직·디지털 의제를
            구조화된 사실 기반으로 풀어 온 경영 컨설팅 펌입니다.
            추측이 아닌 분석으로, 보고서가 아닌 의사결정으로 끝맺습니다.
          </p>
          <div class="hero-meta">
            <div>
              <div class="k">Founded</div>
              <div class="v">1992</div>
            </div>
            <div>
