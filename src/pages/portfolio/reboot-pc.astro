            <div class="field">
              <label for="symptom">증상 / 요청 사항</label>
              <textarea id="symptom" placeholder="예) 전원은 들어오는데 화면이 안 나와요. 본체에서 삑 소리가 납니다."></textarea>
            </div>
            <button class="btn btn-primary" type="submit">견적 요청 보내기</button>
          </form>

          <div>
            <div class="info-well bevel-in">
              <div class="info-row">
                <svg class="ir-icon" viewBox="0 0 18 18" shape-rendering="crispEdges" aria-hidden="true"><rect x="3" y="3" width="12" height="12" fill="#008000" stroke="#000"/><path d="M6 6 l2 3 -1 1 q3 3 5 2 l1 -2 3 1" fill="none" stroke="#fff" stroke-width="1.5"/></svg>
