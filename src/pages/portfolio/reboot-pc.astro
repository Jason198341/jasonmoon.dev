                <svg class="ir-icon" viewBox="0 0 18 18" shape-rendering="crispEdges" aria-hidden="true"><path d="M9 2 C5 2 3 5 3 8 C3 12 9 16 9 16 C9 16 15 12 15 8 C15 5 13 2 9 2 Z" fill="#ff0000" stroke="#000"/><circle cx="9" cy="8" r="2" fill="#fff"/></svg>
