        <span class="menu-dots"></span>
        <span class="menu-price">3,500원</span>
      </div>
      <div class="menu-row">
        <span class="menu-emoji">🧀</span>
        <span class="menu-name">치즈떡볶이</span>
        <span class="menu-dots"></span>
        <span class="menu-price">4,500원</span>
      </div>
      <div class="menu-row">
        <span class="menu-emoji">🍢</span>
        <span class="menu-name">모둠튀김 (5종)</span>
        <span class="menu-dots"></span>
        <span class="menu-price">3,000원</span>
      </div>
      <div class="menu-row">
        <span class="menu-emoji">🩸</span>
        <span class="menu-name">찰순대 한접시</span>
        <span class="menu-dots"></span>
        <span class="menu-price">4,000원</span>
      </div>
      <div class="menu-row">
        <span class="menu-emoji">🍜</span>
        <span class="menu-name">쫄면·비빔국수</span>
        <span class="menu-dots"></span>
        <span class="menu-price">4,000원</span>
      </div>
      <div class="menu-row">
        <span class="menu-emoji">🥚</span>
        <span class="menu-name">어묵 국물 <span class="menu-hot">무한리필</span></span>
        <span class="menu-dots"></span>
        <span class="menu-price">500원</span>
      </div>
      <div class="menu-row">
        <span class="menu-emoji">🍙</span>
        <span class="menu-name">옛날김밥 한줄</span>
        <span class="menu-dots"></span>
        <span class="menu-price">2,500원</span>
      </div>
    </div>
  </div>
</section>

<!-- 3. 세트 (봉지 카드) -->
<section class="sets">
  <div class="wrap">
    <div class="sec-head">
      <h2>알뜰 세트</h2>
      <p>～ 배고픈 학생 환영! 둘이 먹어도 든든 ～</p>
    </div>
    <div class="set-grid">
