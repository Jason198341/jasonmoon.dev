<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>추억의 분식 — 신림동 떡볶이·포장마차</title>
<meta name="description" content="80년대 그 골목 그 맛 그대로. 추억의 분식. 신림동 떡볶이·순대·튀김·포장마차." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Jua&family=Gaegu:wght@400;700&display=swap" rel="stylesheet" />
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

  :root{
    --red:#ff2e00;
    --red-deep:#cc1f00;
    --yellow:#ffe000;
    --yellow-deep:#ffb800;
    --blue:#0048ff;
    --green:#00b14f;
    --cream:#fff6d8;
    --ink:#1a1208;
    --pink:#ff4d9d;
  }

  html{scroll-behavior:smooth}

  body{
    font-family:'Jua',sans-serif;
    color:var(--ink);
    background:var(--cream);
    line-height:1.5;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }

  /* 봉지 인쇄 망점 텍스처 (오프셋 인쇄 거친 느낌) */
  .halftone{
    background-image:radial-gradient(rgba(0,0,0,0.22) 1.2px, transparent 1.3px);
    background-size:6px 6px;
  }

  .wrap{max-width:1080px;margin:0 auto;padding:0 20px}

  h1,h2,h3{font-family:'Black Han Sans',sans-serif;font-weight:400;line-height:1.05;letter-spacing:-0.5px}

  /* ============ 공통 별/폭발 말풍선 ============ */
  .star-burst{
    display:inline-flex;align-items:center;justify-content:center;
    font-family:'Black Han Sans',sans-serif;
    color:#fff;text-align:center;
    background:var(--red);
    width:96px;height:96px;
    clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);
    transform:rotate(-8deg);
    font-size:20px;line-height:1;
    text-shadow:1px 1px 0 var(--red-deep);
  }

  .price-pop{
    position:relative;display:inline-block;
    background:var(--yellow);
    color:var(--red);
    font-family:'Black Han Sans',sans-serif;
    padding:4px 14px;border:3px solid var(--ink);
    border-radius:24px;
    transform:rotate(-3deg);
    box-shadow:3px 3px 0 var(--ink);
    white-space:nowrap;
  }

  /* ============ 데모바 아래 콘텐츠 시작 ============ */

  /* ============ 1. 간판 히어로 ============ */
  .hero{
    position:relative;
    background:
      repeating-linear-gradient(135deg, var(--red) 0 40px, var(--red-deep) 40px 80px);
    padding:64px 0 90px;
    text-align:center;
    overflow:hidden;
    border-bottom:10px solid var(--yellow);
  }
  .hero::before{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(rgba(0,0,0,0.18) 1.4px, transparent 1.5px);
    background-size:7px 7px;
    pointer-events:none;mix-blend-mode:multiply;
  }
  .hero-top-strip{
    display:flex;justify-content:center;gap:10px;flex-wrap:wrap;
    margin-bottom:18px;position:relative;z-index:2;
  }
  .strip-tag{
    background:var(--yellow);color:var(--red);
    font-family:'Black Han Sans',sans-serif;
    padding:4px 14px;border-radius:20px;
    font-size:14px;border:2px solid var(--ink);
    transform:rotate(-2deg);
  }
  .strip-tag:nth-child(2){transform:rotate(2deg);background:var(--blue);color:#fff}
  .strip-tag:nth-child(3){transform:rotate(-1deg);background:var(--green);color:#fff}

  .signboard{
    position:relative;z-index:2;
    display:inline-block;
    background:var(--cream);
    padding:28px 44px 34px;
    border:8px solid var(--ink);
    border-radius:14px;
    box-shadow:0 14px 0 rgba(0,0,0,0.35), 10px 10px 0 var(--blue);
    transform:rotate(-1.5deg);
  }
  .signboard .est{
    font-family:'Gaegu',cursive;font-weight:700;
    color:var(--blue);font-size:18px;margin-bottom:4px;
  }
  .signboard h1{
    font-size:clamp(46px,11vw,108px);
    color:var(--red);
    -webkit-text-stroke:2px var(--ink);
    text-shadow:5px 5px 0 var(--yellow);
  }
  .signboard .sub{
    font-family:'Jua',sans-serif;color:var(--ink);
    font-size:clamp(15px,3.5vw,22px);margin-top:8px;letter-spacing:2px;
  }

  .hero-sub-row{
    position:relative;z-index:2;
    margin-top:30px;display:flex;justify-content:center;align-items:center;
    gap:18px;flex-wrap:wrap;
  }
  .hero-cta{
    font-family:'Black Han Sans',sans-serif;font-size:22px;
    background:var(--yellow);color:var(--ink);
    padding:14px 30px;border:5px solid var(--ink);border-radius:50px;
    text-decoration:none;box-shadow:5px 5px 0 var(--ink);
    transform:rotate(1deg);transition:transform .12s, box-shadow .12s;
    display:inline-block;
  }
  .hero-cta:hover{transform:rotate(1deg) translate(-3px,-3px);box-shadow:8px 8px 0 var(--ink)}
  .hero-cta:active{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink)}

  /* 떠다니는 별 장식 */
  .deco-star{position:absolute;font-family:'Black Han Sans',sans-serif;color:var(--yellow);z-index:1;opacity:.9;
    text-shadow:2px 2px 0 var(--ink)}
  .ds1{top:40px;left:6%;font-size:40px;transform:rotate(-15deg)}
  .ds2{bottom:50px;right:8%;font-size:56px;transform:rotate(12deg);color:var(--blue)}
  .ds3{top:120px;right:14%;font-size:30px;transform:rotate(20deg);color:#fff}

  /* CSS 떡볶이 일러스트 */
  .ttbk{position:absolute;bottom:-6px;left:4%;z-index:2;transform:rotate(-6deg)}
  .ttbk-bowl{
    width:150px;height:78px;background:var(--red);
    border:6px solid var(--ink);border-radius:0 0 80px 80px / 0 0 60px 60px;
    position:relative;box-shadow:inset 0 -8px 0 var(--red-deep);
  }
  .ttbk-bowl::before{
    content:"";position:absolute;top:-14px;left:-6px;right:-6px;height:20px;
    background:var(--yellow-deep);border:6px solid var(--ink);border-radius:40px;
  }
  .ttbk-cake{
    position:absolute;width:20px;height:30px;background:#fff;
    border:4px solid var(--ink);border-radius:10px;top:-2px;
  }
  .tc1{left:30px;transform:rotate(-12deg)}
  .tc2{left:62px;top:6px;transform:rotate(15deg);background:#fff3e0}
  .tc3{left:96px;top:0;transform:rotate(-6deg)}

  /* ============ 섹션 공통 ============ */
  section{position:relative}
  .sec-head{text-align:center;margin:0 auto 36px;position:relative}
  .sec-head h2{
    display:inline-block;
    font-size:clamp(32px,7vw,58px);
    color:var(--ink);
    background:var(--yellow);
    padding:8px 28px;
    border:5px solid var(--ink);border-radius:10px;
    transform:rotate(-1deg);
    box-shadow:6px 6px 0 var(--red);
  }
  .sec-head p{font-family:'Gaegu',cursive;font-weight:700;font-size:18px;margin-top:14px;color:var(--blue)}

  /* ============ 2. 메뉴판 ============ */
  .menu{background:var(--blue);padding:70px 0;border-top:10px solid var(--ink);border-bottom:10px solid var(--ink)}
  .menu .sec-head h2{box-shadow:6px 6px 0 var(--red);background:var(--yellow)}
  .menu .sec-head p{color:var(--yellow)}

  .menu-board{
    background:var(--ink);
    border:8px solid var(--yellow);
    border-radius:12px;
    padding:30px 28px;
    box-shadow:0 16px 0 rgba(0,0,0,0.35);
    max-width:760px;margin:0 auto;
  }
  .menu-board-title{
    text-align:center;font-family:'Black Han Sans',sans-serif;
    color:var(--yellow);font-size:30px;margin-bottom:6px;letter-spacing:4px;
  }
  .menu-board-note{text-align:center;font-family:'Gaegu',cursive;font-weight:700;color:var(--cream);margin-bottom:22px}
  .menu-row{
    display:flex;align-items:flex-end;gap:10px;
    padding:11px 4px;color:var(--cream);
    font-size:21px;
  }
  .menu-row + .menu-row{border-top:2px dashed rgba(255,246,216,0.35)}
  .menu-name{font-family:'Jua',sans-serif;white-space:nowrap}
  .menu-emoji{font-size:24px}
  .menu-dots{flex:1;border-bottom:3px dotted rgba(255,246,216,0.5);transform:translateY(-6px)}
  .menu-price{font-family:'Black Han Sans',sans-serif;color:var(--yellow);white-space:nowrap}
  .menu-hot{color:var(--red);font-family:'Black Han Sans',sans-serif;font-size:14px;
    background:var(--yellow);padding:1px 7px;border-radius:8px;transform:rotate(-4deg);align-self:center}

  /* ============ 3. 세트 (불량식품 봉지 카드) ============ */
  .sets{background:var(--cream);padding:74px 0}
  .set-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:26px;margin-top:10px}
  .set-card{
    position:relative;
    border:6px solid var(--ink);
    border-radius:8px;
    padding:26px 22px 30px;
    box-shadow:8px 8px 0 var(--ink);
    overflow:hidden;
    transform:rotate(-1deg);transition:transform .15s, box-shadow .15s;
  }
  .set-card::before{
    content:"";position:absolute;inset:0;
    background-image:radial-gradient(rgba(0,0,0,0.16) 1.3px, transparent 1.4px);
    background-size:6px 6px;mix-blend-mode:multiply;pointer-events:none;
  }
  .set-card:nth-child(1){background:var(--red)}
  .set-card:nth-child(2){background:var(--green);transform:rotate(1.2deg)}
  .set-card:nth-child(3){background:var(--pink);transform:rotate(-0.6deg)}
  .set-card:hover{transform:rotate(0) translate(-4px,-4px);box-shadow:12px 12px 0 var(--ink)}

  .set-ribbon{
    display:inline-block;font-family:'Black Han Sans',sans-serif;
    background:var(--yellow);color:var(--red);
    padding:3px 14px;border:3px solid var(--ink);border-radius:20px;
    transform:rotate(-3deg);font-size:15px;margin-bottom:14px;
  }
  .set-card h3{color:#fff;font-size:30px;-webkit-text-stroke:1.5px var(--ink);
    text-shadow:3px 3px 0 var(--ink);position:relative;z-index:1}
  .set-card ul{list-style:none;margin:14px 0 18px;position:relative;z-index:1}
  .set-card li{font-family:'Jua',sans-serif;color:#fff;font-size:17px;padding:3px 0;
    text-shadow:1px 1px 0 rgba(0,0,0,0.4)}
  .set-card li::before{content:"★ ";color:var(--yellow)}
  .set-price-line{display:flex;align-items:center;gap:12px;position:relative;z-index:1}
  .set-old{font-family:'Jua',sans-serif;color:#ffd;text-decoration:line-through;opacity:.8;font-size:17px}

  /* ============ 4. 매장 ============ */
  .store{background:var(--green);padding:74px 0;border-top:10px solid var(--ink);border-bottom:10px solid var(--ink)}
  .store .sec-head h2{box-shadow:6px 6px 0 var(--blue)}
  .store .sec-head p{color:var(--yellow)}
  .store-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center}
  @media(max-width:720px){.store-grid{grid-template-columns:1fr}}

  .pojang{
    background:var(--cream);border:7px solid var(--ink);border-radius:12px;
    padding:8px;box-shadow:8px 8px 0 var(--ink);
  }
  /* CSS 포장마차 천막 일러스트 */
  .tent-scene{position:relative;height:240px;overflow:hidden;border-radius:6px;background:#2a3550}
  .tent-sky{position:absolute;inset:0;background:linear-gradient(#1b2238, #3a2a4a)}
  .tent-moon{position:absolute;top:24px;right:34px;width:48px;height:48px;border-radius:50%;
    background:var(--yellow);box-shadow:0 0 30px rgba(255,224,0,0.6)}
  .tent-roof{
    position:absolute;bottom:88px;left:50%;transform:translateX(-50%);
    width:300px;max-width:90%;height:46px;
    background:repeating-linear-gradient(90deg,var(--red) 0 28px,var(--cream) 28px 56px);
    border:5px solid var(--ink);border-radius:8px 8px 0 0;
  }
  .tent-roof::after{content:"";position:absolute;bottom:-14px;left:-5px;right:-5px;height:14px;
    background:repeating-linear-gradient(90deg,var(--ink) 0 14px,transparent 14px 28px)}
  .tent-body{position:absolute;bottom:0;left:50%;transform:translateX(-50%);
    width:290px;max-width:88%;height:90px;background:var(--cream);
    border:5px solid var(--ink);border-bottom:none}
  .tent-sign{position:absolute;bottom:30px;left:50%;transform:translateX(-50%) rotate(-2deg);
    font-family:'Black Han Sans',sans-serif;color:var(--red);font-size:26px;z-index:2;
    text-shadow:2px 2px 0 var(--yellow)}
  .tent-lamp{position:absolute;bottom:140px;left:20%;width:14px;height:14px;border-radius:50%;
    background:var(--yellow);box-shadow:0 0 16px var(--yellow), 60px -10px 0 var(--red),
    120px 6px 0 var(--green), 180px -6px 0 var(--blue)}

  .store-info{font-family:'Jua',sans-serif}
  .store-info h3{font-size:34px;color:var(--cream);-webkit-text-stroke:1px var(--ink);text-shadow:3px 3px 0 var(--ink)}
  .info-card{background:var(--cream);border:5px solid var(--ink);border-radius:10px;
    padding:18px 20px;margin-top:16px;box-shadow:5px 5px 0 var(--ink)}
  .info-line{display:flex;gap:12px;align-items:baseline;padding:6px 0;font-size:18px}
  .info-line + .info-line{border-top:2px dashed rgba(26,18,8,0.25)}
  .info-key{font-family:'Black Han Sans',sans-serif;color:var(--red);min-width:74px}

  /* ============ 5. 연락 ============ */
  .contact{
    background:repeating-linear-gradient(45deg,var(--yellow) 0 36px,var(--yellow-deep) 36px 72px);
    padding:80px 0;text-align:center;position:relative;overflow:hidden;
  }
  .contact::before{content:"";position:absolute;inset:0;
    background-image:radial-gradient(rgba(0,0,0,0.14) 1.3px, transparent 1.4px);
    background-size:6px 6px;mix-blend-mode:multiply;pointer-events:none}
  .contact .inner{position:relative;z-index:2;max-width:640px;margin:0 auto}
  .contact h2{font-size:clamp(34px,8vw,64px);color:var(--red);-webkit-text-stroke:2px var(--ink);
    text-shadow:5px 5px 0 #fff}
  .contact .lead{font-family:'Gaegu',cursive;font-weight:700;font-size:20px;margin:14px 0 28px;color:var(--ink)}

  .phone-box{
    display:inline-block;background:var(--ink);color:var(--yellow);
    font-family:'Black Han Sans',sans-serif;font-size:clamp(30px,9vw,56px);
    padding:14px 34px;border-radius:14px;border:6px solid var(--red);
    box-shadow:8px 8px 0 var(--red);transform:rotate(-1.5deg);
    text-decoration:none;letter-spacing:2px;
  }
  .phone-box small{display:block;font-family:'Jua',sans-serif;font-size:16px;color:var(--cream);letter-spacing:1px}

  .contact-tags{margin-top:30px;display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
  .ct{font-family:'Black Han Sans',sans-serif;background:#fff;border:4px solid var(--ink);
    border-radius:30px;padding:8px 20px;font-size:17px;box-shadow:4px 4px 0 var(--ink)}
  .ct:nth-child(1){color:var(--red);transform:rotate(-2deg)}
  .ct:nth-child(2){color:var(--blue);transform:rotate(2deg)}
  .ct:nth-child(3){color:var(--green);transform:rotate(-1deg)}

  /* ============ 푸터 ============ */
  footer{background:var(--ink);color:var(--cream);text-align:center;padding:34px 20px;font-family:'Jua',sans-serif}
  footer .big{font-family:'Black Han Sans',sans-serif;color:var(--yellow);font-size:24px;margin-bottom:8px}
  footer small{display:block;color:#bba;margin-top:10px;font-size:13px;line-height:1.7}

  @media(max-width:560px){
    .ttbk{display:none}
    .deco-star{display:none}
    .menu-row{font-size:18px;flex-wrap:wrap}
  }
</style>
</head>
<body>

<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
  <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
  <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 34 · 추억의 분식 — 80년대 한국 불량식품 봉지 스타일</span>
  <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
</div>
<div style="height:40px;"></div>

<!-- 1. 간판 히어로 -->
<section class="hero">
  <span class="deco-star ds1">★</span>
  <span class="deco-star ds2">✦</span>
  <span class="deco-star ds3">★</span>
  <div class="wrap">
    <div class="hero-top-strip">
      <span class="strip-tag">신림동 그 골목</span>
      <span class="strip-tag">현금·계좌이체 환영</span>
      <span class="strip-tag">포장 됩니다</span>
    </div>
    <div class="signboard">
      <div class="est">since 1986 · 3代째 그 맛</div>
      <h1>추억의 분식</h1>
      <div class="sub">떡 볶 이 · 순 대 · 튀 김 · 포 장 마 차</div>
    </div>
    <div class="hero-sub-row">
      <span class="star-burst">매운맛<br>100원!</span>
      <a href="#menu" class="hero-cta">오늘의 메뉴 보기 ▼</a>
    </div>
  </div>
  <div class="ttbk" aria-hidden="true">
    <div class="ttbk-bowl">
      <span class="ttbk-cake tc1"></span>
      <span class="ttbk-cake tc2"></span>
      <span class="ttbk-cake tc3"></span>
    </div>
  </div>
</section>

<!-- 2. 메뉴판 -->
<section class="menu" id="menu">
  <div class="wrap">
    <div class="sec-head">
      <h2>오늘의 메뉴</h2>
      <p>～ 변하지 않는 그 가격, 그 맛 ～</p>
    </div>
    <div class="menu-board halftone">
      <div class="menu-board-title">분 식 메 뉴</div>
