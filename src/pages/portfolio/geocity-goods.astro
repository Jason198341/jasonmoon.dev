<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>★☆ 지오시티 - 홍대 문구·소품샵 ☆★ 어서오세요!!</title>
<meta name="description" content="지오시티 문구소품샵 홈페이지에 오신것을 환영합니다 (_ _)" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Jua&family=Press+Start+2P&display=swap" rel="stylesheet" />
<style>
  /* ============ 90년대 개인 홈페이지 갬성 ============ */
  :root{
    --hotpink:#ff2e88;
    --cyber:#00e5ff;
    --lemon:#ffe600;
    --lime:#39ff14;
    --grape:#9d00ff;
    --tangerine:#ff7a00;
    --ink:#1a0033;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Gaegu','Comic Sans MS','Times New Roman',cursive,serif;
    color:var(--ink);
    /* 타일 반복 배경 — 노란 체크 + 별 패턴 */
    background-color:#fff0a8;
    background-image:
      repeating-linear-gradient(45deg, rgba(255,46,136,.08) 0 14px, rgba(0,229,255,.08) 14px 28px),
      radial-gradient(circle at 10px 10px, rgba(157,0,255,.18) 2px, transparent 3px);
    background-size:40px 40px, 20px 20px;
    font-size:18px;
    line-height:1.5;
    word-break:keep-all;
  }

  /* ====== 흐르는 텍스트 (marquee 풍) ====== */
  .marquee{
    overflow:hidden;
    white-space:nowrap;
    background:var(--ink);
    color:var(--lemon);
    border-top:3px ridge var(--lemon);
    border-bottom:3px ridge var(--lemon);
    font-family:'Jua',sans-serif;
    font-size:15px;
    letter-spacing:.05em;
    padding:6px 0;
  }
  .marquee span{
    display:inline-block;
    padding-left:100%;
    animation:scroll-left 18s linear infinite;
  }
  @keyframes scroll-left{
    0%{transform:translateX(0);}
    100%{transform:translateX(-100%);}
  }

  /* ====== 무지개 구분선 ====== */
  hr.rainbow{
    height:6px;
    border:0;
    margin:18px 0;
    background:linear-gradient(90deg,#ff2e88,#ff7a00,#ffe600,#39ff14,#00e5ff,#9d00ff,#ff2e88);
    background-size:200% 100%;
    border-radius:3px;
    animation:rainbow-slide 4s linear infinite;
  }
  @keyframes rainbow-slide{
    0%{background-position:0% 50%;}
    100%{background-position:200% 50%;}
  }

  /* ====== 반짝이 별 ====== */
  .twinkle{display:inline-block;animation:twinkle 1.4s ease-in-out infinite;}
  .twinkle:nth-child(2){animation-delay:.3s;}
  .twinkle:nth-child(3){animation-delay:.6s;}
  .twinkle:nth-child(4){animation-delay:.9s;}
  @keyframes twinkle{
    0%,100%{opacity:1;transform:scale(1) rotate(0deg);}
    50%{opacity:.3;transform:scale(1.4) rotate(20deg);}
  }

  /* ====== 레이아웃 (테이블 느낌) ====== */
  .page{
    max-width:880px;
    margin:18px auto;
    padding:0 12px 60px;
  }
  .frame{
    border:5px double var(--grape);
    background:#fffef5;
    padding:14px;
    box-shadow:6px 6px 0 var(--ink);
  }

  /* ====== 히어로 ====== */
  .hero{
    text-align:center;
    background:
      radial-gradient(circle at 50% 0%, rgba(0,229,255,.35), transparent 60%),
      repeating-linear-gradient(0deg, #fff 0 8px, #ffe9f4 8px 16px);
    border:4px ridge var(--hotpink);
    padding:22px 14px;
    border-radius:8px;
  }
  .hero h1{
    font-family:'Jua',sans-serif;
    font-size:clamp(30px,7vw,54px);
    margin:6px 0 4px;
    color:var(--hotpink);
    text-shadow:2px 2px 0 var(--lemon), 4px 4px 0 var(--cyber);
    line-height:1.1;
  }
  .hero .sub{
    font-size:clamp(15px,3vw,20px);
    color:var(--grape);
    font-weight:700;
  }
  .blink{animation:blink 1s steps(2,start) infinite;}
  @keyframes blink{to{visibility:hidden;}}

  /* ====== 공사중 ====== */
  .construction{
    display:inline-block;
    margin:12px auto;
    background:repeating-linear-gradient(45deg,#1a0033 0 16px,#ffe600 16px 32px);
    color:#fff;
    padding:8px 16px;
    border:3px solid #1a0033;
    border-radius:6px;
    font-family:'Jua',sans-serif;
    font-size:14px;
    transform:rotate(-3deg);
    box-shadow:3px 3px 0 rgba(0,0,0,.3);
  }
  .construction b{
    background:#1a0033;
    padding:2px 8px;
    border-radius:4px;
    display:inline-block;
  }
  .hardhat{display:inline-block;animation:bob 1.2s ease-in-out infinite;}
  @keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}

  /* ====== 방문자 카운터 ====== */
  .counter{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:#000;
    color:#39ff14;
    font-family:'Press Start 2P','Courier New',monospace;
    font-size:13px;
    padding:8px 12px;
    border:3px outset #888;
    border-radius:4px;
    margin-top:14px;
  }
  .counter .digits{letter-spacing:2px;}

  /* ====== 섹션 제목 ====== */
  h2.sec{
    font-family:'Jua',sans-serif;
    font-size:clamp(22px,5vw,30px);
    color:#fff;
    background:linear-gradient(90deg,var(--grape),var(--hotpink));
    display:inline-block;
    padding:6px 18px;
    border-radius:20px 4px 20px 4px;
    box-shadow:3px 3px 0 var(--ink);
    margin:8px 0 4px;
    transform:rotate(-1deg);
  }

  /* ====== 신상 소품 그리드 ====== */
  .goods{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:14px;
    margin-top:10px;
  }
  .good{
    background:#fff;
    border:3px dotted var(--cyber);
    border-radius:8px;
    padding:12px 10px;
    text-align:center;
    transition:transform .15s, box-shadow .15s, border-color .15s;
  }
  .good:hover{
    transform:translateY(-4px) rotate(2deg);
    box-shadow:4px 6px 0 var(--hotpink);
    border-color:var(--hotpink);
  }
  .good .emo{font-size:48px;display:block;line-height:1;margin-bottom:6px;}
  .good .name{font-weight:700;font-size:18px;color:var(--ink);}
  .good .price{
    color:var(--hotpink);
    font-weight:700;
    font-family:'Jua',sans-serif;
    font-size:18px;
  }
  .good .tag{
    display:inline-block;
    font-size:12px;
    background:var(--lemon);
    color:var(--ink);
    padding:1px 7px;
    border-radius:10px;
    margin-top:4px;
  }

  /* ====== 베스트 (순위) ====== */
  .best{list-style:none;padding:0;margin:10px 0 0;}
  .best li{
    background:#fffef5;
    border-left:8px solid var(--tangerine);
    margin-bottom:8px;
    padding:10px 12px;
    border-radius:0 8px 8px 0;
    box-shadow:2px 2px 0 rgba(157,0,255,.25);
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }
  .best .rank{
    font-family:'Press Start 2P',monospace;
    font-size:14px;
    color:#fff;
    background:var(--grape);
    width:34px;height:34px;
    display:inline-flex;align-items:center;justify-content:center;
    border-radius:50%;
    flex-shrink:0;
  }
  .best li:nth-child(1) .rank{background:var(--hotpink);}
  .best li:nth-child(2) .rank{background:var(--cyber);color:var(--ink);}
  .best li:nth-child(3) .rank{background:var(--lime);color:var(--ink);}
  .best .bname{font-weight:700;flex:1;min-width:120px;}
  .best .bprice{color:var(--hotpink);font-weight:700;}

  /* ====== 방명록 풍 ====== */
  .guestbook{
    background:repeating-linear-gradient(0deg,#fff 0 30px,#eaf6ff 30px 31px);
    border:3px solid var(--cyber);
    border-radius:8px;
    padding:14px;
    margin-top:10px;
  }
  .gentry{
    margin-bottom:12px;
    padding-bottom:8px;
    border-bottom:2px dashed #b8d8e8;
  }
  .gentry:last-child{border-bottom:0;margin-bottom:0;}
  .gentry .who{font-weight:700;color:var(--grape);}
  .gentry .when{font-size:13px;color:#888;}
  .gentry .msg{margin-top:2px;}
  .gform{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;}
  .gform input{
    flex:1;min-width:120px;
    border:3px inset #ccc;
    padding:8px;
    font-family:inherit;
    font-size:16px;
    border-radius:4px;
  }
  .gform button{
    background:var(--hotpink);
    color:#fff;
    border:3px outset var(--hotpink);
    padding:8px 18px;
    font-family:'Jua',sans-serif;
    font-size:16px;
    border-radius:4px;
    cursor:pointer;
  }
  .gform button:hover{background:var(--grape);border-color:var(--grape);}
  .gform button:active{border-style:inset;}

  /* ====== 연락 ====== */
  .contact{
    text-align:center;
    background:
      radial-gradient(circle at 50% 100%, rgba(255,230,0,.4), transparent 60%),
      #fff5fb;
    border:4px ridge var(--grape);
    border-radius:8px;
    padding:20px 14px;
    margin-top:10px;
  }
  .contact p{margin:6px 0;font-size:18px;}
  .contact .big{
    font-family:'Jua',sans-serif;
    font-size:clamp(22px,5vw,32px);
    color:var(--hotpink);
  }
  .badges{margin-top:14px;display:flex;justify-content:center;gap:8px;flex-wrap:wrap;}
  .badge{
    font-family:'Press Start 2P',monospace;
    font-size:10px;
    color:#fff;
    background:var(--ink);
    border:2px solid var(--cyber);
    padding:6px 8px;
    border-radius:3px;
  }
  .topbtn{
    display:inline-block;
    margin-top:16px;
    background:var(--cyber);
    color:var(--ink);
    font-weight:700;
    text-decoration:none;
    padding:8px 18px;
    border:3px outset var(--cyber);
    border-radius:4px;
  }
  .topbtn:hover{background:var(--lemon);border-color:var(--lemon);}

  footer.retro{
    text-align:center;
    font-size:13px;
    color:#7a5fa0;
    margin-top:18px;
  }

  @media (max-width:520px){
    body{font-size:16px;}
    .frame{padding:8px;}
  }
</style>
</head>
