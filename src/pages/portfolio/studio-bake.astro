---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>스튜디오 베이크 — LAB NOTE #47</title>
  <meta name="description" content="성수동 베이커리·발효 공방 스튜디오 베이크. 1970년대 실험노트로 기록한 빵의 레시피." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --paper: #f7f3e8;
      --paper-shade: #efe9d8;
      --ink: #3a3326;
      --ink-soft: #6b6051;
      --grid: rgba(58, 51, 38, 0.07);
      --grid-major: rgba(58, 51, 38, 0.12);
      --teal: #1c7a72;
      --teal-soft: rgba(28, 122, 114, 0.12);
      --red: #b23b2e;
      --red-soft: rgba(178, 59, 46, 0.10);
      --coffee: rgba(120, 82, 40, 0.10);
      --cell: 26px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Spectral', Georgia, serif;
      color: var(--ink);
      background-color: var(--paper);
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px),
        linear-gradient(var(--grid-major) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-major) 1px, transparent 1px);
      background-size:
        var(--cell) var(--cell),
        var(--cell) var(--cell),
        calc(var(--cell) * 5) calc(var(--cell) * 5),
        calc(var(--cell) * 5) calc(var(--cell) * 5);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* paper vignette + coffee stains */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background:
        radial-gradient(circle at 82% 14%, var(--coffee) 0 38px, transparent 44px),
        radial-gradient(circle at 84% 16%, transparent 0 40px, var(--coffee) 41px 46px, transparent 50px),
        radial-gradient(circle at 12% 78%, var(--coffee) 0 26px, transparent 32px),
        radial-gradient(ellipse at 50% 0%, rgba(58,51,38,0.05), transparent 60%),
        radial-gradient(ellipse at 50% 100%, rgba(58,51,38,0.06), transparent 55%);
    }

    .wrap { position: relative; z-index: 2; max-width: 1080px; margin: 0 auto; padding: 0 24px 120px; }

    .mono { font-family: 'Courier Prime', monospace; }
    .hand { font-family: 'Caveat', cursive; }

    /* ---------- hand-written annotations ---------- */
    .annot {
      font-family: 'Caveat', cursive;
      color: var(--red);
      font-size: 1.45rem;
      line-height: 1.2;
      transform: rotate(-3deg);
      display: inline-block;
    }
    .annot.teal { color: var(--teal); }

    /* ---------- header / lab note stamp ---------- */
    .note-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px 18px;
      padding: 14px 0 10px;
      border-bottom: 2px solid var(--ink);
      margin-top: 28px;
      font-family: 'Courier Prime', monospace;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }
    .note-head .no {
      color: var(--paper);
      background: var(--red);
      padding: 3px 9px;
      font-weight: 700;
      letter-spacing: 0.1em;
      transform: rotate(-1.5deg);
    }
    .note-head .spacer { flex: 1; }

    /* ---------- hero ---------- */
    .hero { padding: 46px 0 36px; position: relative; }
    .hero .kicker {
      font-family: 'Courier Prime', monospace;
      font-size: 0.82rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--teal);
      margin-bottom: 12px;
    }
    .hero h1 {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: clamp(3.4rem, 11vw, 7rem);
      line-height: 0.92;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .hero h1 .ul {
      position: relative;
      display: inline-block;
    }
    .hero h1 .ul::after {
      content: "";
      position: absolute;
      left: -2%;
      right: -2%;
      bottom: 6px;
      height: 6px;
      background: var(--red);
      opacity: 0.55;
      border-radius: 40% 60% 50% 50% / 100% 100% 0 0;
      transform: rotate(-0.6deg);
    }
    .hero .sub {
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      max-width: 560px;
      color: var(--ink-soft);
      margin: 18px 0 0;
    }
    .hero .annot-float {
      position: absolute;
      top: 38px;
      right: 8px;
      max-width: 230px;
      text-align: right;
    }
    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 22px;
      margin-top: 30px;
      font-family: 'Courier Prime', monospace;
      font-size: 0.8rem;
      color: var(--ink-soft);
    }
    .hero-meta b { color: var(--ink); font-weight: 700; }

    /* ---------- section heads ---------- */
    .sec { padding: 56px 0 14px; scroll-margin-top: 60px; }
    .sec-tag {
      font-family: 'Courier Prime', monospace;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--teal);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }
    .sec-tag::before {
      content: "";
      width: 18px; height: 18px;
      border: 2px solid var(--teal);
      display: inline-block;
    }
    .sec h2 {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: clamp(2.4rem, 6vw, 3.6rem);
      line-height: 1;
      color: var(--ink);
      margin-bottom: 18px;
    }
    .sec p.lead { max-width: 620px; color: var(--ink-soft); margin-bottom: 8px; }

    /* ---------- recipe card ---------- */
    .recipe {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 26px;
      margin-top: 22px;
    }
    .card {
      background: rgba(255,255,255,0.35);
      border: 2px solid var(--ink);
      padding: 22px 24px;
      position: relative;
      box-shadow: 4px 4px 0 rgba(58,51,38,0.12);
    }
    .card.dash { border-style: dashed; }
    .card h3 {
      font-family: 'Courier Prime', monospace;
      font-size: 0.92rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1.5px dashed var(--ink-soft);
    }
    .tape {
      position: absolute;
      top: -12px; left: 50%;
      transform: translateX(-50%) rotate(-2deg);
      background: rgba(28,122,114,0.18);
      border: 1px solid rgba(28,122,114,0.3);
      padding: 2px 18px;
      font-family: 'Courier Prime', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      color: var(--teal);
    }
    .ingredient {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: 'Courier Prime', monospace;
      font-size: 0.88rem;
      padding: 5px 0;
      border-bottom: 1px dotted rgba(58,51,38,0.25);
    }
    .ingredient .name { color: var(--ink); }
    .ingredient .pct { color: var(--teal); font-weight: 700; }
    .ingredient .g { color: var(--ink-soft); font-size: 0.8rem; }

    .calc {
      margin-top: 18px;
      font-family: 'Caveat', cursive;
      font-size: 1.5rem;
      color: var(--red);
      line-height: 1.5;
      transform: rotate(-0.8deg);
    }
    .calc .eq { color: var(--ink-soft); }
    .calc .res {
      background: var(--red);
      color: var(--paper);
      padding: 0 8px;
      transform: rotate(-1deg);
      display: inline-block;
    }

    /* ---------- menu price list ---------- */
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 4px 48px;
      margin-top: 18px;
    }
    .menu-item {
      display: flex;
      align-items: baseline;
      gap: 8px;
      padding: 11px 0;
      border-bottom: 1.5px dotted rgba(58,51,38,0.3);
    }
    .menu-item .mn { font-weight: 600; font-size: 1.08rem; color: var(--ink); white-space: nowrap; }
    .menu-item .dots { flex: 1; border-bottom: 2px dotted rgba(58,51,38,0.35); transform: translateY(-4px); }
    .menu-item .mp {
      font-family: 'Caveat', cursive;
      font-size: 1.7rem;
      color: var(--red);
      font-weight: 700;
      white-space: nowrap;
      transform: rotate(-2deg);
    }
    .menu-item small { display: block; font-family: 'Spectral', serif; font-size: 0.78rem; color: var(--ink-soft); font-weight: 400; }
    .menu-note {
      margin-top: 16px;
      font-family: 'Caveat', cursive;
      font-size: 1.35rem;
      color: var(--teal);
      transform: rotate(-1deg);
    }

    /* ---------- process flow ---------- */
    .flow {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      gap: 4px;
      margin-top: 26px;
    }
    .step {
      flex: 1 1 150px;
      min-width: 140px;
      text-align: center;
      position: relative;
    }
    .step .num {
      font-family: 'Courier Prime', monospace;
      font-size: 0.72rem;
      color: var(--red);
      letter-spacing: 0.1em;
    }
    .step .ico {
      width: 78px; height: 78px;
      margin: 6px auto 8px;
      border: 2px solid var(--ink);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.4);
    }
    .step .nm { font-family: 'Caveat', cursive; font-size: 1.7rem; color: var(--ink); line-height: 1; }
    .step .dt { font-family: 'Courier Prime', monospace; font-size: 0.72rem; color: var(--teal); margin-top: 4px; }
    .arrow { align-self: center; color: var(--red); flex: 0 0 auto; }
    @media (max-width: 760px) { .arrow { transform: rotate(90deg); } }

    /* ---------- class ---------- */
    .class-box {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 26px;
      margin-top: 22px;
      align-items: start;
    }
    .checklist { list-style: none; }
    .checklist li {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      padding: 9px 0;
      font-size: 1rem;
    }
    .checklist .box {
      flex: 0 0 22px;
      width: 22px; height: 22px;
      border: 2px solid var(--ink);
      position: relative;
      margin-top: 2px;
    }
    .checklist li.done .box::after {
      content: "✓";
      position: absolute;
      inset: -8px -2px;
      font-family: 'Caveat', cursive;
      font-size: 2rem;
      color: var(--red);
      line-height: 1;
      transform: rotate(-8deg);
    }
    .checklist li.done .txt { color: var(--ink-soft); }
    .checklist .txt b { font-weight: 600; }
    .class-meta {
      font-family: 'Courier Prime', monospace;
      font-size: 0.85rem;
      line-height: 2;
    }
    .class-meta .row { display: flex; justify-content: space-between; border-bottom: 1px dotted rgba(58,51,38,0.3); }
    .class-meta .k { color: var(--ink-soft); }
    .class-meta .v { color: var(--ink); font-weight: 700; }

    /* ---------- CTA ---------- */
    .cta {
      margin-top: 56px;
      border: 2px solid var(--ink);
      background: rgba(255,255,255,0.4);
      padding: 36px 32px;
      box-shadow: 6px 6px 0 rgba(178,59,46,0.18);
      position: relative;
    }
    .cta h2 { font-family: 'Caveat', cursive; font-size: clamp(2.4rem, 6vw, 3.4rem); line-height: 1; margin-bottom: 14px; }
    .cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 18px; }
    .info-block h4 {
      font-family: 'Courier Prime', monospace;
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--teal);
      margin-bottom: 8px;
    }
    .info-block p { font-family: 'Courier Prime', monospace; font-size: 0.92rem; line-height: 1.9; color: var(--ink); }
    .hours-row { display: flex; justify-content: space-between; max-width: 280px; }
    .hours-row.closed { color: var(--red); }
    .big-phone {
      font-family: 'Caveat', cursive;
      font-size: 2.6rem;
      font-weight: 700;
      color: var(--red);
      line-height: 1;
      transform: rotate(-1.5deg);
      display: inline-block;
      margin: 4px 0;
    }
    .stamp {
      position: absolute;
      top: 18px; right: 22px;
      border: 3px double var(--teal);
      color: var(--teal);
      font-family: 'Courier Prime', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      padding: 8px 12px;
      text-align: center;
      transform: rotate(8deg);
      opacity: 0.8;
      line-height: 1.3;
    }

    .btn-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
    .btn {
      font-family: 'Courier Prime', monospace;
      font-size: 0.9rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 12px 22px;
      border: 2px solid var(--ink);
      display: inline-block;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .btn.primary { background: var(--red); color: var(--paper); border-color: var(--red); box-shadow: 3px 3px 0 var(--ink); }
    .btn.ghost { background: transparent; color: var(--ink); box-shadow: 3px 3px 0 rgba(58,51,38,0.15); }
    .btn:hover { transform: translate(-2px,-2px); box-shadow: 5px 5px 0 rgba(58,51,38,0.4); }

    .footer-note {
      margin-top: 60px;
      padding-top: 16px;
      border-top: 2px solid var(--ink);
      font-family: 'Courier Prime', monospace;
      font-size: 0.74rem;
      color: var(--ink-soft);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      letter-spacing: 0.05em;
    }

    /* margin notes scattered */
    .margin-note {
      font-family: 'Caveat', cursive;
      color: var(--teal);
      font-size: 1.3rem;
      transform: rotate(-2deg);
      margin: 10px 0;
    }
    .margin-note.red { color: var(--red); }

    svg .ink { stroke: var(--ink); }
    svg .teal { stroke: var(--teal); }
    svg .red { stroke: var(--red); }

    /* responsive */
    @media (max-width: 760px) {
      .recipe { grid-template-columns: 1fr; }
      .menu-grid { grid-template-columns: 1fr; }
      .class-box { grid-template-columns: 1fr; }
      .cta-grid { grid-template-columns: 1fr; }
      .hero .annot-float { position: static; max-width: none; text-align: left; margin-top: 18px; }
      .flow { flex-direction: column; }
      .step { min-width: 0; }
    }
  </style>
</head>
<body>

  <div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
    <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
    <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 07 · 스튜디오 베이크 — 1970년대 MIT 실험노트 스타일</span>
    <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
  </div>
  <div style="height:40px;"></div>

  <div class="wrap">

    <!-- ====== LAB NOTE HEADER ====== -->
    <div class="note-head">
      <span class="no">LAB NOTE #47</span>
      <span>DATE · 1974.03.12</span>
      <span>RECORDER · 문 (Baker)</span>
      <span class="spacer"></span>
      <span>SECTION · FERMENTATION LAB</span>
    </div>

    <!-- ====== ① HERO ====== -->
    <header class="hero">
      <p class="kicker">// 성수동 발효 공방 &amp; 베이커리</p>
      <h1>스튜디오 <span class="ul">베이크</span></h1>
      <p class="sub">빵은 실험이다. 밀가루·물·소금·시간 — 네 가지 변수를 매일 기록하고, 가장 잘 부푼 한 덩이를 다음 날의 기준선으로 삼는다.</p>

      <div class="annot-float">
        <span class="annot">매일 같은 빵은<br/>없다 — 어제의 기록만<br/>있을 뿐 ✎</span>
      </div>

      <div class="hero-meta">
        <span>OBSERVATION No. <b>1,847</b></span>
        <span>실온 <b>22.4°C</b> / 습도 <b>61%</b></span>
        <span>오늘의 levain pH <b>3.9</b></span>
      </div>
    </header>

    <!-- ====== ② OUR BREAD = RECIPE ====== -->
    <section class="sec" id="recipe">
      <span class="sec-tag">EXPERIMENT 02 · FORMULA</span>
      <h2>우리의 빵 = 레시피</h2>
      <p class="lead">대표 메뉴 <b>'성수 사워도우'</b>의 실제 배합표. 밀가루 무게를 100%로 둔 베이커스 퍼센트로 모든 재료를 계산한다.</p>

      <div class="recipe">
        <!-- ingredient calc card -->
        <div class="card">
          <span class="tape">FORMULA SHEET</span>
          <h3>배합 / 1 batch (4 loaves)</h3>
          <div class="ingredient"><span class="name">강력분 (제주산)</span><span class="g">800g</span><span class="pct">100%</span></div>
          <div class="ingredient"><span class="name">물 (정수 24°C)</span><span class="g">576g</span><span class="pct">72%</span></div>
          <div class="ingredient"><span class="name">르방 (levain)</span><span class="g">160g</span><span class="pct">20%</span></div>
          <div class="ingredient"><span class="name">천일염 (신안)</span><span class="g">16g</span><span class="pct">2%</span></div>
          <div class="ingredient"><span class="name">통밀 (자가제분)</span><span class="g">80g</span><span class="pct">10%</span></div>

          <div class="calc">
            발효율 = <span class="eq">물 576 ÷ 밀가루 800</span> = <span class="res">72%</span>
            <br/><span style="font-size:1.1rem;color:var(--ink-soft);">→ 수분 많을수록 크고 불규칙한 기공 ✎</span>
          </div>
        </div>

        <!-- fermentation curve card -->
        <div class="card dash">
          <span class="tape" style="background:rgba(178,59,46,0.15);border-color:rgba(178,59,46,0.3);color:var(--red);">FIG. 1 — 발효 곡선</span>
          <h3>1차 발효 — 부피 vs 시간</h3>

          <svg viewBox="0 0 360 230" width="100%" role="img" aria-label="발효 시간에 따른 반죽 부피 변화 곡선 그래프">
            <!-- axes -->
            <line class="ink" x1="40" y1="15" x2="40" y2="195" stroke-width="2"/>
            <line class="ink" x1="40" y1="195" x2="345" y2="195" stroke-width="2"/>
            <!-- y label ticks -->
            <text x="14" y="40" font-family="'Courier Prime',monospace" font-size="9" fill="#6b6051">2.0x</text>
            <text x="14" y="120" font-family="'Courier Prime',monospace" font-size="9" fill="#6b6051">1.5x</text>
            <text x="14" y="190" font-family="'Courier Prime',monospace" font-size="9" fill="#6b6051">1.0x</text>
            <!-- x ticks -->
            <text x="36" y="210" font-family="'Courier Prime',monospace" font-size="9" fill="#6b6051">0h</text>
            <text x="150" y="210" font-family="'Courier Prime',monospace" font-size="9" fill="#6b6051">2h</text>
            <text x="265" y="210" font-family="'Courier Prime',monospace" font-size="9" fill="#6b6051">4h</text>
            <!-- grid faint -->
            <line x1="40" y1="120" x2="345" y2="120" stroke="rgba(58,51,38,0.15)" stroke-dasharray="3 4"/>
            <line x1="40" y1="40" x2="345" y2="40" stroke="rgba(58,51,38,0.15)" stroke-dasharray="3 4"/>
            <!-- target zone -->
            <rect x="210" y="40" width="70" height="80" fill="rgba(28,122,114,0.10)"/>
            <text x="216" y="34" font-family="'Caveat',cursive" font-size="16" fill="#1c7a72">최적 구간</text>
            <!-- the curve -->
            <path class="red" d="M40,190 C90,185 120,170 150,140 C180,110 200,70 245,55 C290,42 320,40 340,42" fill="none" stroke-width="2.5"/>
            <!-- data points -->
            <circle cx="40" cy="190" r="3.5" fill="#b23b2e"/>
            <circle cx="150" cy="140" r="3.5" fill="#b23b2e"/>
            <circle cx="245" cy="55" r="3.5" fill="#b23b2e"/>
