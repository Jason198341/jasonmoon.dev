<!doctype html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>레이브 504 — FLUORESCENT NIGHT // 90s RAVE FLYER</title>
<meta name="description" content="레이브 504 · 90년대 레이브 플라이어 스타일 데모 — 홍대 지하에서 펼쳐지는 형광의 밤. 라인업·타임테이블·입장안내." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bungee&family=Bungee+Shade&family=Russo+One&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --black:#050505;
    --ink:#0a0a0a;
    --lime:#aaff00;
    --pink:#ff00aa;
    --cyan:#00eaff;
    --yellow:#ffee00;
    --purple:#9d00ff;
    --white:#ffffff;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    background:var(--black);
    color:var(--white);
    font-family:'Space Mono','Courier New',monospace;
    overflow-x:hidden;
    line-height:1.5;
  }
  a{color:inherit}
  ::selection{background:var(--pink);color:var(--black)}

  /* ============ SHARED ============ */
  .wrap{max-width:1100px;margin:0 auto;padding:0 20px}
  .display{font-family:'Bungee',cursive;text-transform:uppercase;line-height:0.95;letter-spacing:0.01em}
  .alt{font-family:'Russo One',sans-serif;text-transform:uppercase}
  .mono{font-family:'Space Mono',monospace}

  .section-tag{
    display:inline-block;font-family:'Space Mono',monospace;font-weight:700;
    font-size:11px;letter-spacing:0.35em;text-transform:uppercase;
    padding:5px 12px;border:2px solid var(--cyan);color:var(--cyan);
    transform:rotate(-2deg);margin-bottom:22px;
  }

  /* radial / noise background utility */
  .radial{
    background:
      radial-gradient(circle at 50% 50%, transparent 0, transparent 14px, rgba(170,255,0,0.06) 15px, transparent 16px),
      radial-gradient(circle at 50% 50%, transparent 0, transparent 34px, rgba(255,0,170,0.05) 35px, transparent 37px),
      radial-gradient(circle at 50% 50%, transparent 0, transparent 58px, rgba(0,234,255,0.045) 59px, transparent 61px),
      radial-gradient(circle at 50% 50%, transparent 0, transparent 86px, rgba(170,255,0,0.04) 87px, transparent 89px),
      radial-gradient(circle at 50% 50%, transparent 0, transparent 118px, rgba(255,0,170,0.035) 119px, transparent 121px);
    background-size:300px 300px;background-position:center;
  }

  /* smiley */
  .smiley{display:inline-block;border-radius:50%;position:relative}
  .smiley::before,.smiley::after{content:"";position:absolute}
  /* eyes via box-shadow on ::before */
  .smiley::before{
    width:14%;height:18%;top:30%;left:30%;border-radius:50%;
    background:var(--black);
    box-shadow:160% 0 0 var(--black);
  }
  .smiley::after{
    width:50%;height:30%;left:25%;top:42%;
    border:0 solid var(--black);border-bottom-width:14%;
    border-bottom-left-radius:60% 80%;border-bottom-right-radius:60% 80%;
  }

  /* ============ HERO / FLYER ============ */
  .hero{
    position:relative;min-height:100vh;padding:90px 0 70px;
    display:flex;align-items:center;justify-content:center;
    background:var(--black);overflow:hidden;
  }
  .hero-rays{
    position:absolute;inset:-40% -40%;z-index:0;
    background:repeating-conic-gradient(from 0deg at 50% 50%,
      rgba(157,0,255,0.16) 0deg 9deg,
      transparent 9deg 18deg);
    animation:spin 60s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg)}}
  .hero-glow{
    position:absolute;inset:0;z-index:0;
    background:
      radial-gradient(circle at 30% 25%, rgba(255,0,170,0.32), transparent 42%),
      radial-gradient(circle at 75% 70%, rgba(0,234,255,0.28), transparent 45%),
      radial-gradient(circle at 50% 50%, rgba(170,255,0,0.14), transparent 60%);
  }
  .flyer{
    position:relative;z-index:2;width:100%;max-width:760px;margin:0 20px;
    border:3px solid var(--lime);
    background:linear-gradient(160deg, #0c0c0c, #060606);
    box-shadow:
      0 0 0 6px var(--black),
      0 0 0 9px var(--pink),
      0 26px 80px rgba(255,0,170,0.35),
      0 0 120px rgba(0,234,255,0.18);
    padding:40px 34px 34px;
    transform:rotate(-1.2deg);
  }
  .flyer-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;margin-bottom:14px}
  .flyer-top .badge{
    font-family:'Space Mono',monospace;font-weight:700;font-size:10px;letter-spacing:0.25em;
    border:2px solid var(--cyan);color:var(--cyan);padding:5px 9px;text-transform:uppercase;
  }
  .flyer-top .badge.pink{border-color:var(--pink);color:var(--pink);transform:rotate(2deg)}

  .hero-smiley{
    width:84px;height:84px;background:var(--yellow);
    box-shadow:0 0 0 5px var(--black),0 0 0 9px var(--lime),0 0 40px rgba(170,255,0,0.6);
    transform:rotate(8deg);
  }

  .flyer h1{
    font-family:'Bungee',cursive;text-transform:uppercase;line-height:0.86;
    font-size:clamp(46px,12vw,128px);letter-spacing:-0.01em;margin:6px 0 4px;
  }
  .flyer h1 .l1{
    display:block;color:var(--lime);
    text-shadow:5px 5px 0 var(--pink), 10px 10px 0 var(--cyan);
  }
  .flyer h1 .l2{
    display:block;color:var(--white);
    -webkit-text-stroke:3px var(--pink);text-stroke:3px var(--pink);
    color:transparent;font-family:'Bungee Shade',cursive;
  }
  .flyer .sub{
    font-family:'Russo One',sans-serif;text-transform:uppercase;letter-spacing:0.18em;
    font-size:clamp(14px,3.2vw,22px);color:var(--cyan);margin:10px 0 2px;
  }
  .flyer .tagline{
    font-family:'Space Mono',monospace;font-size:13px;letter-spacing:0.06em;
    color:#cfcfcf;margin-top:6px;
  }

  .flyer-meta{
    display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:26px;
    border-top:2px dashed #333;
  }
  .flyer-meta div{
    padding:16px 10px;text-align:center;border-right:2px dashed #333;
  }
  .flyer-meta div:last-child{border-right:none}
  .flyer-meta .k{font-size:10px;letter-spacing:0.2em;color:var(--pink);text-transform:uppercase}
  .flyer-meta .v{font-family:'Russo One',sans-serif;font-size:clamp(15px,3.4vw,21px);color:var(--lime);margin-top:6px;text-transform:uppercase}

  .stickers{position:absolute;inset:0;z-index:3;pointer-events:none}
  .sticker{position:absolute;font-family:'Bungee',cursive;text-transform:uppercase;font-size:13px;
    padding:8px 12px;border-radius:50%;display:grid;place-items:center;text-align:center;line-height:1;
    box-shadow:0 6px 24px rgba(0,0,0,0.5)}
  .st1{top:-14px;right:34px;background:var(--cyan);color:var(--black);width:88px;height:88px;transform:rotate(-14deg);font-size:12px}
  .st2{bottom:-16px;left:24px;background:var(--pink);color:var(--white);width:96px;height:96px;transform:rotate(12deg);font-size:13px}

  /* ============ MARQUEE ============ */
  .marquee{
    background:var(--lime);color:var(--black);overflow:hidden;white-space:nowrap;
    border-top:4px solid var(--black);border-bottom:4px solid var(--black);
    transform:rotate(-1deg) scale(1.03);margin:60px 0;
  }
  .marquee .track{display:inline-block;padding:10px 0;animation:scroll 18s linear infinite;
    font-family:'Bungee',cursive;text-transform:uppercase;font-size:22px;letter-spacing:0.04em}
  .marquee .track span{margin:0 22px}
  .marquee .track span::after{content:"◉";margin-left:22px;color:var(--pink)}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ============ LINEUP ============ */
  .lineup{padding:30px 0 40px;position:relative}
  .lineup .head{text-align:center;margin-bottom:40px}
  .lineup h2{font-family:'Bungee',cursive;text-transform:uppercase;font-size:clamp(34px,8vw,76px);color:var(--white);
    text-shadow:4px 4px 0 var(--purple), 8px 8px 0 var(--cyan)}
  .dj-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
  .dj{
    position:relative;border:3px solid var(--white);padding:24px 20px 22px;
    background:var(--ink);overflow:hidden;transition:transform .15s ease;
  }
  .dj:nth-child(3n+1){transform:rotate(-1.5deg);border-color:var(--lime)}
  .dj:nth-child(3n+2){transform:rotate(1.2deg);border-color:var(--pink)}
  .dj:nth-child(3n+3){transform:rotate(-0.6deg);border-color:var(--cyan)}
  .dj:hover{transform:rotate(0) scale(1.03);z-index:5}
  .dj .glow{position:absolute;inset:0;opacity:0.5;
    background:radial-gradient(circle at 70% 0%, rgba(157,0,255,0.4), transparent 60%)}
  .dj .rank{position:relative;font-family:'Bungee',cursive;font-size:13px;color:var(--yellow);letter-spacing:0.15em}
  .dj .name{position:relative;font-family:'Russo One',sans-serif;text-transform:uppercase;
    font-size:clamp(22px,5vw,30px);margin:6px 0 4px;line-height:1}
  .dj:nth-child(3n+1) .name{color:var(--lime)}
  .dj:nth-child(3n+2) .name{color:var(--pink)}
  .dj:nth-child(3n+3) .name{color:var(--cyan)}
  .dj .genre{position:relative;font-size:11px;letter-spacing:0.2em;color:#bbb;text-transform:uppercase}
  .dj .city{position:relative;margin-top:14px;font-size:12px;color:#888;border-top:1px dashed #333;padding-top:10px}
  .dj .mini-smiley{position:absolute;top:14px;right:14px;width:30px;height:30px;background:var(--yellow);border-radius:50%;opacity:0.9}

  /* ============ TIMETABLE ============ */
  .timetable{padding:50px 0;background:
    linear-gradient(180deg, transparent, rgba(157,0,255,0.06), transparent)}
  .tt-head{text-align:center;margin-bottom:34px}
  .tt-head h2{font-family:'Bungee Shade',cursive;text-transform:uppercase;font-size:clamp(30px,7vw,62px);
    color:var(--cyan)}
  .rooms{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px}
  .room{border:3px solid var(--purple);background:#080808;padding:0 0 8px;transform:rotate(0.4deg)}
  .room:nth-child(2){transform:rotate(-0.6deg);border-color:var(--lime)}
  .room:nth-child(3){transform:rotate(0.8deg);border-color:var(--pink)}
  .room h3{font-family:'Bungee',cursive;text-transform:uppercase;font-size:18px;text-align:center;
    padding:12px;color:var(--black);background:var(--purple)}
  .room:nth-child(2) h3{background:var(--lime)}
  .room:nth-child(3) h3{background:var(--pink);color:var(--white)}
  .slot{display:flex;justify-content:space-between;align-items:center;gap:10px;
    padding:11px 16px;border-bottom:1px dashed #2a2a2a;font-size:13px}
  .slot:last-child{border-bottom:none}
  .slot .t{font-family:'Space Mono',monospace;font-weight:700;color:var(--cyan);white-space:nowrap}
  .slot .a{font-family:'Russo One',sans-serif;text-transform:uppercase;text-align:right;color:#eee}

  /* ============ INFO / TICKETS ============ */
  .info{padding:60px 0}
  .info .head{text-align:center;margin-bottom:40px}
  .info h2{font-family:'Bungee',cursive;text-transform:uppercase;font-size:clamp(30px,7vw,64px);
    color:var(--lime);text-shadow:4px 4px 0 var(--pink)}
  .tickets{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:22px;margin-bottom:40px}
  .ticket{position:relative;border:3px dashed var(--lime);background:var(--ink);padding:26px 22px;text-align:center;
    transform:rotate(-1deg)}
  .ticket:nth-child(2){border-color:var(--pink);transform:rotate(1deg)}
  .ticket:nth-child(3){border-color:var(--cyan);transform:rotate(-0.5deg)}
  .ticket .tier{font-family:'Bungee',cursive;text-transform:uppercase;font-size:16px;color:var(--yellow)}
  .ticket .price{font-family:'Russo One',sans-serif;font-size:clamp(30px,7vw,46px);margin:10px 0 2px;color:var(--white)}
  .ticket:nth-child(1) .price{color:var(--lime)}
  .ticket:nth-child(2) .price{color:var(--pink)}
  .ticket:nth-child(3) .price{color:var(--cyan)}
  .ticket .price small{font-size:14px;color:#888}
  .ticket .desc{font-size:12px;color:#aaa;margin-top:8px;letter-spacing:0.04em}
  .ticket .hole{position:absolute;width:18px;height:18px;border-radius:50%;background:var(--black);top:50%;transform:translateY(-50%)}
  .ticket .hole.l{left:-12px}.ticket .hole.r{right:-12px}

  .rules{border:2px solid #333;padding:24px;background:#070707}
  .rules h4{font-family:'Russo One',sans-serif;text-transform:uppercase;color:var(--cyan);font-size:14px;letter-spacing:0.15em;margin-bottom:14px}
  .rules ul{list-style:none;display:grid;gap:9px}
  .rules li{font-size:13px;color:#ccc;padding-left:22px;position:relative}
  .rules li::before{content:"◖";position:absolute;left:0;color:var(--pink)}

  /* ============ CONTACT ============ */
  .contact{padding:70px 0 40px;text-align:center;position:relative;overflow:hidden}
  .contact-glow{position:absolute;inset:0;z-index:0;
    background:radial-gradient(circle at 50% 30%, rgba(170,255,0,0.18), transparent 55%)}
  .contact .inner{position:relative;z-index:2}
  .contact .big-smiley{width:96px;height:96px;background:var(--yellow);margin:0 auto 24px;
    box-shadow:0 0 0 6px var(--black),0 0 0 11px var(--pink),0 0 50px rgba(255,0,170,0.5);transform:rotate(-6deg)}
  .contact h2{font-family:'Bungee',cursive;text-transform:uppercase;font-size:clamp(34px,9vw,84px);line-height:0.9;
    color:var(--white);text-shadow:5px 5px 0 var(--cyan),10px 10px 0 var(--pink)}
  .contact .ph{font-family:'Russo One',sans-serif;font-size:clamp(26px,6vw,44px);color:var(--lime);margin:24px 0 6px}
  .contact .lines{font-size:14px;color:#bbb;letter-spacing:0.04em;display:grid;gap:6px;margin-top:10px}
  .contact .lines b{color:var(--cyan)}
  .cta{display:inline-block;margin-top:30px;font-family:'Bungee',cursive;text-transform:uppercase;
    background:var(--lime);color:var(--black);padding:18px 34px;border:3px solid var(--black);
    box-shadow:6px 6px 0 var(--pink);text-decoration:none;font-size:16px;transition:transform .12s,box-shadow .12s}
  .cta:hover{transform:translate(-2px,-2px);box-shadow:9px 9px 0 var(--pink)}

  footer{border-top:3px solid var(--lime);padding:26px 0;text-align:center;margin-top:50px}
  footer .biz{font-size:12px;color:#777;line-height:1.8;letter-spacing:0.03em}
  footer .biz b{color:var(--lime)}
  footer .disc{font-size:10px;color:#444;margin-top:10px;letter-spacing:0.06em}

  @media (max-width:560px){
    .flyer{padding:30px 20px 26px;transform:rotate(0)}
    .flyer-meta{grid-template-columns:1fr;border-top:none}
    .flyer-meta div{border-right:none;border-bottom:2px dashed #333}
    .st1,.st2{display:none}
    .marquee .track{font-size:17px}
  }
</style>
</head>
<body>

<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
