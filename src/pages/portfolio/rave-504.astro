      </div>
      <div class="room">
        <h3>RED ROOM</h3>
        <div class="slot"><span class="t">22:30</span><span class="a">OPEN SET</span></div>
        <div class="slot"><span class="t">00:30</span><span class="a">JUNGLE양</span></div>
        <div class="slot"><span class="t">01:30</span><span class="a">루나 베이스</span></div>
        <div class="slot"><span class="t">05:00</span><span class="a">B2B 클로징</span></div>
      </div>
      <div class="room">
        <h3>BLUE ROOM</h3>
