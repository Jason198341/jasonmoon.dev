<!-- ============ TIMETABLE ============ -->
<section class="timetable">
  <div class="wrap">
    <div class="tt-head">
      <span class="section-tag">// TIME TABLE</span>
      <h2>3 ROOMS · ALL NIGHT</h2>
    </div>
    <div class="rooms">
      <div class="room">
        <h3>MAIN FLOOR</h3>
        <div class="slot"><span class="t">21:30</span><span class="a">김형광</span></div>
        <div class="slot"><span class="t">23:00</span><span class="a">PIXEL 88</span></div>
