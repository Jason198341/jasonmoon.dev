---
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ヴェイパー モール · 베이퍼 몰 — 빈티지 & 카페</title>
  <meta name="description" content="서울 망원의 빈티지 셀렉트샵 & 카페. 80년대 노스탤지어와 미래의 꿈이 교차하는 공간, 베이퍼 몰." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Space+Grotesk:wght@300;400;500;700&family=Zen+Kaku+Gothic+New:wght@400;700;900&family=Noto+Serif+KR:wght@300;500;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --pink: #ff71ce;
      --cyan: #01cdfe;
      --purple: #b967ff;
      --lime: #05ffa1;
      --yellow: #fffb96;
      --ink: #1a0b2e;
      --deep: #0d0221;
      --cream: #fff0f5;
      --grid: rgba(1, 205, 254, 0.45);

      --font-display: 'Orbitron', sans-serif;
      --font-body: 'Space Grotesk', 'Zen Kaku Gothic New', sans-serif;
      --font-jp: 'Zen Kaku Gothic New', sans-serif;
      --font-serif: 'Noto Serif KR', serif;

      --ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

    body {
      font-family: var(--font-body);
      background: var(--deep);
      color: var(--cream);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a { color: inherit; }

    ::selection { background: var(--pink); color: var(--deep); }

    .wrap { width: min(1180px, 92vw); margin-inline: auto; }

    .a-e-s-t-h-e-t-i-c {
      letter-spacing: 0.55em;
      text-transform: uppercase;
    }

    /* ===== Sun / atmosphere shared ===== */
    .vapor-sun {
      position: absolute;
      border-radius: 50%;
      background: linear-gradient(180deg, var(--yellow) 0%, var(--pink) 45%, var(--purple) 100%);
      box-shadow: 0 0 90px rgba(255, 113, 206, 0.6);
      overflow: hidden;
    }
    .vapor-sun::after {
      content: "";
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        180deg,
        transparent 0,
        transparent 14px,
        var(--deep) 14px,
        var(--deep) 18px
      );
      mask: linear-gradient(180deg, transparent 50%, #000 50%);
      -webkit-mask: linear-gradient(180deg, transparent 50%, #000 50%);
      opacity: 0.85;
    }

    /* ===== Grid floor shared ===== */
    .grid-floor {
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 260vw;
      height: 50vh;
      transform: translateX(-50%) perspective(420px) rotateX(72deg);
      transform-origin: bottom center;
      background-image:
        linear-gradient(var(--grid) 2px, transparent 2px),
        linear-gradient(90deg, var(--grid) 2px, transparent 2px);
      background-size: 60px 60px;
      animation: gridmove 2.2s linear infinite;
      pointer-events: none;
    }
    @keyframes gridmove {
      from { background-position: 0 0; }
      to   { background-position: 0 60px; }
    }

    /* =================================================================
       HERO
    ================================================================= */
    .hero {
      position: relative;
      min-height: 100vh;
      padding-top: 90px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background:
        radial-gradient(120% 80% at 50% 0%, rgba(185, 103, 255, 0.55), transparent 60%),
        linear-gradient(180deg, #2a0a4a 0%, #5b1668 30%, #c13584 60%, #ff71ce 80%, #01cdfe 100%);
      overflow: hidden;
    }

    .hero .vapor-sun {
      width: 360px;
      height: 360px;
      top: 16%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
    }

    .hero .grid-floor { z-index: 1; opacity: 0.9; }

    /* Plaster bust silhouettes */
    .bust {
      position: absolute;
      z-index: 2;
      opacity: 0.92;
      filter: drop-shadow(0 0 22px rgba(1, 205, 254, 0.6));
      pointer-events: none;
    }
    .bust.left  { left: 2%;  bottom: 4%; width: clamp(150px, 26vw, 330px); transform: scaleX(-1); }
    .bust.right { right: 2%; bottom: 4%; width: clamp(150px, 26vw, 330px); }

    .hero-jp {
      position: relative;
      z-index: 5;
      font-family: var(--font-jp);
      font-weight: 900;
      font-size: clamp(2.4rem, 9vw, 7rem);
      letter-spacing: 0.12em;
      color: var(--cream);
      text-shadow:
        3px 0 var(--cyan),
        -3px 0 var(--pink);
      animation: glitch 3.4s steps(2, end) infinite;
    }
    @keyframes glitch {
      0%, 92%, 100% { text-shadow: 3px 0 var(--cyan), -3px 0 var(--pink); transform: translate(0,0); }
      93% { text-shadow: -4px 2px var(--lime), 4px -2px var(--pink); transform: translate(2px, -1px); }
      96% { text-shadow: 4px -2px var(--cyan), -4px 2px var(--purple); transform: translate(-2px, 1px); }
    }

    .hero-title {
      position: relative;
      z-index: 5;
      font-family: var(--font-display);
      font-weight: 900;
      font-size: clamp(2.6rem, 11vw, 8.5rem);
      line-height: 0.95;
      margin-top: 0.1em;
      color: #fff;
      text-shadow: 0 0 30px rgba(255, 113, 206, 0.9), 0 0 60px rgba(1, 205, 254, 0.5);
    }

    .hero-sub {
      position: relative;
      z-index: 5;
      margin-top: 1.6rem;
      font-size: clamp(0.7rem, 2.4vw, 1rem);
      color: var(--cyan);
      text-shadow: 0 0 12px rgba(1, 205, 254, 0.8);
    }

    .hero-cta {
      position: relative;
      z-index: 5;
      margin-top: 2.4rem;
      display: inline-flex;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .btn {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 14px 26px;
      border-radius: 2px;
      transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
    }
    .btn-pink {
      background: var(--pink);
      color: var(--deep);
      box-shadow: 0 0 24px rgba(255, 113, 206, 0.7);
    }
    .btn-ghost {
      border: 2px solid var(--cyan);
      color: var(--cyan);
      box-shadow: inset 0 0 16px rgba(1, 205, 254, 0.25);
    }
    .btn:hover { transform: translateY(-3px) scale(1.03); }
    .btn-pink:hover { box-shadow: 0 0 38px rgba(255, 113, 206, 1); }
    .btn-ghost:hover { box-shadow: inset 0 0 26px rgba(1, 205, 254, 0.5), 0 0 22px rgba(1, 205, 254, 0.6); }

    /* palm trees */
    .palm {
      position: absolute;
      bottom: 0;
      z-index: 2;
      width: clamp(80px, 14vw, 170px);
      opacity: 0.85;
      pointer-events: none;
      filter: drop-shadow(0 0 14px rgba(5, 255, 161, 0.5));
    }
    .palm.l { left: 16%; }
    .palm.r { right: 16%; transform: scaleX(-1); }

    /* =================================================================
       MARQUEE
    ================================================================= */
    .marquee {
      background: var(--deep);
      border-top: 2px solid var(--pink);
      border-bottom: 2px solid var(--cyan);
      overflow: hidden;
      white-space: nowrap;
      padding: 12px 0;
    }
    .marquee span {
      display: inline-block;
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.3em;
      color: var(--yellow);
      animation: scroll-left 22s linear infinite;
    }
    @keyframes scroll-left {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    /* =================================================================
       SECTION SHELL
    ================================================================= */
    section { position: relative; }
    .pad { padding-block: clamp(4.5rem, 9vw, 8rem); }

    .sec-head { margin-bottom: 3rem; }
    .sec-kicker {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--cyan);
      letter-spacing: 0.3em;
      margin-bottom: 0.7rem;
    }
    .sec-title {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: clamp(1.9rem, 5.5vw, 3.6rem);
      line-height: 1.05;
      color: var(--cream);
    }
    .sec-title em {
      font-style: normal;
      color: var(--pink);
      text-shadow: 0 0 22px rgba(255, 113, 206, 0.7);
    }

    /* SELECTION ------------------------------------------------------ */
    #selection {
      background:
        radial-gradient(100% 60% at 100% 0%, rgba(1, 205, 254, 0.18), transparent 60%),
        linear-gradient(180deg, #0d0221 0%, #1a0b2e 100%);
    }
    .vint-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 22px;
    }
    .vint-card {
      position: relative;
      border: 1px solid rgba(1, 205, 254, 0.35);
      background: linear-gradient(160deg, rgba(255, 113, 206, 0.08), rgba(1, 205, 254, 0.06));
      backdrop-filter: blur(4px);
      border-radius: 4px;
      overflow: hidden;
      transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
    }
    .vint-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 40px rgba(255, 113, 206, 0.25), 0 0 0 1px var(--pink);
    }
    .vint-thumb {
      height: 200px;
      position: relative;
      display: grid;
      place-items: center;
      overflow: hidden;
    }
    .vint-thumb .ico {
      font-family: var(--font-jp);
      font-weight: 900;
      font-size: 3.4rem;
      color: rgba(255, 255, 255, 0.92);
      text-shadow: 2px 0 var(--cyan), -2px 0 var(--pink);
      z-index: 2;
    }
    .vint-thumb::before {
      content: "";
      position: absolute;
      inset: -20% -20% auto -20%;
      height: 60%;
      background: radial-gradient(circle, rgba(255,251,150,0.5), transparent 70%);
    }
    .t1 { background: linear-gradient(135deg, #ff71ce, #b967ff); }
    .t2 { background: linear-gradient(135deg, #01cdfe, #05ffa1); }
    .t3 { background: linear-gradient(135deg, #b967ff, #01cdfe); }
    .t4 { background: linear-gradient(135deg, #fffb96, #ff71ce); }
    .t5 { background: linear-gradient(135deg, #05ffa1, #01cdfe); }
    .t6 { background: linear-gradient(135deg, #ff71ce, #fffb96); }

    .vint-body { padding: 18px 20px 22px; }
    .vint-cat {
      font-family: var(--font-display);
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      color: var(--cyan);
      text-transform: uppercase;
    }
    .vint-name {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 1.1rem;
      margin: 6px 0 4px;
      color: var(--cream);
    }
    .vint-jp {
      font-family: var(--font-jp);
      font-size: 0.72rem;
      color: var(--pink);
      letter-spacing: 0.18em;
    }
    .vint-price {
      margin-top: 14px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: var(--yellow);
    }

    /* MENU ----------------------------------------------------------- */
    #menu {
      background:
        radial-gradient(80% 70% at 0% 100%, rgba(185,103,255,0.25), transparent 60%),
        linear-gradient(180deg, #1a0b2e 0%, #2a0a4a 100%);
    }
    .menu-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 50px;
      align-items: center;
    }
    .menu-list { display: flex; flex-direction: column; gap: 4px; }
    .menu-row {
      display: flex;
      align-items: baseline;
      gap: 14px;
      padding: 16px 4px;
      border-bottom: 1px dashed rgba(1, 205, 254, 0.3);
    }
    .menu-row .mn {
      font-family: var(--font-serif);
      font-weight: 500;
      font-size: 1.08rem;
      color: var(--cream);
      white-space: nowrap;
    }
    .menu-row .mjp {
      font-family: var(--font-jp);
      font-size: 0.68rem;
      color: var(--pink);
      letter-spacing: 0.15em;
    }
    .menu-row .dots {
      flex: 1;
      border-bottom: 1px dotted rgba(255,255,255,0.25);
      transform: translateY(-4px);
      min-width: 18px;
    }
    .menu-row .mp {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--yellow);
      white-space: nowrap;
    }
    .menu-desc { font-size: 0.74rem; color: rgba(255,240,245,0.55); width: 100%; margin-top: 2px; }

    .menu-card {
      position: relative;
      aspect-ratio: 3 / 4;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid rgba(255,113,206,0.4);
      background: linear-gradient(180deg, #ff71ce 0%, #b967ff 50%, #01cdfe 100%);
      display: grid;
      place-items: center;
      box-shadow: 0 24px 60px rgba(185,103,255,0.35);
    }
    .menu-card .vapor-sun { width: 200px; height: 200px; top: 18%; }
    .menu-card .grid-floor { height: 45%; width: 200%; }
    .menu-card .mc-label {
      position: relative;
      z-index: 3;
      font-family: var(--font-jp);
      font-weight: 900;
      font-size: 1.6rem;
      color: #fff;
      letter-spacing: 0.2em;
      text-shadow: 2px 0 var(--cyan), -2px 0 var(--pink);
      text-align: center;
    }
    .menu-card .mc-en {
      position: relative;
      z-index: 3;
      margin-top: 0.4rem;
      font-family: var(--font-display);
      font-size: 0.62rem;
      letter-spacing: 0.35em;
      color: var(--deep);
      background: var(--yellow);
      padding: 4px 10px;
      border-radius: 2px;
    }

    /* SPACE ---------------------------------------------------------- */
    #space {
      background: linear-gradient(180deg, #2a0a4a 0%, #0d0221 100%);
    }
    .space-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 160px;
      gap: 14px;
    }
    .tile {
      position: relative;
      border-radius: 5px;
      overflow: hidden;
      border: 1px solid rgba(1,205,254,0.3);
      display: grid;
      place-items: center;
      padding: 18px;
    }
    .tile span {
      position: relative;
      z-index: 2;
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.16em;
      color: #fff;
      text-shadow: 0 2px 12px rgba(0,0,0,0.5);
      text-align: center;
    }
    .tile small {
      display: block;
      font-family: var(--font-display);
      font-size: 0.55rem;
      letter-spacing: 0.3em;
      color: var(--deep);
      background: rgba(255,255,255,0.85);
      padding: 2px 6px;
      border-radius: 2px;
      margin-top: 8px;
    }
    .tile::after {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(180deg, transparent 40%, rgba(13,2,33,0.5));
    }
    .big { grid-column: span 2; grid-row: span 2; }
    .wide { grid-column: span 2; }
    .g1 { background: linear-gradient(135deg, #ff71ce, #01cdfe); }
    .g2 { background: linear-gradient(135deg, #b967ff, #ff71ce); }
    .g3 { background: linear-gradient(135deg, #01cdfe, #05ffa1); }
    .g4 { background: linear-gradient(135deg, #fffb96, #b967ff); }
    .g5 { background: linear-gradient(135deg, #05ffa1, #b967ff); }

    /* CONTACT -------------------------------------------------------- */
    #contact {
      position: relative;
      background:
        radial-gradient(120% 90% at 50% 120%, rgba(255,113,206,0.5), transparent 60%),
        linear-gradient(180deg, #0d0221 0%, #5b1668 60%, #c13584 100%);
      overflow: hidden;
      text-align: center;
    }
    #contact .grid-floor { z-index: 0; opacity: 0.7; }
    #contact .vapor-sun {
      width: 240px; height: 240px; left: 50%;
      transform: translateX(-50%); top: 8%; z-index: 0;
    }
    .contact-inner { position: relative; z-index: 3; }
    .col-pillar {
      position: absolute;
      bottom: 0;
      z-index: 1;
      width: clamp(60px, 9vw, 120px);
      opacity: 0.8;
      filter: drop-shadow(0 0 16px rgba(1,205,254,0.5));
      pointer-events: none;
    }
    .col-pillar.l { left: 6%; }
    .col-pillar.r { right: 6%; }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 22px;
      margin-top: 2.6rem;
      text-align: left;
    }
    .contact-item {
      border: 1px solid rgba(1,205,254,0.4);
      background: rgba(13,2,33,0.55);
      backdrop-filter: blur(6px);
      border-radius: 4px;
      padding: 22px;
    }
    .contact-item .lab {
      font-family: var(--font-display);
      font-size: 0.6rem;
      letter-spacing: 0.25em;
      color: var(--cyan);
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .contact-item .val { font-size: 0.98rem; color: var(--cream); }
    .contact-item .val strong { color: var(--yellow); font-family: var(--font-display); }

    /* Retro window UI ----------------------------------------------- */
    .winbox {
      max-width: 460px;
      margin: 2.8rem auto 0;
      border: 2px solid var(--cyan);
      border-radius: 6px;
      background: rgba(13,2,33,0.7);
      backdrop-filter: blur(8px);
      box-shadow: 0 0 40px rgba(1,205,254,0.35);
      text-align: left;
      overflow: hidden;
    }
    .winbar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      background: linear-gradient(90deg, var(--pink), var(--purple));
    }
    .winbar .dot { width: 11px; height: 11px; border-radius: 50%; border: 1px solid rgba(0,0,0,0.3); }
    .winbar .d1 { background: #ff5f56; }
    .winbar .d2 { background: #ffbd2e; }
    .winbar .d3 { background: #27c93f; }
    .winbar .wt {
      margin-left: 6px;
      font-family: var(--font-display);
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      color: #fff;
    }
    .winbody { padding: 22px; }
    .winbody p { font-size: 0.9rem; color: rgba(255,240,245,0.85); }
    .winbody .hours { margin-top: 14px; font-family: var(--font-jp); font-size: 0.82rem; color: var(--cyan); }

    /* FOOTER --------------------------------------------------------- */
    footer {
      background: var(--deep);
      border-top: 2px solid var(--pink);
      padding: 40px 0 60px;
      text-align: center;
    }
    .foot-logo {
      font-family: var(--font-jp);
      font-weight: 900;
      font-size: 1.5rem;
      letter-spacing: 0.2em;
      color: var(--cream);
      text-shadow: 2px 0 var(--cyan), -2px 0 var(--pink);
    }
    .foot-en {
      margin-top: 6px;
      font-family: var(--font-display);
      font-size: 0.62rem;
      color: var(--cyan);
    }
    .foot-meta {
      margin-top: 18px;
      font-size: 0.72rem;
      color: rgba(255,240,245,0.45);
      line-height: 1.9;
    }

    /* RESPONSIVE ----------------------------------------------------- */
    @media (max-width: 860px) {
      .menu-grid { grid-template-columns: 1fr; gap: 34px; }
      .menu-card { max-width: 360px; margin-inline: auto; }
      .space-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 140px; }
      .big { grid-column: span 2; grid-row: span 1; }
      .wide { grid-column: span 2; }
      .palm { display: none; }
      .bust.left, .bust.right { width: 120px; opacity: 0.5; }
    }
    @media (max-width: 480px) {
      .col-pillar { display: none; }
      .hero-cta { flex-direction: column; align-items: stretch; }
      .menu-row { flex-wrap: wrap; }
    }

    @media (prefers-reduced-motion: reduce) {
      .grid-floor, .hero-jp, .marquee span { animation: none !important; }
    }
  </style>
</head>
<body>

  <!-- DEMO BAR -->
  <div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
    <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
    <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 25 · 베이퍼 몰 — 베이퍼웨이브 스타일</span>
    <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
  </div>
  <div style="height:40px;"></div>

  <!-- ============================ HERO ============================ -->
  <header class="hero">
    <div class="vapor-sun"></div>
    <div class="grid-floor"></div>

    <!-- Plaster bust silhouette (left) -->
    <svg class="bust left" viewBox="0 0 200 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="bustG" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff0f5"/>
          <stop offset="0.5" stop-color="#d9c6e8"/>
          <stop offset="1" stop-color="#9d7bc0"/>
        </linearGradient>
      </defs>
