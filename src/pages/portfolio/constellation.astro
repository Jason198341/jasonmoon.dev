          <g fill="#d4af37" stroke="none" font-family="Noto Serif KR, serif" font-size="20" opacity="0.85">
            <text x="280" y="68" text-anchor="middle">♈</text>
            <text x="406" y="118" text-anchor="middle">♉</text>
            <text x="492" y="208" text-anchor="middle">♊</text>
            <text x="520" y="290" text-anchor="middle">♋</text>
            <text x="492" y="372" text-anchor="middle">♌</text>
            <text x="406" y="462" text-anchor="middle">♍</text>
            <text x="280" y="506" text-anchor="middle">♎</text>
            <text x="154" y="462" text-anchor="middle">♏</text>
            <text x="68" y="372" text-anchor="middle">♐</text>
            <text x="40" y="290" text-anchor="middle">♑</text>
