<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="hero-inner">
    <div class="celestial-frame">
      <!-- 회전하는 천구 황도12궁 휠 -->
      <div class="zodiac-wheel" aria-hidden="true">
        <svg class="rotor" viewBox="0 0 560 560" fill="none" stroke="#d4af37">
          <!-- 천구 동심원 프레임 -->
          <circle cx="280" cy="280" r="274" stroke-width="1" opacity="0.5"/>
          <circle cx="280" cy="280" r="252" stroke-width="0.6" opacity="0.35"/>
          <circle cx="280" cy="280" r="206" stroke-width="0.6" opacity="0.3"/>
          <circle cx="280" cy="280" r="150" stroke-width="0.5" opacity="0.25"/>
          <!-- 12 방사 분할 -->
          <g stroke-width="0.7" opacity="0.4">
            <line x1="280" y1="28" x2="280" y2="532"/>
