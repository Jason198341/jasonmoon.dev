<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>아폴로 모터스 · APM-TM-1967 정비 기술 매뉴얼</title>
<meta name="description" content="아폴로 모터스 — 경기 화성 자동차 정비·튜닝. 1960년대 NASA 엔지니어링 기술 매뉴얼 스타일 데모 페이지." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Saira+Condensed:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg:#14171c;            /* 차콜 먹빛 배경 */
    --bg-2:#0f1217;          /* 더 짙은 패널 */
    --bg-3:#1b1f26;          /* 살짝 밝은 패널 */
    --amber:#e6a93b;         /* 앰버 강조 */
    --amber-deep:#b9842a;
    --amber-faint:#5a4a26;   /* 흐린 앰버 라인 */
    --ink:#dfe4ea;           /* 밝은 회색 본문 */
    --ink-dim:#9aa4b2;       /* 흐린 본문 */
    --ink-faint:#5f6a78;     /* 가장 흐린 / 도면 라벨 */
    --rule:#2b313b;          /* 구획선 */
    --rule-blue:#243042;     /* 청사진 라인 */
    --blueprint:#3d5a80;     /* 청사진 색 */
    --warn:#d96a4a;          /* 경고 적황 */
    --head:'Oswald', 'Saira Condensed', sans-serif;
    --cond:'Saira Condensed', 'Oswald', sans-serif;
    --mono:'IBM Plex Mono', ui-monospace, monospace;
    --maxw:1140px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;background:var(--bg);color:var(--ink);
    font-family:var(--cond);font-weight:400;line-height:1.55;
    -webkit-font-smoothing:antialiased;
    /* 청사진 그리드 + 비네팅 */
    background-image:
      linear-gradient(var(--rule-blue) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule-blue) 1px, transparent 1px),
      radial-gradient(120% 90% at 50% -10%, #1c222b 0%, var(--bg) 60%);
    background-size:42px 42px, 42px 42px, 100% 100%;
    background-position:0 0, 0 0, 0 0;
  }
  ::selection{background:var(--amber);color:#0b0d11;}

  /* ===== 레이아웃 ===== */
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
  section{position:relative;}
  .rule-h{height:1px;background:var(--rule);border:0;margin:0;}

  /* ===== 문서 머릿단 (모든 섹션 상단 docno) ===== */
  .docno{
    font-family:var(--mono);font-size:10.5px;letter-spacing:0.18em;
    color:var(--ink-faint);text-transform:uppercase;
    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
    padding:10px 0;border-bottom:1px solid var(--rule);
  }
  .docno .amber{color:var(--amber-deep);}

  /* 라벨 칩 */
  .chip{
    display:inline-block;font-family:var(--mono);font-size:10.5px;font-weight:600;
    letter-spacing:0.2em;text-transform:uppercase;
    color:var(--amber);border:1px solid var(--amber-faint);
    padding:4px 10px;border-radius:1px;background:rgba(230,169,59,0.05);
  }
  .fig{
    font-family:var(--mono);font-size:11px;letter-spacing:0.16em;
    color:var(--amber);text-transform:uppercase;font-weight:600;
  }
  .secnum{
    font-family:var(--mono);font-size:11px;letter-spacing:0.2em;
    color:var(--ink-faint);text-transform:uppercase;
  }
  h2.sec{
    font-family:var(--head);font-weight:600;text-transform:uppercase;
    letter-spacing:0.04em;font-size:clamp(1.7rem,1rem+2.6vw,2.9rem);
    line-height:1.02;margin:.35rem 0 .1rem;color:var(--ink);
  }
  .sec-sub{color:var(--ink-dim);font-size:.98rem;max-width:60ch;margin:.4rem 0 0;letter-spacing:0.01em;}

  /* ===== HERO / 표지 ===== */
  .cover{padding:54px 0 64px;border-bottom:2px solid var(--amber);position:relative;overflow:hidden;}
  .cover::before{
    content:"";position:absolute;inset:0;z-index:0;
    background:
      repeating-linear-gradient(135deg, transparent 0 22px, rgba(230,169,59,0.03) 22px 23px);
    pointer-events:none;
  }
  .cover .wrap{position:relative;z-index:1;}
  .cover-top{
    display:flex;justify-content:space-between;align-items:flex-start;gap:18px;
    flex-wrap:wrap;padding-bottom:34px;border-bottom:1px solid var(--rule);
  }
  .stamp{
    font-family:var(--mono);font-size:10px;letter-spacing:0.16em;color:var(--ink-faint);
    text-transform:uppercase;line-height:1.9;text-align:right;
  }
  .stamp b{color:var(--amber-deep);font-weight:600;}
  .classif{
    display:inline-block;border:1.5px solid var(--warn);color:var(--warn);
    font-family:var(--mono);font-size:10px;letter-spacing:0.22em;font-weight:600;
    padding:3px 9px;transform:rotate(-3deg);margin-bottom:8px;
  }
  .cover-id{font-family:var(--mono);font-size:11px;letter-spacing:0.22em;color:var(--amber);text-transform:uppercase;}
  .cover h1{
    font-family:var(--head);font-weight:700;text-transform:uppercase;
    font-size:clamp(2.8rem,1.2rem+8vw,7.2rem);line-height:0.9;letter-spacing:0.01em;
    margin:30px 0 6px;color:var(--ink);
  }
  .cover h1 .amber{color:var(--amber);}
  .cover .tagline{
    font-family:var(--cond);font-weight:300;font-size:clamp(1.1rem,.7rem+1.6vw,1.7rem);
    color:var(--ink-dim);letter-spacing:0.03em;max-width:48ch;margin:4px 0 0;
  }
  .cover-meta{
    display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--rule);
    border:1px solid var(--rule);margin-top:40px;
  }
  .cover-meta div{background:var(--bg-2);padding:14px 16px;}
  .cover-meta dt{font-family:var(--mono);font-size:9.5px;letter-spacing:0.18em;color:var(--ink-faint);text-transform:uppercase;}
  .cover-meta dd{margin:5px 0 0;font-family:var(--head);font-weight:500;font-size:1.05rem;color:var(--amber);text-transform:uppercase;letter-spacing:0.02em;}

  /* ===== 일반 섹션 패딩 ===== */
  .blk{padding:62px 0;}
  .sec-head{margin-bottom:34px;}
  .sec-head .row{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;}

  /* ===== ② 정비 항목 — 규격표 카드 ===== */
  .spec-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;}
  .spec{
    background:var(--bg-2);border:1px solid var(--rule);position:relative;
    padding:0;overflow:hidden;
  }
  .spec::before{content:"";position:absolute;top:0;left:0;width:3px;height:100%;background:var(--amber);}
  .spec-h{
    display:flex;justify-content:space-between;align-items:center;gap:10px;
    padding:14px 18px;border-bottom:1px solid var(--rule);background:var(--bg-3);
  }
  .spec-h .sys{font-family:var(--head);font-weight:600;font-size:1.25rem;text-transform:uppercase;letter-spacing:0.03em;color:var(--ink);}
  .spec-h .pn{font-family:var(--mono);font-size:10px;letter-spacing:0.14em;color:var(--amber-deep);}
  table.spectbl{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12px;}
  table.spectbl tr{border-bottom:1px solid var(--rule);}
  table.spectbl tr:last-child{border-bottom:0;}
  table.spectbl td{padding:9px 18px;color:var(--ink-dim);}
  table.spectbl td:first-child{color:var(--ink-faint);letter-spacing:0.06em;width:46%;}
  table.spectbl td:last-child{color:var(--ink);text-align:right;font-weight:500;}
  table.spectbl .ok{color:var(--amber);}

  /* ===== ③ 단면도 도식 ===== */
  .cut-stage{
    background:var(--bg-2);border:1px solid var(--rule-blue);position:relative;
    padding:18px 18px 8px;
  }
  .cut-stage .corner{position:absolute;width:14px;height:14px;border:1.5px solid var(--amber-faint);}
  .cut-stage .c1{top:8px;left:8px;border-right:0;border-bottom:0;}
  .cut-stage .c2{top:8px;right:8px;border-left:0;border-bottom:0;}
  .cut-stage .c3{bottom:8px;left:8px;border-right:0;border-top:0;}
  .cut-stage .c4{bottom:8px;right:8px;border-left:0;border-top:0;}
  .cut-cap{
    display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;
    padding:14px 4px 4px;border-top:1px solid var(--rule);margin-top:8px;
  }
  .cut-cap .t{font-family:var(--cond);font-size:.95rem;color:var(--ink-dim);}
  svg{display:block;width:100%;height:auto;}
  .legend{
    display:grid;grid-template-columns:repeat(2,1fr);gap:8px 26px;
    margin-top:18px;font-family:var(--mono);font-size:12px;
  }
  .legend .li{display:flex;gap:10px;align-items:flex-start;color:var(--ink-dim);}
  .legend .bn{
    flex:0 0 auto;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--amber);
    color:var(--amber);font-weight:700;font-size:11px;display:flex;align-items:center;justify-content:center;
    font-family:var(--mono);
  }
  .legend .li b{color:var(--ink);font-weight:600;}

  /* ===== ④ 절차 STEP + CAUTION ===== */
  .steps{display:grid;gap:0;border:1px solid var(--rule);background:var(--bg-2);}
  .step{
    display:grid;grid-template-columns:96px 1fr;gap:0;border-bottom:1px solid var(--rule);
  }
  .step:last-child{border-bottom:0;}
  .step .no{
    background:var(--bg-3);border-right:1px solid var(--rule);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:18px 8px;
  }
  .step .no .lab{font-family:var(--mono);font-size:9px;letter-spacing:0.2em;color:var(--ink-faint);}
  .step .no .n{font-family:var(--head);font-weight:700;font-size:2.1rem;color:var(--amber);line-height:1;}
  .step .body{padding:18px 22px;}
  .step .body h4{font-family:var(--head);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;font-size:1.15rem;margin:0 0 5px;color:var(--ink);}
  .step .body p{margin:0;color:var(--ink-dim);font-size:.96rem;}
  .step .body .torq{font-family:var(--mono);font-size:11px;color:var(--amber-deep);letter-spacing:0.08em;margin-top:8px;}

  .caution{
    margin-top:22px;border:1.5px solid var(--warn);background:rgba(217,106,74,0.07);
    display:grid;grid-template-columns:120px 1fr;
  }
  .caution .hd{
    background:var(--warn);color:#16100c;display:flex;align-items:center;justify-content:center;
    flex-direction:column;gap:2px;padding:12px;text-align:center;
  }
  .caution .hd .ic{font-size:1.6rem;line-height:1;}
  .caution .hd .tx{font-family:var(--mono);font-weight:700;font-size:12px;letter-spacing:0.2em;}
  .caution .ct{padding:14px 18px;font-size:.95rem;color:var(--ink);}
  .caution .ct b{color:var(--warn);}

  /* ===== ⑤ 공임표 ===== */
  .fee{width:100%;border-collapse:collapse;border:1px solid var(--rule);font-family:var(--cond);}
  .fee thead th{
    background:var(--bg-3);font-family:var(--mono);font-size:10px;letter-spacing:0.16em;
    color:var(--ink-faint);text-transform:uppercase;font-weight:600;
    padding:12px 16px;text-align:left;border-bottom:1px solid var(--amber-faint);
  }
  .fee thead th:last-child,.fee tbody td:last-child{text-align:right;}
  .fee tbody td{padding:13px 16px;border-bottom:1px solid var(--rule);color:var(--ink-dim);font-size:.98rem;}
  .fee tbody tr:nth-child(even){background:rgba(255,255,255,0.012);}
  .fee tbody td:first-child{color:var(--ink);font-weight:500;}
  .fee tbody td .pn{font-family:var(--mono);font-size:10px;color:var(--ink-faint);display:block;letter-spacing:0.1em;margin-top:2px;}
  .fee tbody td.cost{font-family:var(--mono);color:var(--amber);font-weight:600;font-size:.95rem;text-align:right;}
  .fee tfoot td{padding:13px 16px;font-family:var(--mono);font-size:11px;color:var(--ink-faint);letter-spacing:0.06em;background:var(--bg-2);}

  /* ===== ⑥ CTA / 연락처 ===== */
  .cta{border-top:2px solid var(--amber);background:var(--bg-2);padding:66px 0 30px;position:relative;}
  .cta::before{
    content:"";position:absolute;inset:0;
    background:repeating-linear-gradient(135deg, transparent 0 22px, rgba(230,169,59,0.025) 22px 23px);
    pointer-events:none;
  }
  .cta .wrap{position:relative;}
  .cta h2{font-family:var(--head);font-weight:700;text-transform:uppercase;font-size:clamp(2rem,1rem+4vw,3.8rem);line-height:0.95;letter-spacing:0.02em;margin:.5rem 0 .3rem;color:var(--ink);}
  .cta h2 .amber{color:var(--amber);}
  .cta p.lead{color:var(--ink-dim);max-width:52ch;font-size:1.02rem;}
  .cta-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:26px;margin-top:36px;align-items:start;}
  .contact{display:grid;gap:1px;background:var(--rule);border:1px solid var(--rule);}
  .contact div{background:var(--bg);padding:16px 18px;}
  .contact dt{font-family:var(--mono);font-size:9.5px;letter-spacing:0.18em;color:var(--ink-faint);text-transform:uppercase;}
  .contact dd{margin:5px 0 0;font-family:var(--head);font-weight:500;font-size:1.15rem;color:var(--ink);letter-spacing:0.02em;}
  .contact dd.amber{color:var(--amber);}
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    font-family:var(--mono);font-weight:700;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;
    color:#0b0d11;background:var(--amber);padding:15px 26px;text-decoration:none;border:0;
    transition:background .18s,transform .18s;
  }
  .btn:hover{background:#f2bd55;transform:translateY(-2px);}
  .btn.ghost{background:transparent;color:var(--amber);border:1.5px solid var(--amber);}
  .btn.ghost:hover{background:rgba(230,169,59,0.1);}
  .btn-row{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;}
  .form-note{font-family:var(--mono);font-size:10.5px;color:var(--ink-faint);letter-spacing:0.08em;margin-top:18px;}

  /* ===== 푸터 ===== */
  footer{border-top:1px solid var(--rule);padding:26px 0 60px;}
  footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;}
  footer .fnote{font-family:var(--mono);font-size:10.5px;letter-spacing:0.14em;color:var(--ink-faint);text-transform:uppercase;line-height:1.9;}
  footer .fnote .amber{color:var(--amber-deep);}

  /* SVG 도면 공통 */
  .draw .out{fill:none;stroke:var(--blueprint);stroke-width:1.4;}
  .draw .out2{fill:none;stroke:#4a6c96;stroke-width:1;}
  .draw .fillp{fill:#1b2532;stroke:#3d5a80;stroke-width:1.2;}
  .draw .hatch{fill:url(#hatch);stroke:#3d5a80;stroke-width:1;}
  .draw .ctr{stroke:var(--amber-deep);stroke-width:0.7;stroke-dasharray:7 3 1 3;fill:none;opacity:.6;}
  .draw .lead{stroke:var(--amber);stroke-width:0.9;fill:none;}
  .draw .bn-c{fill:var(--bg);stroke:var(--amber);stroke-width:1.3;}
  .draw .bn-t{fill:var(--amber);font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;}
  .draw .dim{stroke:var(--ink-faint);stroke-width:0.7;fill:none;}
  .draw .dim-t{fill:var(--ink-faint);font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.05em;}
  .draw .lbl{fill:var(--ink-faint);font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.08em;}

  /* ===== 반응형 ===== */
  @media (max-width:820px){
    .spec-grid{grid-template-columns:1fr;}
    .cover-meta{grid-template-columns:repeat(2,1fr);}
    .cta-grid{grid-template-columns:1fr;}
    .cover-top{flex-direction:column;}
    .stamp{text-align:left;}
  }
  @media (max-width:540px){
    .cover-meta{grid-template-columns:1fr;}
    .step{grid-template-columns:72px 1fr;}
    .caution{grid-template-columns:1fr;}
    .caution .hd{flex-direction:row;gap:8px;}
    .legend{grid-template-columns:1fr;}
    .fee thead{display:none;}
    .fee tbody td{display:block;text-align:left !important;border-bottom:0;padding:4px 16px;}
    .fee tbody tr{display:block;border-bottom:1px solid var(--rule);padding:8px 0;}
    .fee tbody td.cost{text-align:left;padding-top:6px;padding-bottom:10px;}
  }
</style>
</head>
<body>

<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
  <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
  <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 06 · 아폴로 모터스 — 1960년대 NASA 엔지니어링 매뉴얼 스타일</span>
  <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
</div>
<div style="height:40px;"></div>

<!-- ===== ① 표지 / HERO ===== -->
<section class="cover" id="cover">
  <div class="wrap">
    <div class="cover-top">
      <div>
        <span class="classif">FOR SERVICE USE</span>
        <div class="cover-id">DOCUMENT No. APM-TM-1967 &nbsp;·&nbsp; REV.C</div>
        <div class="cover-id" style="color:var(--ink-faint);margin-top:4px;">VEHICLE TECHNICAL MAINTENANCE MANUAL</div>
      </div>
      <div class="stamp">
        ISSUE DATE &nbsp; <b>1967·04·12</b><br/>
        SECTION &nbsp; <b>00 — GENERAL</b><br/>
        SHEET &nbsp; <b>01 OF 06</b><br/>
        ASSY GROUP &nbsp; <b>PROPULSION / CHASSIS</b>
      </div>
    </div>

    <h1>APOLLO<br/><span class="amber">MOTORS</span></h1>
    <p class="tagline">정비를 항공우주 공학처럼 — 측정하고, 기록하고, 규격으로 마감하는 아폴로 모터스.</p>

    <dl class="cover-meta">
      <div><dt>STATION</dt><dd>경기 화성</dd></div>
      <div><dt>SPECIALTY</dt><dd>엔진·미션·튜닝</dd></div>
      <div><dt>CERTIFICATION</dt><dd>정비 1급</dd></div>
      <div><dt>OPERATING</dt><dd>09:00–19:00</dd></div>
    </dl>
  </div>
</section>

<!-- ===== ② 정비 항목 — 규격표 ===== -->
<section class="blk" id="systems">
  <div class="wrap">
    <div class="docno"><span>SECTION 02 — SERVICE SYSTEMS</span><span class="amber">APM-TM-1967 · SHT 02/06</span></div>

    <div class="sec-head" style="margin-top:26px;">
      <div class="row"><span class="secnum">2.0</span><span class="chip">SERVICE SYSTEMS</span></div>
      <h2 class="sec">정비 항목 규격</h2>
      <p class="sec-sub">4개 핵심 계통을 항공 정비 카드 방식으로 점검합니다. 각 계통은 작업 부호(P/N)와 점검 규격으로 관리됩니다.</p>
    </div>

    <div class="spec-grid">
      <!-- 엔진 -->
      <article class="spec">
        <div class="spec-h"><span class="sys">엔진 · ENGINE</span><span class="pn">P/N APM-PWR-01</span></div>
        <table class="spectbl">
          <tr><td>실린더 압축 점검</td><td>11.5 ± 0.5 kg/cm²</td></tr>
          <tr><td>타이밍 / 밸브 간극</td><td class="ok">규격 조정</td></tr>
          <tr><td>오일·쿨런트 교환</td><td>전합성 5W-30</td></tr>
          <tr><td>인젝터 / 카본 클리닝</td><td class="ok">초음파 세척</td></tr>
        </table>
      </article>

      <!-- 미션 -->
      <article class="spec">
