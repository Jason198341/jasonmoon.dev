<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>보생한의원 — 임상 회보 Vol. 7, No. 2</title>
<meta name="description" content="보생한의원 — 침구·한약·추나·체질의학. 과장 없는 임상, 측정 가능한 회복." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
:root{
  --paper:#fbfaf7;
  --paper-2:#f4f1ea;
  --ink:#222021;
  --ink-soft:#444143;
  --ink-faint:#6b6764;
  --rule:#c9c2b4;
  --rule-dark:#1d1b1a;
  --indigo:#34396b;
  --indigo-soft:#5a608f;
  --serif:'Spectral', 'Source Serif 4', Georgia, serif;
  --mono:'IBM Plex Mono', ui-monospace, 'JetBrains Mono', monospace;
}
*{box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;}
body{
  margin:0;
  background:
    linear-gradient(0deg, rgba(180,170,150,0.035) 1px, transparent 1px) 0 0 / 100% 4px,
    var(--paper);
  color:var(--ink);
  font-family:var(--serif);
  font-size:17px;
  line-height:1.62;
  font-weight:400;
  -webkit-font-smoothing:antialiased;
}
::selection{background:rgba(52,57,107,0.16);}
a{color:var(--indigo);}

/* ---- layout shell ---- */
.sheet{
  max-width:920px;
  margin:0 auto;
  padding:0 28px 80px;
}
.col-rule{ border-left:1px solid var(--rule); border-right:1px solid var(--rule); }

/* ---- journal masthead ---- */
.masthead{
  border-top:3px double var(--rule-dark);
  border-bottom:1px solid var(--rule-dark);
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:16px;
  padding:8px 2px 9px;
  margin-top:18px;
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:0.1em;
  text-transform:uppercase;
  color:var(--ink-soft);
  flex-wrap:wrap;
}
.masthead .j-name{font-weight:500;color:var(--ink);}
.masthead .j-vol{color:var(--indigo);}

/* ---- title block ---- */
.titleblock{
  text-align:center;
  padding:46px 12px 30px;
  border-bottom:1px solid var(--rule);
}
.eyebrow{
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:0.34em;
  text-transform:uppercase;
  color:var(--indigo);
  margin:0 0 22px;
}
.clinic-name{
  font-family:var(--serif);
  font-weight:600;
  font-size:clamp(2.4rem, 1.4rem + 4.4vw, 4.4rem);
  line-height:1.02;
  letter-spacing:-0.01em;
  margin:0;
}
.clinic-name .han{
  display:block;
  font-size:0.34em;
  letter-spacing:0.5em;
  font-weight:400;
  color:var(--ink-faint);
  margin-bottom:14px;
  padding-left:0.5em;
}
.subtitle{
  font-family:var(--serif);
  font-style:italic;
  font-weight:400;
  font-size:clamp(1.05rem, 0.9rem + 0.7vw, 1.32rem);
  color:var(--ink-soft);
  margin:20px auto 0;
  max-width:34em;
  line-height:1.5;
}
.byline{
  margin-top:26px;
  font-family:var(--mono);
  font-size:11.5px;
  letter-spacing:0.06em;
  color:var(--ink-faint);
}
.byline sup{color:var(--indigo);font-weight:500;}

/* ---- abstract ---- */
.abstract{
  margin:34px auto;
  max-width:680px;
  background:var(--paper-2);
  border:1px solid var(--rule);
  border-top:2px solid var(--rule-dark);
  padding:24px 30px 26px;
}
.abstract h2{
  margin:0 0 12px;
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:0.28em;
  text-transform:uppercase;
  color:var(--indigo);
  font-weight:500;
}
.abstract p{
  margin:0;
  font-size:15.5px;
  line-height:1.66;
  text-align:justify;
  hyphens:auto;
  color:var(--ink-soft);
}
.abstract .kw{
  margin:16px 0 0;
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:0.04em;
  color:var(--ink-faint);
}
.abstract .kw b{color:var(--ink);font-weight:500;}

/* ---- section heads ---- */
.section{ padding-top:40px; }
.sec-head{
  display:flex;
  align-items:baseline;
  gap:14px;
  border-bottom:1.5px solid var(--rule-dark);
  padding-bottom:6px;
  margin-bottom:20px;
}
.sec-num{
  font-family:var(--mono);
  font-size:13px;
  letter-spacing:0.05em;
  color:var(--indigo);
  font-weight:500;
}
.sec-title{
  font-family:var(--serif);
  font-weight:600;
  font-size:1.42rem;
  letter-spacing:0.01em;
  margin:0;
}

/* ---- two-column body ---- */
.cols{
  column-count:2;
  column-gap:38px;
  column-rule:1px solid var(--rule);
  text-align:justify;
  hyphens:auto;
}
.cols p{ margin:0 0 1em; }
.cols p:first-child{ margin-top:0; }
.dropcap::first-letter{
  font-size:3.2em;
  line-height:0.78;
  float:left;
  font-weight:600;
  padding:0.06em 0.12em 0 0;
  color:var(--indigo);
}
.fn-ref{
  font-family:var(--mono);
  font-size:0.66em;
  vertical-align:super;
  color:var(--indigo);
  font-weight:500;
}

/* ---- figure / numbered services ---- */
.figrow{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:0;
  border:1px solid var(--rule-dark);
  margin-top:8px;
}
.figcell{
  padding:22px 22px 20px;
  border-right:1px solid var(--rule);
  border-bottom:1px solid var(--rule);
  position:relative;
}
.figcell:nth-child(2n){ border-right:none; }
.figcell:nth-last-child(-n+2){ border-bottom:none; }
.fig-plate{
  border:1px solid var(--rule);
  background:var(--paper-2);
  margin-bottom:12px;
  display:block;
}
.fig-cap{
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:0.04em;
  color:var(--ink-faint);
  line-height:1.5;
}
.fig-cap b{ color:var(--indigo); font-weight:500; letter-spacing:0.08em; }
.fig-svc-title{
  font-family:var(--serif);
  font-weight:600;
  font-size:1.16rem;
  margin:4px 0 6px;
}
.fig-svc-title small{
  display:block;
  font-family:var(--mono);
  font-weight:400;
  font-size:10px;
  letter-spacing:0.18em;
  text-transform:uppercase;
  color:var(--indigo);
  margin-bottom:5px;
}
.fig-svc-body{
  font-size:14.5px;
  line-height:1.58;
  color:var(--ink-soft);
  text-align:justify;
  hyphens:auto;
  margin:0;
}

/* ---- data / chart ---- */
.data-wrap{
  display:grid;
  grid-template-columns:1.15fr 0.85fr;
  gap:32px;
  align-items:start;
}
.chart-fig{ margin:0; }
.chart-box{
  border:1px solid var(--rule-dark);
  background:#fcfbf8;
  padding:16px 14px 10px;
}
.chart-box svg{ display:block; width:100%; height:auto; }
.tbl{
  border-collapse:collapse;
  width:100%;
  font-size:13.5px;
  font-family:var(--serif);
}
.tbl caption{
  text-align:left;
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:0.06em;
  color:var(--ink-faint);
  padding-bottom:8px;
}
.tbl caption b{ color:var(--indigo); letter-spacing:0.1em; }
.tbl th, .tbl td{
  padding:7px 8px;
  border-bottom:1px solid var(--rule);
  text-align:right;
}
.tbl th:first-child, .tbl td:first-child{ text-align:left; }
.tbl thead th{
  border-top:2px solid var(--rule-dark);
  border-bottom:1.5px solid var(--rule-dark);
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--ink-soft);
  font-weight:500;
}
.tbl tbody tr:last-child td{ border-bottom:1.5px solid var(--rule-dark); }
.tbl .num{ font-family:var(--mono); }
.tbl-note{
  font-family:var(--mono);
  font-size:10px;
  color:var(--ink-faint);
  margin-top:8px;
  letter-spacing:0.02em;
  line-height:1.5;
}

/* ---- credentials / references ---- */
.refs{
  list-style:none;
  counter-reset:ref;
  margin:0;
  padding:0;
  columns:2;
  column-gap:38px;
}
.refs li{
  counter-increment:ref;
  position:relative;
  padding-left:28px;
  margin:0 0 14px;
  font-size:14px;
  line-height:1.55;
  text-align:left;
  color:var(--ink-soft);
  break-inside:avoid;
}
.refs li::before{
  content:"[" counter(ref) "]";
  position:absolute;
  left:0;
  top:0;
  font-family:var(--mono);
  font-size:11px;
  color:var(--indigo);
}
.refs li b{ color:var(--ink); font-weight:600; }
.refs li i{ color:var(--ink-faint); }

.director-head{
  display:flex;
  gap:24px;
  align-items:flex-start;
  margin-bottom:24px;
}
.portrait{
  flex:0 0 110px;
  border:1px solid var(--rule-dark);
  background:var(--paper-2);
}
.director-meta h3{
  margin:0 0 4px;
  font-family:var(--serif);
  font-weight:600;
  font-size:1.3rem;
}
.director-meta .role{
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:0.1em;
  text-transform:uppercase;
  color:var(--indigo);
  margin:0 0 10px;
}
.director-meta p{
  margin:0;
  font-size:14.5px;
  color:var(--ink-soft);
  line-height:1.6;
  max-width:42em;
}

/* ---- footnotes ---- */
.footnotes{
  margin-top:30px;
  border-top:1px solid var(--rule);
  padding-top:14px;
}
.footnotes ol{
  margin:0; padding:0; list-style:none;
  counter-reset:fn;
}
.footnotes li{
  counter-increment:fn;
  position:relative;
  padding-left:22px;
  margin:0 0 7px;
  font-size:12px;
  line-height:1.5;
  color:var(--ink-faint);
  font-family:var(--serif);
}
.footnotes li::before{
  content:counter(fn);
  position:absolute; left:0; top:-1px;
  font-family:var(--mono);
  font-size:9.5px;
  vertical-align:super;
  color:var(--indigo);
}

/* ---- CTA / colophon ---- */
.cta{
  margin-top:46px;
  border:2px solid var(--rule-dark);
  padding:0;
  display:grid;
  grid-template-columns:1.2fr 1fr;
}
.cta-main{
  padding:34px 36px;
  border-right:1px solid var(--rule-dark);
}
.cta-main h2{
  font-family:var(--serif);
  font-weight:600;
  font-size:1.9rem;
  margin:0 0 10px;
  letter-spacing:-0.01em;
}
.cta-main p{
  margin:0 0 22px;
  font-size:15px;
  color:var(--ink-soft);
  line-height:1.6;
  max-width:30em;
}
.btn{
  display:inline-block;
  background:var(--indigo);
  color:var(--paper);
  font-family:var(--mono);
  font-size:12px;
  letter-spacing:0.12em;
  text-transform:uppercase;
  text-decoration:none;
  padding:12px 22px;
  border:1px solid var(--rule-dark);
}
.btn:hover{ background:var(--indigo-soft); }
.tel{
  display:block;
  margin-top:18px;
  font-family:var(--mono);
  font-size:13px;
  letter-spacing:0.06em;
  color:var(--ink);
}
.tel b{ color:var(--indigo); }
.cta-side{
  padding:28px 30px;
  background:var(--paper-2);
  font-size:13.5px;
}
.cta-side h3{
  margin:0 0 12px;
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:0.2em;
  text-transform:uppercase;
  color:var(--indigo);
}
.hours{ width:100%; border-collapse:collapse; }
.hours td{
  padding:5px 0;
  border-bottom:1px dotted var(--rule);
  font-size:13px;
  color:var(--ink-soft);
}
.hours td:last-child{ text-align:right; font-family:var(--mono); font-size:12px; }
.hours tr:last-child td{ border-bottom:none; }
.hours .closed td{ color:var(--ink-faint); font-style:italic; }
.access{
  margin-top:18px;
  font-size:12.5px;
  color:var(--ink-soft);
  line-height:1.6;
}
.access b{ color:var(--ink); }

/* ---- colophon ---- */
.colophon{
  margin-top:40px;
  border-top:3px double var(--rule-dark);
  padding-top:14px;
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px;
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:0.06em;
  color:var(--ink-faint);
  text-transform:uppercase;
}

/* ---- responsive ---- */
@media (max-width:720px){
  body{ font-size:16px; }
  .sheet{ padding:0 18px 60px; }
  .cols{ column-count:1; column-rule:none; }
  .figrow{ grid-template-columns:1fr; }
  .figcell{ border-right:none; }
  .figcell:nth-last-child(-n+2){ border-bottom:1px solid var(--rule); }
  .figcell:last-child{ border-bottom:none; }
  .data-wrap{ grid-template-columns:1fr; gap:24px; }
  .refs{ columns:1; }
  .cta{ grid-template-columns:1fr; }
  .cta-main{ border-right:none; border-bottom:1px solid var(--rule-dark); }
  .director-head{ flex-direction:column; gap:14px; }
  .portrait{ flex-basis:auto; width:120px; }
}
</style>
</head>
<body>

