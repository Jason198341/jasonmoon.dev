---
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>바우 디자인 — FORM FOLLOWS FUNCTION</title>
  <meta name="description" content="성수동 가구·디자인 스튜디오 바우 디자인. 1920년대 바우하우스 전시 도록으로 기록한 기능주의 가구 컬렉션." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --red: #e3002b;
      --yellow: #ffd500;
      --blue: #005bbb;
      --black: #0e0e0e;
      --white: #f4f1ea;
      --paper: #f4f1ea;
      --line: 4px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Oswald', sans-serif;
      background: var(--paper);
      color: var(--black);
      line-height: 1.4;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .display {
      font-family: 'Archivo', sans-serif;
      text-transform: uppercase;
      font-weight: 900;
      letter-spacing: -0.01em;
      line-height: 0.9;
    }

    .label {
      font-family: 'Archivo', sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-weight: 600;
    }

    .wrap { max-width: 1180px; margin: 0 auto; padding: 0 28px; }

    /* ====================== HERO ====================== */
    .hero {
      position: relative;
      min-height: 100vh;
      border-bottom: var(--line) solid var(--black);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .hero-grid {
      flex: 1;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: auto 1fr auto;
      border-top: var(--line) solid var(--black);
    }

    .hero-tag {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 28px;
      border-bottom: var(--line) solid var(--black);
      background: var(--white);
      flex-wrap: wrap;
      gap: 8px;
    }
    .hero-tag .label { font-size: 12px; }
    .hero-tag .label.dot::before {
      content: "";
      display: inline-block;
      width: 10px; height: 10px;
      background: var(--red);
      border-radius: 50%;
      margin-right: 8px;
      vertical-align: middle;
    }

    .hero-title {
      grid-column: 1 / 2;
      grid-row: 2 / 3;
      padding: 48px 28px;
      border-right: var(--line) solid var(--black);
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
    }
    .hero-title .kicker {
      font-size: 13px;
      letter-spacing: 0.3em;
      margin-bottom: 24px;
      color: var(--blue);
    }
    .hero-title h1 {
      font-size: clamp(3.2rem, 11vw, 8.5rem);
    }
    .hero-title h1 .l2 { color: var(--red); display: block; }
    .hero-title h1 .l3 { color: var(--blue); display: block; }
    .hero-title .sub {
      margin-top: 28px;
      max-width: 30ch;
      font-size: clamp(0.95rem, 1.4vw, 1.15rem);
      font-weight: 300;
      letter-spacing: 0.02em;
    }
    .hero-title .num {
      position: absolute;
      top: 24px; right: 28px;
      font-family: 'Archivo', sans-serif;
      font-weight: 900;
      font-size: 14px;
    }

    /* geometric panel */
    .hero-shapes {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
      position: relative;
      background: var(--white);
      overflow: hidden;
    }
    .hero-shapes .circle {
      position: absolute;
      top: -8%; right: -12%;
      width: 62%; aspect-ratio: 1;
      background: var(--yellow);
      border-radius: 50%;
    }
    .hero-shapes .tri {
      position: absolute;
      bottom: 0; left: 0;
      width: 0; height: 0;
      border-left: 0 solid transparent;
      border-right: 14vw solid transparent;
      border-bottom: 16vw solid var(--blue);
    }
    .hero-shapes .sq {
      position: absolute;
      top: 42%; left: 18%;
      width: 30%; aspect-ratio: 1;
      background: var(--red);
      transform: rotate(0deg);
    }
    .hero-shapes .bar {
      position: absolute;
      top: 0; left: 32%;
      width: var(--line); height: 100%;
      background: var(--black);
    }
    .hero-shapes .barh {
      position: absolute;
      top: 38%; left: 0;
      width: 100%; height: var(--line);
      background: var(--black);
    }

    .hero-foot {
      grid-column: 1 / -1;
      grid-row: 3 / 4;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: var(--line) solid var(--black);
      background: var(--white);
    }
    .hero-foot div {
      padding: 18px 28px;
      border-right: var(--line) solid var(--black);
    }
    .hero-foot div:last-child { border-right: 0; }
    .hero-foot .k { font-size: 10px; letter-spacing: 0.22em; color: var(--blue); }
    .hero-foot .v { font-family: 'Archivo', sans-serif; font-weight: 800; font-size: clamp(1rem,2vw,1.4rem); margin-top: 6px; text-transform: uppercase; }

    /* ====================== WORKS ====================== */
    .works { border-bottom: var(--line) solid var(--black); }
    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding: 40px 0 28px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .section-head h2 {
      font-size: clamp(2rem, 6vw, 4rem);
    }
    .section-head .meta { font-size: 12px; letter-spacing: 0.2em; color: var(--blue); }

    .works-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 200px;
      gap: 0;
      border: var(--line) solid var(--black);
    }
    .work {
      position: relative;
      border-right: var(--line) solid var(--black);
      border-bottom: var(--line) solid var(--black);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 18px;
      color: var(--black);
      background: var(--white);
    }
    .work .vis { position: absolute; inset: 0; overflow: hidden; }
    .work .cap {
      position: relative;
      z-index: 2;
    }
    .work .cap .no { font-family: 'Archivo', sans-serif; font-weight: 900; font-size: 13px; }
    .work .cap .nm { font-family: 'Archivo', sans-serif; font-weight: 800; text-transform: uppercase; font-size: clamp(1.1rem, 2vw, 1.6rem); letter-spacing: -0.01em; line-height: 1; margin-top: 4px; }
    .work .cap .pr { font-size: 12px; letter-spacing: 0.1em; margin-top: 6px; color: var(--blue); font-weight: 500; }

    /* span layouts (asymmetric) */
    .work.w-a { grid-column: span 3; grid-row: span 2; }
    .work.w-b { grid-column: span 3; grid-row: span 1; }
    .work.w-c { grid-column: span 2; grid-row: span 2; }
    .work.w-d { grid-column: span 2; grid-row: span 1; }
    .work.w-e { grid-column: span 4; grid-row: span 1; }
    .works-grid > .work:nth-child(3n) { border-right: 0; }

    /* shape compositions per card */
    .sh { position: absolute; }
    .vis-1 { background: var(--yellow); }
    .vis-1 .c1 { width: 70%; aspect-ratio: 1; background: var(--blue); border-radius: 50%; top: -20%; left: -10%; }
    .vis-1 .t1 { width:0;height:0; border-left: 60px solid transparent; border-right: 60px solid transparent; border-bottom: 120px solid var(--red); bottom: -10px; right: 8%; }

    .vis-2 { background: var(--blue); }
    .vis-2 .s1 { width: 45%; aspect-ratio: 1; background: var(--yellow); top: -10%; right: -8%; transform: rotate(45deg); }
    .vis-2 .b1 { width: 100%; height: var(--line); background: var(--white); top: 50%; left: 0; }

    .vis-3 { background: var(--red); }
    .vis-3 .c1 { width: 55%; aspect-ratio: 1; background: var(--white); border-radius: 50%; bottom: -18%; right: -10%; }
    .vis-3 .h1 { width: 38%; aspect-ratio: 2; background: var(--black); top: 16%; left: 12%; }

    .vis-4 { background: var(--white); }
    .vis-4 .t1 { width:0;height:0; border-left: 90px solid transparent; border-right: 0 solid transparent; border-bottom: 140px solid var(--yellow); top: 0; right: 0; }
    .vis-4 .c1 { width: 40%; aspect-ratio: 1; background: var(--red); border-radius: 50%; bottom: -14%; left: 10%; }
    .vis-4 .b1 { width: var(--line); height: 100%; background: var(--black); left: 50%; top: 0; }

    .vis-5 { background: var(--yellow); }
    .vis-5 .s1 { width: 30%; aspect-ratio: 1; background: var(--blue); top: 18%; left: 14%; }
    .vis-5 .c1 { width: 34%; aspect-ratio: 1; background: var(--red); border-radius: 50%; top: 14%; right: 10%; }

    .vis-6 { background: var(--blue); }
    .vis-6 .half { width: 50%; height: 100%; background: var(--white); right: 0; top: 0; }
    .vis-6 .c1 { width: 46%; aspect-ratio: 1; background: var(--red); border-radius: 50% 50% 0 50%; top: 18%; right: 4%; }

    /* ====================== PHILOSOPHY ====================== */
    .philo {
      background: var(--black);
      color: var(--white);
      border-bottom: var(--line) solid var(--black);
      position: relative;
      overflow: hidden;
    }
    .philo .wrap { position: relative; z-index: 2; padding-top: 90px; padding-bottom: 90px; }
    .philo .kick { font-size: 12px; letter-spacing: 0.3em; color: var(--yellow); margin-bottom: 28px; }
    .philo h2 {
      font-size: clamp(2.4rem, 8vw, 6.5rem);
    }
    .philo h2 .a { color: var(--yellow); }
    .philo h2 .b { color: var(--red); }
    .philo .body {
      margin-top: 36px;
      max-width: 52ch;
      font-weight: 300;
      font-size: clamp(1rem, 1.5vw, 1.2rem);
      letter-spacing: 0.01em;
    }
    .philo-shapes { position: absolute; inset: 0; z-index: 1; opacity: 0.9; }
    .philo-shapes .pc { position: absolute; top: 50%; right: 6%; transform: translateY(-50%); width: 30vw; max-width: 360px; aspect-ratio: 1; border-radius: 50%; border: var(--line) solid var(--blue); }
    .philo-shapes .pt { position: absolute; bottom: -40px; right: 22%; width:0;height:0; border-left: 80px solid transparent; border-right: 80px solid transparent; border-bottom: 150px solid var(--red); opacity: 0.5; }

    .principles {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: var(--line) solid var(--white);
      position: relative;
      z-index: 2;
    }
    .principles div { padding: 30px 28px; border-right: var(--line) solid var(--white); }
    .principles div:last-child { border-right: 0; }
    .principles .pn { font-family: 'Archivo'; font-weight: 900; font-size: 13px; color: var(--yellow); }
    .principles .pt2 { font-family: 'Archivo'; font-weight: 800; text-transform: uppercase; font-size: 1.3rem; margin: 10px 0 8px; }
    .principles .pd { font-weight: 300; font-size: 0.92rem; color: #c9c4ba; }

    /* ====================== DESIGNER ====================== */
    .designer { border-bottom: var(--line) solid var(--black); }
    .designer-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      border: var(--line) solid var(--black);
      min-height: 460px;
    }
    .designer-portrait {
      position: relative;
      background: var(--yellow);
      border-right: var(--line) solid var(--black);
      overflow: hidden;
    }
    .designer-portrait .head { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 52%; height: 70%; background: var(--blue); border-radius: 50% 50% 0 0; }
    .designer-portrait .face { position: absolute; bottom: 26%; left: 50%; transform: translateX(-50%); width: 32%; aspect-ratio: 1; background: var(--red); border-radius: 50%; }
    .designer-portrait .sqd { position: absolute; top: 12%; left: 12%; width: 22%; aspect-ratio: 1; background: var(--black); }
    .designer-portrait .barv { position: absolute; top: 0; left: 50%; width: var(--line); height: 100%; background: var(--black); }
    .designer-info {
      padding: 48px 36px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: var(--white);
    }
    .designer-info .kick { font-size: 12px; letter-spacing: 0.3em; color: var(--blue); margin-bottom: 20px; }
    .designer-info h3 { font-size: clamp(2rem, 5vw, 3.4rem); }
    .designer-info .role { font-weight: 400; letter-spacing: 0.1em; margin-top: 8px; color: var(--red); text-transform: uppercase; font-family: 'Archivo'; font-weight: 600; font-size: 0.9rem; }
    .designer-info p { font-weight: 300; margin-top: 24px; max-width: 46ch; font-size: 1.02rem; }
    .designer-info .stats { display: flex; gap: 36px; margin-top: 32px; flex-wrap: wrap; }
    .designer-info .stats .s .n { font-family: 'Archivo'; font-weight: 900; font-size: 2.2rem; }
    .designer-info .stats .s .l { font-size: 11px; letter-spacing: 0.16em; color: var(--blue); text-transform: uppercase; }

    /* ====================== CONTACT ====================== */
    .contact {
      background: var(--red);
      color: var(--white);
      position: relative;
      overflow: hidden;
    }
    .contact .wrap { position: relative; z-index: 2; padding-top: 80px; padding-bottom: 60px; }
    .contact .kick { font-size: 12px; letter-spacing: 0.3em; color: var(--yellow); margin-bottom: 26px; }
    .contact h2 { font-size: clamp(2.4rem, 8vw, 6rem); }
    .contact h2 .y { color: var(--yellow); }
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      margin-top: 48px;
      border-top: var(--line) solid var(--white);
    }
    .contact-grid .ci {
      padding: 28px 4px;
      border-right: var(--line) solid var(--white);
    }
    .contact-grid .ci:last-child { border-right: 0; padding-left: 28px; }
    .contact-grid .ci .k { font-size: 11px; letter-spacing: 0.2em; color: var(--yellow); }
    .contact-grid .ci .v { font-family: 'Archivo'; font-weight: 800; font-size: clamp(1.1rem, 2.4vw, 1.7rem); margin-top: 8px; text-transform: uppercase; }
    .contact-grid .ci .v.small { font-size: clamp(0.95rem,1.8vw,1.2rem); }

    .contact-shapes { position: absolute; inset: 0; z-index: 1; }
    .contact-shapes .cc { position: absolute; top: -10%; right: -6%; width: 32vw; max-width: 380px; aspect-ratio: 1; background: var(--yellow); border-radius: 50%; opacity: 0.95; }
    .contact-shapes .ct { position: absolute; bottom: -2px; left: 8%; width:0;height:0; border-left: 70px solid transparent; border-right: 70px solid transparent; border-bottom: 130px solid var(--blue); }
    .contact-shapes .cs { position: absolute; top: 30%; right: 24%; width: 90px; aspect-ratio: 1; background: var(--blue); transform: rotate(45deg); }

    .colophon {
      background: var(--black);
      color: var(--white);
      padding: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
    }
    .colophon .label { font-size: 11px; letter-spacing: 0.16em; }
    .colophon .swatches { display: flex; gap: 0; }
    .colophon .swatches span { width: 24px; height: 24px; display: block; }

    /* ====================== RESPONSIVE ====================== */
    @media (max-width: 860px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-title { grid-column: 1 / -1; border-right: 0; border-bottom: var(--line) solid var(--black); padding: 40px 24px 56px; }
      .hero-shapes { grid-column: 1 / -1; grid-row: auto; min-height: 320px; }
      .hero-foot { grid-template-columns: 1fr; }
      .hero-foot div { border-right: 0; border-bottom: var(--line) solid var(--black); }
      .hero-foot div:last-child { border-bottom: 0; }

      .works-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 180px; }
      .work.w-a, .work.w-b, .work.w-c, .work.w-d, .work.w-e { grid-column: span 2; grid-row: span 1; }
      .work.w-a { grid-row: span 2; }
      .works-grid > .work:nth-child(3n) { border-right: var(--line) solid var(--black); }
      .works-grid > .work { border-right: var(--line) solid var(--black); }

      .principles { grid-template-columns: 1fr; }
      .principles div { border-right: 0; border-bottom: var(--line) solid var(--white); }
      .principles div:last-child { border-bottom: 0; }

      .designer-grid { grid-template-columns: 1fr; }
      .designer-portrait { border-right: 0; border-bottom: var(--line) solid var(--black); min-height: 320px; }

      .contact-grid { grid-template-columns: 1fr; }
      .contact-grid .ci { border-right: 0; border-bottom: var(--line) solid var(--white); }
      .contact-grid .ci:last-child { border-bottom: 0; padding-left: 4px; }
    }
  </style>
</head>
<body>
  <div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
    <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
    <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 14 · 바우 디자인 — 1920년대 바우하우스 도록 스타일</span>
    <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
  </div>
  <div style="height:40px;"></div>

  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-tag">
        <span class="label dot">BAU DESIGN · 가구 · 디자인 스튜디오</span>
        <span class="label">전시 도록 № 01 / 1924</span>
      </div>

      <div class="hero-title">
        <span class="num label">№ 01</span>
        <span class="kicker label">기능을 위한 형태</span>
        <h1 class="display">
          <span>FORM</span>
          <span class="l2">FOLLOWS</span>
          <span class="l3">FUNCTION</span>
        </h1>
        <p class="sub">불필요한 장식을 덜어내고 구조와 재료, 쓰임만을 남깁니다. 바우 디자인은 형태가 기능에서 비롯된다는 원칙으로 가구를 만듭니다.</p>
      </div>

      <div class="hero-shapes" aria-hidden="true">
        <div class="bar"></div>
        <div class="barh"></div>
        <div class="circle"></div>
        <div class="sq"></div>
        <div class="tri"></div>
      </div>

      <div class="hero-foot">
        <div>
          <div class="k label">STUDIO</div>
          <div class="v">바우 디자인</div>
        </div>
        <div>
          <div class="k label">DISCIPLINE</div>
          <div class="v">FURNITURE</div>
        </div>
        <div>
          <div class="k label">LOCATION</div>
          <div class="v">서울 성수</div>
        </div>
      </div>
    </div>
  </header>

  <!-- ============ WORKS ============ -->
  <section class="works">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">컬렉션<br/>WORKS</h2>
        <span class="meta label">PL. 02–07 · 도판 6점</span>
      </div>

      <div class="works-grid">
        <article class="work w-a">
          <div class="vis vis-1" aria-hidden="true">
            <div class="sh c1"></div>
            <div class="sh t1"></div>
          </div>
          <div class="cap">
            <div class="no">PL. 02</div>
            <div class="nm">바실리 라운지 체어</div>
            <div class="pr">강관 + 가죽 · ₩ 1,480,000</div>
          </div>
        </article>

        <article class="work w-d">
          <div class="vis vis-2" aria-hidden="true">
            <div class="sh s1"></div>
            <div class="sh b1"></div>
          </div>
          <div class="cap">
            <div class="no">PL. 03</div>
            <div class="nm">슬랫 사이드 테이블</div>
            <div class="pr">참나무 · ₩ 620,000</div>
          </div>
        </article>

        <article class="work w-d">
          <div class="vis vis-5" aria-hidden="true">
            <div class="sh s1"></div>
            <div class="sh c1"></div>
          </div>
          <div class="cap">
            <div class="no">PL. 04</div>
            <div class="nm">프리마 펜던트 램프</div>
            <div class="pr">알루미늄 스핀 · ₩ 390,000</div>
          </div>
        </article>

        <article class="work w-b">
          <div class="vis vis-3" aria-hidden="true">
            <div class="sh h1"></div>
            <div class="sh c1"></div>
          </div>
          <div class="cap">
            <div class="no">PL. 05</div>
            <div class="nm">그리드 모듈 책장</div>
            <div class="pr">자작 합판 · ₩ 2,100,000</div>
          </div>
        </article>

        <article class="work w-c">
          <div class="vis vis-4" aria-hidden="true">
            <div class="sh b1"></div>
            <div class="sh t1"></div>
            <div class="sh c1"></div>
          </div>
          <div class="cap">
            <div class="no">PL. 06</div>
            <div class="nm">캔틸레버 다이닝 체어</div>
            <div class="pr">강관 + 라탄 · ₩ 540,000</div>
          </div>
        </article>

        <article class="work w-e">
