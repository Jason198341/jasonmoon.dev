---
import Base from '../../layouts/Base.astro';
import { portfolio } from '../../data/portfolio';

const tagLabel: Record<string, string> = {
  premium: '프리미엄',
  value: '실속형',
};
---

<Base
  title="제작 샘플 포트폴리오 — jasonmoon.dev"
  description="실제 업종에 '시대+기관+매체' 스타일을 입힌 홈페이지 제작 데모 모음. 클릭하면 진짜 그 업체 홈페이지처럼 열립니다."
>
  <!-- ───────── 히어로 ───────── -->
  <section class="relative border-b border-border overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-16 sm:py-24">
      <div class="flex items-center gap-3 mb-6 font-mono text-[10px] tracking-[0.3em] uppercase">
        <span class="hud-pip hud-pip--amber"></span>
        <span class="text-accent">제작 샘플 · DEMO GALLERY</span>
      </div>

      <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight mb-6">
        제작 샘플
        <span class="reg-mark align-top text-base sm:text-xl text-text-faint">®</span>
      </h1>

      <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl">
        실제 업종에 <span class="text-text">'시대 + 기관 + 매체'</span> 스타일을 입힌 데모입니다.
        클릭하면 진짜 그 업체 홈페이지처럼 열립니다.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="https://invite.kakao.com/tc/EszOu7fY0i"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2.5 border-2 border-accent bg-accent text-black px-6 py-3.5 font-bold text-sm sm:text-base tracking-tight hover:bg-accent-hover transition-colors duration-200"
        >
          <span>💬 카톡으로 무료 제작 문의</span>
          <span class="font-mono transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
        <a
          href="/styles"
          class="inline-flex items-center gap-2 border border-border-strong text-text-muted hover:text-text hover:border-accent px-5 py-3 font-mono text-xs tracking-[0.2em] uppercase transition-colors duration-200"
        >
          스타일 도감 보기
        </a>
      </div>
    </div>
  </section>

  <!-- ───────── 샘플 그리드 ───────── -->
  <section>
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-01</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">샘플 {portfolio.length}종 · SAMPLES</p>
    </div>

    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-12 sm:py-16">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {portfolio.map((s, i) => (
          <a
            href={`/portfolio/${s.slug}`}
            target="_blank"
            rel="noopener"
            class="reveal group relative flex flex-col border border-border hover:border-accent bg-surface/30 p-6 transition-colors duration-300"
            style={`transition-delay:${Math.min(i * 60, 400)}ms; background:linear-gradient(135deg, ${s.swatch}14, transparent 70%);`}
          >
            <!-- 상단: 번호 + 태그 -->
            <div class="flex items-center justify-between mb-5">
              <span class="hud-id">SAMPLE {s.no}</span>
              <span
                class:list={[
                  'font-mono text-[10px] tracking-[0.2em] uppercase px-2 py-0.5 border',
                  s.tag === 'premium'
                    ? 'text-accent border-accent/50 bg-accent-dim'
                    : 'text-text-muted border-border-strong',
                ]}
              >
                {tagLabel[s.tag]}
              </span>
            </div>

            <!-- 색 swatch + 업종 -->
            <div class="flex items-center gap-3 mb-4">
              <span
                class="block w-9 h-9 border border-border-strong shrink-0"
                style={`background:${s.swatch};`}
                aria-hidden="true"
              ></span>
              <span class="font-mono text-[11px] text-text-muted tracking-[0.15em] uppercase">{s.industry}</span>
            </div>

            <!-- 업체명 -->
            <h2 class="font-display text-2xl font-bold tracking-tight mb-2 group-hover:text-accent transition-colors duration-300">
              {s.business}
            </h2>

            <!-- 스타일 레퍼런스 -->
            <p class="font-mono text-[11px] text-text-faint leading-relaxed mb-1">
              {s.styleRef}
            </p>
            <p class="font-mono text-[11px] text-accent/80 tracking-[0.15em] mb-4">{s.era}</p>

            <!-- 한 줄 설명 -->
            <p class="text-sm text-text-muted leading-relaxed mb-6 flex-1">
              {s.blurb}
            </p>

            <!-- 데모 열기 -->
            <span class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.15em] uppercase text-text group-hover:text-accent transition-colors duration-300">
              ► 데모 열기
              <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── 하단 CTA ───────── -->
  <section class="border-t border-border bg-surface/40">
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-16 sm:py-24 text-center">
      <div class="flex items-center justify-center gap-3 mb-6 font-mono text-[10px] tracking-[0.3em] uppercase">
        <span class="hud-pip hud-pip--amber"></span>
        <span class="text-accent">무료 제작 접수중</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        마음에 드는 스타일 있으세요?
      </h2>
      <p class="text-text-muted leading-relaxed max-w-xl mx-auto mb-10">
        카톡으로 알려주세요. 업종과 원하는 분위기만 말씀하시면,
        그 업체만의 홈페이지를 만들어 드립니다.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://invite.kakao.com/tc/EszOu7fY0i"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2.5 border-2 border-accent bg-accent text-black px-6 py-3.5 font-bold text-sm sm:text-base tracking-tight hover:bg-accent-hover transition-colors duration-200"
        >
          <span>💬 카톡으로 문의하기</span>
          <span class="font-mono transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
        <a
          href="/styles"
          class="inline-flex items-center gap-2 border border-border-strong text-text-muted hover:text-text hover:border-accent px-5 py-3 font-mono text-xs tracking-[0.2em] uppercase transition-colors duration-200"
        >
          스타일 도감 →
        </a>
      </div>
    </div>
  </section>
</Base>
