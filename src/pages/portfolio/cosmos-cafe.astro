---
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>코스모스 · КОСМОС — 천문 과학카페</title>
  <meta name="description" content="별을 향하여. 서울 성북의 천문 과학카페 코스모스. 우주를 마시고, 밤하늘을 관측하세요." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Russo+One&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --red: #c41e1e;
      --red-deep: #9a1414;
      --cream: #f4ecd8;
      --cream-dim: #e8dcc0;
      --gold: #f0d040;
      --gold-deep: #c9a417;
      --ink: #1a1410;
      --night: #120d18;
      --paper-line: rgba(26, 20, 16, 0.12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Noto Sans KR', sans-serif;
      background: var(--cream);
      color: var(--ink);
      overflow-x: hidden;
      line-height: 1.6;
    }

    .display { font-family: 'Russo One', 'Oswald', sans-serif; }
    .slab { font-family: 'Oswald', sans-serif; font-weight: 700; }

    /* paper grain */
    .grain::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.018) 3px, rgba(0,0,0,0.018) 4px);
      pointer-events: none;
      z-index: 1;
    }

    /* ============ HERO POSTER ============ */
    .hero {
      position: relative;
      min-height: 100vh;
      background:
        radial-gradient(circle at 78% 22%, rgba(240, 208, 64, 0.18), transparent 42%),
        linear-gradient(135deg, var(--red) 0%, var(--red-deep) 55%, #7c0f0f 100%);
      overflow: hidden;
      display: flex;
      align-items: center;
      padding: 120px 6vw 80px;
    }

    /* radiating rays */
    .rays {
      position: absolute;
      top: 14%;
      right: 8%;
      width: 70vmax;
      height: 70vmax;
      transform: translate(35%, -35%);
      background: repeating-conic-gradient(
        from 0deg,
        rgba(240, 208, 64, 0.13) 0deg 7deg,
        transparent 7deg 14deg
      );
      border-radius: 50%;
      animation: spin 120s linear infinite;
      z-index: 0;
    }
    @keyframes spin { to { transform: translate(35%, -35%) rotate(360deg); } }

    .orbit-ring {
      position: absolute;
      top: 18%;
      right: 12%;
      width: 46vmax;
      height: 46vmax;
      transform: translate(28%, -28%) rotate(-18deg);
      border: 3px solid rgba(244, 236, 216, 0.28);
      border-radius: 50%;
      z-index: 0;
    }
    .orbit-ring::after {
      content: "";
      position: absolute;
      inset: 9%;
      border: 2px dashed rgba(240, 208, 64, 0.5);
      border-radius: 50%;
    }

    .hero-inner {
      position: relative;
      z-index: 3;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 40px;
      align-items: center;
    }

    .eyebrow {
      display: inline-block;
      font-family: 'Oswald', sans-serif;
      font-weight: 600;
      letter-spacing: 0.42em;
      font-size: 13px;
      color: var(--night);
      background: var(--gold);
      padding: 7px 16px 6px;
      transform: skewX(-8deg);
      margin-bottom: 28px;
    }
    .eyebrow span { display: inline-block; transform: skewX(8deg); }

    .hero h1 {
      font-family: 'Russo One', sans-serif;
      color: var(--cream);
      line-height: 0.92;
      font-size: clamp(3.4rem, 11vw, 8.5rem);
      letter-spacing: -0.01em;
      text-shadow: 6px 6px 0 var(--red-deep);
    }
    .hero h1 .cyr {
      display: block;
      font-size: clamp(1.6rem, 4.5vw, 3rem);
      color: var(--gold);
      letter-spacing: 0.16em;
      text-shadow: 3px 3px 0 var(--red-deep);
      margin-top: 8px;
    }

    .hero .slogan {
      margin-top: 30px;
      font-family: 'Oswald', sans-serif;
      font-weight: 500;
      font-size: clamp(1.05rem, 2.4vw, 1.5rem);
      color: var(--cream);
      max-width: 30ch;
      letter-spacing: 0.02em;
    }
    .hero .slogan b { color: var(--gold); font-weight: 700; }

    .hero-cta {
      margin-top: 38px;
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .btn {
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      letter-spacing: 0.12em;
      font-size: 15px;
      text-decoration: none;
      padding: 15px 30px;
      text-transform: uppercase;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
      display: inline-block;
    }
    .btn-gold {
      background: var(--gold);
      color: var(--night);
      box-shadow: 5px 5px 0 var(--red-deep);
    }
    .btn-gold:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--red-deep); }
    .btn-line {
      background: transparent;
      color: var(--cream);
      border: 2px solid var(--cream);
      box-shadow: 5px 5px 0 rgba(18, 13, 24, 0.4);
    }
    .btn-line:hover { transform: translate(-2px, -2px); background: var(--cream); color: var(--red); }

    /* rocket SVG holder */
    .hero-art {
      position: relative;
      z-index: 2;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .rocket {
      width: clamp(180px, 30vw, 360px);
      filter: drop-shadow(8px 12px 0 rgba(18, 13, 24, 0.35));
      animation: float 6s ease-in-out infinite;
    }
    @keyframes float { 0%,100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-18px) rotate(1.5deg); } }

    .star {
      position: absolute;
      color: var(--gold);
      z-index: 2;
      opacity: 0.9;
    }
    .star.s1 { top: 12%; left: 6%; width: 34px; }
    .star.s2 { bottom: 16%; left: 18%; width: 22px; }
    .star.s3 { top: 22%; right: 6%; width: 26px; }

    /* poster bottom bar */
    .poster-bar {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      z-index: 4;
      background: var(--night);
      color: var(--gold);
      font-family: 'Oswald', sans-serif;
      font-weight: 500;
      letter-spacing: 0.3em;
      font-size: 12px;
      text-align: center;
      padding: 12px;
      border-top: 3px solid var(--gold);
    }

    /* ============ SECTION SHELL ============ */
    section { position: relative; }
    .wrap { max-width: 1180px; margin: 0 auto; padding: 0 6vw; }

    .sec-head {
      display: flex;
      align-items: baseline;
      gap: 18px;
      margin-bottom: 48px;
      flex-wrap: wrap;
    }
    .sec-num {
      font-family: 'Russo One', sans-serif;
      font-size: clamp(2.4rem, 6vw, 4.5rem);
      color: var(--red);
      -webkit-text-stroke: 2px var(--red);
      line-height: 1;
    }
    .sec-title {
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: clamp(1.6rem, 4vw, 2.8rem);
      color: var(--ink);
    }
    .sec-kicker {
      font-family: 'Oswald', sans-serif;
      letter-spacing: 0.3em;
      font-size: 12px;
      color: var(--gold-deep);
      font-weight: 600;
      width: 100%;
    }

    /* ============ MENU ============ */
    .menu {
      padding: 110px 0 100px;
      background: var(--cream);
    }
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0;
      border-top: 3px solid var(--ink);
      border-left: 3px solid var(--ink);
    }
    .menu-item {
      border-right: 3px solid var(--ink);
      border-bottom: 3px solid var(--ink);
      padding: 28px 26px 30px;
      background: var(--cream);
      position: relative;
      transition: background 0.2s ease, color 0.2s ease;
    }
    .menu-item:hover { background: var(--red); color: var(--cream); }
    .menu-item:hover .mi-price { color: var(--gold); }
    .menu-item:hover .mi-cyr { color: var(--gold); }
    .mi-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .mi-name { font-family: 'Oswald', sans-serif; font-weight: 700; font-size: 1.35rem; letter-spacing: 0.01em; }
    .mi-cyr { font-family: 'Oswald', sans-serif; font-size: 0.78rem; letter-spacing: 0.18em; color: var(--gold-deep); margin-top: 2px; }
    .mi-price { font-family: 'Russo One', sans-serif; font-size: 1.1rem; color: var(--red); white-space: nowrap; }
    .mi-desc { margin-top: 14px; font-size: 0.9rem; opacity: 0.82; }
    .mi-badge {
      display: inline-block;
      margin-top: 16px;
      font-family: 'Oswald', sans-serif;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border: 1.5px solid currentColor;
      padding: 3px 9px;
      opacity: 0.7;
    }

    /* ============ PROGRAMS (observation) ============ */
    .programs {
      padding: 110px 0 100px;
      background: var(--night);
      color: var(--cream);
      overflow: hidden;
    }
    .programs .sec-title { color: var(--cream); }
    .programs .sec-num { color: var(--gold); -webkit-text-stroke: 2px var(--gold); }
    .stars-bg {
      position: absolute; inset: 0;
      background-image:
        radial-gradient(1.5px 1.5px at 20% 30%, #fff, transparent),
        radial-gradient(1.5px 1.5px at 70% 65%, var(--gold), transparent),
        radial-gradient(1px 1px at 40% 80%, #fff, transparent),
        radial-gradient(1px 1px at 88% 18%, #fff, transparent),
        radial-gradient(1.5px 1.5px at 55% 12%, #fff, transparent),
        radial-gradient(1px 1px at 12% 70%, var(--gold), transparent);
      opacity: 0.5;
      pointer-events: none;
    }
    .prog-list {
      position: relative;
      z-index: 2;
      display: grid;
      gap: 0;
    }
    .prog {
      display: grid;
      grid-template-columns: 130px 1fr auto;
      gap: 28px;
      align-items: center;
      padding: 30px 0;
      border-top: 1px solid rgba(244, 236, 216, 0.2);
      transition: padding-left 0.2s ease;
    }
    .prog:last-child { border-bottom: 1px solid rgba(244, 236, 216, 0.2); }
    .prog:hover { padding-left: 14px; }
    .prog-time {
      font-family: 'Russo One', sans-serif;
      font-size: 1.3rem;
      color: var(--gold);
      letter-spacing: 0.02em;
    }
    .prog-day { display: block; font-family: 'Oswald', sans-serif; font-size: 0.72rem; letter-spacing: 0.2em; color: var(--cream-dim); opacity: 0.7; margin-top: 4px; }
    .prog-name { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 1.35rem; }
    .prog-sub { font-size: 0.88rem; opacity: 0.7; margin-top: 4px; }
    .prog-fee {
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      color: var(--cream);
      border: 2px solid var(--gold);
      padding: 8px 16px;
      white-space: nowrap;
      letter-spacing: 0.05em;
    }

    /* ============ SPACE (interior) ============ */
    .space {
      padding: 110px 0 100px;
      background: var(--cream);
    }
    .space-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 0;
      border: 3px solid var(--ink);
    }
    .space-copy {
      padding: 48px 44px;
      background: var(--gold);
      color: var(--night);
    }
    .space-copy h3 {
      font-family: 'Russo One', sans-serif;
      font-size: clamp(1.6rem, 3.4vw, 2.6rem);
      line-height: 1.05;
      margin-bottom: 22px;
    }
    .space-copy p { font-size: 0.98rem; margin-bottom: 16px; line-height: 1.75; }
    .space-feats { list-style: none; margin-top: 26px; display: grid; gap: 12px; }
    .space-feats li {
      font-family: 'Oswald', sans-serif;
      font-weight: 600;
      letter-spacing: 0.04em;
      padding-left: 26px;
      position: relative;
    }
    .space-feats li::before {
      content: "★";
      position: absolute; left: 0; top: 0;
      color: var(--red);
    }
    .space-art {
      background:
        radial-gradient(circle at 50% 40%, rgba(240,208,64,0.22), transparent 60%),
        linear-gradient(160deg, var(--red) 0%, var(--red-deep) 100%);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 360px;
      overflow: hidden;
    }
    .space-art .planet-svg { width: 70%; animation: float 7s ease-in-out infinite; }
    .space-art .ring-deco {
      position: absolute; inset: 8%;
      border: 2px dashed rgba(244,236,216,0.35);
      border-radius: 50%;
    }

    /* ============ CONTACT ============ */
    .contact {
      padding: 110px 0 0;
      background: var(--red);
      color: var(--cream);
      position: relative;
      overflow: hidden;
    }
    .contact .rays-c {
      position: absolute; bottom: -30%; left: 50%;
      width: 90vmax; height: 90vmax;
      transform: translateX(-50%);
      background: repeating-conic-gradient(from 0deg, rgba(240,208,64,0.08) 0deg 8deg, transparent 8deg 16deg);
      border-radius: 50%;
      z-index: 0;
    }
    .contact .wrap { position: relative; z-index: 2; }
    .contact h2 {
      font-family: 'Russo One', sans-serif;
      font-size: clamp(2.2rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 14px;
    }
    .contact h2 .cyr { display: block; color: var(--gold); font-size: 0.4em; letter-spacing: 0.16em; margin-top: 10px; }
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 36px;
      margin: 56px 0 70px;
    }
    .ci-label { font-family: 'Oswald', sans-serif; letter-spacing: 0.24em; font-size: 11px; color: var(--gold); margin-bottom: 10px; }
    .ci-val { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 1.15rem; }
    .ci-val small { display: block; font-family: 'Noto Sans KR'; font-weight: 400; font-size: 0.82rem; opacity: 0.8; margin-top: 6px; }
    .contact-foot {
      background: var(--night);
      color: var(--cream-dim);
      text-align: center;
      padding: 26px 6vw;
      font-family: 'Oswald', sans-serif;
      letter-spacing: 0.2em;
      font-size: 12px;
      position: relative; z-index: 2;
      border-top: 3px solid var(--gold);
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 880px) {
      .hero-inner { grid-template-columns: 1fr; gap: 30px; }
      .hero-art { order: -1; }
      .rocket { width: clamp(150px, 44vw, 240px); }
      .space-grid { grid-template-columns: 1fr; }
      .prog { grid-template-columns: 100px 1fr; }
      .prog-fee { grid-column: 2; justify-self: start; margin-top: 6px; }
    }
    @media (max-width: 520px) {
      .hero { padding: 110px 7vw 80px; }
      .menu-grid { grid-template-columns: 1fr; }
      .prog { grid-template-columns: 1fr; gap: 8px; }
      .prog-time { font-size: 1.1rem; }
    }
  </style>
</head>
<body>

  <div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
    <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
    <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 27 · 코스모스 — 냉전기 소련 우주 포스터 스타일</span>
    <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
  </div>
  <div style="height:40px;"></div>

  <!-- ============ HERO ============ -->
  <header class="hero grain">
    <div class="rays"></div>
    <div class="orbit-ring"></div>

    <div class="hero-inner">
      <div>
        <span class="eyebrow"><span>천문 · 과학카페 · 1961 SECTOR</span></span>
        <h1>
          코스모스
          <span class="cyr">КОСМОС</span>
        </h1>
        <p class="slogan">
          별을 향하여. <b>우주를 한 잔</b>에 담고, 밤하늘을 우리 손으로 끌어내립니다. 인류는 우주로, 당신은 코스모스로.
        </p>
        <div class="hero-cta">
          <a href="#programs" class="btn btn-gold">관측 프로그램</a>
          <a href="#menu" class="btn btn-line">메뉴 보기</a>
        </div>
      </div>

      <div class="hero-art">
        <!-- star left -->
        <svg class="star s1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l3 9h9l-7.5 5.5L19 24l-7-5.5L5 24l2.5-9.5L0 9h9z"/></svg>
        <svg class="star s2" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l3 9h9l-7.5 5.5L19 24l-7-5.5L5 24l2.5-9.5L0 9h9z"/></svg>
        <svg class="star s3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l3 9h9l-7.5 5.5L19 24l-7-5.5L5 24l2.5-9.5L0 9h9z"/></svg>

        <!-- rocket -->
        <svg class="rocket" viewBox="0 0 200 360" xmlns="http://www.w3.org/2000/svg">
          <!-- exhaust -->
          <path d="M82 300 L100 360 L118 300 Z" fill="#f0d040"/>
          <path d="M90 300 L100 340 L110 300 Z" fill="#f4ecd8"/>
          <!-- fins -->
          <path d="M60 250 Q40 290 56 308 L78 295 L78 250 Z" fill="#9a1414"/>
          <path d="M140 250 Q160 290 144 308 L122 295 L122 250 Z" fill="#9a1414"/>
          <!-- body -->
          <path d="M100 10 Q140 80 140 200 L140 300 L60 300 L60 200 Q60 80 100 10 Z" fill="#f4ecd8"/>
          <!-- red stripe -->
          <path d="M60 250 L140 250 L140 300 L60 300 Z" fill="#c41e1e"/>
          <!-- nose -->
          <path d="M100 10 Q120 50 124 100 L76 100 Q80 50 100 10 Z" fill="#c41e1e"/>
          <!-- window -->
          <circle cx="100" cy="150" r="26" fill="#120d18"/>
          <circle cx="100" cy="150" r="26" fill="none" stroke="#f0d040" stroke-width="5"/>
          <circle cx="92" cy="142" r="7" fill="#f0d040" opacity="0.8"/>
          <!-- star emblem -->
          <path d="M100 200 l5 14 h15 l-12 9 5 15 -13-9 -13 9 5-15 -12-9 h15 z" fill="#f0d040" transform="scale(0.7) translate(43 86)"/>
          <!-- rivet line -->
          <line x1="100" y1="115" x2="100" y2="135" stroke="#c9a417" stroke-width="2"/>
        </svg>
      </div>
    </div>

    <div class="poster-bar">★ ЗА ЗВЁЗДАМИ ★ 별을 향하여 ★ 서울 성북 천문 과학카페 ★ EST. 코스모스 ★</div>
  </header>

  <!-- ============ MENU ============ -->
  <section class="menu grain" id="menu">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">МЕНЮ · 01</span>
        <span class="sec-num">01</span>
        <h2 class="sec-title">우주 보급품 · 음료</h2>
      </div>

      <div class="menu-grid">
        <div class="menu-item">
          <div class="mi-top">
            <div>
              <div class="mi-name">보스토크 블랙</div>
              <div class="mi-cyr">ВОСТОК · ESPRESSO</div>
            </div>
            <div class="mi-price">5,500</div>
          </div>
          <p class="mi-desc">최초의 유인 궤도처럼 묵직하게. 다크 로스트 더블 샷, 무중력 크레마.</p>
          <span class="mi-badge">시그니처</span>
        </div>

        <div class="menu-item">
          <div class="mi-top">
            <div>
              <div class="mi-name">은하수 라떼</div>
              <div class="mi-cyr">ГАЛАКТИКА · LATTE</div>
            </div>
            <div class="mi-price">6,500</div>
          </div>
          <p class="mi-desc">버터플라이피로 푸른 성운을 그린 후 스팀밀크 나선은하. 잔마다 다른 하늘.</p>
          <span class="mi-badge">인기</span>
        </div>

        <div class="menu-item">
          <div class="mi-top">
            <div>
              <div class="mi-name">스푸트니크 소다</div>
              <div class="mi-cyr">СПУТНИК · SODA</div>
            </div>
            <div class="mi-price">6,000</div>
