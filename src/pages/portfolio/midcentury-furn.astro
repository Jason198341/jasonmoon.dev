---
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>미드센추리 — 미드센추리 모던 가구·소품</title>
  <meta name="description" content="임스 시대의 낙천적 기능주의. 미드센추리 모던 가구와 소품, 서울 한남 쇼룸." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --mustard: #e8a33d;
      --mustard-deep: #d18b22;
      --olive: #7a8a4e;
      --olive-deep: #5f6e3a;
      --teal: #2f8f88;
      --teal-deep: #246d68;
      --walnut: #6b4a32;
      --walnut-deep: #4f3623;
      --cream: #f6efe2;
      --cream-soft: #fbf7ee;
      --ink: #2c2620;
      --ink-soft: #5b5347;
      --line: rgba(107, 74, 50, 0.18);

      --font-head: 'Josefin Sans', 'Poppins', sans-serif;
      --font-body: 'Poppins', 'Josefin Sans', sans-serif;

      --space-section: clamp(4.5rem, 3rem + 7vw, 9rem);
      --radius-organic: 40% 60% 62% 38% / 46% 38% 62% 54%;
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: var(--font-body);
      color: var(--ink);
      background: var(--cream);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, .head {
      font-family: var(--font-head);
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1.08;
      margin: 0;
    }

    p { margin: 0; }

    a { color: inherit; }

    .wrap {
      width: min(1180px, 92vw);
      margin-inline: auto;
    }

    .eyebrow {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.72rem;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--teal-deep);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.02em;
      padding: 0.85rem 1.6rem;
      border-radius: 999px;
      text-decoration: none;
      cursor: pointer;
      border: 2px solid transparent;
      transition: transform 0.4s var(--ease), background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
    }
    .btn-primary {
      background: var(--mustard);
      color: var(--walnut-deep);
      box-shadow: 0 14px 30px -14px rgba(209, 139, 34, 0.8);
    }
    .btn-primary:hover {
      background: var(--mustard-deep);
      transform: translateY(-3px);
      box-shadow: 0 22px 40px -16px rgba(209, 139, 34, 0.9);
    }
    .btn-ghost {
      background: transparent;
      color: var(--walnut-deep);
      border-color: var(--walnut);
    }
    .btn-ghost:hover {
      background: var(--walnut);
      color: var(--cream-soft);
      transform: translateY(-3px);
    }

    /* ---------- NAV ---------- */
    .nav {
      position: sticky;
      top: 40px;
      z-index: 50;
      background: rgba(246, 239, 226, 0.82);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.9rem 0;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 1.18rem;
      letter-spacing: 0.04em;
    }
    .brand small {
      display: block;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.58rem;
      letter-spacing: 0.3em;
      color: var(--ink-soft);
      text-transform: uppercase;
    }
    .nav-links {
      display: flex;
      gap: 1.8rem;
      font-size: 0.85rem;
      font-weight: 500;
    }
    .nav-links a {
      text-decoration: none;
      position: relative;
      padding-bottom: 3px;
    }
    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0; bottom: 0;
      width: 0; height: 2px;
      background: var(--mustard);
      transition: width 0.35s var(--ease);
    }
    .nav-links a:hover::after { width: 100%; }
    @media (max-width: 760px) { .nav-links { display: none; } }

    /* ---------- HERO ---------- */
    .hero {
      position: relative;
      padding: clamp(4rem, 3rem + 7vw, 8rem) 0 var(--space-section);
      overflow: hidden;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(2rem, 1rem + 4vw, 5rem);
      align-items: center;
    }
    @media (max-width: 880px) {
      .hero-grid { grid-template-columns: 1fr; }
    }
    .hero h1 {
      font-size: clamp(2.8rem, 1.4rem + 6vw, 5.6rem);
      font-weight: 700;
      margin: 1.1rem 0 0;
    }
    .hero h1 .accent { color: var(--mustard-deep); }
    .hero h1 .teal { color: var(--teal-deep); }
    .hero-lead {
      max-width: 38ch;
      margin-top: 1.5rem;
      color: var(--ink-soft);
      font-size: 1.05rem;
    }
    .hero-cta {
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
      margin-top: 2.2rem;
    }
    .hero-stats {
      display: flex;
      gap: 2.4rem;
      margin-top: 3rem;
      flex-wrap: wrap;
    }
    .hero-stats .num {
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 1.9rem;
      color: var(--walnut-deep);
    }
    .hero-stats .lbl {
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }

    /* hero visual — organic blob with furniture silhouette */
    .hero-visual {
      position: relative;
      aspect-ratio: 1 / 1;
      display: grid;
      place-items: center;
    }
    .blob {
      position: absolute;
      inset: 6%;
      background: linear-gradient(150deg, var(--teal) 0%, var(--olive) 100%);
      border-radius: var(--radius-organic);
      animation: morph 14s ease-in-out infinite;
      box-shadow: 0 40px 80px -40px rgba(47, 143, 136, 0.7);
    }
    .blob.two {
      inset: 16%;
      background: linear-gradient(150deg, var(--mustard) 0%, var(--mustard-deep) 100%);
      opacity: 0.9;
      animation-duration: 18s;
      animation-direction: reverse;
    }
    @keyframes morph {
      0%, 100% { border-radius: 40% 60% 62% 38% / 46% 38% 62% 54%; }
      33% { border-radius: 62% 38% 40% 60% / 58% 62% 38% 42%; }
      66% { border-radius: 50% 50% 58% 42% / 38% 50% 50% 62%; }
    }
    .hero-chair {
      position: relative;
      z-index: 2;
      width: 62%;
      height: auto;
      filter: drop-shadow(0 18px 24px rgba(79, 54, 35, 0.4));
    }

    /* floating motif badges */
    .motif {
      position: absolute;
      z-index: 3;
      animation: float 7s ease-in-out infinite;
    }
    .motif.starburst { top: 4%; right: 8%; width: 64px; animation-delay: -1s; }
    .motif.atom { bottom: 8%; left: 2%; width: 72px; animation-delay: -3s; }
    .motif.boomerang { top: 38%; left: -4%; width: 58px; animation-delay: -2s; }
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-14px) rotate(6deg); }
    }

    /* atmospheric corner shapes */
    .hero::before {
      content: "";
      position: absolute;
      top: -120px; left: -120px;
      width: 320px; height: 320px;
      background: radial-gradient(circle, rgba(232, 163, 61, 0.22), transparent 70%);
      border-radius: 50%;
    }

    /* ---------- COLLECTION ---------- */
    section { scroll-margin-top: 110px; }

    .section-head {
      max-width: 56ch;
      margin-bottom: clamp(2rem, 1rem + 3vw, 3.4rem);
    }
    .section-head h2 {
      font-size: clamp(2rem, 1.2rem + 3vw, 3.2rem);
      margin-top: 0.8rem;
    }

    .collection { padding: var(--space-section) 0; background: var(--cream-soft); }

    .grid-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.6rem;
    }
    @media (max-width: 900px) { .grid-cards { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .grid-cards { grid-template-columns: 1fr; } }

    .card {
      background: var(--cream);
      border: 1px solid var(--line);
      border-radius: 22px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
    }
    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 50px -28px rgba(79, 54, 35, 0.5);
    }
    .card-visual {
      aspect-ratio: 4 / 3;
      display: grid;
      place-items: center;
      position: relative;
    }
    .card:nth-child(1) .card-visual { background: linear-gradient(160deg, #f3d9a8, #e8a33d); }
    .card:nth-child(2) .card-visual { background: linear-gradient(160deg, #bcd0b0, #7a8a4e); }
    .card:nth-child(3) .card-visual { background: linear-gradient(160deg, #aedbd6, #2f8f88); }
    .card:nth-child(4) .card-visual { background: linear-gradient(160deg, #d8bda6, #6b4a32); }
    .card:nth-child(5) .card-visual { background: linear-gradient(160deg, #f0c9a0, #d18b22); }
    .card:nth-child(6) .card-visual { background: linear-gradient(160deg, #c4cf9a, #5f6e3a); }
    .card-visual svg { width: 64%; height: auto; filter: drop-shadow(0 10px 14px rgba(79,54,35,0.35)); }
    .tag {
      position: absolute;
      top: 0.9rem; left: 0.9rem;
      font-size: 0.64rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      background: rgba(246, 239, 226, 0.92);
      color: var(--walnut-deep);
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
    }
    .card-body { padding: 1.3rem 1.4rem 1.6rem; }
    .card-body h3 { font-size: 1.2rem; }
    .card-body .desc { color: var(--ink-soft); font-size: 0.9rem; margin-top: 0.4rem; }
    .card-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1.1rem;
    }
    .price { font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; color: var(--walnut-deep); }
    .dot-link {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--teal-deep);
      text-decoration: none;
    }
    .dot-link:hover { color: var(--mustard-deep); }

    /* ---------- PHILOSOPHY ---------- */
    .philosophy {
      padding: var(--space-section) 0;
      background: var(--walnut-deep);
      color: var(--cream-soft);
      position: relative;
      overflow: hidden;
    }
    .philosophy .eyebrow { color: var(--mustard); }
    .philosophy h2 { color: var(--cream-soft); font-size: clamp(2rem, 1.2rem + 3vw, 3.2rem); }
    .phil-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(2rem, 1rem + 5vw, 5rem);
      align-items: center;
    }
    @media (max-width: 880px) { .phil-grid { grid-template-columns: 1fr; } }
    .phil-lead { color: rgba(246, 239, 226, 0.82); margin-top: 1.4rem; font-size: 1.05rem; max-width: 42ch; }
    .principles {
      display: grid;
      gap: 1.1rem;
    }
    .principle {
      display: flex;
      gap: 1.1rem;
      align-items: flex-start;
      padding: 1.3rem 1.4rem;
      border-radius: 18px;
      background: rgba(246, 239, 226, 0.06);
      border: 1px solid rgba(246, 239, 226, 0.12);
      transition: background 0.4s ease, transform 0.4s var(--ease);
    }
    .principle:hover { background: rgba(246, 239, 226, 0.1); transform: translateX(6px); }
    .principle .ic {
      flex: none;
      width: 48px; height: 48px;
      display: grid; place-items: center;
      border-radius: 14px;
      background: var(--mustard);
    }
    .principle .ic svg { width: 28px; height: 28px; }
    .principle h3 { font-size: 1.05rem; color: var(--cream-soft); }
    .principle p { font-size: 0.86rem; color: rgba(246, 239, 226, 0.72); margin-top: 0.3rem; }
    .philosophy::after {
      content: "";
      position: absolute;
      right: -140px; bottom: -140px;
      width: 360px; height: 360px;
      background: radial-gradient(circle, rgba(232,163,61,0.28), transparent 70%);
      border-radius: 50%;
    }

    /* ---------- SHOWROOM ---------- */
    .showroom { padding: var(--space-section) 0; }
    .show-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 1rem + 4vw, 4.5rem);
      align-items: center;
    }
    @media (max-width: 880px) { .show-grid { grid-template-columns: 1fr; } }
    .show-visual {
      position: relative;
      aspect-ratio: 5 / 4;
      border-radius: 26px;
      background: linear-gradient(165deg, #f3d9a8 0%, #aedbd6 100%);
      overflow: hidden;
      display: grid;
      place-items: center;
    }
    .show-visual .room svg { width: 78%; height: auto; filter: drop-shadow(0 16px 22px rgba(79,54,35,0.3)); }
    .show-visual .stripe {
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(45deg, rgba(255,255,255,0.06) 0 18px, transparent 18px 36px);
    }
    .info-list { display: grid; gap: 1.1rem; margin-top: 1.8rem; }
    .info-row {
      display: flex;
      gap: 1rem;
      padding-bottom: 1.1rem;
      border-bottom: 1px solid var(--line);
    }
    .info-row .k {
      flex: none;
      width: 90px;
      font-weight: 600;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--teal-deep);
      padding-top: 2px;
    }
    .info-row .v { color: var(--ink); font-size: 0.98rem; }
    .info-row .v small { display:block; color: var(--ink-soft); font-size: 0.82rem; margin-top: 2px; }

    /* ---------- CONTACT ---------- */
    .contact {
      padding: var(--space-section) 0;
      background: var(--olive-deep);
      color: var(--cream-soft);
      position: relative;
      overflow: hidden;
    }
    .contact .eyebrow { color: var(--mustard); }
    .contact h2 { color: var(--cream-soft); font-size: clamp(2rem, 1.2rem + 3vw, 3.2rem); }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 1rem + 4vw, 4rem);
      align-items: start;
    }
    @media (max-width: 760px) { .contact-grid { grid-template-columns: 1fr; } }
    .contact-lead { color: rgba(246, 239, 226, 0.82); margin-top: 1.2rem; max-width: 40ch; }
    .contact-cta { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2rem; }
    .contact-cta .btn-primary { background: var(--mustard); }
    .contact-cta .btn-ghost { color: var(--cream-soft); border-color: rgba(246,239,226,0.6); }
    .contact-cta .btn-ghost:hover { background: var(--cream-soft); color: var(--olive-deep); }

    .contact-card {
      background: rgba(246, 239, 226, 0.07);
      border: 1px solid rgba(246, 239, 226, 0.14);
      border-radius: 22px;
      padding: 1.8rem;
      display: grid;
      gap: 1.2rem;
    }
    .contact-card .cc-row { display: flex; gap: 1rem; align-items: flex-start; }
    .contact-card .cc-ic {
      flex: none; width: 42px; height: 42px;
      display: grid; place-items: center;
      border-radius: 12px;
      background: rgba(232, 163, 61, 0.18);
    }
    .contact-card .cc-ic svg { width: 22px; height: 22px; }
    .contact-card .cc-k { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(246,239,226,0.6); }
    .contact-card .cc-v { font-weight: 500; font-size: 1.02rem; margin-top: 2px; }
    .contact::before {
      content: "";
      position: absolute;
      top: -120px; left: -100px;
      width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(47,143,136,0.4), transparent 70%);
      border-radius: 50%;
    }

    /* ---------- FOOTER ---------- */
    .foot {
      background: var(--ink);
      color: rgba(246, 239, 226, 0.65);
      padding: 2.6rem 0;
      font-size: 0.82rem;
    }
    .foot-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: center; }
    .foot .brand { color: var(--cream-soft); font-size: 1.05rem; }
    .foot .brand small { color: rgba(246,239,226,0.5); }
  </style>
</head>
<body>
<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
  <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
  <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 32 · 미드센추리 — 미드센추리 모던 스타일</span>
  <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
</div>
<div style="height:40px;"></div>

  <!-- NAV -->
  <header class="nav">
    <div class="wrap nav-inner">
      <div class="brand">
        미드센추리
        <small>Mid-Century Modern</small>
      </div>
      <nav class="nav-links" aria-label="주요 메뉴">
        <a href="#collection">컬렉션</a>
        <a href="#philosophy">디자인 철학</a>
        <a href="#showroom">쇼룸</a>
        <a href="#contact">연락</a>
      </nav>
      <a class="btn btn-primary" href="#contact" style="padding:0.6rem 1.2rem;font-size:0.82rem;">상담 예약</a>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Eames Era · 1950s</span>
        <h1>곡선은 <span class="accent">낙천</span>,<br/>직선은 <span class="teal">기능</span>.</h1>
        <p class="hero-lead">임스 시대의 따뜻한 기능주의를 오늘의 공간으로. 유기적 곡선과 기하학적 균형이 만나는, 50년대 미드센추리 모던 가구와 소품.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#collection">컬렉션 보기 →</a>
          <a class="btn btn-ghost" href="#showroom">쇼룸 안내</a>
        </div>
        <div class="hero-stats">
          <div><div class="num">68</div><div class="lbl">큐레이션 피스</div></div>
          <div><div class="num">12년</div><div class="lbl">복원·소싱 경력</div></div>
          <div><div class="num">한남</div><div class="lbl">서울 쇼룸</div></div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="blob"></div>
        <div class="blob two"></div>

        <!-- 라운지 체어 실루엣 -->
        <svg class="hero-chair" viewBox="0 0 200 200" fill="none">
          <path d="M40 70 Q40 40 80 40 L130 40 Q160 40 160 78 L160 120 Q160 130 148 130 L70 130 Q56 130 54 118 L40 70Z" fill="#4f3623"/>
          <path d="M58 128 L62 178 M142 128 L138 178" stroke="#2c2620" stroke-width="7" stroke-linecap="round"/>
          <path d="M52 130 L150 130 L156 150 Q158 160 146 160 L66 160 Q54 160 52 150 Z" fill="#6b4a32"/>
          <path d="M48 74 Q48 50 84 50 L126 50 Q150 50 150 80 L150 110 L48 110 Z" fill="#e8a33d"/>
        </svg>

        <!-- 모티프: 스타버스트 -->
        <svg class="motif starburst" viewBox="0 0 64 64" fill="none">
          <g stroke="#f6efe2" stroke-width="3" stroke-linecap="round">
            <path d="M32 6 L32 26 M32 38 L32 58 M6 32 L26 32 M38 32 L58 32 M14 14 L24 24 M40 40 L50 50 M50 14 L40 24 M24 40 L14 50"/>
          </g>
          <circle cx="32" cy="32" r="6" fill="#f6efe2"/>
        </svg>

        <!-- 모티프: 아톰 -->
        <svg class="motif atom" viewBox="0 0 72 72" fill="none">
          <g stroke="#2c2620" stroke-width="3" fill="none">
            <ellipse cx="36" cy="36" rx="30" ry="12"/>
            <ellipse cx="36" cy="36" rx="30" ry="12" transform="rotate(60 36 36)"/>
            <ellipse cx="36" cy="36" rx="30" ry="12" transform="rotate(120 36 36)"/>
          </g>
