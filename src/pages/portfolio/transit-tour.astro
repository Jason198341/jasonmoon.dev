<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>트랜짓 투어 — 여정을 노선도로</title>
  <meta name="description" content="트랜짓 투어. 당신의 여행 코스를 지하철 노선도처럼 명료하게 설계하는 여행사. 서울 종로 기반 시티투어·당일투어·테마투어." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --line-red: #dc241f;
      --line-blue: #0019a8;
      --line-green: #00782a;
      --line-yellow: #ffd329;
      --line-orange: #ee7c0e;
      --line-purple: #7156a5;

      --ink: #10131a;
      --ink-soft: #4a5568;
      --ink-faint: #8a94a6;
      --paper: #ffffff;
      --paper-grey: #f4f5f7;
      --paper-line: #dfe3e9;

      --font-display: 'Hanken Grotesk', system-ui, sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;

      --maxw: 1180px;
      --radius: 4px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      color: var(--ink);
      background: var(--paper);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    a { color: inherit; }

    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 0 24px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }
    .eyebrow::before {
      content: "";
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--paper);
      border: 4px solid var(--line-red);
    }

    /* ---------- TOP BAR (brand) ---------- */
    .topbar {
      position: sticky;
      top: 40px;
      z-index: 50;
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--paper-line);
    }
    .topbar .wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 20px;
      letter-spacing: -0.03em;
    }
    .roundel {
      width: 26px; height: 26px;
      border-radius: 50%;
      border: 6px solid var(--line-red);
      background: var(--paper);
      position: relative;
      flex: none;
    }
    .roundel::after {
      content: "";
      position: absolute;
      left: -6px; right: -6px;
      top: 50%; transform: translateY(-50%);
      height: 6px;
      background: var(--line-blue);
    }
    .nav { display: flex; gap: 28px; align-items: center; }
    .nav a {
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      color: var(--ink-soft);
    }
    .nav a:hover { color: var(--ink); }
    .nav .cta {
      background: var(--ink);
      color: #fff;
      padding: 9px 16px;
      border-radius: var(--radius);
      font-family: var(--font-display);
    }
    .nav .cta:hover { background: var(--line-blue); color: #fff; }
    @media (max-width: 760px) { .nav { display: none; } }

    /* ---------- HERO ---------- */
    .hero {
      background:
        linear-gradient(180deg, var(--paper) 0%, var(--paper-grey) 100%);
      padding: 72px 0 48px;
      border-bottom: 1px solid var(--paper-line);
      overflow: hidden;
    }
    .hero .wrap {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .hero h1 {
      font-size: clamp(40px, 6vw, 76px);
      font-weight: 800;
      margin: 18px 0 20px;
    }
    .hero h1 em {
      font-style: normal;
      color: var(--line-red);
    }
    .hero p.lead {
      font-size: 18px;
      color: var(--ink-soft);
      max-width: 38ch;
      margin-bottom: 28px;
    }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 15px;
      padding: 13px 22px;
      border-radius: var(--radius);
      text-decoration: none;
      transition: transform .12s ease, background .15s ease;
    }
    .btn-primary { background: var(--line-red); color: #fff; }
    .btn-primary:hover { background: #b51d18; transform: translateY(-2px); }
    .btn-ghost { background: #fff; color: var(--ink); border: 2px solid var(--paper-line); }
    .btn-ghost:hover { border-color: var(--ink); transform: translateY(-2px); }

    .hero-stats {
      display: flex;
      gap: 28px;
      margin-top: 36px;
      flex-wrap: wrap;
    }
    .stat strong {
      display: block;
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }
    .stat span { font-size: 13px; color: var(--ink-faint); }

    .hero-map {
      background: #fff;
      border: 1px solid var(--paper-line);
      border-radius: 8px;
      padding: 16px;
      box-shadow: 0 24px 60px -28px rgba(16,19,26,0.25);
    }
    .hero-map svg { width: 100%; height: auto; display: block; }
    @media (max-width: 860px) {
      .hero .wrap { grid-template-columns: 1fr; gap: 32px; }
    }

    /* ---------- SECTION SHELL ---------- */
    section.block { padding: 76px 0; }
    .sec-head { max-width: 60ch; margin-bottom: 40px; }
    .sec-head h2 {
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 800;
      margin: 14px 0 12px;
    }
    .sec-head p { color: var(--ink-soft); font-size: 16px; }

    /* ---------- COURSE MAP (line diagram) ---------- */
    .course-map {
      background: var(--paper-grey);
      border: 1px solid var(--paper-line);
      border-radius: 10px;
      padding: 28px clamp(16px, 4vw, 44px);
    }
    .course-map svg { width: 100%; height: auto; display: block; }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 18px 28px;
      margin-top: 28px;
      padding-top: 24px;
      border-top: 1px dashed var(--paper-line);
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      font-weight: 600;
    }
    .legend-swatch {
      width: 26px; height: 7px; border-radius: 4px; flex: none;
    }
    .legend-item small { color: var(--ink-faint); font-weight: 500; }

    /* ---------- POPULAR JOURNEYS ---------- */
    .journeys {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    @media (max-width: 880px) { .journeys { grid-template-columns: 1fr; } }

    .jcard {
      border: 1px solid var(--paper-line);
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .jcard:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 44px -26px rgba(16,19,26,0.4);
    }
    .jcard-bar { height: 8px; }
    .jcard-body { padding: 22px 22px 24px; flex: 1; display: flex; flex-direction: column; }
    .jcard .line-tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin-bottom: 12px;
    }
    .line-dot { width: 12px; height: 12px; border-radius: 50%; flex: none; }
    .jcard h3 { font-size: 21px; font-weight: 800; margin-bottom: 8px; }
    .jcard p { font-size: 14px; color: var(--ink-soft); margin-bottom: 16px; }

    .stops {
      list-style: none;
      margin: 0 0 18px;
      padding-left: 14px;
      border-left: 3px solid var(--paper-line);
    }
    .stops li {
      position: relative;
      font-size: 13px;
      color: var(--ink);
      padding: 4px 0 4px 14px;
    }
    .stops li::before {
      content: "";
      position: absolute;
      left: -8px; top: 50%; transform: translateY(-50%);
      width: 9px; height: 9px; border-radius: 50%;
      background: #fff;
      border: 2px solid var(--ink-faint);
    }
    .stops li.interchange::before {
      width: 11px; height: 11px;
      border-color: var(--ink);
      box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--ink);
    }

    .jcard-foot {
      margin-top: auto;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
    }
    .price { font-family: var(--font-display); font-weight: 800; font-size: 22px; }
    .price small { font-size: 12px; color: var(--ink-faint); font-weight: 600; }
    .jcard-foot a {
      font-size: 13px; font-weight: 700; text-decoration: none;
      color: var(--line-blue);
    }
    .jcard-foot a:hover { text-decoration: underline; }

    /* ---------- BOOKING (how it works) ---------- */
    .booking { background: var(--paper-grey); border-top: 1px solid var(--paper-line); border-bottom: 1px solid var(--paper-line); }
    .steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      position: relative;
    }
    .steps::before {
      content: "";
      position: absolute;
      top: 26px; left: 8%; right: 8%;
      height: 6px;
      background: var(--line-green);
      border-radius: 4px;
      z-index: 0;
    }
    .step { text-align: center; padding: 0 14px; position: relative; z-index: 1; }
    .step-marker {
      width: 54px; height: 54px;
      margin: 0 auto 18px;
      border-radius: 50%;
      background: #fff;
      border: 6px solid var(--line-green);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 20px;
    }
    .step h4 { font-size: 17px; margin-bottom: 6px; }
    .step p { font-size: 13px; color: var(--ink-soft); }
    @media (max-width: 760px) {
      .steps { grid-template-columns: 1fr 1fr; gap: 32px 0; }
      .steps::before { display: none; }
    }

    /* ---------- CONTACT ---------- */
    .contact .wrap {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
      align-items: start;
    }
    @media (max-width: 860px) { .contact .wrap { grid-template-columns: 1fr; gap: 32px; } }

    .contact-card {
      background: var(--ink);
      color: #fff;
      border-radius: 12px;
      padding: 36px;
    }
    .contact-card h2 { color: #fff; font-size: 32px; margin-bottom: 10px; }
    .contact-card p { color: #b6bdc9; margin-bottom: 26px; }
    .info-row {
      display: flex;
      gap: 14px;
      padding: 14px 0;
      border-top: 1px solid rgba(255,255,255,0.12);
      align-items: center;
    }
    .info-row .ic {
      width: 36px; height: 36px; border-radius: 50%;
      flex: none;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-weight: 800; font-size: 13px;
      color: var(--ink);
    }
    .info-row strong { display: block; font-size: 15px; }
    .info-row span { font-size: 13px; color: #9aa3b2; }

    .hours-card {
      border: 1px solid var(--paper-line);
      border-radius: 12px;
      padding: 30px;
    }
    .hours-card h3 { font-size: 20px; margin-bottom: 18px; }
    .hours-row {
      display: flex; justify-content: space-between;
      padding: 9px 0;
      border-bottom: 1px dashed var(--paper-line);
      font-size: 14px;
    }
    .hours-row:last-child { border-bottom: none; }
    .hours-row span:last-child { color: var(--ink-soft); font-weight: 600; }
    .mapnote {
      margin-top: 20px;
      padding: 16px;
      background: var(--paper-grey);
      border-radius: 8px;
      font-size: 13px;
      color: var(--ink-soft);
    }

    /* ---------- FOOTER ---------- */
    footer.site {
      background: var(--ink);
      color: #aab2c0;
      padding: 40px 0;
      font-size: 13px;
    }
    footer.site .wrap {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    footer.site .brand { color: #fff; font-size: 17px; }
    footer.site .roundel { width: 20px; height: 20px; border-width: 5px; }
    footer.site .roundel::after { height: 5px; left: -5px; right: -5px; }
  </style>
</head>
<body>

<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
  <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
  <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 36 · 트랜짓 투어 — 런던 지하철 노선도(벡) 스타일</span>
  <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
</div>
<div style="height:40px;"></div>

<!-- BRAND BAR -->
<header class="topbar">
  <div class="wrap">
    <div class="brand">
      <span class="roundel" aria-hidden="true"></span>
      트랜짓 투어
    </div>
    <nav class="nav">
      <a href="#map">노선도</a>
      <a href="#journeys">인기 여정</a>
      <a href="#booking">예약 안내</a>
      <a href="#contact" class="cta">상담 예약</a>
    </nav>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">서울 종로 · 시티투어 전문</span>
      <h1>여정을 <em>노선도</em>처럼 명료하게.</h1>
      <p class="lead">복잡한 여행 일정을 한 장의 지하철 노선도로 설계합니다. 환승역에서 코스를 갈아타고, 원하는 역에서 내리세요.</p>
      <div class="hero-actions">
        <a href="#journeys" class="btn btn-primary">인기 노선 보기</a>
        <a href="#contact" class="btn btn-ghost">맞춤 코스 상담</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><strong>4개</strong><span>테마 노선</span></div>
        <div class="stat"><strong>120+</strong><span>큐레이션 역</span></div>
        <div class="stat"><strong>4.9</strong><span>이용 만족도</span></div>
      </div>
    </div>

    <!-- HERO MINI MAP -->
    <div class="hero-map" aria-label="트랜짓 투어 노선도 미리보기">
      <svg viewBox="0 0 360 300" role="img" aria-hidden="true">
        <!-- Red line -->
        <polyline points="40,60 140,60 200,120 200,200" fill="none" stroke="#dc241f" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Blue line -->
        <polyline points="40,140 120,140 200,220 320,220" fill="none" stroke="#0019a8" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Green line -->
        <polyline points="200,40 200,120 280,200 280,260" fill="none" stroke="#00782a" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Yellow line -->
        <polyline points="80,260 200,200 320,80" fill="none" stroke="#ffd329" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>

        <!-- normal stations -->
        <g fill="#fff" stroke="#10131a" stroke-width="3">
          <circle cx="40" cy="60" r="6"/>
          <circle cx="140" cy="60" r="6"/>
          <circle cx="40" cy="140" r="6"/>
          <circle cx="120" cy="140" r="6"/>
          <circle cx="320" cy="220" r="6"/>
          <circle cx="200" cy="40" r="6"/>
          <circle cx="280" cy="260" r="6"/>
          <circle cx="80" cy="260" r="6"/>
          <circle cx="320" cy="80" r="6"/>
        </g>
        <!-- interchange (200,120) and (200,200) -->
        <g fill="#fff" stroke="#10131a" stroke-width="4">
          <rect x="190" y="110" width="20" height="20" rx="10"/>
          <rect x="190" y="190" width="20" height="20" rx="10"/>
        </g>
      </svg>
    </div>
  </div>
</section>

<!-- COURSE MAP -->
<section class="block" id="map">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">투어 코스 = 노선</span>
      <h2>한눈에 보는 트랜짓 노선도</h2>
      <p>네 개의 테마 노선이 서울 도심을 가로지릅니다. 색이 곧 테마이고, 환승역에서 다른 매력으로 갈아탈 수 있습니다.</p>
    </div>

    <div class="course-map">
      <svg viewBox="0 0 1100 360" role="img" aria-label="트랜짓 투어 4개 테마 노선도">
        <!-- ===== LINES ===== -->
        <!-- RED: 고궁 노선 -->
        <polyline points="80,80 300,80 380,160 700,160 780,80 1020,80"
          fill="none" stroke="#dc241f" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- BLUE: 한강 노선 -->
        <polyline points="80,160 300,160 380,160 460,240 900,240 980,160 1020,160"
          fill="none" stroke="#0019a8" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- GREEN: 미식 노선 -->
        <polyline points="80,300 460,300 540,220 540,160"
          fill="none" stroke="#00782a" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- YELLOW: 야경 노선 -->
        <polyline points="700,160 700,300 1020,300"
          fill="none" stroke="#ffd329" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>

        <!-- ===== STATIONS (normal) ===== -->
        <g fill="#fff" stroke="#10131a" stroke-width="3.5">
          <circle cx="80" cy="80" r="7"/>
          <circle cx="780" cy="80" r="7"/>
          <circle cx="1020" cy="80" r="7"/>
          <circle cx="80" cy="160" r="7"/>
          <circle cx="980" cy="160" r="7"/>
          <circle cx="1020" cy="160" r="7"/>
          <circle cx="460" cy="240" r="7"/>
          <circle cx="900" cy="240" r="7"/>
          <circle cx="80" cy="300" r="7"/>
          <circle cx="700" cy="300" r="7"/>
          <circle cx="1020" cy="300" r="7"/>
        </g>

        <!-- ===== INTERCHANGES (rounded bars / circles) ===== -->
        <g fill="#fff" stroke="#10131a" stroke-width="4">
          <!-- 광화문 환승 (red+blue meet near 380,160) -->
          <circle cx="380" cy="160" r="11"/>
          <!-- 종각 환승 (300,80 area) -->
          <rect x="290" y="70" width="20" height="20" rx="10"/>
          <!-- 시청 환승 (700,160 red+yellow) -->
          <circle cx="700" cy="160" r="11"/>
          <!-- 명동 환승 (540,160 green+ ...) -->
          <rect x="530" y="150" width="20" height="20" rx="10"/>
          <!-- 한강진 (460,300 green) -->
          <circle cx="460" cy="300" r="11"/>
        </g>

        <!-- ===== LABELS ===== -->
        <g font-family="Hanken Grotesk, sans-serif" font-size="15" font-weight="700" fill="#10131a">
          <text x="80" y="62" text-anchor="middle">창덕궁</text>
          <text x="290" y="60" text-anchor="middle">종각</text>
          <text x="380" y="140" text-anchor="middle">광화문</text>
          <text x="780" y="62" text-anchor="middle">서촌</text>
          <text x="1020" y="62" text-anchor="middle">북촌</text>
          <text x="80" y="146" text-anchor="middle">여의도</text>
          <text x="700" y="142" text-anchor="middle">시청</text>
          <text x="980" y="144" text-anchor="middle">성수</text>
          <text x="1020" y="146" text-anchor="middle">뚝섬</text>
          <text x="460" y="226" text-anchor="middle">반포</text>
          <text x="900" y="226" text-anchor="middle">잠실</text>
          <text x="540" y="142" text-anchor="middle">명동</text>
          <text x="80" y="324" text-anchor="middle">광장시장</text>
          <text x="460" y="324" text-anchor="middle">한강진</text>
          <text x="700" y="324" text-anchor="middle">남산</text>
          <text x="1020" y="324" text-anchor="middle">DDP</text>
        </g>
      </svg>

      <div class="legend">
