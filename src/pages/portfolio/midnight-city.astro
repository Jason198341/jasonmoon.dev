<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>미드나잇 시티 — MIDNIGHT CITY · 청담 칵테일 라운지</title>
  <meta name="description" content="석양이 지지 않는 밤. 1984년 도쿄의 시티팝 무드를 담은 청담동 칵테일 바·라운지 미드나잇 시티." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,600;0,700;0,800;1,500;1,700&family=Pacifico&display=swap" rel="stylesheet" />
  <style>
    :root{
      --pink:#ff5e8a;
      --pink-deep:#ff3d6e;
      --cyan:#28e0e6;
      --purple:#8b5cf6;
      --purple-deep:#5b2a86;
      --gold:#ffd27a;
      --night:#0b0717;
      --night-2:#160a2b;
      --ink:#f4ecff;
      --muted:#b9a7d8;
      --glass:rgba(255,255,255,0.06);
      --line:rgba(255,255,255,0.12);
      --ease:cubic-bezier(0.16,1,0.3,1);
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{
      font-family:'Poppins',system-ui,sans-serif;
      background:var(--night);
      color:var(--ink);
      line-height:1.6;
      overflow-x:hidden;
      -webkit-font-smoothing:antialiased;
    }
    a{color:inherit;}
    img{max-width:100%;display:block;}
    section{position:relative;}
    .wrap{width:min(1120px,92vw);margin-inline:auto;}

    /* ---- Shared text styles ---- */
    .script{
      font-family:'Pacifico',cursive;
      font-weight:400;
      line-height:1.05;
      background:linear-gradient(180deg,#fff 0%,var(--pink) 45%,var(--purple) 100%);
      -webkit-background-clip:text;background-clip:text;
      -webkit-text-fill-color:transparent;color:transparent;
      filter:drop-shadow(0 2px 14px rgba(255,94,138,0.55));
    }
    .chrome{
      font-weight:800;font-style:italic;letter-spacing:-0.02em;line-height:0.98;
      background:linear-gradient(180deg,#fdfdff 0%,#cfe9ff 28%,var(--cyan) 50%,var(--pink) 74%,var(--purple) 100%);
      -webkit-background-clip:text;background-clip:text;
      -webkit-text-fill-color:transparent;color:transparent;
      text-shadow:0 0 30px rgba(255,94,138,0.25);
    }
    .eyebrow{
      font-size:11px;font-weight:700;letter-spacing:0.42em;text-transform:uppercase;
      color:var(--cyan);text-shadow:0 0 16px rgba(40,224,230,0.6);
    }
    .neon-line{
      width:64px;height:2px;border:0;margin:18px 0;
      background:linear-gradient(90deg,var(--pink),var(--cyan));
      box-shadow:0 0 14px var(--pink);
    }
    .neon-line.center{margin-inline:auto;}

    /* ============ HERO ============ */
    .hero{
      min-height:100vh;display:flex;align-items:center;
      padding:120px 0 80px;overflow:hidden;
      background:
        radial-gradient(120% 80% at 50% 120%, rgba(91,42,134,0) 40%, rgba(11,7,23,0.9) 100%),
        linear-gradient(180deg,#1a0c2e 0%,#3a1147 28%,#8a2a5e 52%,#ff5e8a 72%,#ffb27a 100%);
    }
    /* sun */
    .sun{
      position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);
      width:min(560px,72vw);height:min(560px,72vw);border-radius:50%;
      background:linear-gradient(180deg,#fff3c4 0%,#ffd27a 30%,#ff8e6a 60%,var(--pink-deep) 100%);
      box-shadow:0 0 120px 30px rgba(255,142,106,0.55),0 0 220px 60px rgba(255,94,138,0.35);
      z-index:1;
    }
    /* sun slats */
    .sun-slats{
      position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);
      width:min(560px,72vw);height:min(560px,72vw);border-radius:50%;
      z-index:2;overflow:hidden;-webkit-mask:radial-gradient(closest-side,#000 99%,transparent);
              mask:radial-gradient(closest-side,#000 99%,transparent);
    }
    .sun-slats span{
      position:absolute;left:0;right:0;height:8px;background:rgba(11,7,23,0.85);
    }
    .sun-slats span:nth-child(1){bottom:8%;}
    .sun-slats span:nth-child(2){bottom:18%;height:10px;}
    .sun-slats span:nth-child(3){bottom:30%;height:13px;}
    .sun-slats span:nth-child(4){bottom:44%;height:16px;}
    /* grid floor */
    .grid-floor{
      position:absolute;left:50%;bottom:0;transform:translateX(-50%);
      width:200%;height:38vh;z-index:3;
      background:
        linear-gradient(180deg,transparent,rgba(40,224,230,0.18)),
        repeating-linear-gradient(90deg,transparent 0,transparent calc(50% - 1px),rgba(40,224,230,0.55) calc(50% - 1px),rgba(40,224,230,0.55) calc(50% + 1px),transparent calc(50% + 1px),transparent 6.25%),
        repeating-linear-gradient(0deg,transparent 0,transparent 28px,rgba(40,224,230,0.45) 28px,rgba(40,224,230,0.45) 29px);
      transform:translateX(-50%) perspective(420px) rotateX(72deg);
      transform-origin:bottom center;
      -webkit-mask:linear-gradient(180deg,transparent,#000 55%);
              mask:linear-gradient(180deg,transparent,#000 55%);
    }
    /* city skyline */
    .skyline{position:absolute;left:0;right:0;bottom:34vh;width:100%;z-index:4;opacity:0.92;}
    /* palm silhouettes */
    .palm{position:absolute;bottom:30vh;z-index:5;filter:drop-shadow(0 6px 18px rgba(0,0,0,0.45));}
    .palm.left{left:2vw;width:140px;}
    .palm.right{right:1vw;width:180px;}
    .stars{position:absolute;inset:0;z-index:0;
      background-image:
        radial-gradient(1px 1px at 12% 18%,#fff,transparent),
        radial-gradient(1px 1px at 26% 9%,#fff,transparent),
        radial-gradient(1.5px 1.5px at 68% 14%,#fff,transparent),
        radial-gradient(1px 1px at 82% 7%,#cfe9ff,transparent),
        radial-gradient(1px 1px at 46% 22%,#fff,transparent),
        radial-gradient(1.5px 1.5px at 91% 20%,#fff,transparent);
      opacity:0.8;
    }
    .hero-inner{position:relative;z-index:6;text-align:center;width:100%;}
    .hero .eyebrow{display:inline-block;margin-bottom:14px;}
    .hero h1{font-size:clamp(52px,12vw,140px);margin-bottom:6px;}
    .hero .script-sub{font-size:clamp(28px,6vw,64px);margin-bottom:18px;}
    .hero p.lead{
      max-width:560px;margin:0 auto 30px;color:#fff;
      font-style:italic;font-weight:500;font-size:clamp(15px,2.4vw,20px);
      text-shadow:0 2px 18px rgba(0,0,0,0.5);
    }
    .cta-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
    .btn{
      display:inline-flex;align-items:center;gap:8px;
      padding:14px 28px;border-radius:40px;font-weight:700;font-size:14px;
      letter-spacing:0.04em;text-decoration:none;cursor:pointer;border:0;
      transition:transform .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease);
    }
    .btn-primary{
      color:#1a0418;background:linear-gradient(180deg,#fff 0%,var(--pink) 100%);
      box-shadow:0 8px 30px rgba(255,94,138,0.5);
    }
    .btn-primary:hover{transform:translateY(-3px);box-shadow:0 14px 44px rgba(255,94,138,0.7);}
    .btn-ghost{
      color:#fff;background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.4);backdrop-filter:blur(6px);
    }
    .btn-ghost:hover{transform:translateY(-3px);background:rgba(255,255,255,0.16);box-shadow:0 0 24px rgba(40,224,230,0.4);}

    /* ============ Section base ============ */
    .sec{padding:96px 0;}
    .sec-head{margin-bottom:48px;}
    .sec-head.center{text-align:center;}
    .sec-head h2{font-size:clamp(30px,5vw,52px);}
    .sec-head p{color:var(--muted);max-width:560px;margin-top:10px;}
    .sec-head.center p{margin-inline:auto;}

    /* ---- Signature cocktails ---- */
    .cocktails{
      background:
        radial-gradient(80% 60% at 15% 0%,rgba(139,92,246,0.22),transparent 60%),
        radial-gradient(70% 60% at 100% 100%,rgba(255,94,138,0.18),transparent 60%),
        var(--night);
    }
    .menu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;}
    .card{
      position:relative;padding:26px 24px;border-radius:18px;overflow:hidden;
      background:linear-gradient(160deg,rgba(255,255,255,0.07),rgba(255,255,255,0.02));
      border:1px solid var(--line);backdrop-filter:blur(8px);
      transition:transform .4s var(--ease),border-color .4s var(--ease),box-shadow .4s var(--ease);
    }
    .card::before{
      content:"";position:absolute;inset:0;opacity:0;transition:opacity .4s var(--ease);
      background:linear-gradient(160deg,rgba(255,94,138,0.14),rgba(40,224,230,0.1));
    }
    .card:hover{transform:translateY(-6px);border-color:rgba(255,94,138,0.6);box-shadow:0 18px 50px rgba(91,42,134,0.45);}
    .card:hover::before{opacity:1;}
    .card .relayer{position:relative;z-index:1;}
    .card .num{font-family:'Poppins';font-style:italic;font-weight:800;font-size:13px;color:var(--cyan);letter-spacing:0.1em;}
    .card h3{font-size:22px;font-weight:700;margin:8px 0 4px;}
    .card .jp{font-size:12px;color:var(--muted);letter-spacing:0.18em;text-transform:uppercase;margin-bottom:12px;}
    .card .desc{font-size:14px;color:#d9ccf2;min-height:48px;}
    .card .price{
      margin-top:16px;font-weight:800;font-style:italic;font-size:20px;
      background:linear-gradient(90deg,var(--pink),var(--gold));
      -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
    }

    /* ---- Mood / 분위기 ---- */
    .mood{
      background:linear-gradient(180deg,#0b0717,#190a30 50%,#0b0717);
    }
    .mood-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:40px;align-items:center;}
    .vinyl-stage{display:flex;justify-content:center;align-items:center;padding:20px;}
    .vinyl{
      position:relative;width:min(360px,80vw);aspect-ratio:1;border-radius:50%;
      background:
        repeating-radial-gradient(circle at 50% 50%,#0e0a18 0px,#0e0a18 2px,#1b1330 3px,#1b1330 4px);
      box-shadow:0 0 0 1px rgba(255,255,255,0.06),0 30px 80px rgba(0,0,0,0.6),0 0 60px rgba(139,92,246,0.35);
      display:flex;align-items:center;justify-content:center;
      animation:spin 9s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg);}}
    .vinyl .label{
      width:42%;aspect-ratio:1;border-radius:50%;
      background:radial-gradient(circle at 35% 30%,var(--pink),var(--purple-deep) 70%);
      display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;
      box-shadow:0 0 30px rgba(255,94,138,0.5);
    }
    .vinyl .label .lp-script{font-family:'Pacifico',cursive;font-size:clamp(16px,4.4vw,24px);color:#fff;text-shadow:0 1px 8px rgba(0,0,0,0.4);}
    .vinyl .label small{font-size:9px;letter-spacing:0.3em;color:rgba(255,255,255,0.8);margin-top:4px;}
    .vinyl::after{content:"";position:absolute;width:7%;aspect-ratio:1;border-radius:50%;background:#0b0717;box-shadow:inset 0 0 0 2px rgba(255,255,255,0.15);}
    .mood-copy h2{font-size:clamp(28px,4.6vw,46px);margin-bottom:8px;}
    .mood-feats{list-style:none;margin-top:24px;display:grid;gap:14px;}
    .mood-feats li{display:flex;gap:14px;align-items:flex-start;font-size:15px;color:#e4d9fb;}
    .mood-feats .dot{
      flex:0 0 auto;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:14px;
      background:linear-gradient(160deg,var(--pink),var(--purple));box-shadow:0 0 18px rgba(255,94,138,0.5);
    }
    .hours{
      margin-top:30px;padding:18px 20px;border-radius:14px;border:1px solid var(--line);
      background:var(--glass);font-size:14px;color:#d9ccf2;
    }
    .hours b{color:var(--cyan);}

    /* ---- Reservation ---- */
    .reserve{
      background:
        radial-gradient(90% 70% at 50% 0%,rgba(255,94,138,0.22),transparent 60%),
        linear-gradient(180deg,#160a2b,#0b0717);
    }
    .reserve-card{
      max-width:680px;margin-inline:auto;padding:42px clamp(24px,5vw,52px);border-radius:24px;
      background:linear-gradient(160deg,rgba(255,255,255,0.08),rgba(255,255,255,0.02));
      border:1px solid rgba(255,94,138,0.35);backdrop-filter:blur(10px);
      box-shadow:0 30px 90px rgba(0,0,0,0.5);
    }
    form{display:grid;gap:16px;margin-top:26px;}
    .frow{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
    label{display:block;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--muted);margin-bottom:7px;}
    input,select{
      width:100%;padding:13px 14px;border-radius:10px;font-family:inherit;font-size:15px;
      background:rgba(11,7,23,0.6);border:1px solid var(--line);color:var(--ink);
      transition:border-color .3s,box-shadow .3s;
    }
    input::placeholder{color:#7d6ca0;}
    input:focus,select:focus{outline:0;border-color:var(--pink);box-shadow:0 0 0 3px rgba(255,94,138,0.2);}
    form .btn-primary{justify-content:center;margin-top:6px;}
    .reserve-note{font-size:12px;color:var(--muted);text-align:center;margin-top:6px;}

    /* ---- Footer / contact ---- */
    .contact{
      padding:80px 0 110px;
      background:linear-gradient(180deg,#0b0717,#1a0b30);
    }
    .contact-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:start;}
    .contact h2{font-size:clamp(30px,5vw,52px);}
    .contact .script-sm{font-size:clamp(26px,5vw,40px);}
    .info-list{list-style:none;display:grid;gap:16px;margin-top:8px;}
    .info-list li{display:flex;gap:14px;align-items:flex-start;font-size:15px;color:#e4d9fb;}
    .info-list .ic{
      flex:0 0 auto;width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
      background:var(--glass);border:1px solid var(--line);
    }
    .info-list a{color:var(--cyan);text-decoration:none;}
    .info-list a:hover{text-decoration:underline;}
    .map-card{
      border-radius:18px;overflow:hidden;border:1px solid var(--line);min-height:230px;
      background:
        radial-gradient(circle at 70% 30%,rgba(40,224,230,0.25),transparent 55%),
        radial-gradient(circle at 20% 80%,rgba(255,94,138,0.28),transparent 55%),
        linear-gradient(160deg,#160a2b,#2a0f3e);
      display:flex;align-items:flex-end;padding:22px;position:relative;
    }
    .map-card .pin{
      position:absolute;top:42%;left:50%;transform:translate(-50%,-50%);
      width:18px;height:18px;border-radius:50% 50% 50% 0;rotate:-45deg;
      background:var(--pink);box-shadow:0 0 0 6px rgba(255,94,138,0.25),0 0 22px var(--pink);
    }
    .map-card .addr{font-size:13px;color:#e4d9fb;letter-spacing:0.04em;}
    .foot-bottom{
      margin-top:64px;padding-top:24px;border-top:1px solid var(--line);
      display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;
      font-size:12px;color:var(--muted);letter-spacing:0.06em;
    }
    .foot-bottom .brand{font-family:'Pacifico',cursive;font-size:18px;color:var(--pink);}

    @media(max-width:820px){
      .mood-grid,.contact-grid{grid-template-columns:1fr;}
      .vinyl-stage{order:-1;}
      .frow{grid-template-columns:1fr;}
      .sec{padding:72px 0;}
      .palm.left{width:90px;}.palm.right{width:110px;}
    }
  </style>
</head>
<body>

<!-- DEMO BAR -->
<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
  <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
  <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 19 · 미드나잇 시티 — 1984 일본 시티팝 LP 스타일</span>
  <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
</div>
<div style="height:40px;"></div>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="stars"></div>
  <div class="sun"></div>
  <div class="sun-slats"><span></span><span></span><span></span><span></span></div>

  <!-- city skyline -->
  <svg class="skyline" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <g fill="#1a0820">
      <rect x="40" y="70" width="46" height="90"/><rect x="96" y="40" width="34" height="120"/>
      <rect x="150" y="88" width="40" height="72"/><rect x="210" y="55" width="28" height="105"/>
      <rect x="256" y="78" width="52" height="82"/><rect x="330" y="30" width="30" height="130"/>
      <rect x="378" y="92" width="44" height="68"/><rect x="446" y="62" width="26" height="98"/>
      <rect x="492" y="80" width="60" height="80"/><rect x="572" y="44" width="32" height="116"/>
      <rect x="624" y="96" width="40" height="64"/><rect x="690" y="34" width="36" height="126"/>
      <rect x="748" y="86" width="50" height="74"/><rect x="820" y="58" width="28" height="102"/>
      <rect x="868" y="78" width="46" height="82"/><rect x="936" y="40" width="34" height="120"/>
      <rect x="990" y="90" width="42" height="70"/><rect x="1058" y="60" width="26" height="100"/>
      <rect x="1104" y="82" width="56" height="78"/><rect x="1182" y="36" width="32" height="124"/>
      <rect x="1236" y="94" width="44" height="66"/><rect x="1302" y="56" width="30" height="104"/>
      <rect x="1356" y="84" width="48" height="76"/>
    </g>
    <g fill="#ffd27a" opacity="0.85">
      <rect x="106" y="56" width="4" height="6"/><rect x="116" y="70" width="4" height="6"/>
      <rect x="340" y="48" width="4" height="6"/><rect x="346" y="66" width="4" height="6"/>
      <rect x="582" y="60" width="4" height="6"/><rect x="700" y="52" width="4" height="6"/>
      <rect x="708" y="74" width="4" height="6"/><rect x="946" y="58" width="4" height="6"/>
      <rect x="1192" y="54" width="4" height="6"/><rect x="1198" y="78" width="4" height="6"/>
    </g>
  </svg>

  <!-- palms -->
  <svg class="palm left" viewBox="0 0 120 260" aria-hidden="true">
    <g fill="#120417">
      <path d="M58 260c2-70 0-130-4-170l8-1c2 42 4 100 4 171z"/>
      <path d="M58 92C40 64 16 54 0 56c20-2 40 8 56 28C70 60 92 50 116 58 92 56 72 70 62 92z"/>
      <path d="M60 90C70 62 96 46 120 50 96 50 74 66 66 94z"/>
      <path d="M58 92C44 70 22 70 6 86 26 72 46 76 60 96z"/>
      <path d="M60 90C56 60 64 36 86 22 66 38 62 62 64 92z"/>
    </g>
  </svg>
  <svg class="palm right" viewBox="0 0 120 260" aria-hidden="true">
    <g fill="#120417">
      <path d="M62 260c-2-70 0-130 4-170l-8-1c-2 42-4 100-4 171z"/>
      <path d="M62 92C80 64 104 54 120 56c-20-2-40 8-56 28C50 60 28 50 4 58 28 56 48 70 58 92z"/>
      <path d="M60 90C50 62 24 46 0 50 24 50 46 66 54 94z"/>
      <path d="M62 92C76 70 98 70 114 86 94 72 74 76 60 96z"/>
      <path d="M60 90C64 60 56 36 34 22 54 38 58 62 56 92z"/>
    </g>
  </svg>

  <div class="grid-floor"></div>

  <div class="wrap hero-inner">
    <span class="eyebrow">Cocktail Bar &amp; Lounge · Seoul Cheongdam</span>
    <h1 class="chrome">MIDNIGHT</h1>
    <div class="script script-sub">&amp; the City</div>
    <p class="lead">석양이 지지 않는 밤. 1984년 도쿄의 네온과 시티팝이 흐르는<br />청담동의 작은 라운지에서 당신의 한 곡을 주문하세요.</p>
    <div class="cta-row">
      <a href="#reserve" class="btn btn-primary">예약하기 →</a>
      <a href="#cocktails" class="btn btn-ghost">시그니처 보기</a>
    </div>
  </div>
</section>

<!-- ============ SIGNATURE COCKTAILS ============ -->
<section id="cocktails" class="sec cocktails">
  <div class="wrap">
    <div class="sec-head center">
      <span class="eyebrow">Signature Cocktails</span>
      <hr class="neon-line center" />
      <h2 class="chrome" style="display:inline-block;">시그니처 칵테일</h2>
