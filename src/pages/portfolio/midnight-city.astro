<!-- ============ RESERVATION ============ -->
<section id="reserve" class="sec reserve">
  <div class="wrap">
    <div class="reserve-card">
      <div class="sec-head center" style="margin-bottom:8px;">
        <span class="eyebrow">Reservation</span>
        <hr class="neon-line center" />
        <h2 class="script" style="display:inline-block;font-size:clamp(30px,6vw,52px);">Reserve a Seat</h2>
        <p>오늘 밤의 자리를 미리 잡아두세요. 예약 확정은 문자로 안내드립니다.</p>
      </div>

      <form onsubmit="event.preventDefault();this.querySelector('.btn-primary').textContent='예약 요청 완료 ✓';">
        <div class="frow">
          <div>
            <label for="name">성함</label>
            <input id="name" type="text" placeholder="홍길동" required />
          </div>
          <div>
            <label for="phone">연락처</label>
            <input id="phone" type="tel" placeholder="010-0000-0000" required />
          </div>
        </div>
        <div class="frow">
          <div>
            <label for="date">날짜</label>
            <input id="date" type="date" required />
          </div>
          <div>
            <label for="people">인원</label>
            <select id="people">
              <option>1명</option><option selected>2명</option>
              <option>3명</option><option>4명</option><option>5명 이상</option>
            </select>
          </div>
        </div>
        <div>
          <label for="time">희망 시간</label>
          <select id="time">
            <option>19:00</option><option>20:00</option><option selected>21:00</option>
            <option>22:00</option><option>23:00</option><option>00:00</option><option>01:00</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">예약 요청 보내기 →</button>
        <p class="reserve-note">* 데모용 양식입니다. 실제 예약 데이터는 전송되지 않습니다.</p>
      </form>
    </div>
  </div>
</section>

