<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>더하버드 입시학원 — Harvard Admissions Academy</title>
<meta name="description" content="합격을 방법론으로. 대치동 더하버드 입시학원 — 케이스스터디 기반 입시 전략 교육." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root {
    --cream: #f5ece0;
    --cream-deep: #ece0cf;
    --paper: #fbf6ee;
    --crimson: #7c1f2b;
    --crimson-dark: #5a161f;
    --ink: #1c1815;
    --ink-soft: #4a423a;
    --rule: #c9b89c;
    --rule-soft: #ddcdb3;
    --gold: #9a7b3f;
    --serif: 'Crimson Pro', 'Libre Baskerville', Georgia, serif;
    --display: 'Libre Baskerville', Georgia, serif;
    --label: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    --maxw: 1080px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
    background-image:
      repeating-linear-gradient(0deg, rgba(124,31,43,0.014) 0 1px, transparent 1px 4px);
  }

  .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 28px; }

  .label {
    font-family: var(--label);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 600;
  }

  a { color: var(--crimson); }

  /* ===== Masthead / Case header ===== */
  .casebar {
    border-bottom: 3px double var(--crimson);
    background: var(--paper);
  }
  .casebar-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 18px 28px 12px;
    max-width: var(--maxw);
    margin: 0 auto;
    gap: 16px;
    flex-wrap: wrap;
  }
  .case-no {
    font-family: var(--label);
    font-size: 12px;
    letter-spacing: 0.22em;
    font-weight: 700;
    color: var(--crimson);
  }
  .case-meta {
    font-family: var(--label);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    text-align: right;
    line-height: 1.7;
  }

  /* ===== Hero ===== */
  .hero { padding: 70px 0 56px; border-bottom: 1px solid var(--rule); }
  .hero .kicker {
    font-family: var(--label);
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    font-weight: 700;
    margin-bottom: 22px;
  }
  .hero h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(38px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .hero h1 .en {
    display: block;
    font-family: var(--label);
    font-weight: 500;
    font-size: clamp(12px, 1.6vw, 16px);
    letter-spacing: 0.3em;
    color: var(--crimson);
    margin-top: 20px;
    text-transform: uppercase;
  }
  .hero .lede {
    font-size: clamp(20px, 2.4vw, 27px);
    font-style: italic;
    color: var(--ink-soft);
    max-width: 720px;
    margin: 30px 0 0;
    line-height: 1.5;
  }
  .hero-rule {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat {
    padding: 22px 20px;
    border-right: 1px solid var(--rule-soft);
  }
  .stat:last-child { border-right: none; }
  .stat b {
    font-family: var(--display);
    font-size: 40px;
    color: var(--crimson);
    line-height: 1;
    display: block;
  }
  .stat span {
    font-family: var(--label);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    display: block;
    margin-top: 9px;
  }

  /* ===== Section scaffolding ===== */
  section { padding: 64px 0; border-bottom: 1px solid var(--rule); }
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 36px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 12px;
  }
  .sec-num {
    font-family: var(--label);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--crimson);
    white-space: nowrap;
  }
  .sec-head h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 36px);
    color: var(--ink);
    line-height: 1.1;
  }

  .twocol {
    column-count: 2;
    column-gap: 38px;
    column-rule: 1px solid var(--rule-soft);
  }
  .twocol p { margin-bottom: 16px; text-align: justify; hyphens: auto; }
  .twocol p:first-child::first-letter {
    font-family: var(--display);
    font-size: 64px;
    float: left;
    line-height: 0.78;
    padding: 6px 10px 0 0;
    color: var(--crimson);
    font-weight: 700;
  }
  .fn { font-size: 14px; color: var(--ink-soft); }
  sup { color: var(--crimson); font-size: 0.7em; }

  /* ===== Case narrative box ===== */
  .casebox {
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 5px 5px 0 var(--cream-deep);
    padding: 34px 36px;
    margin-bottom: 38px;
  }
  .casebox .tag {
    font-family: var(--label);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--crimson);
    margin-bottom: 14px;
    display: inline-block;
    border-bottom: 1px solid var(--crimson);
    padding-bottom: 4px;
  }
  .casebox h3 {
    font-family: var(--display);
    font-size: 23px;
    margin-bottom: 12px;
    color: var(--ink);
  }
  .casebox p { margin-bottom: 12px; }
  .casebox p:last-child { margin-bottom: 0; }

  /* ===== Exhibit table ===== */
  .exhibit { margin: 0 0 38px; }
  .exhibit-cap {
    font-family: var(--label);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 8px;
    margin-bottom: 0;
  }
  .exhibit-cap em {
    font-family: var(--serif);
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-soft);
    font-weight: 400;
    display: block;
    margin-top: 4px;
    font-size: 15px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }
  thead th {
    font-family: var(--label);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    padding: 12px 12px;
    border-bottom: 1px solid var(--ink);
    color: var(--ink-soft);
  }
  thead th:first-child { text-align: left; }
  tbody td {
    padding: 11px 12px;
    text-align: right;
    border-bottom: 1px solid var(--rule-soft);
    font-variant-numeric: tabular-nums;
  }
  tbody td:first-child { text-align: left; font-family: var(--label); font-size: 14px; font-weight: 500; }
  tbody tr:last-child td {
    border-bottom: 2px solid var(--ink);
    border-top: 1px solid var(--ink);
    font-weight: 700;
    color: var(--crimson);
  }
  .exhibit-note { font-size: 13px; color: var(--ink-soft); margin-top: 10px; font-style: italic; }

  /* ===== Framework SVG cards ===== */
  .frames {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .frame {
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 26px 26px 30px;
  }
  .frame h3 {
    font-family: var(--label);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--crimson);
    margin-bottom: 4px;
  }
  .frame p.sub {
    font-size: 15px;
    font-style: italic;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .frame svg { width: 100%; height: auto; display: block; }

  /* curriculum timeline */
  .phases {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 34px;
    border: 1px solid var(--rule);
  }
  .phase {
    padding: 22px 18px;
    border-right: 1px solid var(--rule-soft);
  }
  .phase:last-child { border-right: none; }
  .phase .pnum {
    font-family: var(--label);
    font-weight: 800;
    font-size: 12px;
    color: var(--crimson);
    letter-spacing: 0.1em;
  }
  .phase h4 {
    font-family: var(--display);
    font-size: 19px;
    margin: 8px 0 8px;
  }
  .phase p { font-size: 15px; color: var(--ink-soft); }

  /* ===== Discussion Questions ===== */
  .dq {
    background: var(--crimson);
    color: var(--cream);
    padding: 40px 44px;
    box-shadow: 6px 6px 0 var(--crimson-dark);
  }
  .dq .tag {
    font-family: var(--label);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: #e9c9ad;
    margin-bottom: 26px;
    display: block;
  }
  .dq ol { list-style: none; counter-reset: q; }
  .dq li {
    counter-increment: q;
    position: relative;
    padding: 0 0 22px 52px;
    margin-bottom: 22px;
    border-bottom: 1px solid rgba(245,236,224,0.22);
  }
  .dq li:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .dq li::before {
    content: counter(q, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: -4px;
    font-family: var(--display);
    font-size: 26px;
    color: #e9c9ad;
  }
  .dq .qq {
    font-family: var(--display);
    font-size: 20px;
    line-height: 1.4;
    margin-bottom: 8px;
  }
  .dq .qa {
    font-size: 17px;
    color: #f0e2d2;
    font-style: italic;
    line-height: 1.55;
  }

  /* ===== Faculty ===== */
  .faculty {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .prof {
    border-top: 3px solid var(--crimson);
    padding-top: 18px;
  }
  .prof .seal {
    width: 60px; height: 60px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--display);
    font-size: 24px;
    color: var(--crimson);
    margin-bottom: 16px;
    background: var(--paper);
  }
  .prof h3 {
    font-family: var(--display);
    font-size: 22px;
    margin-bottom: 2px;
  }
  .prof .role {
    font-family: var(--label);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--crimson);
    margin-bottom: 12px;
  }
  .prof p { font-size: 15.5px; color: var(--ink-soft); }
  .prof .cred {
    margin-top: 12px;
    font-size: 13px;
    font-style: italic;
    color: var(--gold);
    border-top: 1px solid var(--rule-soft);
    padding-top: 10px;
  }

  /* ===== CTA / colophon ===== */
  .cta { background: var(--paper); }
  .cta-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 50px;
    align-items: start;
  }
  .cta h2 {
    font-family: var(--display);
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    margin-bottom: 18px;
  }
  .cta p.lede { font-size: 19px; font-style: italic; color: var(--ink-soft); margin-bottom: 28px; }
  .btn {
    display: inline-block;
    font-family: var(--label);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    background: var(--crimson);
    color: var(--cream);
    padding: 15px 30px;
    text-decoration: none;
    border: 1px solid var(--crimson);
    transition: background .2s, color .2s;
  }
  .btn:hover { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .btn.ghost { background: transparent; color: var(--crimson); margin-left: 12px; }
  .btn.ghost:hover { background: var(--crimson); color: var(--cream); }

  .info {
    border: 1px solid var(--ink);
    padding: 28px 30px;
    background: var(--cream);
  }
  .info dl { display: grid; grid-template-columns: auto 1fr; gap: 12px 18px; }
  .info dt {
    font-family: var(--label);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--crimson);
    font-weight: 700;
    padding-top: 3px;
  }
  .info dd { font-size: 16px; }

  footer {
    padding: 36px 0 60px;
    font-family: var(--label);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    text-align: center;
    line-height: 1.9;
  }
  footer .seal-line { color: var(--crimson); font-weight: 700; letter-spacing: 0.22em; margin-bottom: 8px; }

  /* ===== Responsive ===== */
  @media (max-width: 760px) {
    body { font-size: 17px; }
    .twocol { column-count: 1; }
    .frames { grid-template-columns: 1fr; }
    .phases { grid-template-columns: 1fr; }
    .phase { border-right: none; border-bottom: 1px solid var(--rule-soft); }
    .phase:last-child { border-bottom: none; }
    .faculty { grid-template-columns: 1fr; }
    .hero-rule { grid-template-columns: 1fr; }
    .stat { border-right: none; border-bottom: 1px solid var(--rule-soft); }
    .stat:last-child { border-bottom: none; }
    .cta-grid { grid-template-columns: 1fr; gap: 32px; }
    .casebar-inner { align-items: flex-start; }
    .case-meta { text-align: left; }
    .dq { padding: 30px 24px; }
    .casebox { padding: 26px 22px; }
    .btn.ghost { margin-left: 0; margin-top: 12px; }
  }
</style>
</head>
