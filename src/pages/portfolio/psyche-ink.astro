<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>사이키 잉크 · PSYCHE INK — 타투 & 레코드</title>
  <meta name="description" content="이태원 사이키 잉크. 사이키델릭 타투 스튜디오 & 빈티지 레코드샵." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rye&family=Bungee+Shade&family=Bungee+Inline&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root{
      --pink:#ff00aa;
      --orange:#ff6a00;
      --yellow:#ffd400;
      --purple:#7a00ff;
      --violet:#c400ff;
      --cyan:#00e5ff;
      --ink:#1a0033;
      --cream:#fff3d6;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{
      background:
        radial-gradient(circle at 20% 10%, var(--violet) 0%, transparent 45%),
        radial-gradient(circle at 80% 0%, var(--orange) 0%, transparent 40%),
        radial-gradient(circle at 50% 100%, var(--pink) 0%, transparent 55%),
        var(--ink);
      color:var(--cream);
      font-family:'Gowun Batang', serif;
      overflow-x:hidden;
      -webkit-text-size-adjust:100%;
    }

    /* ===== psychedelic helpers ===== */
    @keyframes spin{to{transform:rotate(360deg);}}
    @keyframes spinrev{to{transform:rotate(-360deg);}}
    @keyframes wobble{
      0%,100%{transform:skewX(-8deg) scaleY(1);}
      25%{transform:skewX(6deg) scaleY(1.06);}
      50%{transform:skewX(-4deg) scaleY(0.96);}
      75%{transform:skewX(8deg) scaleY(1.04);}
    }
    @keyframes hue{to{filter:hue-rotate(360deg);}}
    @keyframes melt{
      0%,100%{transform:translateY(0) scaleY(1);letter-spacing:0.02em;}
      50%{transform:translateY(6px) scaleY(1.12);letter-spacing:0.06em;}
    }
    @keyframes drift{
      0%,100%{transform:translate(0,0) rotate(0);}
      50%{transform:translate(14px,-10px) rotate(4deg);}
    }
    @keyframes pulseGlow{
      0%,100%{text-shadow:0 0 10px var(--yellow),0 0 30px var(--pink);}
      50%{text-shadow:0 0 22px var(--cyan),0 0 50px var(--violet);}
    }
    @media (prefers-reduced-motion: reduce){
      *{animation:none !important;}
    }

    /* ===== background swirl layer ===== */
    .swirl-bg{
      position:fixed;inset:-20%;z-index:0;pointer-events:none;
      opacity:.5;mix-blend-mode:screen;
      animation:spin 90s linear infinite, hue 24s linear infinite;
    }
    .swirl-bg.rev{animation:spinrev 120s linear infinite, hue 30s linear infinite reverse;opacity:.35;}

    main{position:relative;z-index:1;}
    section{
      position:relative;
      padding:clamp(60px,9vw,140px) clamp(18px,5vw,80px);
      border-bottom:6px solid var(--yellow);
      overflow:hidden;
    }

    /* ===== HERO ===== */
    .hero{
      min-height:100vh;
      display:flex;flex-direction:column;align-items:center;justify-content:center;
      text-align:center;
      background:
        repeating-conic-gradient(from 0deg at 50% 50%,
          var(--purple) 0deg 12deg,
          var(--pink) 12deg 24deg);
      border-bottom:8px solid var(--cyan);
    }
    .hero::before{
      content:"";position:absolute;inset:0;
      background:radial-gradient(circle at 50% 45%, transparent 0%, var(--ink) 75%);
      mix-blend-mode:multiply;
    }
    .hero-inner{position:relative;z-index:2;max-width:900px;}
    .hero .kicker{
      font-family:'Bungee Inline', cursive;
      font-size:clamp(.9rem,2.6vw,1.4rem);
      letter-spacing:.3em;color:var(--yellow);
      text-shadow:2px 2px 0 var(--purple);
      animation:drift 7s ease-in-out infinite;
    }
    .hero h1{
      font-family:'Bungee Shade', cursive;
      font-size:clamp(3.6rem,16vw,11rem);
      line-height:.85;
      color:var(--yellow);
      text-shadow:
        4px 4px 0 var(--pink),
        8px 8px 0 var(--violet),
        12px 12px 0 var(--cyan);
      margin:.15em 0;
      animation:wobble 6s ease-in-out infinite, pulseGlow 4s ease-in-out infinite;
    }
    .hero .sub{
      font-family:'Rye', serif;
      font-size:clamp(1.3rem,5vw,2.6rem);
      color:var(--cream);
      letter-spacing:.04em;
      animation:melt 5s ease-in-out infinite;
    }
    .mandala{
      position:absolute;left:50%;top:50%;
      width:min(120vw,1100px);height:min(120vw,1100px);
      transform:translate(-50%,-50%);
      z-index:1;opacity:.85;
      animation:spin 60s linear infinite;
    }
    .hero .tagline{
      margin-top:1.4em;
      font-family:'Gowun Batang', serif;font-weight:700;
      font-size:clamp(1rem,3vw,1.4rem);
      color:var(--ink);background:var(--yellow);
      display:inline-block;padding:.5em 1.1em;
      border:3px solid var(--ink);
      transform:rotate(-2deg);
      box-shadow:6px 6px 0 var(--pink);
    }
    .scroll-hint{
      position:absolute;bottom:26px;left:50%;transform:translateX(-50%);
      z-index:3;font-family:'Bungee Inline',cursive;letter-spacing:.2em;
      color:var(--cyan);font-size:.8rem;animation:melt 2.4s infinite;
    }

    /* ===== section titles ===== */
    .sec-title{
      font-family:'Bungee Shade', cursive;
      font-size:clamp(2.2rem,8vw,5rem);
      text-align:center;line-height:.9;
      color:var(--yellow);
      text-shadow:3px 3px 0 var(--pink),6px 6px 0 var(--purple);
      margin-bottom:.6em;
      animation:hue 18s linear infinite;
    }
    .sec-label{
      display:block;text-align:center;
      font-family:'Bungee Inline',cursive;letter-spacing:.35em;
      color:var(--cyan);font-size:.85rem;margin-bottom:.5em;
    }

    /* ===== TATTOO GALLERY ===== */
    .tattoo{background:
      repeating-linear-gradient(45deg, rgba(122,0,255,.25) 0 24px, rgba(196,0,255,.25) 24px 48px),
      var(--ink);}
    .gallery{
      display:grid;gap:clamp(14px,2.5vw,28px);
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      max-width:1200px;margin:0 auto;
    }
    .tile{
      position:relative;aspect-ratio:1;border-radius:14px;overflow:hidden;
      border:4px solid var(--yellow);
      box-shadow:8px 8px 0 var(--pink);
      transition:transform .35s ease, box-shadow .35s ease;
    }
    .tile:nth-child(odd){transform:rotate(-1.5deg);}
    .tile:nth-child(even){transform:rotate(1.5deg);}
    .tile:hover{transform:rotate(0) scale(1.05);box-shadow:0 0 28px var(--cyan);z-index:5;}
    .tile svg{position:absolute;inset:0;width:100%;height:100%;}
    .tile .cap{
      position:absolute;left:0;right:0;bottom:0;
      background:rgba(26,0,51,.82);
      font-family:'Rye',serif;font-size:.95rem;letter-spacing:.03em;
      color:var(--yellow);padding:.5em .7em;text-align:center;
    }

    /* ===== RECORD SELECTION ===== */
    .records{background:
      radial-gradient(circle at 50% 50%, var(--orange) 0%, transparent 60%),
      var(--ink);}
    .lp-grid{
      display:grid;gap:clamp(20px,3vw,40px);
      grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
      max-width:1100px;margin:0 auto;
    }
    .lp{
      text-align:center;
      background:rgba(26,0,51,.55);
      border:3px solid var(--cyan);border-radius:16px;
      padding:clamp(18px,3vw,30px);
      backdrop-filter:blur(2px);
      transition:transform .3s ease;
    }
    .lp:hover{transform:translateY(-8px) rotate(-1deg);}
    .lp:hover .disc{animation-duration:1.4s;}
    .disc{
      width:clamp(140px,40%,200px);aspect-ratio:1;margin:0 auto .9em;
      animation:spin 6s linear infinite;
    }
    .lp h3{font-family:'Rye',serif;color:var(--yellow);font-size:1.3rem;margin-bottom:.15em;}
    .lp .artist{font-style:italic;color:var(--cyan);margin-bottom:.5em;font-size:.95rem;}
    .lp .price{
      font-family:'Bungee Inline',cursive;color:var(--pink);
      font-size:1.15rem;letter-spacing:.05em;
    }

    /* ===== ARTIST ===== */
    .artist-sec{background:
      repeating-conic-gradient(from 0deg at 50% 50%, var(--ink) 0 18deg, rgba(255,106,0,.18) 18deg 36deg);}
    .artist-card{
      max-width:880px;margin:0 auto;display:grid;gap:30px;
      grid-template-columns:minmax(180px,260px) 1fr;align-items:center;
      background:rgba(26,0,51,.6);border:4px solid var(--pink);
      border-radius:20px;padding:clamp(20px,4vw,44px);
      box-shadow:10px 10px 0 var(--violet);
    }
    .avatar{aspect-ratio:1;border-radius:50%;overflow:hidden;border:5px solid var(--yellow);animation:hue 12s linear infinite;}
    .avatar svg{width:100%;height:100%;display:block;}
    .artist-card h3{font-family:'Bungee Shade',cursive;color:var(--yellow);font-size:clamp(1.8rem,5vw,2.8rem);line-height:.9;text-shadow:2px 2px 0 var(--pink);}
    .artist-card .role{font-family:'Rye',serif;color:var(--cyan);margin:.3em 0 .8em;letter-spacing:.05em;}
    .artist-card p{line-height:1.8;color:var(--cream);}
    .tags{margin-top:1em;display:flex;flex-wrap:wrap;gap:8px;}
    .tags span{
      font-family:'Bungee Inline',cursive;font-size:.72rem;letter-spacing:.1em;
      background:var(--yellow);color:var(--ink);padding:.35em .7em;border-radius:20px;
      transform:rotate(-2deg);
    }

    /* ===== CONTACT ===== */
    .contact{
      text-align:center;border-bottom:none;
      background:
        repeating-radial-gradient(circle at 50% 50%,
          var(--violet) 0 16px, var(--pink) 16px 32px, var(--orange) 32px 48px);
    }
    .contact::before{
      content:"";position:absolute;inset:0;
      background:radial-gradient(circle at 50% 50%, transparent 0, var(--ink) 70%);
    }
    .contact-inner{position:relative;z-index:2;max-width:680px;margin:0 auto;}
    .contact .info{
      font-family:'Rye',serif;font-size:clamp(1.05rem,3vw,1.5rem);
      line-height:2.1;color:var(--cream);
    }
    .contact .info b{color:var(--yellow);}
    .cta{
      display:inline-block;margin-top:1.3em;
      font-family:'Bungee Shade',cursive;font-size:clamp(1.4rem,5vw,2.4rem);
      color:var(--ink);background:var(--yellow);
      padding:.4em 1em;border:4px solid var(--ink);border-radius:8px;
      text-decoration:none;transform:rotate(-2deg);
      box-shadow:8px 8px 0 var(--pink);
      transition:transform .2s ease, box-shadow .2s ease;
    }
    .cta:hover{transform:rotate(2deg) scale(1.05);box-shadow:0 0 30px var(--cyan);}
    .hours{
      margin-top:1.6em;font-family:'Gowun Batang',serif;
      color:var(--cyan);font-size:.95rem;letter-spacing:.05em;
    }
    footer{
      position:relative;z-index:1;text-align:center;
      padding:30px 16px;background:var(--ink);
      font-family:'Bungee Inline',cursive;letter-spacing:.2em;
      color:var(--pink);font-size:.8rem;
    }

    @media(max-width:640px){
      .artist-card{grid-template-columns:1fr;text-align:center;}
      .avatar{max-width:200px;margin:0 auto;}
      .tags{justify-content:center;}
    }
  </style>
</head>
<body>

<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
  <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
  <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 30 · 사이키 잉크 — 60년대 사이키델릭 포스터 스타일</span>
  <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
</div>
<div style="height:40px;"></div>

<!-- ===== global swirl backgrounds ===== -->
<svg class="swirl-bg" viewBox="0 0 200 200" aria-hidden="true">
  <defs>
    <radialGradient id="sg1" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffd400"/>
      <stop offset="50%" stop-color="#ff00aa"/>
      <stop offset="100%" stop-color="#7a00ff"/>
    </radialGradient>
  </defs>
  <g fill="none" stroke="url(#sg1)" stroke-width="2">
    <path d="M100,100 m-90,0 a90,90 0 1,1 180,0 a70,70 0 1,0 -140,0 a50,50 0 1,1 100,0 a30,30 0 1,0 -60,0 a14,14 0 1,1 28,0"/>
  </g>
</svg>
<svg class="swirl-bg rev" viewBox="0 0 200 200" aria-hidden="true">
  <g fill="none" stroke="#00e5ff" stroke-width="1.4" opacity=".8">
    <path d="M100,100 m-95,0 a95,95 0 1,0 190,0 a75,75 0 1,1 -150,0 a55,55 0 1,0 110,0 a35,35 0 1,1 -70,0"/>
  </g>
</svg>

<main>

  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <svg class="mandala" viewBox="0 0 400 400" aria-hidden="true">
      <defs>
        <linearGradient id="mg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#ffd400"/>
          <stop offset="33%" stop-color="#ff6a00"/>
          <stop offset="66%" stop-color="#ff00aa"/>
          <stop offset="100%" stop-color="#00e5ff"/>
        </linearGradient>
      </defs>
      <g transform="translate(200,200)" fill="none" stroke="url(#mg)" stroke-width="1.6" opacity=".9">
        <g id="petal-set">
          <ellipse cx="0" cy="-120" rx="26" ry="80"/>
          <ellipse cx="0" cy="-120" rx="12" ry="50"/>
        </g>
        <use href="#petal-set" transform="rotate(30)"/>
        <use href="#petal-set" transform="rotate(60)"/>
        <use href="#petal-set" transform="rotate(90)"/>
        <use href="#petal-set" transform="rotate(120)"/>
        <use href="#petal-set" transform="rotate(150)"/>
        <use href="#petal-set" transform="rotate(180)"/>
        <use href="#petal-set" transform="rotate(210)"/>
        <use href="#petal-set" transform="rotate(240)"/>
        <use href="#petal-set" transform="rotate(270)"/>
        <use href="#petal-set" transform="rotate(300)"/>
        <use href="#petal-set" transform="rotate(330)"/>
