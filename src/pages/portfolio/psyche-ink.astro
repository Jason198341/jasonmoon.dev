            <g stroke="#ff6a00"><line x1="-22" y1="-22" x2="-55" y2="-55"/><line x1="22" y1="22" x2="55" y2="55"/><line x1="-22" y1="22" x2="-55" y2="55"/><line x1="22" y1="-22" x2="55" y2="-55"/></g>
