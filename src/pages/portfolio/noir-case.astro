---
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>느와르 케이스 — 추리·방탈출 카페</title>
<meta name="description" content="1930년대 하드보일드 탐정의 세계로. 서울 강남의 필름 누아르 방탈출·추리 카페, 느와르 케이스." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" />
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    --ink:#0c0a07;
    --ink-2:#15110b;
    --paper:#cabd9f;
    --paper-2:#b6a988;
    --sepia:#a6864c;
    --sepia-bright:#d8b56b;
    --blood:#7d2a1f;
    --smoke:#6f685a;
    --fog:#9a917e;
    --line:#3a3225;
    --mono:'Courier Prime','Special Elite',ui-monospace,monospace;
    --type:'Special Elite','Courier Prime',monospace;
    --serif:'Playfair Display',Georgia,serif;
  }
  html{scroll-behavior:smooth}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:var(--mono);
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
    position:relative;
  }
  /* film grain + vignette over everything */
  body::before{
    content:"";position:fixed;inset:0;z-index:1;pointer-events:none;
    background:
      radial-gradient(ellipse at center, transparent 52%, rgba(0,0,0,0.78) 100%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.05'/></svg>");
    mix-blend-mode:overlay;
  }
  ::selection{background:var(--blood);color:var(--paper)}
  a{color:inherit}
  img{max-width:100%}
  .wrap{max-width:1120px;margin:0 auto;padding:0 24px;position:relative;z-index:2}
  .eyebrow{
    font-family:var(--mono);font-size:12px;letter-spacing:0.42em;
    text-transform:uppercase;color:var(--sepia);
  }
  .smoke{position:absolute;pointer-events:none;opacity:0.5;z-index:1}

  /* ============ HERO ============ */
  .hero{
    position:relative;min-height:100vh;display:flex;align-items:center;
    background:
      linear-gradient(180deg, rgba(8,6,4,0.82), rgba(8,6,4,0.92)),
      repeating-linear-gradient(255deg, rgba(0,0,0,0) 0 26px, rgba(0,0,0,0.55) 26px 64px),
      radial-gradient(circle at 72% 18%, rgba(216,181,107,0.16), transparent 46%),
      #0a0805;
    overflow:hidden;
    border-bottom:1px solid var(--line);
  }
  /* venetian blind light slats sweeping the hero */
  .hero::before{
    content:"";position:absolute;inset:-10% -20% -10% 30%;z-index:1;
    background:repeating-linear-gradient(
      168deg,
      transparent 0 34px,
      rgba(214,179,108,0.10) 34px 40px,
      transparent 40px 74px
    );
    transform:rotate(-4deg);
    filter:blur(0.5px);
    mix-blend-mode:screen;
    pointer-events:none;
  }
  .hero__inner{position:relative;z-index:3;padding:120px 0 90px}
  .hero__file{
    display:inline-flex;align-items:center;gap:14px;margin-bottom:34px;
    border:1px solid var(--sepia);padding:7px 16px;
    background:rgba(166,134,76,0.07);
  }
  .hero__file .no{font-family:var(--mono);font-size:12px;letter-spacing:0.3em;color:var(--sepia-bright)}
  .hero__file .stamp{
    font-family:var(--type);font-size:11px;letter-spacing:0.2em;
    color:var(--blood);border:1.5px solid var(--blood);padding:2px 8px;
    transform:rotate(-3deg);
  }
  h1.hero__title{
    font-family:var(--serif);font-weight:900;font-style:italic;
    font-size:clamp(3.2rem,11vw,8rem);line-height:0.94;
    color:var(--paper);letter-spacing:-0.01em;
    text-shadow:0 2px 0 #000, 0 0 44px rgba(0,0,0,0.9);
    margin-bottom:8px;
  }
  h1.hero__title .l2{display:block;color:var(--sepia-bright);font-size:0.62em}
  .hero__tag{
    font-family:var(--type);font-size:clamp(1rem,2.4vw,1.45rem);
    color:var(--fog);max-width:46ch;margin:26px 0 40px;line-height:1.9;
  }
  .hero__tag b{color:var(--paper);font-weight:400;border-bottom:1px solid var(--blood)}
  .hero__cta{display:flex;flex-wrap:wrap;gap:16px}
  .btn{
    font-family:var(--mono);font-size:13px;letter-spacing:0.18em;text-transform:uppercase;
    text-decoration:none;padding:15px 30px;display:inline-block;
    transition:all .25s ease;cursor:pointer;
  }
  .btn--gold{background:var(--sepia-bright);color:#100c06;font-weight:700;border:1px solid var(--sepia-bright)}
  .btn--gold:hover{background:transparent;color:var(--sepia-bright);box-shadow:0 0 22px rgba(216,181,107,0.35)}
  .btn--ghost{background:transparent;color:var(--paper);border:1px solid var(--smoke)}
  .btn--ghost:hover{border-color:var(--paper);background:rgba(202,189,159,0.06)}
  /* detective silhouette */
  .hero__figure{
    position:absolute;right:-2%;bottom:0;z-index:2;height:92%;width:auto;
    opacity:0.9;filter:drop-shadow(-30px 0 40px rgba(0,0,0,0.8));pointer-events:none;
  }
  @media(max-width:820px){.hero__figure{opacity:0.22;right:-12%}}

  /* section frame */
  section{position:relative;z-index:2}
  .sect{padding:110px 0;border-bottom:1px solid var(--line)}
  .sect__head{margin-bottom:56px;max-width:60ch}
  .sect__head h2{
    font-family:var(--serif);font-weight:700;font-style:italic;
    font-size:clamp(2rem,5.5vw,3.4rem);color:var(--paper);line-height:1.05;margin:14px 0 0;
  }
  .sect--dark{background:var(--ink-2)}

  /* ============ CASES / THEMES ============ */
  .cases{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:30px}
  .case{
    position:relative;background:var(--paper);color:var(--ink);
    padding:30px 28px 26px;
    box-shadow:0 18px 40px rgba(0,0,0,0.6);
    transform:rotate(-0.6deg);transition:transform .3s ease, box-shadow .3s ease;
    border:1px solid #8b7d5c;
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100' height='100' filter='url(%23p)' opacity='0.06'/></svg>"),
      linear-gradient(180deg,var(--paper),var(--paper-2));
  }
  .case:nth-child(even){transform:rotate(0.7deg)}
  .case:hover{transform:rotate(0) translateY(-6px);box-shadow:0 26px 54px rgba(0,0,0,0.7)}
  .case::before{ /* paperclip / tape */
    content:"CASE FILE";position:absolute;top:-12px;left:22px;
    background:var(--blood);color:var(--paper);font-family:var(--mono);
    font-size:10px;letter-spacing:0.24em;padding:4px 12px;
    box-shadow:0 4px 10px rgba(0,0,0,0.4);
  }
  .case__no{font-family:var(--mono);font-size:11px;letter-spacing:0.26em;color:var(--blood);margin-top:6px}
  .case__title{font-family:var(--serif);font-weight:700;font-size:1.7rem;line-height:1.1;margin:6px 0 12px;color:var(--ink)}
  .case__desc{font-family:var(--mono);font-size:13.5px;line-height:1.75;color:#2c251a}
  .case__meta{
    margin-top:18px;padding-top:14px;border-top:1.5px dashed #8b7d5c;
    display:flex;justify-content:space-between;align-items:center;
    font-family:var(--mono);font-size:11.5px;letter-spacing:0.06em;color:#3a3022;
  }
  .case__tag{
    display:inline-block;background:var(--ink);color:var(--sepia-bright);
    font-family:var(--mono);font-size:10px;letter-spacing:0.2em;padding:3px 9px;
    transform:rotate(-2deg);
  }
  .case__solved{color:var(--blood);font-weight:700}

  /* ============ EVIDENCE / 난이도·인원 ============ */
  .evid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px}
  .evid__card{
    border:1px solid var(--line);padding:30px 26px;background:rgba(166,134,76,0.04);
    position:relative;transition:border-color .25s ease, background .25s ease;
  }
  .evid__card:hover{border-color:var(--sepia);background:rgba(166,134,76,0.09)}
  .evid__label{
    position:absolute;top:-9px;left:18px;background:var(--ink-2);padding:0 10px;
    font-family:var(--mono);font-size:10px;letter-spacing:0.24em;color:var(--sepia)
  }
  .evid__big{font-family:var(--serif);font-style:italic;font-size:2.6rem;color:var(--sepia-bright);line-height:1}
  .evid__sub{font-family:var(--mono);font-size:13px;color:var(--fog);margin-top:10px;line-height:1.7}
  .evid__bars{margin-top:18px;display:flex;gap:4px}
  .evid__bars span{height:7px;flex:1;background:var(--smoke);opacity:0.3}
  .evid__bars span.on{background:var(--blood);opacity:1}

  /* ============ RESERVE ============ */
  .reserve{display:grid;grid-template-columns:1.1fr 0.9fr;gap:50px;align-items:start}
  @media(max-width:860px){.reserve{grid-template-columns:1fr}}
  .ticket{
    border:1px solid var(--sepia);padding:34px 30px;position:relative;
    background:
      repeating-linear-gradient(90deg,transparent 0 11px, rgba(166,134,76,0.05) 11px 12px),
      rgba(12,9,6,0.6);
  }
  .ticket h3{font-family:var(--serif);font-style:italic;font-size:1.7rem;color:var(--paper);margin-bottom:6px}
  .ticket p{font-family:var(--mono);font-size:13px;color:var(--fog);margin-bottom:24px}
  .field{margin-bottom:18px}
  .field label{display:block;font-family:var(--mono);font-size:10px;letter-spacing:0.22em;color:var(--sepia);text-transform:uppercase;margin-bottom:7px}
  .field input,.field select{
    width:100%;background:#0a0805;border:1px solid var(--line);color:var(--paper);
    font-family:var(--mono);font-size:14px;padding:12px 13px;outline:none;transition:border-color .2s ease;
  }
  .field input:focus,.field select:focus{border-color:var(--sepia-bright)}
  .field input::placeholder{color:#5d564a}
  .priceboard{font-family:var(--mono)}
  .priceboard .row{
    display:flex;justify-content:space-between;align-items:baseline;
    padding:14px 0;border-bottom:1px dashed var(--line);
  }
  .priceboard .row span:first-child{color:var(--paper)}
  .priceboard .row .amt{color:var(--sepia-bright);font-size:1.15rem}
  .priceboard .row small{display:block;color:var(--smoke);font-size:11px;margin-top:3px}
  .note{margin-top:22px;font-family:var(--mono);font-size:12px;color:var(--smoke);line-height:1.8;border-left:2px solid var(--blood);padding-left:14px}

  /* ============ CONTACT ============ */
  .contact{background:#080604;text-align:center;padding:96px 0}
  .contact h2{font-family:var(--serif);font-style:italic;font-size:clamp(2rem,6vw,3.2rem);color:var(--paper);margin-bottom:10px}
  .contact .quote{font-family:var(--type);color:var(--fog);font-size:1.05rem;max-width:40ch;margin:0 auto 38px;line-height:1.9}
  .contact__grid{display:flex;flex-wrap:wrap;justify-content:center;gap:18px 48px;font-family:var(--mono);font-size:14px;color:var(--paper)}
  .contact__grid div span{display:block;color:var(--sepia);font-size:10px;letter-spacing:0.24em;margin-bottom:6px}
  .contact .phone{font-family:var(--serif);font-style:italic;font-size:2.4rem;color:var(--sepia-bright);margin:30px 0}
  footer{border-top:1px solid var(--line);padding:30px 0;text-align:center}
  footer p{font-family:var(--mono);font-size:11px;letter-spacing:0.1em;color:var(--smoke)}
</style>
</head>
<body>
<div style="position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 16px;background:rgba(7,11,20,0.94);backdrop-filter:blur(8px);border-bottom:2px solid #ffb000;font-family:ui-monospace,'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;">
  <a href="/portfolio" style="color:#ffb000;text-decoration:none;white-space:nowrap;">← PORTFOLIO</a>
  <span style="color:#8ea0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">SAMPLE 39 · 느와르 케이스 — 1930년대 하드보일드 탐정 스타일</span>
  <a href="/contact" style="color:#070b14;background:#ffb000;padding:6px 12px;text-decoration:none;font-weight:700;white-space:nowrap;border-radius:2px;">제작 문의 →</a>
</div>
<div style="height:40px;"></div>

<!-- ============ HERO ============ -->
<header class="hero">
  <!-- cigarette smoke -->
  <svg class="smoke" style="left:8%;top:30%;width:180px;height:520px" viewBox="0 0 180 520" aria-hidden="true">
    <path d="M90 520 C70 440 130 400 90 330 C50 270 120 230 88 160 C60 110 110 70 90 0"
      fill="none" stroke="rgba(214,179,108,0.18)" stroke-width="14" stroke-linecap="round"/>
  </svg>
  <!-- detective silhouette (trench coat + fedora) -->
  <svg class="hero__figure" viewBox="0 0 360 760" aria-hidden="true">
    <g fill="#050402">
      <!-- hat brim + crown -->
      <ellipse cx="180" cy="150" rx="118" ry="26"/>
      <path d="M120 150 q60 -82 120 0 q-10 -56 -60 -56 q-50 0 -60 56Z"/>
      <rect x="122" y="118" width="116" height="14" rx="6"/>
      <!-- head/face -->
      <path d="M138 160 q42 60 84 0 l0 40 q-42 36 -84 0Z"/>
      <!-- shoulders + trench coat body -->
      <path d="M96 224 q84 -60 168 0 l30 120 -36 14 -8 360 -140 0 -8 -360 -36 -14Z"/>
      <!-- collar -->
      <path d="M150 210 l30 40 30 -40 -8 60 -44 0Z"/>
      <!-- coat split line -->
      <rect x="176" y="300" width="8" height="380" fill="#0c0a07"/>
    </g>
  </svg>

  <div class="wrap hero__inner">
    <div class="hero__file">
      <span class="no">CASE No. 1930-NK</span>
      <span class="stamp">CLASSIFIED</span>
    </div>
    <h1 class="hero__title">느와르<span class="l2">케이스.</span></h1>
    <p class="hero__tag">
      비가 그치지 않는 밤, 도시는 거짓말을 한다.<br/>
      당신에게 주어진 시간은 <b>60분</b>. 단서는 흩어졌고,
      진실은 담배 연기 속에 숨었다. <b>강남의 하드보일드 추리극장</b>에 발을 들여라.
    </p>
    <div class="hero__cta">
      <a href="#reserve" class="btn btn--gold">사건 의뢰하기</a>
      <a href="#cases" class="btn btn--ghost">미해결 사건 보기</a>
    </div>
  </div>
</header>

<!-- ============ THEMES / CASE FILES ============ -->
<section class="sect" id="cases">
  <div class="wrap">
    <div class="sect__head">
      <p class="eyebrow">Open Investigations · 진행 중인 사건</p>
      <h2>네 개의 사건, 네 개의 거짓말.</h2>
    </div>
    <div class="cases">

      <article class="case">
        <p class="case__no">CASE No. 01</p>
        <h3 class="case__title">붉은 우산의 여인</h3>
        <p class="case__desc">
          빗속에서 사라진 가수. 마지막 목격자는 그녀의 붉은 우산뿐.
          호텔 408호에 남겨진 립스틱 메모를 따라가면, 도시의 가장 깊은 비밀이 입을 연다.
        </p>
        <div class="case__meta">
          <span class="case__tag">스토리 · 추리</span>
          <span class="case__solved">탈출률 38%</span>
        </div>
      </article>

      <article class="case">
        <p class="case__no">CASE No. 02</p>
        <h3 class="case__title">마지막 재즈클럽</h3>
        <p class="case__desc">
          금주법 시대, 지하 재즈클럽의 사장이 무대 위에서 쓰러졌다.
          연주자 다섯, 알리바이 다섯. 진짜 음표를 찾아내는 자만이 문을 연다.
        </p>
        <div class="case__meta">
          <span class="case__tag">고난도 · 심문</span>
          <span class="case__solved">탈출률 24%</span>
        </div>
      </article>

      <article class="case">
        <p class="case__no">CASE No. 03</p>
        <h3 class="case__title">은행가의 금고</h3>
        <p class="case__desc">
          파산 직전 자살한 은행가. 그가 남긴 마지막 금고에는 빚 대신 살인의 증거가.
          숫자 뒤에 숨은 동기를 풀어라. 장치형 자물쇠 14개가 당신을 기다린다.
        </p>
        <div class="case__meta">
          <span class="case__tag">장치 · 메커니즘</span>
          <span class="case__solved">탈출률 31%</span>
        </div>
      </article>

      <article class="case">
        <p class="case__no">CASE No. 04</p>
        <h3 class="case__title">탐정이 죽던 날</h3>
        <p class="case__desc">
          이 도시 최고의 탐정이 의문의 죽음을 맞았다. 그의 마지막 의뢰인은… 바로 당신.
          그가 남긴 수첩을 따라 자신의 무죄를 증명하라. 공포 연출 포함.
        </p>
        <div class="case__meta">
          <span class="case__tag">호러 · 추격</span>
          <span class="case__solved">탈출률 19%</span>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- ============ EVIDENCE / 난이도·인원 ============ -->
<section class="sect sect--dark" id="evidence">
  <div class="wrap">
    <div class="sect__head">
      <p class="eyebrow">Case Brief · 사건 개요</p>
      <h2>들어오기 전에, 규칙을 읽어라.</h2>
    </div>
    <div class="evid">

      <div class="evid__card">
        <span class="evid__label">DURATION · 제한시간</span>
        <div class="evid__big">60′</div>
        <p class="evid__sub">방마다 60분.<br/>시간이 멈추면, 사건도 멈춘다.</p>
      </div>

      <div class="evid__card">
        <span class="evid__label">SUSPECTS · 인원</span>
        <div class="evid__big">2–6</div>
        <p class="evid__sub">2인 듀오 수사부터<br/>6인 합동 수사대까지.</p>
      </div>

      <div class="evid__card">
        <span class="evid__label">DIFFICULTY · 난이도</span>
        <div class="evid__big">★★★★☆</div>
        <p class="evid__sub">초심 탐정 환영.<br/>단, 자만은 금물.</p>
        <div class="evid__bars"><span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span><span></span></div>
      </div>

      <div class="evid__card">
        <span class="evid__label">HINTS · 단서 제공</span>
        <div class="evid__big">3회</div>
        <p class="evid__sub">전담 형사가 무전으로<br/>최대 3회 결정적 단서 제공.</p>
      </div>

    </div>
  </div>
</section>

<!-- ============ RESERVE ============ -->
<section class="sect" id="reserve">
  <div class="wrap">
    <div class="sect__head">
      <p class="eyebrow">File a Case · 사건 의뢰</p>
      <h2>의뢰서를 작성하라.</h2>
    </div>
    <div class="reserve">
      <form class="ticket" onsubmit="return false">
        <h3>예약 의뢰서</h3>
        <p>접수 후 형사실에서 30분 내 확인 전화를 드립니다.</p>
        <div class="field">
          <label>의뢰인 성함</label>
          <input type="text" placeholder="홍길동" />
        </div>
        <div class="field">
          <label>연락처</label>
          <input type="tel" placeholder="010-0000-0000" />
        </div>
        <div class="field">
          <label>사건 선택</label>
