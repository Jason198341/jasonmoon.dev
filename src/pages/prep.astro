---
import Base from '../layouts/Base.astro';
import { CONCEPTS, type Level } from '../data/concepts';
import { schoolStatus, stageOf, STAGE_BY_N, SEYEON } from '../data/curriculum';
import { DEEP } from '../data/deep';
import { PREP, PREP_LABEL, CHECK_ITEMS, prepCount } from '../data/prep';
import { EN } from '../data/english';

const rows = [...CONCEPTS].sort((a, b) => stageOf(a) - stageOf(b)).map((c) => {
  const p = PREP[c.id];
  return {
    id: c.id, name: c.name.replace(/ ★.*$/, ''), en: EN[c.id] ?? '', lv: c.lv as Level,
    area: c.area, stage: STAGE_BY_N[stageOf(c)].short, school: schoolStatus(c),
    hasDeep: !!DEEP[c.id], prep: p,
    checks: p ? CHECK_ITEMS.filter((k) => p.checklist?.[k.key]).length : 0,
  };
});
const deepCount = rows.filter((r) => r.hasDeep).length;
---
<Base title="아빠 예습" desc="가르치기 전에 제1원칙으로 내가 먼저 재구성한다">
  <h1>아빠 예습</h1>
  <p class="lead" style="max-width:720px">
    가르치기 전에 <b>제1원칙으로 내가 먼저 재구성</b>한다.
    공리에서 출발해 원자 단위로 쪼개고, 인과 사슬에 비약이 없는지 확인하고, 비유의 깨지는 지점까지 정해 둔다.
    <span class="hand" style="font-size:20px">이름 붙이기는 설명이 아니다.</span>
  </p>

  <div class="grid c4" style="margin:18px 0">
    <div class="stat"><div class="n">{prepCount('ready') + prepCount('taught')}</div><div class="k">준비 완료</div></div>
    <div class="stat"><div class="n">{prepCount('drafting')}</div><div class="k">작성 중</div></div>
    <div class="stat"><div class="n">{prepCount('taught')}</div><div class="k">가르침</div></div>
    <div class="stat"><div class="n">{deepCount}</div><div class="k">심층자료 / {rows.length}</div></div>
  </div>

  <div class="card" style="background:#F5F9FF;border-color:#C9DDF5;margin-bottom:20px">
    <b>예습 7단계</b>
    <ol style="margin:8px 0 0;padding-left:22px;font-size:14.5px">
      <li><b>출발점</b> — 전제하는 공리·사실을 명시. 관행·통념은 출발점이 아니다.</li>
      <li><b>원자 분해</b> — 등장하는 모든 용어를 그 전에 정의. 선행 → 후행 순서.</li>
      <li><b>인과 사슬</b> — A이므로 B. "따라서/당연히"로 건너뛴 곳이 설명의 구멍이다.</li>
      <li><b>메커니즘</b> — "무엇"이 아니라 "어떻게". 왜 그 형태일 수밖에 없는가.</li>
      <li><b>경계</b> — 언제 성립하고 언제 깨지는가. 답 못 하면 설명이 아니라 믿음이다.</li>
      <li><b>비유의 한계</b> — 깨지는 지점을 말하지 않는 비유는 오개념을 심는다.</li>
      <li><b>재도출 검사</b> — 세연이가 나 없이 다시 도출할 수 있는가.</li>
    </ol>
    <p class="tiny" style="margin:10px 0 0">
      예습 노트는 <code>src/data/prep/</code> 에 코드로 씁니다. Claude에게 <code>/mathjason</code> 으로 불러주세요.
    </p>
  </div>

  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;align-items:center">
    <button type="button" class="ft primary" data-f="">전체</button>
    <button type="button" class="ft" data-f="ready">준비 완료</button>
    <button type="button" class="ft" data-f="drafting">작성 중</button>
    <button type="button" class="ft" data-f="taught">가르침</button>
    <button type="button" class="ft" data-f="todo">예습 전</button>
    <input id="q" type="search" placeholder="개념 검색" style="flex:1;min-width:180px" />
  </div>

  <ul class="list" id="list">
    {rows.map((r) => (
      <li data-st={r.prep?.status ?? 'todo'} data-q={`${r.name} ${r.en} ${r.area} ${r.stage}`.toLowerCase()}
          style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <span class={`chip ${r.lv}`} style="flex:0 0 auto">{r.stage}</span>
        <a href={`/c/${r.id}#prep`} style="font-weight:700;font-size:15.5px">{r.name}</a>
        {r.en && <span class="eng-term sm">{r.en}</span>}
        <span class="tiny">{r.area}</span>
        {r.school === 'current' && <span class="pill current">지금 여기</span>}
        {r.hasDeep && <span class="tiny" title="심층자료 있음">📚</span>}
        <span style="margin-left:auto;display:flex;gap:8px;align-items:center">
          {r.prep && <span class="tiny">점검 {r.checks}/{CHECK_ITEMS.length}</span>}
          {r.prep?.minutes && <span class="tiny">{r.prep.minutes}분</span>}
          <span class={`pill ${r.prep?.status === 'ready' || r.prep?.status === 'taught' ? 'learned'
                             : r.prep?.status === 'drafting' ? 'current' : 'upcoming'}`}>
            {PREP_LABEL[r.prep?.status ?? 'todo']}
          </span>
        </span>
      </li>
    ))}
  </ul>
</Base>

<script>
  const items = document.querySelectorAll<HTMLLIElement>('#list li');
  const q = document.getElementById('q') as HTMLInputElement;
  let f = '';
  const apply = () => {
    const v = q.value.trim().toLowerCase();
    items.forEach((li) => {
      const okF = !f || li.dataset.st === f;
      const okQ = !v || (li.dataset.q || '').includes(v);
      li.style.display = okF && okQ ? '' : 'none';
    });
  };
  q.addEventListener('input', apply);
  document.querySelectorAll<HTMLButtonElement>('.ft').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.ft').forEach((x) => x.classList.remove('primary'));
      b.classList.add('primary');
      f = b.dataset.f || '';
      apply();
    }));
</script>
