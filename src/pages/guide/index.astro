---
import Base from '../../layouts/Base.astro';

const KAKAO = 'https://invite.kakao.com/tc/EszOu7fY0i';

// 무엇이 무료인가
const freeItems = [
  { mark: '✓', good: true, text: '홈페이지·프로그램을 만들어 드리고, 완성된 파일을 그대로 전달해 드립니다.', sub: '제작은 전부 무료입니다.' },
  { mark: '✓', good: true, text: '직접 인터넷에 올리는 방법(배포)을 이 페이지에서 차근차근 알려 드립니다.', sub: '이 안내문도 무료입니다.' },
  { mark: '·', good: false, text: '도메인(주소) 구매·연결이나 서버를 대신 운영해 드리는 일은 원하실 때 따로 의논합니다.', sub: '요청하시면 별도 협의로 도와드립니다.' },
];

// 3가지 방법
const methods = [
  {
    tag: 'METHOD-A',
    name: '방법 A',
    title: '그냥 파일만 받기',
    badge: '가장 쉬움',
    badgeTone: 'green',
    body: '완성된 홈페이지 파일을 그대로 드립니다. 인터넷에 올리지 않고, 컴퓨터에서 열어 보거나 나중에 천천히 올리셔도 됩니다. 가장 간단한 방법입니다.',
    cost: '무료',
  },
  {
    tag: 'METHOD-B',
    name: '방법 B',
    title: '무료로 인터넷에 올리기',
    badge: '추천',
    badgeTone: 'amber',
    body: 'GitHub(깃허브)와 Cloudflare Pages(클라우드플레어)를 이용합니다. 바로 이 jasonmoon.dev 홈페이지가 쓰는 방식입니다. 호스팅(인터넷에 올려두는 공간)이 무료이고, 보안 자물쇠(SSL)도 자동으로 붙습니다.',
    cost: '무료',
  },
  {
    tag: 'METHOD-C',
    name: '방법 C',
    title: '나만의 주소(도메인) 달기',
    badge: '한 단계 더',
    badgeTone: 'cyan',
    body: 'Namecheap(네임칩)에서 원하는 주소(예: mycafe.com)를 사고, 그 주소를 Cloudflare에 연결합니다. 그러면 ○○.pages.dev 대신 내가 고른 멋진 주소로 홈페이지가 열립니다.',
    cost: '주소 값은 본인 부담(보통 연 5~10만원)',
  },
];

// 배포 STEP
const deploySteps = [
  {
    n: 1,
    title: 'github.com 에 가입하고, 새 저장소(repository)를 만듭니다',
    body: '인터넷 주소창에 github.com 을 칩니다. 이메일로 무료 가입한 뒤, 초록색 "New" 버튼을 눌러 새 저장소(파일을 보관하는 폴더라고 생각하시면 됩니다)를 하나 만듭니다.',
  },
  {
    n: 2,
    title: '받은 홈페이지 파일을 저장소에 올립니다(업로드)',
    body: '방금 만든 저장소 화면에서 "uploading an existing file"(파일 올리기) 글자를 누릅니다. 제가 드린 홈페이지 파일들을 마우스로 끌어다 놓고, 아래 초록색 "Commit changes" 버튼을 누르면 올라갑니다.',
  },
  {
    n: 3,
    title: 'dash.cloudflare.com 에 가입하고 저장소를 연결합니다',
    body: '주소창에 dash.cloudflare.com 을 칩니다. 무료 가입 후 왼쪽 메뉴에서 "Pages"를 찾아 누르고, "Connect to Git"(깃 연결)을 눌러 방금 만든 GitHub 저장소를 골라 줍니다.',
  },
  {
    n: 4,
    title: 'Deploy 버튼을 누르면 몇 분 뒤 인터넷에 살아납니다',
    body: '빌드 설정 화면이 나오면 보통 그대로 두셔도 됩니다. 아래 "Save and Deploy"(배포) 버튼을 누르고 몇 분만 기다리면, ○○.pages.dev 라는 주소로 홈페이지가 진짜로 열립니다.',
  },
];

// 도메인 STEP
const domainSteps = [
  {
    n: 1,
    title: 'namecheap.com 에서 원하는 주소를 검색하고 삽니다',
    body: '주소창에 namecheap.com 을 칩니다. 원하는 주소(예: mycafe.com)를 검색해서 비어 있으면 장바구니에 담아 결제합니다. 값은 보통 1년에 5~10만원 정도이며, 이 비용은 고객님이 부담하십니다.',
  },
  {
    n: 2,
    title: 'Cloudflare에 도메인을 추가하고 네임서버 2개를 복사합니다',
    body: 'Cloudflare 화면에서 "Add a site"(사이트 추가)로 방금 산 주소를 넣습니다. 그러면 Cloudflare가 네임서버(nameserver)라는 주소 2개를 알려 줍니다. 이 두 줄을 마우스로 복사해 둡니다.',
  },
  {
    n: 3,
    title: 'Namecheap의 Custom DNS에 그 네임서버를 붙여 넣습니다',
    body: 'Namecheap의 도메인 관리(Manage) 화면으로 갑니다. "Nameservers" 항목을 "Custom DNS"로 바꾸고, 아까 복사한 네임서버 2개를 한 줄씩 붙여 넣은 뒤 저장합니다.',
  },
  {
    n: 4,
    title: '몇 시간 안에 내 주소로 홈페이지가 열립니다',
    body: '짧으면 몇 십 분, 길면 몇 시간 뒤에 내가 고른 주소로 홈페이지가 열립니다. 이때부터 누구에게나 그 주소를 알려 주시면 됩니다.',
  },
];

const toneClass = {
  green: 'border-green text-green',
  amber: 'border-accent text-accent',
  cyan: 'border-cyan text-cyan',
};
---

<Base
  title="제작·배포·도메인 안내 — jasonmoon.dev"
  description="홈페이지 제작은 무료. 직접 인터넷에 올리는 방법(GitHub + Cloudflare Pages)과 나만의 주소(Namecheap 도메인) 연결을 80대 어르신도 따라할 수 있게 큼직하고 친절하게 안내합니다."
>
  <!-- ══ HERO ══ -->
  <section class="border-b border-border">
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-14 sm:py-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="hud-pip hud-pip--amber"></span>
        <span class="hud-id">GUIDE-001</span>
        <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">Make · Deploy · Domain</p>
      </div>
      <h1 class="font-display text-3xl sm:text-5xl font-bold leading-tight tracking-tight mb-5">
        제작 · 배포 · 도메인 안내
      </h1>
      <p class="text-lg sm:text-xl text-text-muted leading-relaxed max-w-2xl">
        홈페이지나 프로그램을 <span class="text-accent font-semibold">무료로 만들어</span> 드립니다.
        그리고 만든 것을 직접 인터넷에 올리는 방법까지 — 컴퓨터가 처음이신 분도 따라오실 수 있게
        <span class="text-text">하나씩 천천히</span> 알려 드립니다.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={KAKAO}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 border-2 border-accent bg-accent text-black px-6 py-3.5 font-bold text-base sm:text-lg tracking-tight hover:bg-accent-hover transition-colors"
        >
          💬 카톡으로 무료 문의하기
        </a>
        <a
          href="#deploy"
          class="inline-flex items-center gap-2.5 border border-border-strong bg-surface text-text px-6 py-3.5 font-semibold text-base sm:text-lg hover:border-accent hover:text-accent transition-colors"
        >
          ↓ 올리는 방법 바로 보기
        </a>
      </div>
    </div>
  </section>

  <!-- ══ MOD-1 · 무엇이 무료인가 ══ -->
  <section class="border-b border-border">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-1</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">무엇이 무료인가</p>
    </div>
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-12 sm:py-16">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-3">무엇이 무료인가요?</h2>
      <p class="text-base sm:text-lg text-text-muted mb-8 leading-relaxed">
        헷갈리지 않으시도록 먼저 분명히 적어 둡니다.
      </p>
      <div class="space-y-4">
        {freeItems.map((item) => (
          <div class={`flex items-start gap-4 border p-5 sm:p-6 ${item.good ? 'border-green/40 bg-green-dim' : 'border-border-strong bg-surface'}`}>
            <span class={`shrink-0 font-display text-2xl sm:text-3xl font-bold leading-none ${item.good ? 'text-green' : 'text-text-faint'}`}>
              {item.mark}
            </span>
            <div>
              <p class="text-base sm:text-lg text-text leading-relaxed">{item.text}</p>
              <p class={`mt-1 text-sm sm:text-base ${item.good ? 'text-green' : 'text-text-muted'}`}>{item.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ MOD-2 · 올리는 3가지 방법 ══ -->
  <section class="border-b border-border">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-2</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">올리는 3가지 방법</p>
    </div>
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-12 sm:py-16">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-3">홈페이지를 인터넷에 올리는 3가지 방법</h2>
      <p class="text-base sm:text-lg text-text-muted mb-8 leading-relaxed">
        쉬운 순서대로 적었습니다. 마음에 드는 방법 하나만 고르시면 됩니다.
      </p>
      <div class="grid gap-5 sm:grid-cols-3">
        {methods.map((m) => (
          <div class="flex flex-col border border-border bg-surface p-6 hover:border-accent transition-colors">
            <div class="flex items-center justify-between mb-4">
              <span class="hud-id">{m.tag}</span>
              <span class={`font-mono text-[10px] tracking-[0.15em] uppercase border px-2 py-1 ${toneClass[m.badgeTone]}`}>{m.badge}</span>
            </div>
            <p class="font-mono text-sm text-accent mb-1">{m.name}</p>
            <h3 class="font-display text-xl font-bold leading-snug mb-3">{m.title}</h3>
            <p class="text-base text-text-muted leading-relaxed flex-1">{m.body}</p>
            <p class="mt-5 pt-4 border-t border-border text-sm font-semibold text-text">
              💰 {m.cost}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ MOD-3 · 배포 따라하기 ══ -->
  <section id="deploy" class="border-b border-border scroll-mt-24">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-3</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">배포 따라하기 (방법 B)</p>
    </div>
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-12 sm:py-16">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-3">따라하기 — 무료로 인터넷에 올리기</h2>
      <p class="text-base sm:text-lg text-text-muted mb-10 leading-relaxed">
        GitHub와 Cloudflare Pages를 씁니다. 둘 다 무료입니다. 아래 4단계만 차례로 따라오세요.
      </p>
      <ol class="space-y-6">
        {deploySteps.map((step) => (
          <li class="flex gap-5 sm:gap-6 border border-border bg-surface p-5 sm:p-7">
            <span class="shrink-0 grid place-items-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-accent text-black font-display text-2xl sm:text-3xl font-bold">
              {step.n}
            </span>
            <div class="pt-1">
              <p class="font-mono text-[11px] text-accent tracking-[0.2em] uppercase mb-2">STEP {step.n}</p>
              <h3 class="font-display text-lg sm:text-xl font-bold leading-snug mb-2">{step.title}</h3>
              <p class="text-base sm:text-lg text-text-muted leading-relaxed">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex items-start gap-3 border border-accent/50 bg-accent-dim p-5 sm:p-6">
        <span class="hud-pip hud-pip--amber mt-2"></span>
        <p class="text-base sm:text-lg text-text leading-relaxed">
          어려우면 <span class="text-accent font-semibold">이 단계는 제가 대신 해드릴 수도 있어요.</span>
          부담 갖지 마시고 카톡 주세요.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ MOD-4 · 도메인 따라하기 ══ -->
  <section class="border-b border-border">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-4</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">도메인 따라하기 (방법 C)</p>
    </div>
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-12 sm:py-16">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-3">따라하기 — 나만의 주소 사고 연결하기</h2>
      <p class="text-base sm:text-lg text-text-muted mb-10 leading-relaxed">
        Namecheap에서 주소를 사고, Cloudflare에 연결하는 4단계입니다.
      </p>
      <ol class="space-y-6">
        {domainSteps.map((step) => (
          <li class="flex gap-5 sm:gap-6 border border-border bg-surface p-5 sm:p-7">
            <span class="shrink-0 grid place-items-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-accent text-black font-display text-2xl sm:text-3xl font-bold">
              {step.n}
            </span>
            <div class="pt-1">
              <p class="font-mono text-[11px] text-accent tracking-[0.2em] uppercase mb-2">STEP {step.n}</p>
              <h3 class="font-display text-lg sm:text-xl font-bold leading-snug mb-2">{step.title}</h3>
              <p class="text-base sm:text-lg text-text-muted leading-relaxed">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex items-start gap-3 border border-accent/50 bg-accent-dim p-5 sm:p-6">
        <span class="hud-pip hud-pip--amber mt-2"></span>
        <p class="text-base sm:text-lg text-text leading-relaxed">
          주소 연결(DNS)은 누구나 헷갈리기 쉬운 부분입니다. 원하시면
          <span class="text-accent font-semibold"> 이 부분도 대행해 드립니다.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ══ MOD-5 · 대행 안내 ══ -->
  <section class="border-b border-border">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-5</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">통째로 맡기기 (대행)</p>
    </div>
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-12 sm:py-16">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-4">
        "도메인도 신청해 주고, 서버 관리도 해 주세요" 하면 되나요?
      </h2>

      <div class="border-2 border-green/50 bg-green-dim p-6 sm:p-7 mb-8">
        <p class="font-mono text-[11px] text-green tracking-[0.2em] uppercase mb-2">결론</p>
        <p class="text-xl sm:text-2xl font-bold text-text leading-snug">
          네, 가능합니다.
        </p>
        <p class="mt-2 text-base sm:text-lg text-text-muted leading-relaxed">
          바로 이 jasonmoon.dev 홈페이지도 정확히 그 방식(Astro + Cloudflare Pages + Namecheap 도메인)으로
          운영되고 있습니다.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 mb-8">
        <div class="border border-border bg-surface p-6">
          <h3 class="font-display text-lg font-bold mb-3 flex items-center gap-2">
            <span class="hud-pip hud-pip--on"></span> 대행 범위
          </h3>
          <ul class="space-y-2.5 text-base text-text-muted leading-relaxed">
            <li><span class="text-accent">▸</span> 도메인(주소) 구매 대행 — 비용은 실비입니다</li>
            <li><span class="text-accent">▸</span> Cloudflare 연결 및 배포 전부 처리</li>
            <li><span class="text-accent">▸</span> 나중에 고치고 싶은 내용 반영</li>
            <li><span class="text-accent">▸</span> 서버는 Cloudflare가 자동 관리(서버리스)라 사실상 무중단·무료 호스팅</li>
          </ul>
        </div>
        <div class="border border-border bg-surface p-6">
          <h3 class="font-display text-lg font-bold mb-3 flex items-center gap-2">
            <span class="hud-pip hud-pip--amber"></span> 비용 안내
          </h3>
          <ul class="space-y-2.5 text-base text-text-muted leading-relaxed">
            <li><span class="text-accent">▸</span> 제작은 <span class="text-text font-semibold">무료</span></li>
            <li><span class="text-accent">▸</span> 도메인 실비(연 5~10만원)는 고객 부담</li>
            <li><span class="text-accent">▸</span> 지속 관리·수정 대행은 건별로 협의 (월 유지보수 형태도 가능)</li>
          </ul>
        </div>
      </div>

      <div class="border border-border-strong bg-surface-elev p-6 sm:p-7">
        <p class="font-mono text-[11px] text-text-faint tracking-[0.2em] uppercase mb-2">신청 방법</p>
        <p class="text-base sm:text-lg text-text leading-relaxed">
          어렵게 생각하지 마세요. 카톡으로
          <span class="text-accent font-semibold"> "도메인+서버까지 맡길게요"</span>
          한 마디만 주시면 됩니다. 나머지는 제가 합니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ MOD-6 · 소유권 이야기 ══ -->
  <section class="border-b border-border">
    <div class="px-6 sm:px-10 py-4 border-b border-border bg-surface/40 flex items-center gap-3">
      <span class="hud-id">MOD-6</span>
      <p class="font-mono text-[11px] text-text-muted tracking-[0.25em] uppercase">소유권 이야기</p>
    </div>
