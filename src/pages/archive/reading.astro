---
import Base from '../../layouts/Base.astro';

const books = [
  {
    title: '자존감 수업',
    subtitle: '100회 읽기 프로젝트',
    author: '윤홍균',
    status: 'reading' as const,
    current: 3,
    goal: 100,
    quote: '횟수가 목적이 아니라, 매회 다르게 읽히는 문장을 발견하는 것이 목적이다.',
    sessions: [
      {
        round: 1,
        date: '1/23',
        sentence: '나를 괴롭히는 목소리가 아니라, 나를 지지해주는 목소리를 키우라',
        change: '오래된 서랍이 열렸다 — 외면해온 감정과 대면',
        note: '아내가 무심코 건넨 책 한 권이 예기치 않게 내 일상에 작은 파문을 일으켰다. 책장을 넘길수록 마치 오래된 서랍을 하나씩 여는 기분이 들었다. 내 안에 늘 자리 잡고 있던 불안감이 선명하게 모습을 드러냈다. 저자는 낮은 자존감 때문에 힘들어하는 나를, 오히려 내가 응원해줘야 한다고 했다. 이 책은 한 번 읽고 끝낼 수 있는 책이 아니라고 — 최소 100번은 읽어야겠다고 결심했다.',
      },
      {
        round: 2,
        date: '1/28',
        sentence: "'지금 여기 나' 챕터 전체",
        change: '자존감 낮은 나를 핍박하던 밤 → 사랑하는 대화로 마감',
        note: "하루 종일 낮 동안은 자존감이 낮은 나로 살다가, 저녁에 와서는 공허한 마음에 나를 핍박하던 나. 하지만 이제는 자존감이 낮은 나를 온전히 사랑하는 나와 대화하며 하루를 마감한다. 마치 자존감이 충만한 사람처럼 스스로에게 미소 지어주고, 당당히 걷고, 혼잣말로 응원의 메시지를 보내며 하루를 마감할 수 있다.",
      },
      {
        round: 3,
        date: '2/5',
        sentence: '(책을 껴안았다)',
        change: '머리의 지식이 일상의 행동으로 전환되기 시작',
        note: '3회독을 마치고 나니 지식이 머리에 머무는 것을 넘어, 일상에서 자연스러운 행동의 변화로 나타나기 시작했다. 힘들어하는 동료에게 진심 어린 말을 건넸고, 아들의 물음에 즉시 손을 씻고 거실로 향했다. 아내는 내가 짜증 내는 횟수가 눈에 띄게 줄었다고 말한다.',
      },
    ],
  },
];

const statusLabel = {
  reading: { text: 'Reading', class: 'text-emerald-400 bg-emerald-400/10' },
  completed: { text: 'Completed', class: 'text-accent bg-accent-dim' },
  planned: { text: 'Planned', class: 'text-text-muted bg-surface' },
};
---

<Base title="Reading — Archive — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <a href="/archive" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Archive
      </a>

      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Reading</h1>
      <p class="text-text-muted mb-10">
        Books I'm reading — not just once, but deeply. Tracking what sticks and what changes.
      </p>

      {books.map((book) => (
        <div class="rounded-xl border border-border bg-surface p-6 mb-6">
          <div class="flex items-start justify-between mb-2">
            <div>
              <h2 class="text-xl font-semibold">{book.title}</h2>
              <p class="text-sm text-text-muted">{book.author} · {book.subtitle}</p>
            </div>
            <span class={`px-2.5 py-1 rounded text-xs font-medium shrink-0 ${statusLabel[book.status].class}`}>
              {statusLabel[book.status].text}
            </span>
          </div>

          <blockquote class="text-sm text-text-muted italic border-l-2 border-accent pl-3 my-4">
            {book.quote}
          </blockquote>

          <!-- Progress bar -->
          <div class="mb-6">
            <div class="flex justify-between text-xs text-text-muted mb-1">
              <span>Progress</span>
              <span class="font-mono">{book.current} / {book.goal}</span>
            </div>
            <div class="h-2 rounded-full bg-bg overflow-hidden">
              <div class="h-full rounded-full bg-accent transition-all" style={`width: ${(book.current / book.goal) * 100}%`} />
            </div>
          </div>

          <!-- Sessions -->
          <h3 class="text-sm font-semibold text-text-muted mb-4">Reading Sessions</h3>
          <div class="space-y-6">
            {book.sessions.map((s) => (
              <div class="pl-4 border-l-2 border-border">
                <div class="flex items-center gap-2 mb-2">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-accent text-white text-xs font-bold">{s.round}</span>
                  <span class="text-xs font-mono text-accent">{s.date}</span>
                </div>
                <div class="rounded-lg bg-bg p-3 mb-2">
                  <p class="text-sm font-medium text-text mb-1">"{s.sentence}"</p>
                  <p class="text-xs text-accent">{s.change}</p>
                </div>
                <p class="text-sm text-text-muted leading-relaxed">{s.note}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
