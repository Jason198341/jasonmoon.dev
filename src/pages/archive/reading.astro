---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import BookLibrary from '../../components/BookLibrary';
---

<Base title="Reading — Archive — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <a href="/archive" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Archive
      </a>

      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Reading</h1>
      <p class="text-text-muted mb-10">
        Books I'm reading — not just once, but deeply. Tracking what sticks and what changes.
      </p>

      <BookLibrary client:load />
    </div>
  </section>
</Base>
