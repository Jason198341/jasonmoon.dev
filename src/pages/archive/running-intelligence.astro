---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { fetchEnrichedRunData } from '../../lib/strava';
import { computeIntelligence } from '../../lib/strava-analytics';
import RunningIntelligence from '../../components/RunningIntelligence';

let intelligence = null;
let error = false;

try {
  const enriched = await fetchEnrichedRunData();
  intelligence = computeIntelligence(enriched.runs, parseFloat(enriched.stats.totalDistance));
} catch (e: any) {
  console.error('Running Intelligence error:', e?.message ?? e);
  error = true;
}
---

<Base title="Running Intelligence — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <a href="/archive/running" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Running
      </a>

      <div class="flex items-baseline gap-3 mb-2">
        <h1 class="text-3xl sm:text-4xl font-bold">Running Intelligence</h1>
      </div>

      {intelligence && (
        <p class="text-sm text-text-muted mb-10">
          {intelligence.totalRuns} runs · {intelligence.totalKm.toFixed(0)} km · {intelligence.dateRange}
        </p>
      )}

      {error && (
        <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 mb-6 text-sm text-amber-200">
          Could not load running analytics. Please try again later.
        </div>
      )}

      {intelligence ? (
        <RunningIntelligence client:load data={intelligence} />
      ) : !error ? (
        <div class="rounded-xl border border-border bg-surface p-8 text-center">
          <p class="text-4xl mb-3">📊</p>
          <p class="text-text-muted">No running data available for analysis.</p>
        </div>
      ) : null}

      <!-- Club Analytics CTA -->
      {intelligence && (
        <div class="mt-20 rounded-2xl border border-accent/20 bg-surface p-8 sm:p-10 text-center">
          <p class="text-3xl mb-4">🏃‍♂️🏃‍♀️</p>
          <h3 class="text-xl sm:text-2xl font-bold mb-3">Want this for your running club?</h3>
          <p class="text-text-muted text-sm sm:text-base max-w-lg mx-auto mb-2">
            This analytics engine can be extended to teams —
            member rankings, group pace optimization, injury prevention monitoring,
            and GPS-based meetup recommendations.
          </p>
          <p class="text-text-muted text-sm max-w-lg mx-auto mb-6">
            The personal version is already running with real data.
            Let's build the club version together.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-2.5 text-sm font-medium text-white hover:bg-accent-hover transition-colors"
            >
              Let's Talk
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a
              href="https://github.com/Jason198341"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-2.5 text-sm font-medium text-text-muted hover:text-text hover:border-accent/50 transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          </div>
        </div>
      )}

      <!-- Strava Attribution -->
      <div class="mt-12 flex items-center justify-center gap-2 text-xs text-text-muted">
        <span>Powered by</span>
        <a href="https://www.strava.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-[#FC4C02] transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
          </svg>
          <span class="font-semibold">Strava</span>
        </a>
      </div>
    </div>
  </section>
</Base>
