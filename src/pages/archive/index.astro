---
import Base from '../../layouts/Base.astro';

const archives = [
  {
    title: 'Reading',
    emoji: '📚',
    description: 'Book notes, highlights, and reading progress. Currently tracking personal growth books.',
    href: '/archive/reading',
  },
  {
    title: 'Running',
    emoji: '🏃',
    description: 'Monthly running logs and cumulative stats. Building the habit, one run at a time.',
    href: '/archive/running',
  },
];
---

<Base title="Archive — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Archive</h1>
      <p class="text-text-muted mb-10">
        Personal trackers and logs. Things I want to remember and measure.
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        {archives.map(({ title, emoji, description, href }) => (
          <a
            href={href}
            class="group block rounded-xl border border-border bg-surface p-6 hover:border-accent/40 hover:bg-surface-hover transition-all"
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">{emoji}</span>
              <h2 class="text-xl font-semibold group-hover:text-accent transition-colors">{title}</h2>
            </div>
            <p class="text-sm text-text-muted leading-relaxed">{description}</p>
            <div class="mt-4 text-sm text-accent opacity-0 group-hover:opacity-100 transition-opacity">
              View &rarr;
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
