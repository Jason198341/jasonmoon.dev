---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { fetchEnrichedRunData } from '../../lib/strava';
import type { EnrichedRunData } from '../../lib/strava';
import RunningDashboard from '../../components/RunningDashboard';

let data: EnrichedRunData | null = null;
let error = false;

try {
  data = await fetchEnrichedRunData();
} catch (e: any) {
  console.error('Strava fetch error:', e?.message ?? e);
  error = true;
}

const quote = 'Keep the records, but don\u0027t chase the results. Watch the thoughts that rise while running.';
---

<Base title="Running — Archive — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <a href="/archive" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Archive
      </a>

      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Running</h1>

      <blockquote class="text-text-muted italic border-l-2 border-accent pl-3 mb-6">
        {quote}
      </blockquote>

      <a
        href="/archive/running-intelligence"
        class="inline-flex items-center gap-2 rounded-lg border border-accent/30 bg-accent/5 px-4 py-2 text-sm font-medium text-accent hover:bg-accent/10 transition-colors mb-10"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Running Intelligence — Deep Analytics
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>

      {error && (
        <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 mb-6 text-sm text-amber-200">
          Could not load Strava data. Showing cached or empty results.
        </div>
      )}

      {data ? (
        <RunningDashboard client:load data={data} />
      ) : !error ? (
        <div class="rounded-xl border border-border bg-surface p-8 text-center">
          <p class="text-4xl mb-3">🏃</p>
          <p class="text-text-muted">No runs recorded on Strava yet.</p>
          <p class="text-sm text-text-muted mt-2">Start running and activities will appear here automatically.</p>
        </div>
      ) : null}

      <!-- Club Version CTA (subtle) -->
      {data && (
        <div class="mt-14 rounded-xl border border-border bg-surface p-6 text-center">
          <p class="text-sm text-text-muted mb-2">
            Built with Strava API, ACWR analytics, and custom SVG visualizations.
          </p>
          <p class="text-sm">
            <span class="text-text-muted">Interested in a team/club version?</span>{' '}
            <a href="/contact" class="text-accent hover:underline font-medium">Let's talk</a>
          </p>
        </div>
      )}

      <!-- Strava Attribution (required by API terms) -->
      <div class="mt-12 flex items-center justify-center gap-2 text-xs text-text-muted">
        <span>Powered by</span>
        <a href="https://www.strava.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-[#FC4C02] transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
          </svg>
          <span class="font-semibold">Strava</span>
        </a>
      </div>
    </div>
  </section>
</Base>
