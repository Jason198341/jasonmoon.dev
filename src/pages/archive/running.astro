---
import Base from '../../layouts/Base.astro';

// Data synced from Obsidian: C:\obsidian\04_학습\러닝 트래커.md
// Run "sync archive" to update from Obsidian

const stats = {
  totalRuns: 0,
  totalDistance: 0,
  consecutiveWeeks: 0,
};

const quote = '기록은 남기되, 성과는 쫓지 않는다. 달리면서 올라오는 생각을 본다.';

// Monthly data — populated when Obsidian tracker has entries
const months: { month: string; runs: { date: string; distance: string; time: string; musicOff: boolean; thought: string }[]; reflection?: string }[] = [
  // { month: '2026년 2월', runs: [...], reflection: '...' },
];
---

<Base title="Running — Archive — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <a href="/archive" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Archive
      </a>

      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Running</h1>

      <blockquote class="text-text-muted italic border-l-2 border-accent pl-3 mb-10">
        {quote}
      </blockquote>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mb-10">
        <div class="rounded-xl border border-border bg-surface p-4 text-center">
          <p class="text-2xl font-bold text-accent">{stats.totalRuns}</p>
          <p class="text-xs text-text-muted mt-1">Total Runs</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-4 text-center">
          <p class="text-2xl font-bold text-accent">{stats.totalDistance}</p>
          <p class="text-xs text-text-muted mt-1">Total km</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-4 text-center">
          <p class="text-2xl font-bold text-accent">{stats.consecutiveWeeks}</p>
          <p class="text-xs text-text-muted mt-1">Weeks</p>
        </div>
      </div>

      {months.length > 0 ? (
        <div class="space-y-4">
          {months.map((m) => (
            <div class="rounded-xl border border-border bg-surface p-5">
              <h3 class="font-mono font-semibold text-accent mb-3">{m.month}</h3>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="text-text-muted text-xs border-b border-border">
                      <th class="text-left py-2 pr-3">Date</th>
                      <th class="text-left py-2 pr-3">Distance</th>
                      <th class="text-left py-2 pr-3">Time</th>
                      <th class="text-left py-2">Thoughts</th>
                    </tr>
                  </thead>
                  <tbody>
                    {m.runs.map((r) => (
                      <tr class="border-b border-border/50">
                        <td class="py-2 pr-3 font-mono text-xs">{r.date}</td>
                        <td class="py-2 pr-3">{r.distance}</td>
                        <td class="py-2 pr-3">{r.time}</td>
                        <td class="py-2 text-text-muted">{r.thought}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {m.reflection && (
                <p class="text-sm text-text-muted mt-3 pt-3 border-t border-border">{m.reflection}</p>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-border bg-surface p-8 text-center">
          <p class="text-4xl mb-3">🏃</p>
          <p class="text-text-muted">No runs logged yet. The journey begins with one step.</p>
          <p class="text-sm text-text-muted mt-2">Data syncs from Obsidian running tracker.</p>
        </div>
      )}
    </div>
  </section>
</Base>
