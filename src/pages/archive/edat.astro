---
import Base from '../../layouts/Base.astro';
import EDATDemo from '../../components/EDATDemo';
---

<Base title="EDAT — Enterprise Decision Agent Team — Jason Moon">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <a href="/archive" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-accent transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Archive
      </a>

      <h1 class="text-3xl sm:text-4xl font-bold mb-2">Enterprise Decision Agent Team</h1>
      <p class="text-text-muted mb-2">Multi-Agent Decision Simulator</p>
      <p class="text-sm text-text-muted mb-10 max-w-2xl">
        AI department agents with conflicting KPIs run through Analysis → Debate → Consensus
        to reach optimal decisions. Instead of a single AI answer, it visualizes the clash and coordination of competing interests.
      </p>

      <EDATDemo client:load />

      <!-- CTA -->
      <div class="mt-20 rounded-2xl border border-accent/20 bg-surface p-8 sm:p-10 text-center">
        <p class="text-3xl mb-4">🏛️</p>
        <h3 class="text-xl sm:text-2xl font-bold mb-3">Want AI teams making your enterprise decisions?</h3>
        <p class="text-text-muted text-sm sm:text-base max-w-lg mx-auto mb-2">
          This framework applies to any multi-department decision &mdash;
          new part adoption, process changes, investment decisions, resource allocation.
        </p>
        <p class="text-text-muted text-sm max-w-lg mx-auto mb-6">
          Customize scenarios and agent configurations to build simulations tailored to your organization.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-2.5 text-sm font-medium text-white hover:bg-accent-hover transition-colors"
          >
            Let's Talk
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a
            href="/projects/edat"
            class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-2.5 text-sm font-medium text-text-muted hover:text-text hover:border-accent/50 transition-colors"
          >
            View Project Details
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
